---
import { linkify } from '../utils/linkify';
// 영어판 본문 섹션 공통 렌더러.
// guide·checklist(+ Phase C의 tips)가 같은 {heading, body, items} 구조를 쓴다.
// ja판 JaSections.astro와 동일한 패턴.
import type { EnSection } from '../data/sg/pages';

interface Props {
  sections: EnSection[];
  /** 항목 앞에 체크박스 모양을 붙일지(체크리스트용) */
  checkbox?: boolean;
}

const { sections, checkbox = false } = Astro.props;

// 제목을 URL 앵커로 쓰지 않고 순번 기반 id를 쓴다(제목이 바뀌어도 링크가 유지되게).
const anchor = (i: number) => `s${i + 1}`;
---

<div class="en-sections">
  {
    sections.map((s, i) => (
      <section class="en-section" id={anchor(i)}>
        <h2>
          <a href={`#${anchor(i)}`} class="en-anchor" aria-label={`Link to section “${s.heading}”`}>
            {s.heading}
          </a>
        </h2>
        {s.body && <p class="en-section-body">{s.body}</p>}
        {s.items.length > 0 && (
          <ul class={checkbox ? 'en-check' : 'en-list'}>
            {s.items.map((it) => (
              <li set:html={linkify(it)} />
            ))}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  .en-sections {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .en-section {
    scroll-margin-top: 20px;
  }
  .en-section h2 {
    font-size: 17px;
    color: var(--sg-primary);
    border-left: 4px solid var(--sg-primary);
    padding-left: 10px;
    margin-bottom: 12px;
  }
  .en-anchor {
    color: inherit;
    text-decoration: none;
  }
  .en-anchor:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .en-section-body {
    margin-bottom: 12px;
  }
  .en-list,
  .en-check {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .en-list li,
  .en-check li {
    position: relative;
    padding-left: 22px;
    font-size: 14.5px;
    line-height: 1.9;
  }
  .en-list li::before {
    content: '–';
    position: absolute;
    left: 4px;
    color: var(--sg-primary);
  }
  .en-check li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 11px;
    height: 11px;
    border: 1.5px solid var(--sg-primary);
  }
  .en-check li {
    border-bottom: 1px dotted var(--sg-border);
    padding-bottom: 8px;
  }
  .en-check li:last-child {
    border-bottom: none;
  }
</style>
