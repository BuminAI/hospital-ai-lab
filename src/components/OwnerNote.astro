---
import { ownerNoteLabel } from '../i18n/growth';
import { tokenStyle, type Loc } from '../utils/locale';

// 글 하단의 '운영자 메모' (2026-10-13 신설). 다섯 언어판 공용.
//
// frontmatter에 ownerNote가 있을 때만 그려진다. 이 값은 **오너가 직접 쓴 한두 문단**이어야
// 한다 — 현장에서 본 것, 이 글의 주제에 대한 오너 자신의 판단 같은 것. 자동 작성 세션이
// 대신 채우지 않는다(사람이 쓰지 않은 글을 사람의 말처럼 보이게 하는 장치가 되면 안 된다).
interface Props {
  note?: string;
  loc?: Loc;
}
const { note, loc = 'ko' } = Astro.props;
const paragraphs = (note ?? '')
  .split(/\n{2,}|\n\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

{
  paragraphs.length > 0 && (
    <aside class="gx-note" style={tokenStyle(loc)} aria-label={ownerNoteLabel[loc]}>
      <p class="label">{ownerNoteLabel[loc]}</p>
      {paragraphs.map((p) => (
        <p class="text">{p}</p>
      ))}
    </aside>
  )
}

<style>
  .gx-note {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--c-primary);
    background: var(--c-soft);
    border-radius: 0 var(--c-radius) var(--c-radius) 0;
    color: var(--c-text);
  }
  .label {
    margin: 0 0 0.4rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--c-primary);
  }
  .text {
    margin: 0 0 0.6rem;
    line-height: 1.8;
    font-size: 0.95rem;
  }
  .text:last-child {
    margin-bottom: 0;
  }
</style>
