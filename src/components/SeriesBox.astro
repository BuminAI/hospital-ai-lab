---
import { growth } from '../i18n/growth';
import { postHref, seriesHref, tokenStyle, type Loc } from '../utils/locale';
import type { ResolvedSeries, Post } from '../utils/series';

// 글 하단의 "이 글이 속한 연재" 상자 — 시리즈 안에서 이전·다음 글로 이어 준다.
// 글이 여러 시리즈에 속하면 최대 2개까지만 보여 준다(글 하단이 길어지지 않게).
// 다섯 언어판 공용 — 문구는 src/i18n/growth.ts, 색은 tokenStyle()이 언어판 토큰에 이어 준다.
interface Item {
  series: ResolvedSeries;
  index: number;
  prev: Post | null;
  next: Post | null;
}
interface Props {
  items: Item[];
  loc?: Loc;
}
const { items, loc = 'ko' } = Astro.props;
const t = growth[loc].box;
const shown = items.slice(0, 2);
---

{
  shown.length > 0 && (
    <section class="gx-box" style={tokenStyle(loc)} aria-labelledby="gx-box-title">
      <h2 id="gx-box-title">{t.heading}</h2>
      {shown.map(({ series, index, prev, next }) => (
        <div class="one">
          <p class="head">
            <a class="name" href={seriesHref(loc, series.slug)}>
              {series.title}
            </a>
            <span class="pos">
              {index + 1} / {series.posts.length}
            </span>
          </p>
          <div class="nav">
            {prev ? (
              <a href={postHref(loc, prev.id)} rel="prev">
                <span class="dir">{t.prev}</span>
                <span class="ttl">{prev.data.title}</span>
              </a>
            ) : (
              <span class="empty" />
            )}
            {next ? (
              <a href={postHref(loc, next.id)} rel="next" class="right">
                <span class="dir">{t.next}</span>
                <span class="ttl">{next.data.title}</span>
              </a>
            ) : (
              <span class="empty" />
            )}
          </div>
        </div>
      ))}
      <p class="all">
        <a href={seriesHref(loc)}>{t.all}</a>
      </p>
    </section>
  )
}

<style>
  .gx-box {
    margin-top: 2.5rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--c-border);
    border-radius: var(--c-radius);
    background: var(--c-surface);
    color: var(--c-text);
  }
  .gx-box h2 {
    margin: 0 0 0.75rem;
    padding: 0;
    border: 0;
    background: none;
    font-size: 1rem;
    color: var(--c-heading);
  }
  .one + .one {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--c-border);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.6rem;
  }
  .name {
    font-weight: 600;
  }
  .pos {
    font-size: 0.82rem;
    color: var(--c-muted);
  }
  .nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .nav a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--c-border);
    border-radius: var(--c-radius);
    background: var(--c-bg);
    text-decoration: none;
    color: var(--c-text);
    font-weight: 400;
  }
  .nav a:hover {
    border-color: var(--c-primary);
  }
  .nav .right {
    text-align: right;
  }
  .dir {
    font-size: 0.75rem;
    color: var(--c-muted);
  }
  .ttl {
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .all {
    margin: 0.9rem 0 0;
    font-size: 0.88rem;
  }
  @media (max-width: 40rem) {
    .nav {
      grid-template-columns: 1fr;
    }
    .nav .right {
      text-align: left;
    }
  }
  @media print {
    .gx-box {
      display: none;
    }
  }
</style>
