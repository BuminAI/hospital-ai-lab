      )}
      {prop === 'exam' && (
        <g transform="translate(-60 0)">
          <path d="M10 4h120v118H10z" fill="#fff"></path>
          <path d="M24 24h92" stroke-width="4"></path>
          <g fill="none" stroke="#8da0bb">
            <circle cx="34" cy="52" r="8"></circle>
            <circle cx="62" cy="52" r="8"></circle>
            <circle cx="90" cy="52" r="8"></circle>
            <circle cx="34" cy="80" r="8"></circle>
            <circle cx="62" cy="80" r="8"></circle>
