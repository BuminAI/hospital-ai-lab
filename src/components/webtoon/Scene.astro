---
/**
 * 웹툰 한 컷의 그림. 외부 이미지 없이 직접 그린 SVG다.
 * 동물 인물 두 마리(staff=왼쪽 토끼, bot=오른쪽 고양이)와 가운데 소품을 조합한다. 글자는 넣지 않는다(PDF·AI·기호만).
 * 내용은 모두 말풍선·해설 텍스트에 있으므로 그림은 보조 기술에서 숨긴다.
 */
import type { BotMood, SceneProp, StaffMood } from '../../data/tip-webtoons';
import Cat from './Cat.astro';
import Rabbit from './Rabbit.astro';

interface Props {
  staff?: StaffMood;
  bot?: BotMood;
  prop?: SceneProp;
}

const { staff, bot, prop } = Astro.props;
const INK = '#6b4a3f';
---

<svg class="scene" viewBox="0 0 360 204" aria-hidden="true" focusable="false">
  <ellipse cx="180" cy="232" rx="260" ry="56" fill="#f6e4c8"></ellipse>

  {staff && <Rabbit mood={staff} x={72} y={114} />}
  {bot && <Cat mood={bot} x={288} y={114} />}

  {prop && (
    <g transform="translate(133 62)" stroke={INK} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      {prop === 'upload' && (
        <g>
          <path d="M18 14h40l16 16v78H18z" fill="#fff"></path>
          <path d="M58 14v16h16" fill="#e6eefa"></path>
          <rect x="26" y="44" width="40" height="18" rx="4" fill="#d9534f" stroke="none"></rect>
          <text x="46" y="57.5" text-anchor="middle" font-size="13" font-weight="800" fill="#fff" stroke="none">PDF</text>
          <path d="M28 76h36M28 87h36M28 98h22" stroke="#8da0bb"></path>
          <path d="M80 70h20m-8-8l9 8-9 8" fill="none" stroke="#0b5394" stroke-width="4"></path>
        </g>
      )}
      {prop === 'badge' && (
        <g>
          <path d="M45 14l36 12v28c0 24-16 40-36 48-20-8-36-24-36-48V26z" fill="#ffe08a"></path>
          <path d="M28 56l12 12 24-26" fill="none" stroke-width="6"></path>
          <path d="M2 16l-8-8M88 16l8-8M45 2v-12" fill="none" stroke="#e4a11b" stroke-width="3.5"></path>
        </g>
      )}
      {prop === 'magnify' && (
        <g>
          <path d="M12 20h52v90H12z" fill="#fff"></path>
          <path d="M22 36h32M22 50h32M22 64h24M22 78h32M22 92h18" stroke="#8da0bb"></path>
          <circle cx="62" cy="62" r="25" fill="#dff0ff" fill-opacity="0.85" stroke-width="5"></circle>
          <path d="M80 81l18 20" stroke-width="8"></path>
          <text x="62" y="73" text-anchor="middle" font-size="31" font-weight="800" fill="#d9534f" stroke="none">?</text>
        </g>
      )}
      {prop === 'exam' && (
        <g transform="translate(-60 0)">
          <path d="M10 4h120v118H10z" fill="#fff"></path>
          <path d="M24 24h92" stroke-width="4"></path>
          <g fill="none" stroke="#8da0bb">
            <circle cx="34" cy="52" r="8"></circle>
            <circle cx="62" cy="52" r="8"></circle>
            <circle cx="90" cy="52" r="8"></circle>
            <circle cx="34" cy="80" r="8"></circle>
            <circle cx="62" cy="80" r="8"></circle>
            <circle cx="90" cy="80" r="8"></circle>
          </g>
          <circle cx="62" cy="52" r="5" fill={INK} stroke="none"></circle>
          <text x="112" y="88" text-anchor="middle" font-size="26" font-weight="800" fill="#d9534f" stroke="none">?</text>
          <path d="M138 52l16 7-24 56-12 8-2-15z" fill="#ffd36b"></path>
          <path d="M118 108l14 7" fill="none"></path>
        </g>
      )}
      {prop === 'typing' && (
        <g>
          <rect x="4" y="26" width="82" height="58" rx="7" fill="#fff"></rect>
          <path d="M16 42h56M16 54h42" stroke="#8da0bb"></path>
          <rect x="16" y="64" width="50" height="10" rx="3" fill="#ffe08a" stroke="none"></rect>
          <path d="M70 63v13" stroke="#0b5394" stroke-width="3"></path>
          <path d="M-6 100h102l-8-16H2z" fill="#c9d9ec"></path>
        </g>
      )}
      {prop === 'notfound' && (
        <g>
          <path d="M16 16h58v92H16z" fill="#fff"></path>
          <path d="M26 34h38M26 48h38M26 90h26" stroke="#8da0bb"></path>
          <rect x="26" y="58" width="38" height="22" rx="4" fill="#fff" stroke-dasharray="5 5"></rect>
          <text x="45" y="75" text-anchor="middle" font-size="16" font-weight="800" fill="#0b5394" stroke="none">?</text>
          <circle cx="76" cy="100" r="17" fill="#46c1a6"></circle>
          <path d="M68 100l6 6 11-12" fill="none" stroke="#fff" stroke-width="4"></path>
        </g>
      )}
      {prop === 'quotes' && (
        <g>
          <path d="M8 10h74v108H8z" fill="#fff"></path>
          <rect x="30" y="29" width="44" height="11" fill="#ffe08a" stroke="none"></rect>
          <rect x="30" y="63" width="44" height="11" fill="#ffe08a" stroke="none"></rect>
          <path d="M32 34h38M32 51h30M32 68h38M32 85h26M32 101h34" stroke="#8da0bb"></path>
          <g stroke="none">
            <circle cx="19" cy="34" r="8" fill="#0b5394"></circle>
            <circle cx="19" cy="68" r="8" fill="#0b5394"></circle>
            <g font-size="11" font-weight="800" fill="#fff" text-anchor="middle">
              <text x="19" y="38">1</text>
              <text x="19" y="72">2</text>
            </g>
          </g>
        </g>
      )}
      {prop === 'checklist' && (
        <g transform="translate(18 -4)">
          <rect x="8" y="14" width="96" height="116" rx="8" fill="#fff"></rect>
          <rect x="36" y="6" width="40" height="17" rx="5" fill="#c9d9ec"></rect>
          <g fill="none">
            <path d="M22 46l6 6 11-13M22 74l6 6 11-13" stroke="#1e9e5a" stroke-width="4"></path>
            <rect x="22" y="96" width="14" height="14" rx="3"></rect>
            <path d="M48 47h42M48 75h42M48 103h30" stroke="#8da0bb"></path>
          </g>
        </g>
      )}
      {prop === 'lock' && (
        <g transform="translate(24 -4)">
          <path d="M60 6l54 18v38c0 34-24 56-54 68C30 118 6 96 6 62V24z" fill="#cfe3f7"></path>
          <path d="M44 62V48a16 16 0 0 1 32 0v14" fill="none" stroke-width="7"></path>
          <rect x="34" y="60" width="52" height="42" rx="8" fill="#ffd36b"></rect>
          <circle cx="60" cy="76" r="6" fill={INK} stroke="none"></circle>
          <path d="M60 78v12" stroke-width="5"></path>
        </g>
      )}
      {prop === 'mismatch' && (
        <g>
          <path d="M-2 28h42v62H-2z" fill="#fff"></path>
          <path d="M6 42h26M6 54h26M6 66h18M6 78h24" stroke="#8da0bb"></path>
          <path d="M58 28h42v62H58z" fill="#fff"></path>
          <path d="M66 42h26" stroke="#f09b4a" stroke-width="5"></path>
          <path d="M66 62h10M82 62h10M66 76h18" stroke="#8da0bb"></path>
          <circle cx="49" cy="108" r="15" fill="#ffe08a"></circle>
          <path d="M42 104h14M42 112h14M54 100l-10 16" fill="none"></path>
        </g>
      )}
      {prop === 'example' && (
        <g>
          <path d="M14 18h70v94H14z" fill="#fff"></path>
          <rect x="24" y="32" width="50" height="12" rx="3" fill="#bfeee2" stroke="none"></rect>
          <g fill={INK} stroke="none">
            <rect x="24" y="55" width="7" height="7"></rect>
            <rect x="24" y="73" width="7" height="7"></rect>
            <rect x="24" y="91" width="7" height="7"></rect>
          </g>
          <path d="M38 59h34M38 77h28M38 95h34" stroke="#8da0bb"></path>
          <circle cx="84" cy="18" r="14" fill="#ffd45c"></circle>
          <path d="M77 18l5 5 9-10" fill="none" stroke-width="3.5"></path>
        </g>
      )}
      {prop === 'examples' && (
        <g>
          <path d="M-2 38h34v62H-2z" fill="#fff" transform="rotate(-9 15 69)"></path>
          <path d="M64 36h34v76H64z" fill="#fff" transform="rotate(9 81 74)"></path>
          <path d="M28 22h40v92H28z" fill="#fff"></path>
          <path d="M36 36h24M36 50h24M36 64h16M36 78h24M36 92h20" stroke="#8da0bb"></path>
          <circle cx="10" cy="38" r="9" fill="#46c1a6"></circle>
          <circle cx="48" cy="20" r="9" fill="#f09b4a"></circle>
          <circle cx="87" cy="38" r="9" fill="#ff8fa0"></circle>
        </g>
      )}
      {prop === 'longdoc' && (
        <g>
          <path d="M22 2h54v116l-9-6-9 6-9-6-9 6-9-6-9 6z" fill="#fff"></path>
          <path d="M32 16h34M32 28h34M32 40h28M32 52h34M32 64h22M32 76h34M32 88h30M32 100h34" stroke="#8da0bb"></path>
        </g>
      )}
      {(prop === 'nodate' || prop === 'dateok') && (
        <g>
          <rect x="10" y="28" width="78" height="76" rx="9" fill="#fff"></rect>
          <path d="M10 50V37a9 9 0 0 1 9-9h60a9 9 0 0 1 9 9v13z" fill="#ff8f8f"></path>
          <path d="M28 20v16M70 20v16" fill="none" stroke-width="5"></path>
          {prop === 'nodate' ? (
            <g>
              <rect x="30" y="60" width="38" height="33" rx="6" fill="none" stroke-dasharray="5 5"></rect>
              <text x="49" y="86" text-anchor="middle" font-size="25" font-weight="800" fill="#d9534f" stroke="none">?</text>
            </g>
          ) : (
            <g>
              <circle cx="49" cy="77" r="19" fill="#bfeee2"></circle>
              <path d="M40 77l7 7 13-14" fill="none" stroke="#1e9e5a" stroke-width="5"></path>
            </g>
          )}
        </g>
      )}
      {prop === 'idea' && (
        <g>
          <path d="M48 16c20 0 33 15 33 32 0 18-16 22-17 38H32c-1-16-17-20-17-38 0-17 13-32 33-32z" fill="#ffe08a"></path>
          <rect x="33" y="86" width="30" height="22" rx="5" fill="#c9d9ec"></rect>
          <path d="M33 97h30M39 86l-5-32 14 11 14-11-5 32" fill="none"></path>
          <path d="M48 5v-9M14 18l-7-7M82 18l7-7M6 48H-4M90 48h10" fill="none" stroke="#e4a11b" stroke-width="3.5"></path>
        </g>
      )}
      {prop === 'board' && (
        <g>
          <path d="M14 100v20M82 100v20" fill="none" stroke-width="5"></path>
          <rect x="-2" y="18" width="100" height="84" rx="7" fill="#e8c08a"></rect>
          <path d="M20 34h56v54H20z" fill="#fff"></path>
          <path d="M28 52h40M28 64h40M28 76h26" stroke="#8da0bb"></path>
          <circle cx="48" cy="34" r="6" fill="#ff8f8f"></circle>
        </g>
      )}
    </g>
  )}
</svg>

<style>
  .scene {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
