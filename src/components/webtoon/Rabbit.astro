---
/** 토끼 직원 '토리 주임'. 원점(0,0)이 얼굴 가운데다. 표정에 따라 귀와 앞발도 함께 움직인다. */
import type { StaffMood } from '../../data/tip-webtoons';

interface Props {
  mood: StaffMood;
  x: number;
  y: number;
}

const { mood, x, y } = Astro.props;

const LINE = '#6b4a3f';
const FUR = '#fffdfb';
const PINK = '#ffb9c4';
const CLOTH = '#7ccbbd';

// 귀: [왼쪽 각도, 오른쪽 각도]
const ears = {
  ask: [-12, 14],
  happy: [-22, 22],
  surprised: [-4, 4],
  think: [-10, 52],
  firm: [-8, 8],
}[mood];

// 앞발 위치
const paws = {
  ask: [[-30, 56], [34, 40]],
  happy: [[-42, 38], [42, 38]],
  surprised: [[-36, 30], [36, 30]],
  think: [[-30, 56], [18, 38]],
  firm: [[-30, 56], [42, 36]],
}[mood];
---

<g transform={`translate(${x} ${y})`} stroke={LINE} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
  {/* 귀 */}
  <g transform={`translate(-20 -30) rotate(${ears[0]})`}>
    <ellipse cx="0" cy="-31" rx="13" ry="36" fill={FUR}></ellipse>
    <ellipse cx="0" cy="-31" rx="6" ry="25" fill={PINK} stroke="none"></ellipse>
  </g>
  <g transform={`translate(20 -30) rotate(${ears[1]})`}>
    <ellipse cx="0" cy="-31" rx="13" ry="36" fill={FUR}></ellipse>
    <ellipse cx="0" cy="-31" rx="6" ry="25" fill={PINK} stroke="none"></ellipse>
  </g>

  {/* 몸과 발 */}
  <path d="M-34 80C-36 46-22 30 0 30S36 46 34 80z" fill={CLOTH}></path>
  <ellipse cx="-17" cy="78" rx="15" ry="8" fill={FUR}></ellipse>
  <ellipse cx="17" cy="78" rx="15" ry="8" fill={FUR}></ellipse>
  <path d="M-13 40L0 62 13 40" fill="none" stroke="#f0a830" stroke-width="3"></path>
  <rect x="-9" y="59" width="18" height="15" rx="3.5" fill="#fff" stroke-width="2"></rect>
  <path d="M-4 65h8M-4 69.5h5" stroke-width="1.6"></path>

  {/* 머리 */}
  <path d="M0-42C32-42 52-22 52 4S30 40 0 40-52 30-52 4-32-42 0-42z" fill={FUR}></path>
  <ellipse cx="-32" cy="14" rx="10" ry="6.5" fill={PINK} stroke="none" opacity="0.75"></ellipse>
  <ellipse cx="32" cy="14" rx="10" ry="6.5" fill={PINK} stroke="none" opacity="0.75"></ellipse>

  {/* 눈 */}
  {mood === 'happy' ? (
    <path d="M-28 2q8-12 16 0M12 2q8-12 16 0" fill="none" stroke-width="3.4"></path>
  ) : (
    <g stroke="none">
      <ellipse cx="-20" cy="0" rx={mood === 'surprised' ? 9.5 : 7.5} ry={mood === 'surprised' ? 11 : 9.5} fill="#3d2a26"></ellipse>
      <ellipse cx="20" cy="0" rx={mood === 'surprised' ? 9.5 : 7.5} ry={mood === 'surprised' ? 11 : 9.5} fill="#3d2a26"></ellipse>
      <g fill="#fff">
        <circle cx={mood === 'think' ? -18 : -17.5} cy={mood === 'think' ? -5 : -3.5} r="3.2"></circle>
        <circle cx={mood === 'think' ? 22 : 22.5} cy={mood === 'think' ? -5 : -3.5} r="3.2"></circle>
        <circle cx="-23" cy="4" r="1.6"></circle>
        <circle cx="17" cy="4" r="1.6"></circle>
      </g>
    </g>
  )}

  {/* 눈썹 */}
  {mood === 'firm' && <path d="M-28-17l13 2M28-17l-13 2" fill="none"></path>}
  {mood === 'think' && <path d="M-28-15q7-3 14-2M14-20q8-3 15 2" fill="none"></path>}
  {mood === 'surprised' && <path d="M-27-19q7-5 14-1M13-20q7-4 14 1" fill="none"></path>}

  {/* 코와 입 */}
  <path d="M-4 10q4-3 8 0l-4 4.5z" fill="#ff8fa0" stroke-width="1.8"></path>
  {mood === 'surprised' ? (
    <ellipse cx="0" cy="24" rx="6" ry="7.5" fill="#d9626f"></ellipse>
  ) : mood === 'happy' ? (
    <path d="M-10 18q10 4 20 0q-2 15-10 15t-10-15z" fill="#d9626f"></path>
  ) : mood === 'ask' ? (
    <g>
      <path d="M0 15v3" fill="none"></path>
      <ellipse cx="0" cy="23" rx="4.5" ry="5" fill="#d9626f"></ellipse>
    </g>
  ) : mood === 'think' ? (
    <path d="M0 15v3M-7 23q4-4 7-1t7 0" fill="none"></path>
  ) : (
    <path d="M0 15v3M-10 20q10 11 20 0" fill="none"></path>
  )}

  {/* 팔과 앞발: 굵은 선을 두 번 겹쳐 팔을 만들고 끝에 앞발을 얹는다 */}
  {paws.map(([px, py]) => {
    const arm = `M${Math.sign(px) * 22} 56L${px} ${py}`;
    return (
      <g>
        <path d={arm} fill="none" stroke-width="15"></path>
        <path d={arm} fill="none" stroke={CLOTH} stroke-width="10"></path>
        <ellipse cx={px} cy={py} rx="10" ry="9" fill={FUR}></ellipse>
      </g>
    );
  })}

  {mood === 'surprised' && <path d="M52-30c7 9 9 15 4 19s-12 1-10-6z" fill="#a8d8f8" stroke-width="2"></path>}
</g>
