---
/** 고양이 모습의 AI 'AI 냥이'. 원점(0,0)이 얼굴 가운데다. 머리 위 안테나와 가슴의 AI 표시로 AI임을 알린다. */
import type { BotMood } from '../../data/tip-webtoons';

interface Props {
  mood: BotMood;
  x: number;
  y: number;
}

const { mood, x, y } = Astro.props;

const LINE = '#6b4a3f';
const FUR = '#ffc476';
const STRIPE = '#f09b4a';
const CREAM = '#fff4e0';
const PINK = '#ff9fae';
const droop = mood === 'unsure';
---

<g transform={`translate(${x} ${y})`} stroke={LINE} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
  {/* 꼬리: 굵은 선을 두 번 겹쳐 테두리를 만든다 */}
  <path d={droop ? 'M22 70C48 74 58 78 56 84' : 'M24 68C58 72 66 48 52 36'} fill="none" stroke-width="16"></path>
  <path d={droop ? 'M22 70C48 74 58 78 56 84' : 'M24 68C58 72 66 48 52 36'} fill="none" stroke={FUR} stroke-width="11"></path>

  {/* 몸과 발 */}
  <path d="M-33 80C-35 46-22 30 0 30S35 46 33 80z" fill={FUR}></path>
  <ellipse cx="0" cy="64" rx="19" ry="17" fill={CREAM} stroke="none"></ellipse>
  <ellipse cx="-17" cy="78" rx="14" ry="8" fill={CREAM}></ellipse>
  <ellipse cx="17" cy="78" rx="14" ry="8" fill={CREAM}></ellipse>
  <circle cx="0" cy="55" r="11" fill="#bfeee2" stroke-width="2"></circle>
  <text x="0" y="59.5" text-anchor="middle" font-size="12" font-weight="800" fill="#2b6f62" stroke="none">AI</text>

  {/* 귀 */}
  <g transform={droop ? 'rotate(-22 -34 -20)' : undefined}>
    <path d="M-48-8C-50-34-46-52-39-55S-20-45-12-35z" fill={FUR}></path>
    <path d="M-41-22c-1-12 0-20 3-22s10 4 15 10z" fill={PINK} stroke="none"></path>
  </g>
  <g transform={droop ? 'rotate(22 34 -20)' : undefined}>
    <path d="M48-8C50-34 46-52 39-55S20-45 12-35z" fill={FUR}></path>
    <path d="M41-22c1-12 0-20-3-22s-10 4-15 10z" fill={PINK} stroke="none"></path>
  </g>

  {/* 안테나 */}
  <path d="M0-39q-2-13 4-23" fill="none"></path>
  <circle cx="5" cy="-67" r="7" fill={droop ? '#ffd45c' : '#6fd9c0'}></circle>
  <circle cx="3" cy="-69.5" r="2" fill="#fff" stroke="none"></circle>

  {/* 머리 */}
  <path d="M0-40C34-40 55-20 55 5S32 40 0 40-55 30-55 5-34-40 0-40z" fill={FUR}></path>
  <g fill={STRIPE} stroke="none">
    <path d="M-4-39h8l-4 15z"></path>
    <path d="M-19-37l8-1.5 1 12z"></path>
    <path d="M19-37l-8-1.5-1 12z"></path>
  </g>
  <ellipse cx="0" cy="20" rx="23" ry="15" fill={CREAM} stroke="none"></ellipse>
  <ellipse cx="-36" cy="15" rx="9.5" ry="6" fill={PINK} stroke="none" opacity="0.75"></ellipse>
  <ellipse cx="36" cy="15" rx="9.5" ry="6" fill={PINK} stroke="none" opacity="0.75"></ellipse>
  <path d="M-47 8l-14-3M-47 18l-14 3M47 8l14-3M47 18l14 3" fill="none" stroke-width="1.8"></path>

  {/* 눈 */}
  {mood === 'proud' ? (
    <path d="M-30-1q9-10 18 0M12-1q9-10 18 0" fill="none" stroke-width="3.4"></path>
  ) : mood === 'unsure' ? (
    <g fill="#3d2a26" stroke="none">
      <circle cx="-17" cy="2" r="4.5"></circle>
      <circle cx="23" cy="2" r="4.5"></circle>
    </g>
  ) : (
    <g stroke="none">
      <ellipse cx="-21" cy="0" rx="8" ry="10" fill="#3d2a26"></ellipse>
      <ellipse cx="21" cy="0" rx="8" ry="10" fill="#3d2a26"></ellipse>
      <g fill="#fff">
        <circle cx="-18.5" cy="-3.5" r={mood === 'honest' ? 4 : 3.2}></circle>
        <circle cx="23.5" cy="-3.5" r={mood === 'honest' ? 4 : 3.2}></circle>
        <circle cx="-24" cy="4.5" r="1.8"></circle>
        <circle cx="18" cy="4.5" r="1.8"></circle>
      </g>
    </g>
  )}
  {mood === 'unsure' && <path d="M-29-13q8 0 14-5M29-13q-8 0-14-5" fill="none"></path>}

  {/* 코와 입 */}
  <path d="M-4 11q4-3 8 0l-4 4.5z" fill="#ff8fa0" stroke-width="1.8"></path>
  {mood === 'proud' ? (
    <path d="M-12 18q12 5 24 0q-2 17-12 17t-12-17z" fill="#d9626f"></path>
  ) : mood === 'unsure' ? (
    <path d="M-11 25q3-5 7 0t7 0t8 0" fill="none"></path>
  ) : (
    <path d="M0 16v3M-10 20q5 8 10-1q5 9 10 1" fill="none"></path>
  )}

  {droop && <path d="M52-36c7 9 9 15 4 19s-12 1-10-6z" fill="#a8d8f8" stroke-width="2"></path>}
  {mood === 'proud' && (
    <path d="M-62-34l2 7 7 2-7 2-2 7-2-7-7-2 7-2zM60-44l1.6 5.4 5.4 1.6-5.4 1.6-1.6 5.4-1.6-5.4-5.4-1.6 5.4-1.6z" fill="#ffd45c" stroke-width="1.6"></path>
  )}
</g>
