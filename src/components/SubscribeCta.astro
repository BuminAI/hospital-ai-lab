---
import { withBase, EMAIL_NEWSLETTER_LIVE } from '../utils/site';

// 글·연재·점검표 하단의 구독 안내 (2026-09-20 신설).
//
// ⚠️ 문구는 **지금 실제로 되는 것만** 약속한다. 새 글 알림 메일은 발송 연동
//    (RESEND_API_KEY 등)이 끝나기 전까지 한 번도 나간 적이 없으므로,
//    EMAIL_NEWSLETTER_LIVE가 false인 동안에는 메일 얘기를 빼고 RSS·회원가입만
//    안내한다. 플래그는 src/utils/site.ts에 있다.
interface Props {
  /** 안내문 첫 줄에 붙일 맥락(예: '이 시리즈의 새 글') — 없으면 기본 문구 */
  context?: string;
}
const { context = '새 글' } = Astro.props;
---

<aside class="subscribe-cta" aria-labelledby="subscribe-cta-title">
  <div class="text">
    <h2 id="subscribe-cta-title">{context}을 놓치지 않으려면</h2>
    {
      EMAIL_NEWSLETTER_LIVE ? (
        <p>
          병원 행정·간호 실무자를 위한 의료 AI 글을 새로 올릴 때마다 메일로 알려 드립니다.
          회원가입 때 알림 수신을 선택해 주세요. 메일 하단 링크로 언제든 끊을 수 있습니다.
        </p>
      ) : (
        <p>
          병원 행정·간호 실무자를 위한 의료 AI 글을 날마다 올립니다. RSS 리더에 등록해 두면
          새 글이 바로 도착하고, 회원가입하시면 실무자용 강의노트도 볼 수 있습니다.
        </p>
      )
    }
  </div>
  <div class="actions">
    <a class="btn" href={withBase('/signup/')}>
      {EMAIL_NEWSLETTER_LIVE ? '새 글 알림 신청' : '회원가입'}
    </a>
    <a class="btn ghost" href={withBase('/rss.xml')}>RSS로 구독</a>
  </div>
</aside>

<style>
  .subscribe-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-primary-soft);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius);
  }
  .subscribe-cta h2 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }
  .subscribe-cta p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-muted);
    line-height: 1.7;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  @media (max-width: 40rem) {
    .subscribe-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media print {
    .subscribe-cta {
      display: none;
    }
  }
</style>
