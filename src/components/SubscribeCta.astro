---
import { growth } from '../i18n/growth';
import { withBase, EMAIL_NEWSLETTER_LIVE } from '../utils/site';
import { rssHref, tokenStyle, type Loc } from '../utils/locale';

// 글·연재·점검표 하단의 구독 안내 (2026-09-20 신설). 다섯 언어판 공용.
//
// ⚠️ 문구는 **지금 실제로 되는 것만** 약속한다. 새 글 알림 메일은 발송 연동
//    (RESEND_API_KEY 등)이 끝나기 전까지 한 번도 나간 적이 없으므로,
//    EMAIL_NEWSLETTER_LIVE가 false인 동안에는 메일 얘기를 빼고 RSS·회원가입만
//    안내한다. 플래그는 src/utils/site.ts에 있다.
// ⚠️ 한국어판 밖에는 회원가입·메일 발송이 없다. 다른 언어판은 RSS만 안내한다.
interface Props {
  /** 안내문 첫 줄에 붙일 맥락(예: '이 시리즈의 새 글') — 없으면 언어별 기본 문구 */
  context?: string;
  loc?: Loc;
}
const { context, loc = 'ko' } = Astro.props;
const t = growth[loc].subscribe;
const isKo = loc === 'ko';
---

<aside class="gx-cta" style={tokenStyle(loc)} aria-labelledby="gx-cta-title">
  <div class="text">
    <h2 id="gx-cta-title">{t.title(context)}</h2>
    {
      isKo && EMAIL_NEWSLETTER_LIVE ? (
        <p>
          병원 행정·간호 실무자를 위한 의료 AI 글을 새로 올릴 때마다 메일로 알려 드립니다.
          회원가입 때 알림 수신을 선택해 주세요. 메일 하단 링크로 언제든 끊을 수 있습니다.
        </p>
      ) : (
        <p>{t.body}</p>
      )
    }
  </div>
  <div class="actions">
    {
      isKo && (
        <a class="gx-btn" href={withBase('/signup/')}>
          {EMAIL_NEWSLETTER_LIVE ? '새 글 알림 신청' : '회원가입'}
        </a>
      )
    }
    <a class={isKo ? 'gx-btn ghost' : 'gx-btn'} href={rssHref(loc)}>{t.rss}</a>
  </div>
</aside>

<style>
  .gx-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--c-soft);
    border: 1px solid var(--c-ring);
    border-radius: var(--c-radius);
    color: var(--c-text);
  }
  .gx-cta h2 {
    margin: 0 0 0.35rem;
    padding: 0;
    border: 0;
    background: none;
    font-size: 1.05rem;
    color: var(--c-heading);
  }
  .gx-cta p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--c-muted);
    line-height: 1.7;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .gx-btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--c-btn-bg);
    border-radius: var(--c-radius);
    background: var(--c-btn-bg);
    color: var(--c-btn-fg);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    line-height: 1.4;
  }
  .gx-btn:hover {
    opacity: 0.88;
  }
  .gx-btn.ghost {
    background: transparent;
    color: var(--c-primary);
    border-color: var(--c-primary);
  }
  @media (max-width: 40rem) {
    .gx-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media print {
    .gx-cta {
      display: none;
    }
  }
</style>
