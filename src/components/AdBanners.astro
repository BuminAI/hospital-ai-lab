---
// 다른 언어판 홈 전용 광고 배너 2장 (2026-11-17 오너 지시: 한국어판 제외 전 언어판에 게시).
// 한국어 홈은 src/pages/index.astro에 직접 넣어 두었다(한국어 이미지). 내릴 때는 각 언어판 index.astro의 <AdBanners />와
// 이 파일, public/ads/ 이미지를 함께 지운다. 화면에는 '광고' 글자를 쓰지 않는다(오너 지시); 스크린리더용 aria-label만 둔다.
import { withBase } from '../utils/site';
interface Props {
  label?: string;
}
const { label = 'Advertisement' } = Astro.props;
---
<aside class="adb-wrap" aria-label={label}>
  <div class="adb-row">
    <a class="adb" href="https://blog.naver.com/namujangi" target="_blank" rel="sponsored nofollow noopener">
      <img
        src={withBase('/ads/namujangi-banner-en.webp')}
        alt="Master Carpenter Kim: home repair expert. Kitchen furniture upgrades, carpentry, bathroom repairs, electrical and lighting. Quotes: 010-2456-6909"
        width="1000"
        height="254"
        loading="lazy"
        decoding="async"
      />
    </a>
    <a class="adb" href="https://www.bumin.co.kr/" target="_blank" rel="noopener">
      <img
        src={withBase('/ads/bumin-hospital-banner.webp')}
        alt="Bumin Hospital Group"
        width="1000"
        height="254"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
</aside>

<style>
  .adb-wrap {
    max-width: 1120px;
    margin: 28px auto;
    padding: 0 16px;
  }
  .adb-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .adb {
    display: block;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid rgba(128, 128, 128, 0.3);
    background: #fff;
  }
  .adb img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 640px) {
    .adb-row {
      grid-template-columns: 1fr;
    }
  }
</style>
