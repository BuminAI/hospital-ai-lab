---
// 일본어판 본문 섹션 공통 렌더러.
// guide·checklist·tips 세 페이지가 같은 {heading, body, items} 구조를 쓴다.
//
// heading에 id를 붙여 개별 항목에 직접 링크할 수 있게 한다. 일본 독자는
// 자료를 부서에 공유할 때 특정 항목만 지목하는 경우가 많고, AI 검색엔진도
// 앵커가 있으면 해당 부분만 인용하기 쉽다.
import type { JaSection } from '../data/ja/pages';

interface Props {
  sections: JaSection[];
  /** 항목 앞에 체크박스 모양을 붙일지(체크리스트용) */
  checkbox?: boolean;
}

const { sections, checkbox = false } = Astro.props;

// 일본어 제목은 URL 앵커로 쓰기 어려우므로 순번 기반 id를 쓴다.
const anchor = (i: number) => `s${i + 1}`;
---

<div class="ja-sections">
  {
    sections.map((s, i) => (
      <section class="ja-section" id={anchor(i)}>
        <h2>
          <a href={`#${anchor(i)}`} class="ja-anchor" aria-label={`${s.heading}へのリンク`}>
            {s.heading}
          </a>
        </h2>
        {s.body && <p class="ja-section-body">{s.body}</p>}
        {s.items.length > 0 && (
          <ul class={checkbox ? 'ja-check' : 'ja-list'}>
            {s.items.map((it) => (
              <li>{it}</li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  .ja-sections {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .ja-section {
    /* 앵커로 이동했을 때 헤더에 가려지지 않게 */
    scroll-margin-top: 20px;
  }
  .ja-section h2 {
    font-size: 17px;
    color: var(--ja-primary);
    border-left: 4px solid var(--ja-primary);
    padding-left: 10px;
    margin-bottom: 12px;
  }
  .ja-anchor {
    color: inherit;
    text-decoration: none;
  }
  .ja-anchor:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ja-section-body {
    margin-bottom: 12px;
  }
  .ja-list,
  .ja-check {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ja-list li,
  .ja-check li {
    position: relative;
    padding-left: 22px;
    font-size: 14.5px;
    line-height: 1.9;
  }
  .ja-list li::before {
    content: '・';
    position: absolute;
    left: 4px;
    color: var(--ja-primary);
  }
  /* 체크리스트는 네모칸으로 — 인쇄해서 회의에 들고 가는 용도 */
  .ja-check li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 11px;
    height: 11px;
    border: 1.5px solid var(--ja-primary);
  }
  .ja-check li {
    border-bottom: 1px dotted var(--ja-border);
    padding-bottom: 8px;
  }
  .ja-check li:last-child {
    border-bottom: none;
  }
</style>
