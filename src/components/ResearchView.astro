---
// 각 언어판 '의료 기술·논문' 페이지의 본문 (2026-11-14). 데이터: src/data/research/<loc>.json, 문구: src/data/research/strings.ts
import { RESEARCH_STRINGS } from '../data/research/strings';
import type { Loc } from '../utils/locale';

interface Props {
  loc: Loc;
}
const { loc } = Astro.props;
const t = RESEARCH_STRINGS[loc];
const all = import.meta.glob('../data/research/*.json', { eager: true }) as Record<string, { default: any }>;
const data = all[`../data/research/${loc}.json`]?.default;
const keys = ['surgery', 'drug', 'trials', 'disease'] as const;
const totals: Record<string, number> = data?.totals ?? {};
const fmt = (d: string) => (d ? d.replace(/-01$/, '') === d ? d : d : '');
---

<div class="rs">
  <p class="rs-lead">{t.lead}</p>
  {data && <p class="rs-window">{t.window(data.window.from, data.window.to)}</p>}

  <div class="rs-note" role="note">
    <strong>{t.noteTitle}</strong>
    <ul>
      {t.note.map((n) => <li>{n}</li>)}
      <li>{t.titlesNote}</li>
    </ul>
  </div>

  {
    keys.map((k) => {
      const items: any[] = data?.sections?.[k] ?? [];
      const total = k === 'trials' ? totals.trials : totals[k];
      return (
        <section class="rs-sec" aria-labelledby={`rs-${k}`}>
          <h2 id={`rs-${k}`}>{t.sections[k].title}</h2>
          <p class="rs-desc">{t.sections[k].desc}</p>
          {items.length > 0 ? (
            <>
              {total ? <p class="rs-count">{t.count(items.length, total)}</p> : null}
              <ol class="rs-list">
                {items.map((it) => (
                  <li>
                    <a href={it.url} target="_blank" rel="noopener">
                      {it.title}
                    </a>
                    {it.kind === 'trial' ? (
                      <p class="rs-meta">
                        <span>{it.id}</span>
                        {it.phase && <span>{t.phase}: {it.phase}</span>}
                        {it.date && <span>{t.started}: {fmt(it.date)}</span>}
                        {it.source && <span>{t.sponsor}: {it.source}</span>}
                        {it.conditions && <span>{t.conditions}: {it.conditions}</span>}
                        {it.intervention && <span>{t.intervention}: {it.intervention}</span>}
                      </p>
                    ) : (
                      <p class="rs-meta">
                        <span>{it.source}</span>
                        <span>{it.date}</span>
                        {it.authors && <span>{it.authors}</span>}
                        <span>{it.id}</span>
                      </p>
                    )}
                  </li>
                ))}
              </ol>
            </>
          ) : (
            <p class="rs-empty">{t.empty}</p>
          )}
        </section>
      );
    })
  }

  <p class="rs-src">
    {t.source}: <a href="https://pubmed.ncbi.nlm.nih.gov/" target="_blank" rel="noopener">PubMed</a> · <a href="https://clinicaltrials.gov/" target="_blank" rel="noopener">ClinicalTrials.gov</a>
  </p>
</div>

<style>
  .rs { max-width: 62rem; }
  .rs-lead { font-size: 1.05rem; line-height: 1.7; margin: 0 0 0.5rem; }
  .rs-window { opacity: 0.75; font-size: 0.9rem; margin: 0 0 1rem; }
  .rs-note { border: 1px solid rgba(128, 128, 128, 0.4); border-radius: 8px; padding: 0.8rem 1rem; margin: 0 0 1.5rem; font-size: 0.92rem; line-height: 1.6; }
  .rs-note ul { margin: 0.4rem 0 0; padding-left: 1.2rem; }
  .rs-sec { margin: 2rem 0; }
  .rs-sec h2 { margin: 0 0 0.25rem; }
  .rs-desc { opacity: 0.75; margin: 0 0 0.6rem; font-size: 0.93rem; }
  .rs-count { font-size: 0.85rem; opacity: 0.7; margin: 0 0 0.5rem; }
  .rs-list { margin: 0; padding-left: 1.3rem; }
  .rs-list li { padding: 0.55rem 0; border-bottom: 1px dotted rgba(128, 128, 128, 0.4); }
  .rs-list a { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .rs-meta { margin: 0.2rem 0 0; font-size: 0.85rem; opacity: 0.8; display: flex; flex-wrap: wrap; gap: 0.15rem 0.9rem; }
  .rs-empty { opacity: 0.7; }
  .rs-src { margin-top: 2rem; font-size: 0.88rem; opacity: 0.8; }
</style>
