---
// 각 언어판 '의료 기술·논문' 페이지의 본문 (2026-11-14). 데이터: src/data/research/<loc>.json, 문구: src/data/research/strings.ts
import { RESEARCH_STRINGS } from '../data/research/strings';
import type { Loc } from '../utils/locale';

interface Props {
  loc: Loc;
}
const { loc } = Astro.props;
const t = RESEARCH_STRINGS[loc];
const all = import.meta.glob('../data/research/*.json', { eager: true }) as Record<string, { default: any }>;
const data = all[`../data/research/${loc}.json`]?.default;
const keys = ['surgery', 'drug', 'trials', 'disease'] as const;
const totals: Record<string, number> = data?.totals ?? {};
// 검색창 문구(2026-11-23, 오너 지시: 의료 기술·논문 메뉴에 검색창). 영어권 판(en·in·sg·ph·ae·ie)은 영어를 같이 쓴다.
const enQ = { label: 'Search papers and trials', ph: 'Title, journal or author (e.g. cancer, stroke)', none: 'Nothing matches your search.' };
const SEARCH: Record<string, { label: string; ph: string; none: string }> = {
  ko: { label: '논문·임상시험 검색', ph: '제목·저널·저자 검색 — 제목이 영어라 영어로 (예: cancer, stroke)', none: '검색어에 맞는 항목이 없습니다.' },
  ja: { label: '論文・治験を検索', ph: 'タイトル・雑誌・著者で検索 — 題名は英語です(例: cancer, stroke)', none: '検索条件に合う項目がありません。' },
  ru: { label: 'Поиск по статьям и испытаниям', ph: 'Название, журнал или автор — заголовки на английском (например, cancer, stroke)', none: 'Ничего не найдено.' },
  id: { label: 'Cari makalah dan uji klinis', ph: 'Judul, jurnal, atau penulis — judul berbahasa Inggris (mis. cancer, stroke)', none: 'Tidak ada yang cocok dengan pencarian.' },
  tw: { label: '搜尋論文與臨床試驗', ph: '以標題、期刊或作者搜尋 — 標題為英文(例如:cancer, stroke)', none: '沒有符合搜尋條件的項目。' },
  fr: { label: 'Rechercher des articles et essais', ph: 'Titre, revue ou auteur — titres en anglais (p. ex. cancer, stroke)', none: 'Aucun résultat pour cette recherche.' },
  en: enQ, in: enQ, sg: enQ, ph: enQ, ae: enQ, ie: enQ,
};
const q = SEARCH[loc] ?? enQ;
const fmt = (d: string) => (d ? d.replace(/-01$/, '') === d ? d : d : '');
---

<div class="rs">
  <p class="rs-lead">{t.lead}</p>
  {data && <p class="rs-window">{t.window(data.window.from, data.window.to)}</p>}

  <form class="rs-search" role="search" onsubmit="return false">
    <label for="rs-q">{q.label}</label>
    <input type="search" id="rs-q" placeholder={q.ph} autocomplete="off" />
    <p class="rs-found" id="rs-found" aria-live="polite" hidden></p>
  </form>

  <div class="rs-note" role="note">
    <strong>{t.noteTitle}</strong>
    <ul>
      {t.note.map((n) => <li>{n}</li>)}
      <li>{t.titlesNote}</li>
    </ul>
  </div>

  {
    keys.map((k) => {
      const items: any[] = data?.sections?.[k] ?? [];
      const total = k === 'trials' ? totals.trials : totals[k];
      return (
        <section class="rs-sec" aria-labelledby={`rs-${k}`}>
          <h2 id={`rs-${k}`}>{t.sections[k].title}</h2>
          <p class="rs-desc">{t.sections[k].desc}</p>
          {items.length > 0 ? (
            <>
              {total ? <p class="rs-count">{t.count(items.length, total)}</p> : null}
              <ol class="rs-list">
                {items.map((it) => (
                  <li>
                    <a href={it.url} target="_blank" rel="noopener">
                      {it.title}
                    </a>
                    {it.kind === 'trial' ? (
                      <p class="rs-meta">
                        <span>{it.id}</span>
                        {it.phase && <span>{t.phase}: {it.phase}</span>}
                        {it.date && <span>{t.started}: {fmt(it.date)}</span>}
                        {it.source && <span>{t.sponsor}: {it.source}</span>}
                        {it.conditions && <span>{t.conditions}: {it.conditions}</span>}
                        {it.intervention && <span>{t.intervention}: {it.intervention}</span>}
                      </p>
                    ) : (
                      <p class="rs-meta">
                        <span>{it.source}</span>
                        <span>{it.date}</span>
                        {it.authors && <span>{it.authors}</span>}
                        <span>{it.id}</span>
                      </p>
                    )}
                  </li>
                ))}
              </ol>
            </>
          ) : (
            <p class="rs-empty">{t.empty}</p>
          )}
        </section>
      );
    })
  }

  <p class="rs-src">
    {t.source}: <a href="https://pubmed.ncbi.nlm.nih.gov/" target="_blank" rel="noopener">PubMed</a> · <a href="https://clinicaltrials.gov/" target="_blank" rel="noopener">ClinicalTrials.gov</a>
  </p>
</div>

<p class="rs-nomatch" id="rs-nomatch" hidden>{q.none}</p>

<script is:inline>
  (function () {
    var input = document.getElementById('rs-q');
    if (!input) return;
    var found = document.getElementById('rs-found');
    var nomatch = document.getElementById('rs-nomatch');
    var secs = Array.prototype.slice.call(document.querySelectorAll('.rs-sec'));
    var lis = Array.prototype.slice.call(document.querySelectorAll('.rs-list li'));
    var texts = lis.map(function (li) { return li.textContent.replace(/\s+/g, ' ').toLowerCase(); });
    function run() {
      var q = input.value.replace(/\s+/g, ' ').trim().toLowerCase();
      var n = 0;
      lis.forEach(function (li, i) {
        var ok = !q || texts[i].indexOf(q) >= 0;
        li.hidden = !ok;
        if (ok) n++;
      });
      secs.forEach(function (sec) {
        var list = sec.querySelector('.rs-list');
        var has = !q || !list || Array.prototype.some.call(list.children, function (li) { return !li.hidden; });
        sec.hidden = !has;
        var cnt = sec.querySelector('.rs-count');
        if (cnt) cnt.hidden = !!q;
      });
      nomatch.hidden = !(q && n === 0);
      found.hidden = !q || n === 0;
      if (q && n > 0) found.textContent = n + ' / ' + lis.length;
      try {
        var p = new URLSearchParams(location.search);
        if (q) p.set('q', input.value.trim()); else p.delete('q');
        history.replaceState(null, '', location.pathname + (p.toString() ? '?' + p.toString() : ''));
      } catch (e) {}
    }
    input.addEventListener('input', run);
    try {
      var p0 = new URLSearchParams(location.search).get('q');
      if (p0) { input.value = p0; run(); }
    } catch (e) {}
  })();
</script>

<style>
  .rs-search { margin: 0 0 1.25rem; display: grid; gap: 0.3rem; max-width: 34rem; }
  .rs-search label { font-size: 0.85rem; opacity: 0.75; }
  .rs-search input { padding: 0.6rem 0.75rem; font: inherit; color: inherit; background: transparent; border: 1px solid rgba(128, 128, 128, 0.6); border-radius: 8px; }
  .rs-found { margin: 0; font-size: 0.85rem; opacity: 0.75; }
  .rs-nomatch { opacity: 0.75; margin: 1rem 0; }
  .rs { max-width: 62rem; }
  .rs-lead { font-size: 1.05rem; line-height: 1.7; margin: 0 0 0.5rem; }
  .rs-window { opacity: 0.75; font-size: 0.9rem; margin: 0 0 1rem; }
  .rs-note { border: 1px solid rgba(128, 128, 128, 0.4); border-radius: 8px; padding: 0.8rem 1rem; margin: 0 0 1.5rem; font-size: 0.92rem; line-height: 1.6; }
  .rs-note ul { margin: 0.4rem 0 0; padding-left: 1.2rem; }
  .rs-sec { margin: 2rem 0; }
  .rs-sec h2 { margin: 0 0 0.25rem; }
  .rs-desc { opacity: 0.75; margin: 0 0 0.6rem; font-size: 0.93rem; }
  .rs-count { font-size: 0.85rem; opacity: 0.7; margin: 0 0 0.5rem; }
  .rs-list { margin: 0; padding-left: 1.3rem; }
  .rs-list li { padding: 0.55rem 0; border-bottom: 1px dotted rgba(128, 128, 128, 0.4); }
  .rs-list a { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .rs-meta { margin: 0.2rem 0 0; font-size: 0.85rem; opacity: 0.8; display: flex; flex-wrap: wrap; gap: 0.15rem 0.9rem; }
  .rs-empty { opacity: 0.7; }
  .rs-src { margin-top: 2rem; font-size: 0.88rem; opacity: 0.8; }
</style>
