---
// 일본어판 전용 레이아웃 (2026-07-31 신설)
//
// 한국어판 BaseLayout과 완전히 분리했다. 같은 레이아웃에 조건문을 넣으면
// 한국어판이 일본어판 변경에 휘말릴 위험이 있는데, 한국어판은 이미 검색
// 자산이 쌓여 있어 건드리면 안 되기 때문이다.
//
// 일본형 구성(작업지시서 §3): 2컬럼 + パンくずリスト + 상시 사이드바.
// 일본 사용자는 여백 많고 정보 적은 화면을 "미완성·수상함"으로 읽는다.
import '../styles/global.css';
import '../styles/ja-tokens.css';
import ja from '../i18n/ja.json';
import navConfig from '../data/ja/content/nav.json';
import { lastModifiedForPath } from '../utils/git-lastmod.mjs';
import {
  withBase,
  BASE,
  stripBase,
  CONTACT_EMAIL,
  YOUTUBE_CHANNEL_URL,
  GOATCOUNTER_CODE,
} from '../utils/site';

interface Props {
  title: string;
  description: string;
  /** 브레드크럼 마지막 항목 이름. 홈이면 넘기지 않는다. */
  crumb?: string;
  /** 이 페이지의 한국어판 경로(hreflang·언어 전환용). 없으면 한국어 홈. */
  koPath?: string;
  /**
   * 이 페이지의 러시아어판 경로(2026-08-12 추가). 넘기면 hreflang에 ru도
   * 함께 걸린다 — 러시아어판이 아직 없는 ja 페이지는 넘기지 않으면 된다.
   */
  ruPath?: string;
  /** 이 페이지의 인도네시아어판 경로(2026-09-05 추가). 없으면 안 넘기면 된다. */
  idPath?: string;
  /** 갱신일 표기 */
  updated?: Date;
  /** 페이지 고유 JSON-LD 노드 */
  schema?: Record<string, unknown>[];
}

const { title, description, crumb, koPath = '/', ruPath, idPath, updated, schema = [] } = Astro.props;

const SITE_JA = '病院AI研究所';
const pageTitle = crumb ? `${title}｜${SITE_JA}` : `${title}｜${SITE_JA}`;

const siteRoot = Astro.site
  ? Astro.site.href.replace(/\/$/, '')
  : 'https://hospital-ai-lab.com';
const currentPath = stripBase(Astro.url.pathname);
const canonicalPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const canonical = `${siteRoot}${withBase(canonicalPath)}`;

// 更新日は日本のサイトでは必須の信頼シグナルであり、検索側にも鮮度を伝える。
//
// ⚠️ 2026-08-12 修正: 以前はページ側が updated を渡さないとビルド時刻を使っていた。
//    このサイトはニュース自動収集で1日に何十回も再ビルドされるため、何か月も
//    変わっていないページまで毎回「本日更新」と表示していた（画面に出る日付が
//    事実と異なる＝サイトの事実検証原則に反する）。ページ側の指定が無いときは
//    そのページのソースファイルの最終コミット日時を使う。git が使えない
//    ビルド環境ではビルド日に戻す。
const updatedAt =
  updated ?? lastModifiedForPath(Astro.url.pathname, BASE) ?? new Date();

// hreflang — 같은 내용의 한국어판이 있는 페이지끼리 짝지어 준다.
// x-default는 한국어판(원본)으로 둔다.
const koHref = `${siteRoot}${withBase(koPath)}`;
const ruHref = ruPath ? `${siteRoot}${withBase(ruPath)}` : undefined;
const idHref = idPath ? `${siteRoot}${withBase(idPath)}` : undefined;

// メニューは韓国語版の並び（ホーム→運営者→補助金→ブログ→動画→ノウハウ→入門）に
// 合わせている（ブログは2026-08-20新設）。韓国語版にあってここに無い区分
// （ニュース・イベント・講義ノート）は、日本語の中身がまだ無いため出していない。
// 中身のないページを並べても利用者の信頼を損ない、検索側にも薄いページとして
// 扱われる。
//
// ⚠️ メニューの表示・非表示は src/data/ja/content/nav.json で管理します
//    (管理画面 /admin-ja/ の「公開状態」から切り替えられます)。
//    ここを直接書き換えないでください。
//    label は ja.nav の키(key)から引きます。
//    ホーム(/ja/)は常に表示します — 消すと日本語版の入口が無くなるため。
const navLabels = ja.nav as Record<string, string>;
const nav = navConfig
  .filter((item) => item.href === '/ja/' || item.enabled)
  .map((item) => ({
    href: item.href,
    label: navLabels[item.key] ?? item.key,
  }));

const isActive = (href: string) =>
  href === '/ja/' ? canonicalPath === '/ja/' : canonicalPath.startsWith(href);

// ── 구조화 데이터 (일본어) ─────────────────────────────
// 한국어판 SchemaOrg와 같은 @id를 쓴다. 같은 조직·같은 사람이므로
// 언어판이 달라도 엔티티는 하나여야 검색엔진이 혼동하지 않는다.
// name には氏名だけを入れ、読み仮名は alternateName に分ける。
// 「曺永熩（チョ・ヨンホ）」をそのまま name にすると、括弧まで氏名の一部として
// 機械に読まれてしまう。韓国語版の Person(#person) と同一人物なので、
// ハングル表記も alternateName に併記して同一性を示す。
const person = {
  '@type': 'Person',
  '@id': `${siteRoot}/#person`,
  name: ja.profile.nameShort,
  alternateName: ['チョ・ヨンホ', '조영호', 'Youngho Cho'],
  jobTitle: ja.profile.role,
  url: `${siteRoot}${withBase('/ja/about/')}`,
  sameAs: [YOUTUBE_CHANNEL_URL],
};
const organization = {
  '@type': 'Organization',
  '@id': `${siteRoot}/#organization`,
  name: SITE_JA,
  url: siteRoot,
  founder: { '@id': `${siteRoot}/#person` },
  email: CONTACT_EMAIL,
};
const website = {
  '@type': 'WebSite',
  '@id': `${siteRoot}/#website-ja`,
  url: `${siteRoot}${withBase('/ja/')}`,
  name: SITE_JA,
  inLanguage: 'ja-JP',
  publisher: { '@id': `${siteRoot}/#organization` },
};
const crumbs = [
  { name: ja.ui.breadcrumbHome, url: `${siteRoot}${withBase('/ja/')}` },
  ...(crumb ? [{ name: crumb, url: canonical }] : []),
];
const breadcrumbLd =
  crumbs.length > 1
    ? [
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: crumbs.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: c.name,
            item: c.url,
          })),
        },
      ]
    : [];

// WebPage — 各ページの更新日を機械可読にする。画面の「更新日」表示と同じ値を使う
// (見えていない事実をマークアップしないため)。
const webPage = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@id': `${siteRoot}/#website-ja` },
  dateModified: updatedAt.toISOString(),
  ...(crumb ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
  about: { '@id': `${siteRoot}/#organization` },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, organization, website, webPage, ...breadcrumbLd, ...schema],
};

// ⚠️ セキュリティ上必須 — 絶対に削除しないこと。
// <script type="application/ld+json"> の中身はブラウザが「HTML の中の
// スクリプト要素」として先に読むため、本文に "</script>" という文字が
// 入っていると、そこでスクリプト要素が閉じてしまい、続く文字列が
// 生きた HTML として実行される(蓄積型 XSS)。
// 管理画面 /admin-ja/ から入る用語の説明・FAQ の回答・動画タイトル、
// および jGrants から自動取得する公募名も、すべてこの JSON-LD に入る。
// JSON 文字列の中では "<" と "<" は同じ意味なので、"<" をすべて
// エスケープしても構造化データの意味は一切変わらない。
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');

const fmtJa = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja" data-locale="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* hreflang — 한국어판이 원본이므로 x-default는 한국어로 둔다 */}
    <link rel="alternate" hreflang="ko" href={koHref} />
    <link rel="alternate" hreflang="ja" href={canonical} />
    {ruHref && <link rel="alternate" hreflang="ru" href={ruHref} />}
    {idHref && <link rel="alternate" hreflang="id" href={idHref} />}
    <link rel="alternate" hreflang="x-default" href={koHref} />

    <script type="application/ld+json" is:inline set:html={jsonLdText} />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_JA} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:locale:alternate" content="ko_KR" />
    <meta
      property="og:image"
      content={`${siteRoot}${withBase('/og-default.png')}`}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="病院AI研究所" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={`${siteRoot}${withBase('/og-default.png')}`}
    />

    {
      GOATCOUNTER_CODE && (
        <script
          is:inline
          async
          data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#ja-main">本文へスキップ</a>

    <header class="ja-header">
      <div class="ja-header-inner">
        <a class="ja-brand" href={withBase('/ja/')}>
          病院AI研究所
          <span class="ja-brand-sub">HOSPITAL AI LAB — 医療AIの実務情報</span>
        </a>
        <a class="ja-lang" href={withBase(koPath)} hreflang="ko">{ja.ui.langKo}</a>
      </div>
    </header>

    <nav class="ja-nav" aria-label="メインメニュー">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* パンくずリスト — 일본 사이트에서는 없으면 아마추어로 읽힌다 */}
    <nav class="ja-breadcrumb" aria-label="パンくずリスト">
      <ol>
        <li><a href={withBase('/ja/')}>{ja.ui.breadcrumbHome}</a></li>
        {crumb && <li aria-current="page">{crumb}</li>}
      </ol>
    </nav>

    <div class="ja-shell">
      <main id="ja-main">
        <p class="ja-updated">
          {ja.ui.updated}：<time datetime={updatedAt.toISOString()}>{fmtJa(updatedAt)}</time>
        </p>
        <slot />
      </main>

      <aside class="ja-side">
        {/* 운영자 신뢰 블록 — 일본에서는 장식이 아니라 필수 신뢰 시그널이다 */}
        <section>
          <h2>{ja.ui.sidebarProfileTitle}</h2>
          <div class="ja-side-body">
            <dl>
              <dt>氏名</dt>
              <dd>{ja.profile.nameShort}</dd>
              <dt>役職</dt>
              <dd>{ja.profile.role}</dd>
              <dt>経歴</dt>
              <dd>{ja.profile.careerShort}</dd>
              <dt>学位</dt>
              <dd>{ja.profile.educationShort}</dd>
            </dl>
            <p style="margin-top:10px">
              <a class="ja-ext" href={YOUTUBE_CHANNEL_URL} target="_blank" rel="noopener">
                {ja.profile.youtube}
                <span class="sr-only">（{ja.ui.external}）</span>
              </a>
            </p>
            <p style="margin-top:6px">
              <a href={withBase('/ja/about/')}>{ja.nav.about}</a>
            </p>
          </div>
        </section>

        <section>
          <h2>{ja.nav.subsidies}</h2>
          <div class="ja-side-body">
            <p>{ja.home.subsidiesDesc}</p>
            <p style="margin-top:8px">
              <a href={withBase('/ja/subsidies/')}>{ja.ui.viewAll}</a>
            </p>
          </div>
        </section>

        <section>
          <h2>{ja.home.koNoticeTitle}</h2>
          <div class="ja-side-body">
            <p>{ja.home.koNoticeBody}</p>
            <p style="margin-top:8px">
              <a href={withBase('/')} hreflang="ko">{ja.ui.langKo}</a>
            </p>
          </div>
        </section>
      </aside>
    </div>

    <footer class="ja-footer">
      <div class="ja-footer-inner">
        <ul>
          <li><a href={withBase('/ja/about/')}>{ja.footer.about}</a></li>
          <li><a href={withBase('/privacy/')}>{ja.footer.privacy}</a></li>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{ja.footer.contact}</a></li>
          <li><a href={withBase('/sitemap-index.xml')}>{ja.footer.sitemap}</a></li>
        </ul>
        <p>{ja.ui.disclaimer}</p>
        <p style="margin-top:10px">© {year} 病院AI研究所（HOSPITAL AI LAB）</p>
      </div>
    </footer>

    <style>
      .ja-lang {
        font-size: 12.5px;
        color: var(--ja-text-sub);
        text-decoration: none;
        border: 1px solid var(--ja-border);
        border-radius: 3px;
        padding: 4px 10px;
      }
      .ja-lang:hover {
        color: var(--ja-primary);
        border-color: var(--ja-primary);
      }
    </style>
  </body>
</html>
