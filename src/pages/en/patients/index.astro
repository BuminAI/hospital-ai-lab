---
// For patients (patients and families) — overview page (2026-11-06)
// ⚠️ No diagnosis or treatment advice. General information with links to official sources.
import '../../../styles/en-guide.css';
import EnLayout from '../../../layouts/EnLayout.astro';
import { withBase } from '../../../utils/site';

const title = 'For patients: AI, your records and your rights';
const description =
  'Before you ask an AI about your health, what the rules give you when a hospital uses AI, and your rights to your records. Plain language, with official sources.';

const cards = [
  { href: '/en/patients/ai-health-consult/', t: 'Before you ask an AI about your health: six things', d: 'An AI answer is not a diagnosis, what you type may not be protected by HIPAA, and when not to wait.' },
  { href: '/en/patients/ai-in-hospital/', t: 'When your hospital uses AI: what the rules give you', d: 'Notice of privacy practices, access, correction, breach notice and nondiscrimination.' },
  { href: '/en/patients/medical-records/', t: 'Your rights to your medical records', d: 'Who can see them, how fast a hospital must respond, and how to ask for a correction.' },
];
---

<EnLayout title={title} description={description} crumb="For patients" standalone>
  <h1>For patients</h1>
  <p class="tg-lead">
    People have many questions about hospitals and AI that they would like to ask but are not sure whom to ask. The answers here come from official sources and use as few technical terms as possible.
  </p>
  <div class="tg-box tg-warn">
    This is general information, not a diagnosis or a treatment recommendation. For a health concern, contact the clinician or hospital that treats you. In an emergency, call 911.
  </div>
  <div class="tg-cards">
    {
      cards.map((c) => (
        <a class="tg-card" href={withBase(c.href)}>
          <b>{c.t}</b>
          <span>{c.d}</span>
        </a>
      ))
    }
  </div>
  <p class="tg-meta" style="margin-top:22px">
    For hospital staff, see the <a href={withBase('/en/practice/')}>Practice guides</a>.
  </p>
</EnLayout>
