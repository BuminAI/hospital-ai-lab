---
// Home page of the English edition (2026-11-06; same structure as the Indonesian, Japanese, Russian and Taiwanese editions)
//
// Structure (top to bottom):
//   1) Hero: one-sentence promise + two actions + "Latest updates" on the right (proof that the site is alive)
//   2) Row of trust figures: only real data, nothing invented
//   3) "When you face this": six entry points by task
//   4) Updates, new federal documents from the Federal Register, featured articles, series
//   5) Principles, library, FAQ, about the site
// ⚠️ The author's years of experience are not written in the home text or the meta description (the sidebar profile stays as is).
// ⚠️ Figures are computed from the data, or are facts already on the site.
import navConfig from '../../data/en/content/nav.json';
import '../../styles/en-home.css';
import { getCollection } from 'astro:content';
import EnLayout from '../../layouts/EnLayout.astro';
import en from '../../i18n/en.json';
import notices from '../../data/en/gov-notices.json';
import newsData from '../../data/en/news.json';
import linkHealth from '../../data/en/link-health.json';
import HomeSeries from '../../components/HomeSeries.astro';
import { withBase } from '../../utils/site';
import ViewCounts from '../../components/ViewCounts.astro';
import { getResolvedSeries } from '../../utils/series';
import { getEnUpdates, KIND_LABEL } from '../../utils/en-updates';

const updated = notices.updatedAt ? new Date(notices.updatedAt) : undefined;
const fmtMD = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', day: 'numeric', month: 'numeric' });
const fmtYMD = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', year: 'numeric', month: 'long', day: 'numeric' });
const short = (t: string, n = 150) => (t.length > n ? t.slice(0, n).replace(/\s+\S*$/, '') + '…' : t);

const posts = (await getCollection('blogEn', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.slice(0, 4);

const feed = await getEnUpdates(30);
const heroFeed = feed.slice(0, 4);
const newsFeed = feed.slice(0, 8);
const weekly = feed.filter((u) => Date.now() - new Date(u.date).getTime() <= 7 * 86400000);
const weeklyCount = (k: 'news' | 'notice' | 'event' | 'video' | 'blog') => weekly.filter((u) => u.kind === k).length;

// New federal documents from the Federal Register (newest first)
const topNotices = notices.items.slice(0, 5);

// Trust figures (all from real data)
const stats = [
  { n: posts.length, unit: '', label: 'Published articles', href: '/en/blog/' },
  { n: linkHealth.total, unit: '', label: 'Source links checked daily', href: '/en/updates/' },
  { n: notices.items.length, unit: '', label: 'New federal documents in the feed', href: '/en/calendar/' },
  { n: newsData.items.length, unit: '', label: 'AI news headlines (checked several times a day)', href: '/en/news/' },
];
const checkedDay = linkHealth.checkedAt ? fmtYMD.format(new Date(linkHealth.checkedAt)) : '';

const tasks = [
  { q: 'Which dates should I know?', t: 'Roadmap: HIPAA, FDA and ONC', d: 'Breach notification, the Security Rule proposal, Section 1557, FDA guidance and the HTI-5 rule on one timeline.', href: '/en/dx-roadmap/' },
  { q: 'What did the government publish lately?', t: 'Calendar: new federal documents', d: 'New HHS, FDA and CMS documents from the Federal Register, automatically.', href: '/en/calendar/' },
  { q: 'A vendor offers an EHR add-on or AI?', t: 'Checklist: records access and AI vendors', d: 'Access timing, information blocking, FDA status and HTI-5, with sections.', href: '/en/documents-checklist/' },
  { q: 'Is patient data protected?', t: 'Patient data protection checklist', d: '21 items from 45 CFR, by section: uses, vendors, security and breaches.', href: '/en/data-checklist/' },
  { q: 'Before adopting AI', t: 'Templates: policy and 20 vendor questions', d: 'Drafts you can copy and adapt when a proposal arrives.', href: '/en/templates/' },
  { q: 'For patients and families', t: 'For patients', d: 'Before asking an AI about your health, your rights when a hospital uses AI, and your rights to your records.', href: '/en/patients/' },
];

const promises = [
  { t: 'Based on primary sources', d: 'We write only what comes from official texts that were opened and read (eCFR, Federal Register, FDA, ASTP/ONC), with links.' },
  { t: 'The date checked is visible', d: 'At the bottom of every practice and patient page: “Sources and date checked.” Rules change, so the date is required.' },
  { t: 'Source links are checked daily', d: `The English edition has ${linkHealth.total} external links; they are checked automatically every day, and ${linkHealth.dead.length} are not found (404/410)${checkedDay ? ` (${checkedDay})` : ''}.` },
  { t: 'No recommendations of particular products or hospitals', d: 'We look at whether something can be used in your hospital and on what basis, not at brands or a push to adopt quickly.' },
];

const library = [
  { t: en.nav.guide, d: en.home.guideDesc, href: '/en/guide/' },
  { t: en.nav.glossary, d: en.home.glossaryDesc, href: '/en/glossary/' },
  { t: en.nav.faq, d: en.home.faqDesc, href: '/en/faq/' },
  { t: en.nav.checklist, d: en.home.checklistDesc, href: '/en/checklist/' },
  { t: en.nav.tips, d: 'Practical tips for working with AI services in a hospital.', href: '/en/tips/' },
  { t: en.nav.videos, d: 'A selection of videos about AI in health care.', href: '/en/videos/' },
];

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/en/')}`;
const homeFaqLd = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#home-faq`,
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': `${siteRoot}/#website-en` },
  mainEntity: en.home.homeFaq.map((f, i) => ({
    '@type': 'Question',
    '@id': `${pageUrl}#home-q${i + 1}`,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const homeSeries = (await getResolvedSeries('en'))
  .slice()
  .sort((a, b) => b.posts.length - a.posts.length)
  .slice(0, 3);
// 메뉴(nav.json)의 모든 항목을 같은 순서로 홈에도 보여 준다. 메뉴에만/홈에만 있는 페이지가 없게 하려는 구역(2026-11-14).
const navLabelsHome = en.nav as Record<string, string>;
const allMenu = navConfig
  .filter((n) => n.enabled && n.href !== '/en/')
  .map((n) => ({ href: n.href, label: navLabelsHome[n.key] ?? n.key }));

---

<EnLayout
  title={en.home.metaTitle}
  description={en.home.metaDescription}
  koPath="/"
  twPath="/tw/"
  inPath="/in/"
  jaPath="/ja/"
  idPath="/id/"
  ruPath="/ru/"
  updated={updated}
  schema={[homeFaqLd]}
>
  <Fragment slot="hero">
    <section class="th-hero">
      <div class="th-hero-inner">
        <div class="th-hero-copy">
          <p class="th-eyebrow">Patient data, health records and AI — for administration and nursing</p>
          <h1>The decision to adopt AI in a hospital —<br />read from U.S. rules and primary sources.</h1>
          <p class="th-lead">
            Is the product a medical device, on what basis may patient data be used, where does it go, and how fast must a breach be reported. Collected from the eCFR, the Federal Register and FDA pages; each item gives its section and the date checked.
          </p>
          <p class="th-cta">
            <a class="th-btn th-btn-main" href={withBase('/en/dx-roadmap/')}>Roadmap</a>
            <a class="th-btn th-btn-sub" href={withBase('/en/calendar/')}>New federal documents</a>
          </p>
        </div>
        <aside class="th-hero-card" aria-labelledby="th-live-h">
          <h2 id="th-live-h"><span class="th-dot" aria-hidden="true"></span>Latest updates</h2>
          <ul>
            {heroFeed.map((it) => (
              <li>
                <time datetime={it.date}>{fmtMD.format(new Date(it.date))}</time>
                <span class="th-chip">{KIND_LABEL[it.kind]}</span>
                <a href={it.href} {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
                  {it.title}
                  {it.external && <span class="sr-only">({en.ui.external})</span>}
                </a>
              </li>
            ))}
          </ul>
          <a class="th-hero-more" href={withBase('/en/updates/')}>All updates →</a>
        </aside>
      </div>
    </section>

    <section class="th-stats" aria-label="Site status">
      <ul>
        {
          stats.map((s) => (
            <li>
              <a href={withBase(s.href)}>
                <span class="th-num">{s.n.toLocaleString('id-ID')}<small>{s.unit}</small></span>
                <span class="th-lab">{s.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Fragment>

  <section class="th-sec" aria-labelledby="th-tasks-h">
    <h2 class="th-h" id="th-tasks-h"><span>When you face this</span><small>BY PURPOSE</small></h2>
    <div class="th-tasks">
      {
        tasks.map((x) => (
          <a class="th-task" href={withBase(x.href)}>
            <span class="th-task-q">{x.q}</span>
            <span class="th-task-t">{x.t}</span>
            <span class="th-task-d">{x.d}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="th-sec" aria-labelledby="th-feed-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-feed-h"><span>Updates</span><small>WHAT'S NEW</small></h2>
      <a class="th-more" href={withBase('/en/updates/')}>See all →</a>
    </div>
    <p class="th-note">
      Last 7 days: {KIND_LABEL.news} {weeklyCount('news')} · {KIND_LABEL.notice} {weeklyCount('notice')} · {KIND_LABEL.event} {weeklyCount('event')} · {KIND_LABEL.video} {weeklyCount('video')}
    </p>
    <ul class="th-feed">
      {
        newsFeed.map((it) => (
          <li>
            <time datetime={it.date}>{fmtYMD.format(new Date(it.date))}</time>
            <span class="th-chip">{KIND_LABEL[it.kind]}</span>
            <a href={it.href} {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
              {it.title}
              {it.external && <span class="sr-only">({en.ui.external})</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-gov-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-gov-h"><span>New federal documents from the Federal Register</span><small>NEW REGULATIONS</small></h2>
      <a class="th-more" href={withBase('/en/calendar/')}>See all →</a>
    </div>
    <p class="th-note">The date is the publication date of the document, not a deadline. Read the official text for its content and effect; the list reflects documents of the selected agencies, not only those that concern hospitals.</p>
    <ul class="th-feed th-feed-sub">
      {
        topNotices.map((n) => (
          <li>
            <time datetime={n.pubDate}>{fmtYMD.format(new Date(n.pubDate))}</time>
            <span class="th-chip th-chip-gov">{n.kind}</span>
            <a href={n.link} target="_blank" rel="noopener">
              {short(n.title)}
              <span class="sr-only">({en.ui.external})</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-posts-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-posts-h"><span>Featured articles</span><small>ARTICLES</small></h2>
      <a class="th-more" href={withBase('/en/blog/')}>All articles →</a>
    </div>
    <div class="th-posts">
      {
        featured.map((p) => (
          <article class="th-post">
            <p class="th-post-meta">
              <span class="th-chip">{p.data.category}</span>
              <time datetime={p.data.pubDate.toISOString()}>{fmtYMD.format(p.data.pubDate)}</time>
              <span class="views" data-view-path={withBase(`/en/blog/${p.id}/`)} hidden></span>
            </p>
            <h3><a href={withBase(`/en/blog/${p.id}/`)}>{p.data.title}</a></h3>
            <p class="th-post-d">{p.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <HomeSeries loc="en" list={homeSeries} />

  <section class="th-sec th-promise" aria-labelledby="th-promise-h">
    <h2 class="th-h" id="th-promise-h"><span>Our principles</span><small>OUR PRINCIPLES</small></h2>
    <ul>
      {
        promises.map((x, i) => (
          <li>
            <span class="th-no">{i + 1}</span>
            <div>
              <strong>{x.t}</strong>
              <p>{x.d}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="th-note"><a href={withBase('/en/about/#principles')}>How material is written and checked →</a></p>
  </section>

  <section class="th-sec" aria-labelledby="th-menu-h">
    <h2 class="th-h" id="th-menu-h"><span>All pages at a glance</span><small>ALL PAGES</small></h2>
    <ul class="th-lib">
      {
        allMenu.map((x) => (
          <li>
            <a href={withBase(x.href)}>
              <strong>{x.label}</strong>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-lib-h">
    <h2 class="th-h" id="th-lib-h"><span>Learning materials and reference</span><small>LIBRARY</small></h2>
    <ul class="th-lib">
      {
        library.map((x) => (
          <li>
            <a href={withBase(x.href)}>
              <strong>{x.t}</strong>
              <span>{x.d}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-faq-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-faq-h"><span>{en.home.homeFaqTitle}</span><small>ABOUT THIS SITE</small></h2>
      <a class="th-more" href={withBase('/en/faq/')}>{en.home.homeFaqMore}</a>
    </div>
    <dl class="th-faq">
      {
        en.home.homeFaq.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <section class="th-sec" aria-labelledby="th-intro-h">
    <h2 class="th-h" id="th-intro-h"><span>{en.home.introTitle}</span><small>ABOUT</small></h2>
    <p>{en.home.introBody}</p>
    <div class="en-note">
      <p><strong>{en.home.koNoticeTitle}</strong></p>
      <p style="margin-top:6px">{en.home.koNoticeBody}</p>
      <p style="margin-top:8px"><a href={withBase('/')} hreflang="ko">{en.ui.langKo} →</a></p>
    </div>
  </section>
  <ViewCounts loc="en" />
</EnLayout>
