---
import EnLayout from '../../layouts/EnLayout.astro';
import { videosEn, videosMetaEn, videosLocalEn } from '../../data/en/pages';
import en from '../../i18n/en.json';
import { YOUTUBE_CHANNEL_URL } from '../../utils/site';

const p = videosMetaEn;

// ⚠️ VideoObject는 쓰지 않는다. uploadDate·duration을 정확히 모르기 때문이다
//    (recommended-videos.json의 addedAt은 사이트 추가일이지 유튜브 공개일이 아님).
//    화면에 보이는 목록 순서를 ItemList로만 전달한다.
const schema = [
  {
    '@type': 'ItemList',
    name: p.pageTitle,
    numberOfItems: videosEn.length,
    itemListElement: videosEn.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.titleEn,
      url: `https://www.youtube.com/watch?v=${v.videoId}`,
    })),
  },
  {
    '@type': 'ItemList',
    name: 'Videos from other channels',
    numberOfItems: videosLocalEn.length,
    itemListElement: videosLocalEn.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.title,
      url: `https://www.youtube.com/watch?v=${v.videoId}`,
    })),
  },
];
---

<EnLayout
  title={p.title}
  description={p.description}
  crumb={en.nav.videos}
  koPath="/youtube/"
  twPath="/tw/videos/"
  inPath="/in/videos/"
  jaPath="/ja/videos/"
  idPath="/id/videos/"
  ruPath="/ru/videos/"
  schema={schema}
>
  <h1>{p.pageTitle}</h1>
  <p class="en-lead">{p.lead}</p>

  {/* Language/context notice before playback — telling people after they watch hurts trust */}
  <p class="en-notice">{p.notice}</p>

  {videosEn.length > 0 && <p class="en-count">Videos: {videosEn.length}</p>}

  {videosEn.length > 0 && <h2 class="en-vsec">Videos from our lab</h2>}
  <ul class="en-videos">
    {
      videosEn.map((v) => (
        <li>
          <a href={`https://www.youtube.com/watch?v=${v.videoId}`} target="_blank" rel="noopener">
            <img
              src={`https://img.youtube.com/vi/${v.videoId}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              width="320"
              height="180"
            />
            <div class="en-video-text">
              <span class="en-video-title">{v.titleEn}</span>
              {v.note && <span class="en-video-note">{v.note}</span>}
              <span class="en-video-ext">
                Watch on YouTube<span class="sr-only"> ({en.ui.external})</span>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>


  <h2 class="en-vsec">Videos from other channels</h2>
  <p class="en-lead">A selection of English-language videos about AI in hospitals and medicine, and about doing real work with AI tools such as ChatGPT, Gemini and Claude, from news outlets, public bodies and independent creators. We did not make these videos. Rules and claims in them may be those of another country or an earlier date, and tutorials are not medical or legal advice.</p>
  {/* 제휴가 아니라는 안내를 반드시 함께 낸다 — 지우지 말 것.
      영상 내용은 각 제작자의 것이고 이 사이트가 검증한 주장이 아니다. */}
  <p class="en-notice">All videos listed belong to their creators. Inclusion means only that we selected it; there is no partnership or sponsorship. Claims in the videos are the creators’ own and have not been verified by us.</p>

  <ul class="en-videos">
    {
      videosLocalEn.map((v) => (
        <li>
          <a href={`https://www.youtube.com/watch?v=${v.videoId}`} target="_blank" rel="noopener">
            <img
              src={`https://img.youtube.com/vi/${v.videoId}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              width="320"
              height="180"
            />
            <div class="en-video-text">
              <span class="en-video-title">{v.title}</span>
              <span class="en-video-ch">{v.channel}</span>
              {v.note && <span class="en-video-note">{v.note}</span>}
              <span class="en-video-ext">
                Watch on YouTube<span class="sr-only"> ({en.ui.external})</span>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="en-channel">
    <a href={YOUTUBE_CHANNEL_URL} target="_blank" rel="noopener">
      {en.profile.youtube}<span class="sr-only"> ({en.ui.external})</span>
    </a>
  </p>
</EnLayout>

<style>
  .en-lead {
    color: var(--en-text-sub);
  }
  .en-notice {
    border: 1px solid var(--en-border);
    border-left: 4px solid var(--en-primary);
    background: var(--en-surface);
    padding: 12px 14px;
    font-size: 13.5px;
    line-height: 1.85;
    margin-bottom: 18px;
  }
  .en-count {
    font-size: 13px;
    color: var(--en-text-sub);
    margin-bottom: 16px;
  }
  .en-videos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .en-videos a {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    border: 1px solid var(--en-border);
    background: var(--en-base);
    padding: 12px;
    text-decoration: none;
    color: var(--en-text);
  }
  .en-videos a:hover {
    background: var(--en-surface);
    border-color: var(--en-primary);
  }
  .en-videos img {
    width: 160px;
    height: 90px;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--en-surface);
  }
  .en-video-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }
  .en-video-title {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--en-primary);
  }
  .en-video-note {
    font-size: 13px;
    color: var(--en-text-sub);
    line-height: 1.8;
  }
  .en-video-ext {
    font-size: 12px;
    color: var(--en-text-sub);
  }
  .en-channel {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--en-border);
    font-size: 14px;
  }

  @media (max-width: 560px) {
    .en-videos a {
      flex-direction: column;
    }
    .en-videos img {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
  .en-vsec {
    font-size: 16px;
    margin: 30px 0 10px;
    padding-left: 10px;
    border-left: 4px solid var(--en-primary);
  }
  .en-vsec:first-of-type {
    margin-top: 18px;
  }
  .en-video-ch {
    font-size: 12.5px;
    color: var(--en-text-sub);
  }
</style>
