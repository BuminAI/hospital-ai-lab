---
// About the author — the key trust-signal page of the English edition (same pattern as ja/about.astro)
import EnLayout from '../../layouts/EnLayout.astro';
import en from '../../i18n/en.json';
import { withBase, CONTACT_EMAIL, YOUTUBE_CHANNEL_URL } from '../../utils/site';

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';

// ProfilePage — AI 답변 엔진이 '누가 쓰는 사이트인가'를 판정하는 근거.
// 화면에 보이는 사실만 마크업한다(구글은 비가시 콘텐츠 마크업을 금지).
const profilePage = {
  '@type': 'ProfilePage',
  '@id': `${siteRoot}${withBase('/en/about/')}#profile`,
  inLanguage: 'en-US',
  mainEntity: { '@id': `${siteRoot}/#person` },
};
---

<EnLayout
  title={en.about.pageTitle}
  description={en.about.metaDescription}
  crumb={en.nav.about}
  koPath="/about/"
  twPath="/tw/about/"
  jaPath="/ja/about/"
  idPath="/id/about/"
  ruPath="/ru/about/"
  schema={[profilePage]}
>
  <h1>{en.about.pageTitle}</h1>
  <p>{en.about.pageLead}</p>

  <table class="en-profile">
    <tbody>
<tr><th>Name</th><td>{en.profile.name}</td></tr>
<tr><th>Role</th><td>{en.profile.role}</td></tr>
<tr><th>Experience</th><td>{en.profile.career}</td></tr>
<tr><th>Education</th><td>{en.profile.education}</td></tr>
      <tr>
<th>Channel</th>
        <td>
          <a class="en-ext" href={YOUTUBE_CHANNEL_URL} target="_blank" rel="noopener">
            {en.profile.youtube}<span class="sr-only"> ({en.ui.external})</span>
          </a>
        </td>
      </tr>
    </tbody>
  </table>

  <h2>{en.about.whyTitle}</h2>
  <p>{en.about.why}</p>

  <h2>{en.about.stanceTitle}</h2>
  <p>{en.about.stance}</p>

  <h2>{en.about.methodTitle}</h2>
  <p>{en.about.method}</p>

{/* Principles (2026-10-21) — Organization.publishingPrinciples points to #principles. We write only what is actually practiced (the fact-checking rules in CLAUDE.md). */}
  <h2 id="principles">{en.about.principlesTitle}</h2>
  <p>{en.about.principlesLead}</p>
  <ul class="en-principles">
    {
      en.about.principles.map((item) => (
        <li>
          <strong>{item.title}</strong> {item.body}
        </li>
      ))
    }
  </ul>

  <h2>{en.about.researchTitle}</h2>
  <ul class="en-research">
    {
      en.about.researchAreas.map((area) => (
        <li>
          <h3>{area.title}</h3>
          <p>{area.body}</p>
        </li>
      ))
    }
  </ul>

  <h2>{en.about.contactTitle}</h2>
  <p>{en.about.contact}</p>
  <p style="margin-top:8px"><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
</EnLayout>

<style>
  .en-profile {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0 8px;
    font-size: 14.5px;
  }
  .en-profile th,
  .en-profile td {
    border: 1px solid var(--en-border);
    padding: 9px 12px;
    text-align: left;
    vertical-align: top;
    line-height: 1.8;
  }
  .en-profile th {
    background: var(--en-surface);
    width: 8em;
    white-space: nowrap;
    font-weight: 600;
  }
  .en-principles {
    margin: 12px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 10px;
    font-size: 14.5px;
    line-height: 1.8;
  }
  .en-research {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .en-research li {
    border-left: 3px solid var(--en-primary);
    padding-left: 14px;
  }
  .en-research h3 {
    font-size: 15.5px;
    margin: 0 0 4px;
  }
  .en-research p {
    margin: 0;
    font-size: 14px;
    color: var(--en-text-sub);
    line-height: 1.75;
  }
</style>
