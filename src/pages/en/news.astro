---
// AI news — automatically collected list from U.S. trade and national outlets (see scripts/wide-sources.mjs; same pattern as ko news.astro).
// hreflang을 걸지 않는다 — 자동 수집 목록은 언어판마다 완전히 다른 기사
// 목록이라, 번역 관계가 아닌 페이지에 alternate를 걸면 검색엔진에 잘못된
// 신호가 된다(ko news.astro도 jaPath가 없다 — 같은 원칙).
import EnLayout from '../../layouts/EnLayout.astro';
import en from '../../i18n/en.json';
import { withBase } from '../../utils/site';
import news from '../../data/en/news.json';

const fmt = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const items = news.items;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/en/news/')}`;
const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: en.nav.news,
  description:
    'Headlines about artificial intelligence in health care from Fierce Healthcare, Healthcare Dive, STAT, MedCity News, HIT Consultant, The New York Times, NPR and other outlets, collected automatically.',
  inLanguage: 'en-US',
  isPartOf: { '@id': `${siteUrl}/#website-en` },
  dateModified: news.updatedAt ?? new Date().toISOString(),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<EnLayout
  title="AI news for U.S. health care"
  description="Headlines about AI in U.S. health care from Fierce Healthcare, Healthcare Dive, STAT, MedCity News, HIT Consultant, The New York Times, NPR and other outlets, collected automatically several times a day."
  crumb={en.nav.news}
  koPath="/news/"
  standalone
  updated={new Date(news.updatedAt ?? Date.now())}
  schema={[collectionPage]}
>
  <h1>{en.nav.news}</h1>
  <p class="en-lead">
    Headlines that mention artificial intelligence are collected several times a day from Fierce Healthcare, Healthcare Dive, Becker’s Hospital Review, STAT, MedCity News, HIT Consultant, Radiology Business, Health Affairs, KFF Health News, NEJM AI, JAMA Network, Healthcare Business Today, TechCrunch, The Verge, Ars Technica, WIRED, MIT Technology Review, The New York Times, NPR, BBC News and The Guardian. Older items are not deleted.
  </p>

  {
    items.length > 0 ? (
      <ul class="en-news-list">
        {items.map((item) => (
          <li>
            <a href={item.link} target="_blank" rel="noopener">
              {item.title}
              <span class="sr-only"> ({en.ui.external})</span>
            </a>
            <span class="en-news-meta">
              {item.source} · <time datetime={item.pubDate}>{fmt.format(new Date(item.pubDate))}</time>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="en-empty">{en.ui.noItems}</p>
    )
  }

  <div class="en-note">
    <p>
      This list is built automatically from articles of the outlets named above that mention artificial intelligence. It is not an editorial selection: the site
      does not choose or recommend particular items. A headline leads to the original article on the
      publisher’s site. We copy only the headline, date and link.
    </p>
  </div>
</EnLayout>

<style>
  .en-lead {
    color: var(--en-text-sub);
  }
  .en-news-list {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--en-border);
  }
  .en-news-list li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid var(--en-border);
  }
  .en-news-list a {
    color: var(--en-text);
    font-weight: 600;
    line-height: 1.6;
  }
  .en-news-list a:hover {
    color: var(--en-primary);
  }
  .en-news-meta {
    font-size: 13px;
    color: var(--en-text-sub);
  }
  .en-empty {
    margin-top: 20px;
    color: var(--en-text-sub);
  }
</style>
