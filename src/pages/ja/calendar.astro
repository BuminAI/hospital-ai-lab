---
// 制度カレンダー (2026-10-31 新設)
// 既存の自動収集データ(補助金・ニュース)と、手書きで一次資料から確認した年度の節目(milestones.ts)を
// 一つの画面にまとめる。新しい収集元は増やしていない。
// ⚠️ 補助金の締切は jGrants の掲載データそのまま。実際の接受期間は公募元で確認する必要がある
//    (HANDOFF の「jGrants 掲載期間 ≠ 実際の申請窓口」を参照)。画面にもその注意を出している。
import '../../styles/ja-guide.css';
import JaLayout from '../../layouts/JaLayout.astro';
import JaGuideFoot from '../../components/JaGuideFoot.astro';
import subsidies from '../../data/ja/subsidies.json';
import news from '../../data/ja/news.json';
import { MILESTONES, THEMES, SRC, CHECKED } from '../../data/ja/guides/milestones';
import { withBase } from '../../utils/site';

const DAY = 86400000;
const now = Date.now();
const fmtDay = new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'long', day: 'numeric' });
const fmtShort = new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', month: 'long', day: 'numeric' });

const upcoming = subsidies.items
  .filter((s) => s.endDate && new Date(s.endDate).getTime() > now)
  .sort((a, b) => new Date(a.endDate as string).getTime() - new Date(b.endDate as string).getTime())
  .slice(0, 12)
  .map((s) => {
    const t = new Date(s.endDate as string).getTime();
    return { ...s, left: Math.ceil((t - now) / DAY) };
  });

// 目安として、今から約2年先までの節目だけを出す(その先は年表ページへ)
const horizon = new Date(now + 2 * 365 * DAY).toISOString().slice(0, 7);
const nowMonth = new Date(now).toISOString().slice(0, 7);
const ahead = MILESTONES.filter((m) => m.status === 'ahead' && m.sort >= nowMonth && m.sort <= horizon).sort((a, b) =>
  a.sort.localeCompare(b.sort)
);

const EVENT_RE = /開催|シンポジウム|セミナー|説明会|研修|公募|募集|検討会|アワード|フォーラム/;
const recent = news.items.filter((i) => EVENT_RE.test(i.title)).slice(0, 8);

const title = '医療DX・補助金カレンダー｜締切と制度の節目を一画面で';
const description =
  '病院が使える補助金の締切、医療DXの年度ごとの節目、検討会・公募の案内を、近い順に一画面で確認できます。補助金は毎日、案内は3時間ごとに自動で確認しています。';
const sources = [SRC.policy, SRC.checklist, { label: 'jGrants(デジタル庁の補助金電子申請システム)', url: 'https://www.jgrants-portal.go.jp/' }];
---

<JaLayout
  title={title}
  description={description}
  crumb="制度カレンダー"
  standalone
  updated={new Date(subsidies.updatedAt)}
>
  <h1>医療DX・補助金カレンダー</h1>
  <p class="jg-lead">
    「締切はいつか」「次の節目はいつか」を、一画面で確認できるようにしました。補助金と案内は自動で集めたデータ、年度の節目は一次資料で確認した内容です。
  </p>
  <p class="jg-meta">表示は{fmtDay.format(new Date(now))}時点の目安 ／ 補助金データの更新: {fmtDay.format(new Date(subsidies.updatedAt))}</p>

  <section class="jg-sec" aria-labelledby="h-sub">
    <h2 id="h-sub">補助金・助成金の締切(近い順)</h2>
    <div class="jg-box jg-warn">
      締切は、jGrants(補助金電子申請システム)に載っている日付です。実際の申請は、事前の計画提出や選定が先に必要で、公募元が別の日程を定めている場合があります。必ず公募元のページで、受付期間と申請の流れをご確認ください。
    </div>
    {
      upcoming.length > 0 ? (
        <ol class="jg-tl">
          {upcoming.map((s) => (
            <li>
              <div class="when">
                {fmtDay.format(new Date(s.endDate as string))}
                <br />
                <small>あと{s.left}日</small>
              </div>
              <div class="what">
                <b>
                  {s.area && <span class="jg-tag">{s.area}</span>}
                  <a href={s.link} target="_blank" rel="noopener">
                    {s.title}
                    <span class="sr-only"> (新しいタブで開きます)</span>
                  </a>
                </b>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p>現在、締切の先にある補助金は掲載されていません。</p>
      )
    }
    <p><a href={withBase('/ja/subsidies/')}>補助金・助成金の一覧をすべて見る →</a></p>
  </section>

  <section class="jg-sec" aria-labelledby="h-ms">
    <h2 id="h-ms">制度の節目(今後およそ2年)</h2>
    <p>国の「医療情報化推進方針」などから、時期が示されているものを並べました。「めど」「目指す」は目標であり、確定した期限ではありません。</p>
    <ol class="jg-tl">
      {
        ahead.map((m) => (
          <li>
            <div class="when">{m.when}</div>
            <div class="what">
              <b>
                <span class="jg-tag">{THEMES[m.theme]}</span>
                {m.title}
              </b>
            </div>
          </li>
        ))
      }
    </ol>
    <p><a href={withBase('/ja/dx-roadmap/')}>説明つきの医療DX年表を見る →</a></p>
  </section>

  {
    recent.length > 0 && (
      <section class="jg-sec" aria-labelledby="h-ev">
        <h2 id="h-ev">最近出た検討会・公募・開催の案内</h2>
        <p>厚生労働省・デジタル庁・CBnewsの見出しから自動で拾っています。日付は「案内が出た日」で、開催日や締切日ではありません。</p>
        <ul class="jg-list">
          {recent.map((i) => (
            <li>
              <a href={i.link} target="_blank" rel="noopener">
                {i.title}
                <span class="sr-only"> (新しいタブで開きます)</span>
              </a>
              <br />
              <small>
                {i.source} ・ {fmtShort.format(new Date(i.pubDate))}
              </small>
            </li>
          ))}
        </ul>
        <p><a href={withBase('/ja/events/')}>AI教育・イベントのページへ →</a></p>
      </section>
    )
  }

  <JaGuideFoot sources={sources} checked={CHECKED} />
</JaLayout>
