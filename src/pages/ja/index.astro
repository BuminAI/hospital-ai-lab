---
// 일본어판 홈
import JaLayout from '../../layouts/JaLayout.astro';
import ja from '../../i18n/ja.json';
import subsidies from '../../data/ja/subsidies.json';
import { withBase } from '../../utils/site';
import newsData from '../../data/ja/news.json';

// 홈에는 마감 임박 순 5건만. 일본 사용자는 정보가 화면에 미리 보이는 것을
// 신뢰의 근거로 삼으므로, 목록으로 들어가야만 내용을 볼 수 있게 두지 않는다.
const top = subsidies.items.slice(0, 5);
const updated = new Date(subsidies.updatedAt);

const fmtJa = (iso) => {
  if (!iso) return null;
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? null : `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
};

// ── AEO/GEO — 홈에서 바로 답이 되는 블록 (2026-09-07) ──────────
// 답변 엔진은 "이 사이트는 무엇이고 누구를 위한 것인가"를 물었을 때
// **그 답이 실제로 적혀 있는 페이지**를 인용한다. 홈이 소개 문단만
// 있으면 인용할 문장이 없다. 그래서 사이트 자체에 대한 문답을
// 화면에 그대로 싣고 FAQPage로 표시한다.
//
// ⚠️ 여기 답변은 /ja/faq/ 의 제도 문답과 **내용이 겹치지 않는다.**
//    저쪽은 "AI를 도입할 때 무엇을 확인하나", 여기는 "이 사이트는
//    무엇인가"다. 같은 문답을 두 곳에 복사하면 안 된다.
// ⚠️ 답변에 적은 사실(수집처·갱신 주기)은 scripts/ 의 수집기와
//    .github/workflows/ 의 cron 에서 확인한 것이다. 수집처나 주기를
//    바꾸면 이 문구도 함께 고칠 것.
const recentNews = newsData.items.slice(0, 5);

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/ja/')}`;

const homeFaqLd = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#home-faq`,
  url: pageUrl,
  inLanguage: 'ja',
  isPartOf: { '@id': `${siteRoot}/#website-ja` },
  mainEntity: ja.home.homeFaq.map((f, i) => ({
    '@type': 'Question',
    '@id': `${pageUrl}#home-q${i + 1}`,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<JaLayout
  title={ja.home.metaTitle}
  description={ja.home.metaDescription}
  koPath="/"
  twPath="/tw/"
  ruPath="/ru/"
  idPath="/id/"
  updated={updated}
  schema={[homeFaqLd]}
>
  <p class="ja-updated" style="letter-spacing:.08em">{ja.home.heroEyebrow}</p>
  <h1>{ja.home.heroTitle}<br />{ja.home.heroTitle2}</h1>
  <p>{ja.home.heroLead}</p>

  <p style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap">
    <a class="ja-cta" href={withBase('/ja/subsidies/')}>{ja.home.ctaSubsidies}</a>
    <a class="ja-cta ja-cta-ghost" href={withBase('/ja/about/')}>{ja.home.ctaAbout}</a>
  </p>

  <h2>{ja.home.subsidiesTitle}</h2>
  <p>{ja.home.subsidiesDesc}</p>
  <ul class="ja-list">
    {top.map((item) => (
      <li>
        <a class="ja-item-title ja-ext" href={item.link} target="_blank" rel="noopener">
          {item.title}
          <span class="sr-only">（{ja.ui.external}）</span>
        </a>
        <span class="ja-item-meta">
          {fmtJa(item.endDate) && <span>{ja.subsidies.labelDeadline}：{fmtJa(item.endDate)}</span>}
          {item.area && <span class="ja-badge ja-badge-gov">{item.area}</span>}
        </span>
      </li>
    ))}
  </ul>
  <p style="margin-top:12px"><a href={withBase('/ja/subsidies/')}>{ja.ui.viewAll} →</a></p>

  <h2>{ja.home.resourcesTitle}</h2>
  <div class="ja-cards">
    <a class="ja-card" href={withBase('/ja/videos/')}>
      <span class="ja-card-t">{ja.nav.videos}</span>
      <span class="ja-card-d">{ja.home.videosDesc}</span>
    </a>
    <a class="ja-card" href={withBase('/ja/guide/')}>
      <span class="ja-card-t">{ja.nav.guide}</span>
      <span class="ja-card-d">{ja.home.guideDesc}</span>
    </a>
    <a class="ja-card" href={withBase('/ja/tips/')}>
      <span class="ja-card-t">{ja.nav.tips}</span>
      <span class="ja-card-d">{ja.home.tipsDesc}</span>
    </a>
    <a class="ja-card" href={withBase('/ja/checklist/')}>
      <span class="ja-card-t">{ja.nav.checklist}</span>
      <span class="ja-card-d">{ja.home.checklistDesc}</span>
    </a>
    <a class="ja-card" href={withBase('/ja/glossary/')}>
      <span class="ja-card-t">{ja.nav.glossary}</span>
      <span class="ja-card-d">{ja.home.glossaryDesc}</span>
    </a>
    <a class="ja-card" href={withBase('/ja/faq/')}>
      <span class="ja-card-t">{ja.nav.faq}</span>
      <span class="ja-card-d">{ja.home.faqDesc}</span>
    </a>
  </div>

  {/* 최신 뉴스 — 홈에 실제 내용이 있어야 검색·답변 엔진이 인용할 거리가 생긴다.
      한국어판 홈이 이미 쓰는 방식이고, 다른 판에는 빠져 있었다(2026-09-07 추가). */}
  {
    recentNews.length > 0 && (
      <section class="ja-home-sec">
        <div class="ja-sec-head">
          <h2>{ja.home.homeNewsTitle}</h2>
          <a class="ja-more" href={withBase('/ja/news/')}>{ja.home.homeNewsMore}</a>
        </div>
        <ul class="ja-news-preview">
          {recentNews.map((item) => (
            <li>
              <a href={item.link} target="_blank" rel="noopener">
                {item.title}
                <span class="sr-only"> ({ja.ui.external})</span>
              </a>
              {item.source && <span class="ja-src">{item.source}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* 사이트 자체에 대한 문답. /ja/faq/ 의 제도 문답과 내용이 겹치지 않는다. */}
  <section class="ja-home-sec">
    <div class="ja-sec-head">
      <h2>{ja.home.homeFaqTitle}</h2>
      <a class="ja-more" href={withBase('/ja/faq/')}>{ja.home.homeFaqMore}</a>
    </div>
    <dl class="ja-home-faq">
      {
        ja.home.homeFaq.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <h2>{ja.home.introTitle}</h2>
  <p>{ja.home.introBody}</p>

  <div class="ja-note">
    <p><strong>{ja.home.koNoticeTitle}</strong></p>
    <p style="margin-top:6px">{ja.home.koNoticeBody}</p>
    <p style="margin-top:8px"><a href={withBase('/')} hreflang="ko">{ja.ui.langKo} →</a></p>
  </div>
</JaLayout>

<style>
  .ja-cta {
    display: inline-block;
    background: var(--ja-btn-bg);
    color: var(--ja-btn-fg);
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 4px;
    font-size: 14.5px;
  }
  .ja-cta:hover { background: var(--ja-btn-bg-hover); }
  .ja-cta-ghost {
    background: transparent;
    color: var(--ja-primary);
    border: 1px solid var(--ja-primary);
  }
  .ja-cta-ghost:hover { background: var(--ja-surface); color: var(--ja-primary); }

  /* 資料カード — 日本の利用者は情報が画面に見えていることを信頼の根拠にする */
  .ja-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 14px;
    margin-top: 4px;
  }
  .ja-card {
    display: block;
    border: 1px solid var(--ja-border);
    border-left: 4px solid var(--ja-primary);
    background: var(--ja-base);
    padding: 14px 16px;
    text-decoration: none;
    color: var(--ja-text);
  }
  .ja-card:hover { background: var(--ja-surface); }
  .ja-card-t { display: block; font-size: 15.5px; color: var(--ja-primary); margin-bottom: 6px; }
  .ja-card-d { display: block; font-size: 13.5px; color: var(--ja-text-sub); line-height: 1.8; }

  /* 홈 뉴스·문답 (2026-09-07 AEO/GEO) */
  .ja-home-sec {
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--ja-border);
  }
  .ja-sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ja-sec-head h2 {
    margin: 0;
  }
  .ja-more {
    font-size: 13px;
    color: var(--ja-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .ja-more:hover { text-decoration: underline; }
  .ja-news-preview {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }
  .ja-news-preview li {
    padding: 9px 0;
    border-bottom: 1px solid var(--ja-border);
    font-size: 14px;
    line-height: 1.7;
  }
  .ja-news-preview a {
    color: var(--ja-text);
    text-decoration: none;
  }
  .ja-news-preview a:hover { color: var(--ja-primary); text-decoration: underline; }
  .ja-src {
    display: inline-block;
    margin-left: 8px;
    font-size: 12px;
    color: var(--ja-text-sub);
  }
  .ja-home-faq {
    margin: 14px 0 0;
  }
  .ja-home-faq dt {
    font-weight: 700;
    color: var(--ja-primary);
    margin-top: 16px;
    font-size: 14.5px;
    line-height: 1.7;
  }
  .ja-home-faq dt:first-child { margin-top: 0; }
  .ja-home-faq dd {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.9;
    color: var(--ja-text);
  }
</style>
