---
import JaLayout from '../../layouts/JaLayout.astro';
import InteractiveChecklist from '../../components/InteractiveChecklist.astro';
import SubscribeCta from '../../components/SubscribeCta.astro';
import { getCollection } from 'astro:content';
import { checklistRelated } from '../../data/checklist-related';
import { COLLECTION, postHref } from '../../utils/locale';
import { checklistJa } from '../../data/ja/pages';
import ja from '../../i18n/ja.json';
import { withBase } from '../../utils/site';

const p = checklistJa;

// 점검표를 체크해 가며 쓰는 형태로 그린다(2026-09-20). 체크 상태는 이 기기의 브라우저에만 저장된다.
// 마지막 구역은 공식 자료 목록이라 체크 대상이 아니다(plain).
const sections = p.sections.map((s, i) => ({
  title: s.heading,
  body: s.body,
  items: s.items,
  plain: i === p.sections.length - 1,
}));
const posts = await getCollection(COLLECTION.ja, ({ data }) => !data.draft);
const titleOf = new Map(posts.map((x) => [x.id, x.data.title]));
const relatedByTitle: Record<string, { href: string; title: string }[]> = {};
for (const [idx, ids] of Object.entries(checklistRelated.ja)) {
  const sec = sections[Number(idx)];
  if (!sec) throw new Error('[checklist:ja] 관련 글의 섹션 번호 ' + idx + '가 없습니다.');
  relatedByTitle[sec.title] = ids.map((id) => {
    const title = titleOf.get(id);
    if (!title) throw new Error('[checklist:ja] 관련 글 ID ' + id + '가 없습니다.');
    return { href: postHref('ja', id), title };
  });
}

// 区分（見出し）を、画面に表示している順のまま ItemList で示す。
const schema = [
  {
    '@type': 'ItemList',
    name: p.meta.pageTitle,
    numberOfItems: p.sections.length,
    itemListElement: p.sections.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.heading,
    })),
  },
];
---

<JaLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={ja.nav.checklist}
  koPath="/checklist/"
  idPath="/id/checklist/"
  twPath="/tw/checklist/"
  ruPath="/ru/checklist/"
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="ja-lead">{p.meta.lead}</p>

  <InteractiveChecklist id="ai-adoption-ja" loc="ja" sections={sections} related={relatedByTitle} />

  <SubscribeCta loc="ja" />
</JaLayout>
