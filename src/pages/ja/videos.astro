---
import JaLayout from '../../layouts/JaLayout.astro';
import { videosJa, videosMetaJa, videosLocalJa } from '../../data/ja/pages';
import ja from '../../i18n/ja.json';
import { withBase, YOUTUBE_CHANNEL_URL } from '../../utils/site';

const p = videosMetaJa;

// ⚠️ VideoObject は使わない。uploadDate・duration を正確に持っていないためで、
//    推測で入れると検索側に誤った事実を伝えることになる。
//    (韓国語版 recommended-videos.json の addedAt は「サイトに追加した日」であって
//     YouTube への公開日ではない。)
//    代わりに、画面に見えている一覧の順序を ItemList で伝える。
const schema = [
  {
    '@type': 'ItemList',
    name: p.pageTitle,
    numberOfItems: videosJa.length,
    itemListElement: videosJa.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.titleJa,
      url: `https://www.youtube.com/watch?v=${v.videoId}`,
    })),
  },
  {
    '@type': 'ItemList',
    name: '他チャンネルのおすすめ動画',
    numberOfItems: videosLocalJa.length,
    itemListElement: videosLocalJa.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.title,
      url: `https://www.youtube.com/watch?v=${v.videoId}`,
    })),
  },
];
---

<JaLayout
  title={p.title}
  description={p.description}
  crumb={ja.nav.videos}
  koPath="/youtube/"
  twPath="/tw/videos/"
  ruPath="/ru/videos/"
  idPath="/id/videos/"
  schema={schema}
>
  <h1>{p.pageTitle}</h1>
  <p class="ja-lead">{p.lead}</p>

  {/* 言語の案内は再生前に出す。見てから気づく形にすると信頼を損ねる */}
  <p class="ja-notice">{p.notice}</p>

  <p class="ja-count">全{videosJa.length}回</p>

  <h2 class="ja-vsec">当研究所が制作した動画</h2>
  <ul class="ja-videos">
    {
      videosJa.map((v) => (
        <li>
          <a
            href={`https://www.youtube.com/watch?v=${v.videoId}`}
            target="_blank"
            rel="noopener"
          >
            <img
              src={`https://img.youtube.com/vi/${v.videoId}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              width="320"
              height="180"
            />
            <div class="ja-video-text">
              <span class="ja-video-title">{v.titleJa}</span>
              <span class="ja-video-note">{v.note}</span>
              <span class="ja-video-ext">
                YouTubeで見る<span class="sr-only">（{ja.ui.external}）</span>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>


  <h2 class="ja-vsec">他チャンネルのおすすめ動画</h2>
  <p class="ja-lead">日本語で医療AI・医療DXを扱っている動画を選びました。当研究所が作ったものではありません。</p>
  {/* 제휴가 아니라는 안내를 반드시 함께 낸다 — 지우지 말 것.
      영상 내용은 각 제작자의 것이고 이 사이트가 검증한 주장이 아니다. */}
  <p class="ja-notice">ここに挙げた動画は各チャンネルの制作者によるものです。掲載は当研究所が選んだという意味にとどまり、提携や後援の関係はありません。内容は各制作者の見解であり、当研究所が検証した事実ではありません。</p>

  <ul class="ja-videos">
    {
      videosLocalJa.map((v) => (
        <li>
          <a href={`https://www.youtube.com/watch?v=${v.videoId}`} target="_blank" rel="noopener">
            <img
              src={`https://img.youtube.com/vi/${v.videoId}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              width="320"
              height="180"
            />
            <div class="ja-video-text">
              <span class="ja-video-title">{v.title}</span>
              <span class="ja-video-ch">{v.channel}</span>
              {v.note && <span class="ja-video-note">{v.note}</span>}
              <span class="ja-video-ext">
                YouTubeで見る<span class="sr-only"> ({ja.ui.external})</span>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="ja-channel">
    <a href={YOUTUBE_CHANNEL_URL} target="_blank" rel="noopener">
      {ja.profile.youtube}<span class="sr-only">（{ja.ui.external}）</span>
    </a>
  </p>
</JaLayout>

<style>
  .ja-notice {
    border: 1px solid var(--ja-border);
    border-left: 4px solid var(--ja-primary);
    background: var(--ja-surface);
    padding: 12px 14px;
    font-size: 13.5px;
    line-height: 1.9;
    margin-bottom: 18px;
  }
  .ja-count {
    font-size: 13px;
    color: var(--ja-text-sub);
    margin-bottom: 16px;
  }
  .ja-videos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ja-videos a {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    border: 1px solid var(--ja-border);
    background: var(--ja-base);
    padding: 12px;
    text-decoration: none;
    color: var(--ja-text);
  }
  .ja-videos a:hover {
    background: var(--ja-surface);
    border-color: var(--ja-primary);
  }
  .ja-videos img {
    width: 160px;
    height: 90px;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--ja-surface);
  }
  .ja-video-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }
  .ja-video-title {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--ja-primary);
  }
  .ja-video-note {
    font-size: 13px;
    color: var(--ja-text-sub);
    line-height: 1.85;
  }
  .ja-video-ext {
    font-size: 12px;
    color: var(--ja-text-sub);
  }
  .ja-channel {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--ja-border);
    font-size: 14px;
  }

  @media (max-width: 560px) {
    .ja-videos a {
      flex-direction: column;
    }
    .ja-videos img {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
  .ja-vsec {
    font-size: 16px;
    margin: 30px 0 10px;
    padding-left: 10px;
    border-left: 4px solid var(--ja-primary);
  }
  .ja-vsec:first-of-type {
    margin-top: 18px;
  }
  .ja-video-ch {
    font-size: 12.5px;
    color: var(--ja-text-sub);
  }
</style>
