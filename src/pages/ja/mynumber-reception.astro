// 根拠: 厚生労働省「マイナ保険証」FAQ(newpage_40406)・「オンライン資格確認」医療機関向けページ(newpage_08280)・
//       患者向けページ(newpage_08277)。実際にアクセスして確認した記述だけを使っている。
import '../../styles/ja-guide.css';
import JaLayout from '../../layouts/JaLayout.astro';
import JaGuideFoot from '../../components/JaGuideFoot.astro';
import { SRC } from '../../data/ja/guides/milestones';
import { withBase } from '../../utils/site';

const CHECKED = '2026年10月31日';
const title = 'マイナ保険証 窓口対応ガイド｜受付で迷う場面を整理';
const description =
  'マイナ保険証の受付で迷いやすい場面(顔認証がうまくいかない・読み取れない・資格確認書・電子証明書の期限切れ)を、厚生労働省の公式資料に沿って整理しました。病院の受付・医事課向けです。';

const MHLW = 'https://www.mhlw.go.jp';
const links = [
  { label: '施設内設計とお声かけ方法について(好事例のまとめ)', url: `${MHLW}/content/10200000/001301964.pdf` },
  { label: '窓口に掲示できる掲示物(厚生労働省)', url: `${MHLW}/stf/index_16745.html` },
  { label: '医療機関・薬局の窓口で患者に配布できる周知資料', url: `${MHLW}/content/10200000/001122284.pdf` },
  { label: '(別添1)マイナンバーカードによるオンライン資格確認を行うことができない場合の対応', url: `${MHLW}/content/10200000/001120093.pdf` },
  { label: '(別添2)システム障害時モード・目視確認モードの立ち上げ方法・利用方法', url: `${MHLW}/content/10200000/001120094.pdf` },
  { label: '目視確認モード改善に関するリーフレット', url: `${MHLW}/content/10200000/001473356.pdf` },
  { label: '被保険者資格申立書に関する説明書', url: `${MHLW}/content/10200000/001120095.pdf` },
  { label: '疑義解釈(マイナンバーカードによるオンライン資格確認を行うことができない場合における対応等)', url: `${MHLW}/content/10200000/001131620.pdf` },
  { label: '医療機関・薬局の窓口における資格確認方法等についてのセミナー(アーカイブ動画)', url: `${MHLW}/stf/newpage_43776.html` },
