---
// 患者さん向け: 病院でAIが使われるとき （2026-10-31 新設）
// 確認した出典: 厚労省医事課長通知（医政医発1219第1号）、個人情報保護委員会の注意喚起（令和5年6月2日）、
// 医療安全支援センター運営要領。特定の病院・製品の紹介や評価はしない（医療広告を避ける）。
import '../../../styles/ja-guide.css';
import JaLayout from '../../../layouts/JaLayout.astro';
import JaGuideFoot from '../../../components/JaGuideFoot.astro';
import JaFaq from '../../../components/JaFaq.astro';
import { guideSchema } from '../../../utils/ja-guide';
import { withBase } from '../../../utils/site';

const CHECKED = '2026年10月31日';
const title = '病院でAIが使われるとき、患者さんが知っておきたいこと';
const description =
  '病院で診断の支援や業務にAIが使われるとき、決めるのは誰か、自分の情報はどう扱われるのか、どう尋ねればよいのかを、公的な資料に沿ってQ&A形式でまとめました。患者さん・ご家族向けです。';

const sources = [
  { label: '厚生労働省医政局医事課長通知「人工知能（AI）を用いた診断、治療等の支援を行うプログラムの利用と医師法第17条の規定との関係について」（医政医発1219第1号、平成30年12月19日）', url: 'https://www.mhlw.go.jp/content/10601000/000468150.pdf' },
  { label: '個人情報保護委員会「生成AIサービスの利用に関する注意喚起等について」（令和5年6月2日）', url: 'https://www.ppc.go.jp/news/careful_information/230602_AI_utilize_alert/' },
  { label: '厚生労働省「医療安全支援センター運営要領」', url: 'https://www.mhlw.go.jp/content/10800000/000921599.pdf' },
];

const qa = [
  {
    q: 'AIが、病気を診断するのですか。',
    a: '厚生労働省は2018年の通知で、AIを使った診断や治療の支援を行うときでも、診断・治療を行う主体は医師であり、医師が最終的な判断の責任を負う、と整理しています。AIが出す結果は、医師の判断を助けるための情報（支援ツール）であって、診断や治療の指示そのものではありません。',
  },
  {
    q: 'AIの結果は、間違っていないのですか。',
    a: 'AIの結果には、誤りが含まれることがあります。通知に添えられた研究報告書の概要には、AIの推測結果には誤りがありうるため、判断の主体である医師が責任を負うべきで、その前提として医師にAIについての適切な教育を行うべきだ、と書かれています。ですから、病院では、AIの結果をそのまま使わず、医療者が確認する流れが大切になります。',
  },
  {
    q: '私の情報は、AIに入力されるのですか。',
    a: '病院が、外部の生成AIサービスなどに個人情報を入力するときは、個人情報保護法に基づいて、その利用が目的の範囲内か、入力した情報が提供事業者の機械学習に使われないか、などの確認が必要です。個人情報保護委員会は、事業者向けの注意点として、この2点を挙げています。実際に、どのような情報を、どのサービスに入力しているかは、病院ごとに異なります。気になるときは、病院の個人情報の窓口に尋ねることができます。',
  },
  {
    q: '病院に、AIのことを聞いてもよいのですか。',
    a: 'もちろんかまいません。次のような聞き方が考えられます（当研究所からの提案です）。',
    list: [
      '「この検査や説明には、AIが使われていますか。」',
      '「AIの結果は、先生（医療者）が確認したものですか。」',
      '「私の情報は、病院の外のサービスに送られますか。」',
      '「AIの結果と、先生のお考えが違うときは、どちらを優先しますか。」',
    ],
  },
  {
    q: '説明に納得できないとき、相談できる所はありますか。',
    a: '病院の相談窓口のほか、各自治体に「医療安全支援センター」があります。医療法に基づいて、都道府県・保健所を設置する市・特別区が設けている窓口で、医療に関する患者・住民の苦情・心配や相談に応じています。患者・住民と医療提供施設の間で中立的な立場に立ち、相談者のプライバシーに配慮するとされています。お住まいの自治体のホームページで、窓口を探せます。',
  },
];

// 画面に見えているQ&Aと同じ内容をFAQPageとして渡す（見えていないことはマークアップしない）
const schema = [
  {
    '@type': 'FAQPage',
    inLanguage: 'ja-JP',
    mainEntity: qa.map((x) => ({
      '@type': 'Question',
      name: x.q,
      acceptedAnswer: { '@type': 'Answer', text: x.a + (x.list ? ' ' + x.list.join(' ') : '') },
    })),
  },
];

// 検索・回答エンジン向けの構造化データ（画面に見えている出典・質問と同じ内容を渡す）
const siteRootG = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const guide = guideSchema({
  siteRoot: siteRootG,
  path: '/ja/patients/ai-in-hospital/',
  headline: title,
  description,
  sources,
  published: '2026-10-31',
  modified: '2026-10-31',
  audience: '患者・家族',
});
---

<JaLayout
  title={title}
  description={description}
  crumb="病院でAIが使われるとき"
  standalone
  updated={new Date('2026-10-31T00:00:00+09:00')}
  schema={[...schema, ...guide]}
>
  <h1>病院でAIが使われるとき、患者さんが知っておきたいこと</h1>
  <p class="jg-lead">
    病院では、診断や治療を支援するAI(人工知能)のプログラムや、事務の作業を助けるAIが使われることがあります。「AIが診断するの?」「自分の情報はどうなるの?」という疑問に、公的な資料に沿ってお答えします。
  </p>
  <p class="jg-meta">確認日: {CHECKED} ／ 患者さん・ご家族向け</p>

  <div class="jg-box">
    このページは、特定の病院や製品を紹介・評価するものではありません。また、特定の方の治療についての助言でもありません。
  </div>

  {
    qa.map((x, i) => (
      <section class="jg-sec" aria-labelledby={`q${i + 1}`}>
        <h2 id={`q${i + 1}`}>Q{i + 1}. {x.q}</h2>
        <p>{x.a}</p>
        {x.list && (
          <ul class="jg-list">
            {x.list.map((l) => (
              <li>{l}</li>
            ))}
          </ul>
        )}
      </section>
    ))
  }

  <section class="jg-sec" aria-labelledby="more">
    <h2 id="more">あわせて読みたい</h2>
    <ul class="jg-list">
      <li><a href={withBase('/ja/patients/ai-health-consult/')}>AIに健康相談をする前に知っておきたい6つのこと</a></li>
      <li><a href={withBase('/ja/patients/mynumber-navii/')}>マイナ保険証と医療情報ネット（ナビイ）の使い方</a></li>
    </ul>
    <p>病院で働く方は、<a href={withBase('/ja/templates/')}>患者さんへのお知らせの文例</a>もご利用いただけます。</p>
  </section>

  <JaGuideFoot sources={sources} checked={CHECKED} patient />
</JaLayout>
