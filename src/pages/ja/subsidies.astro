---
// 補助金・助成金情報 — jGrants(디지털청) 공개 API 자동 수집
// 데이터: scripts/fetch-jgrants.mjs → src/data/ja/subsidies.json
import JaLayout from '../../layouts/JaLayout.astro';
import ja from '../../i18n/ja.json';
import subsidies from '../../data/ja/subsidies.json';
import subsidyNotes from '../../data/ja/subsidy-notes.json';
import { withBase } from '../../utils/site';

const items = subsidies.items;

// 수기 주석(subsidy-notes.json): 자동 수집 데이터만으로는 오해할 수 있는 공모에 붙인다.
// 예) jGrants의 게재 기간이 사전 계획 제출·대상 병원 선정 뒤의 교부 신청 단계를 가리키는 경우.
type SubsidyNote = { text: string; sourceLabel: string; sourceUrl: string; checkedOn: string };
const noteOf = (id: string): SubsidyNote | null => {
  const n = (subsidyNotes as Record<string, unknown>)[id];
  return n && typeof n === 'object' ? (n as SubsidyNote) : null;
};
const updated = new Date(subsidies.updatedAt);

const siteRoot = Astro.site
  ? Astro.site.href.replace(/\/$/, '')
  : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/ja/subsidies/')}`;

// 일본어 날짜 표기 (2026年8月14日)
const fmtJa = (iso: string | null) => {
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
};

// 금액은 만엔 단위로 — 일본 공모 문서 관행
const fmtAmount = (yen: number | null) => {
  if (!yen) return null;
  const man = yen / 10000;
  return `${man.toLocaleString('ja-JP')}万円`;
};

// 7일 이내 마감이면 '新着'이 아니라 '締切間近'를 보여주는 편이 실무에 맞다
const DAY = 86400000;
const now = Date.now();
const isSoon = (iso: string | null) => {
  if (!iso) return false;
  const t = new Date(iso).getTime();
  return !Number.isNaN(t) && t - now > 0 && t - now < 14 * DAY;
};

// 답을 먼저(2026-11-26): '締切が近い公募は？'에 한 문단으로 답할 수 있게, 데이터에서 계산한 요약을 맨 위에 둔다.
// 실적 보고·세액 공제 보고처럼 이미 받은 곳이 하는 절차는 새로 신청하는 공모가 아니므로 요약에서 뺀다(목록에는 남는다).
const REPORT_ONLY = /実績報告|状況報告|完了報告|仕入控除税額|消費税.*報告|精算/;
const open = items.filter((i) => i.endDate && new Date(i.endDate).getTime() > now && !REPORT_ONLY.test(i.title));
const nearest = open.slice().sort((a, b) => new Date(a.endDate!).getTime() - new Date(b.endDate!).getTime()).slice(0, 3);
const md = (iso: string) => {
  const d = new Date(iso);
  return `${d.getMonth() + 1}月${d.getDate()}日`;
};
// 화면에 보이는 문답과 FAQPage 구조화 데이터는 같은 배열을 쓴다.
const FAQ = [
  {
    q: '病院が使える補助金・助成金はどこで確認できますか。',
    a: 'このページでは、デジタル庁「Jグランツ」の公開APIから、医療・病院・診療所・介護・医療DXなどのキーワードに当てはまる募集中の公募を、締切が近い順に掲載しています。申請資格と手順は各項目の公式詳細ページで確認してください。',
  },
  {
    q: 'この一覧はどのくらいの頻度で更新されますか。',
    a: '毎日、公開APIを確認して更新しています。公募元の情報が反映されるまでに時間差があるため、受付が終了した公募がしばらく残っていることがあります。',
  },
  {
    q: '表示されている締切日までに申請すれば間に合いますか。',
    a: '間に合うとは限りません。掲載している締切はJグランツ上の受付期間で、事業によっては事前の計画提出などが先に締め切られます。必ず公募元の要領で確認してください。',
  },
];
const faqLd = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  url: pageUrl,
  inLanguage: 'ja-JP',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

// CollectionPage + ItemList — AI 답변 엔진이 '무엇을 모은 목록인지' 알게 한다
const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: ja.subsidies.pageTitle,
  description: ja.subsidies.metaDescription,
  inLanguage: 'ja-JP',
  dateModified: subsidies.updatedAt,
  isPartOf: { '@id': `${siteRoot}/#website-ja` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<JaLayout
  title={ja.subsidies.metaTitle}
  description={ja.subsidies.metaDescription}
  crumb={ja.nav.subsidies}
  koPath="/gov-support/"
  updated={updated}
  schema={[collectionPage, faqLd]}
>
  <h1>{ja.subsidies.pageTitle}</h1>
  <p>{ja.subsidies.pageLead}</p>

  {
    nearest.length > 0 && (
      <aside class="ja-answer" aria-labelledby="sub-answer-h">
        <h2 id="sub-answer-h">締切が近い公募は？</h2>
        <p>
          {fmtJa(subsidies.updatedAt)}時点のデータでは、締切前の公募は{open.length}件です（実績報告などの手続きを除く）。締切が近い順に次の{nearest.length}件です。
        </p>
        <ul>
          {nearest.map((i) => (
            <li>
              {i.title}（{i.area ? `${i.area}、` : ''}締切 {md(i.endDate!)}{noteOf(i.id) ? '、下の注記を必ず確認' : ''}）
            </li>
          ))}
        </ul>
        <p>締切はJグランツ上の日付です。申請の可否と手順は公式の詳細ページで確認してください。</p>
      </aside>
    )
  }

  <p class="ja-caution">{ja.subsidies.caution}</p>

  <p class="ja-updated" style="margin-bottom:8px">
    {ja.subsidies.countLabel}：{items.length}件
  </p>

  {
    items.length > 0 ? (
      <ul class="ja-list">
        {items.map((item) => {
          const deadline = fmtJa(item.endDate);
          const amount = fmtAmount(item.maxLimit);
          return (
            <li>
              <a
                class="ja-item-title ja-ext"
                href={item.link}
                target="_blank"
                rel="noopener"
              >
                {item.title}
                <span class="sr-only">（{ja.ui.external}）</span>
              </a>
              <span class="ja-item-meta">
                {isSoon(item.endDate) && <span class="ja-badge ja-badge-new">締切間近</span>}
                {deadline && (
                  <span>
                    {ja.subsidies.labelDeadline}：{deadline}
                  </span>
                )}
                {amount && (
                  <span>
                    {ja.subsidies.labelMaxAmount}：{amount}
                  </span>
                )}
                {item.rate && (
                  <span>
                    {ja.subsidies.labelRate}：{item.rate}
                  </span>
                )}
                {item.area && <span class="ja-badge ja-badge-gov">{item.area}</span>}
              </span>
              {item.usePurpose && (
                <span class="ja-item-meta">
                  {ja.subsidies.labelPurpose}：{item.usePurpose}
                </span>
              )}
              {noteOf(item.id) && (
                <span class="ja-item-meta">
                  <span>
                    ※ {noteOf(item.id)!.text}（
                    <a
                      class="ja-ext"
                      href={noteOf(item.id)!.sourceUrl}
                      target="_blank"
                      rel="noopener"
                    >
                      {noteOf(item.id)!.sourceLabel}
                      <span class="sr-only">（{ja.ui.external}）</span>
                    </a>
                    、{noteOf(item.id)!.checkedOn}確認）
                  </span>
                </span>
              )}
            </li>
          );
        })}
      </ul>
    ) : (
      <p>{ja.ui.noItems}</p>
    )
  }

  <section class="ja-faq" aria-labelledby="sub-faq-h">
    <h2 id="sub-faq-h">よくある質問</h2>
    <dl>
      {
        FAQ.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <div class="ja-note">
    <p>{ja.subsidies.noticeSource}</p>
    <p style="margin-top:8px">{ja.subsidies.noticeFilter}</p>
  </div>
</JaLayout>

<style>
  .ja-answer {
    margin: 20px 0;
    padding: 14px 18px 10px;
    background: var(--ja-surface);
    border: 1px solid var(--ja-border);
    border-left: 4px solid var(--ja-primary);
    border-radius: 6px;
  }
  .ja-answer h2 {
    margin: 0 0 8px;
    padding: 0;
    border: 0;
    background: none;
    font-size: 16px;
    color: var(--ja-primary);
  }
  .ja-answer p {
    margin: 6px 0;
    font-size: 14px;
  }
  .ja-answer ul {
    margin: 6px 0;
    padding-left: 1.2em;
  }
  .ja-answer li {
    margin: 4px 0;
    line-height: 1.8;
    font-size: 15px;
  }
  .ja-faq {
    margin: 32px 0;
  }
  .ja-faq dt {
    margin-top: 14px;
    font-weight: 700;
  }
  .ja-faq dd {
    margin: 6px 0 0;
    line-height: 1.8;
    color: var(--ja-text-sub);
  }
</style>
