---
// よくあるご質問 — 일본 제도 기준으로 재작성한 FAQ
import JaLayout from '../../layouts/JaLayout.astro';
import ja from '../../i18n/ja.json';
import { faqItemsJa } from '../../data/ja/faq';
import { withBase } from '../../utils/site';

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/ja/faq/')}`;

// FAQPage — AI 답변 엔진이 Q&A 쌍을 그대로 인용할 수 있게 한다.
// 답변이 <details> 안에 실제로 렌더되므로 '숨겨진 콘텐츠 마크업'이 아니다.
const faqPage = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  url: pageUrl,
  inLanguage: 'ja-JP',
  isPartOf: { '@id': `${siteRoot}/#website-ja` },
  mainEntity: faqItemsJa.map((it, i) => ({
    '@type': 'Question',
    '@id': `${pageUrl}#q${i + 1}`,
    name: it.question,
    acceptedAnswer: { '@type': 'Answer', text: it.answer },
  })),
};
---

<JaLayout
  title={ja.faq.metaTitle}
  description={ja.faq.metaDescription}
  crumb={ja.nav.faq}
  koPath="/faq/"
  ruPath="/ru/faq/"
  schema={[faqPage]}
>
  <h1>{ja.faq.pageTitle}</h1>
  <p>{ja.faq.pageLead}</p>

  <div class="ja-faq">
    {faqItemsJa.map((item) => (
      <details class="ja-faq-item">
        <summary>{item.question}</summary>
        <div class="ja-faq-a">
          <p>{item.answer}</p>
          {item.sources.length > 0 && (
            <p class="ja-src">
              {ja.ui.source}：
              {item.sources.map((src, i) => (
                <>
                  {i > 0 && ' / '}
                  <a class="ja-ext" href={src} target="_blank" rel="noopener">
                    {new URL(src).hostname.replace(/^www\./, '')}
                    <span class="sr-only">（{ja.ui.external}）</span>
                  </a>
                </>
              ))}
            </p>
          )}
        </div>
      </details>
    ))}
  </div>

  <div class="ja-note"><p>{ja.faq.notice}</p></div>
</JaLayout>

<style>
  .ja-faq { margin-top: 16px; border-top: 1px solid var(--ja-border); }
  .ja-faq-item { border-bottom: 1px solid var(--ja-border); }
  .ja-faq-item summary {
    cursor: pointer; padding: 14px 4px; font-size: 15px; line-height: 1.75;
    list-style-position: outside;
  }
  .ja-faq-item summary:hover { color: var(--ja-primary); }
  .ja-faq-item[open] summary { color: var(--ja-primary); }
  .ja-faq-a { padding: 0 4px 16px; }
  .ja-src { margin-top: 8px; font-size: 12.5px; }
</style>
