---
// 러시아어판(Лаборатория ИИ для больниц) 전용 관리자 대시보드 — /admin-ru/
//
// ⚠️ 한국어판 관리자(src/pages/admin.astro)·일본어판 관리자(admin-ja.astro)는
//    절대 수정하지 않는다. 이 페이지는 인증 방식(Supabase 로그인 +
//    admin_secrets의 GitHub PAT)과 CSS 클래스만 같은 방식으로 복제한
//    별도 페이지다(이 저장소는 언어판 간 공용 유틸을 두지 않는 관례).
//
// ⚠️ 반드시 BaseLayout + noindex. RuLayout에는 noindex 기능이 없고
//    robots.txt도 아무것도 막지 않으므로, RuLayout으로 만들면 관리자
//    페이지가 검색엔진에 색인된다.
//
// ⚠️ 경로를 바꾸지 말 것. astro.config.mjs의 사이트맵 필터가
//    page.includes('/admin')으로 제외하므로 '/admin-ru/'여야 빠진다.
//
// 편집 대상 데이터(GitHub Contents API로 커밋 → Actions 재빌드):
//    src/data/ru/content/nav.json         상단 메뉴 표시/비표시
//    src/data/ru/content/glossary.json    용어집
//    src/data/ru/content/faq.json         자주 묻는 질문
//    src/data/ru/content/guide.json       입문 가이드
//    src/data/ru/content/checklist.json   도입 체크리스트
//    src/data/ru/content/tips.json        실무 팁 ('본문 페이지' 탭에서 편집)
//    src/data/ru/content/videos.json      추천 영상 제목·설명
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUPABASE_URL, SUPABASE_ANON_KEY, ADMIN_EMAIL } from '../utils/site';
import navConfig from '../data/ru/content/nav.json';
import { glossaryCategoriesRu } from '../data/ru/glossary';
import ru from '../i18n/ru.json';

// 화면의 카테고리 선택 상자는 glossary.ts의 3개 값에서 그대로 만든다.
// (자유 입력을 허용하면 오타 하나로 그 용어가 러시아어판 화면에서 조용히 사라진다)
const categories = glossaryCategoriesRu;

// 분류(category)의 한국어 이름 — 운영자는 러시아어를 읽지 못하므로
// 선택 상자와 목록 양쪽에 한국어를 병기한다.
// ⚠️ 저장되는 값(value)은 반드시 러시아어 원문 그대로여야 한다.
//    glossary.ts의 GlossaryCategoryRu 3개 값과 한 글자라도 다르면
//    그 용어가 러시아어판 화면에서 조용히 사라진다.
const categoryKo: Record<string, string> = {
  'Регулирование и сертификация': '규제·인증',
  'Данные и конфиденциальность': '데이터·개인정보',
  'Стандарты и терминология': '표준·용어',
};
const categoryRows = categories.map((c) => ({ value: c, ko: categoryKo[c] ?? '' }));

// 메뉴 항목의 한국어 설명 — 운영자는 러시아어를 읽지 못하므로
// 러시아어 메뉴명 옆에 한국어 이름을 함께 보여준다.
const navLabelKo: Record<string, string> = {
  home: '홈',
  about: '운영자 소개',
  glossary: '용어집',
  faq: '자주 묻는 질문',
  checklist: '도입 체크리스트',
  guide: '입문 가이드',
  tips: '실무 팁',
  videos: '추천 영상',
};
const navLabels = ru.nav as Record<string, string>;
const navRows = navConfig.map((n) => ({
  href: n.href,
  key: n.key,
  ru: navLabels[n.key] ?? n.key,
  ko: navLabelKo[n.key] ?? n.key,
}));
---

<BaseLayout
  title="러시아어판 관리자"
  description="러시아어판(Лаборатория ИИ для больниц) 콘텐츠 관리 대시보드"
  noindex
>
  <div class="container admin-ru">
    <header class="page-head">
      <h1>러시아어판 관리자</h1>
      <p class="lead">
        러시아어판 사이트(Лаборатория ИИ для больниц, /ru/)의 내용을 여기서
        고칩니다. 화면 안내는 모두 한국어이고, <strong>입력하는 내용만
        러시아어</strong>입니다. 저장하면 사이트에 반영되기까지 2~3분 걸립니다.
      </p>
      <p class="lead">
        용어집·FAQ·본문 페이지(입문 가이드·체크리스트)의 <strong>제도 관련
        내용을 고치거나 추가할 때는 반드시 실제 출처를 확인한 뒤</strong>
        입력하세요. 확인 안 된 내용은 이 사이트의 절대 원칙에 어긋납니다.
      </p>
    </header>

    {
      !SUPABASE_URL ? (
        <p class="hint">
          회원 기능이 아직 연결되지 않았습니다. supabase/SETUP-GUIDE.md의
          안내대로 개통한 뒤 사용할 수 있습니다.
        </p>
      ) : (
        <div id="admin-login-gate" class="panel">
          <h2>관리자 로그인</h2>
          <p class="hint">관리자 계정({ADMIN_EMAIL})으로 로그인하세요.</p>
          <div class="row gate-row">
            <label>
              이메일
              <input
                type="email"
                id="gate-email"
                placeholder="관리자 이메일"
                autocomplete="username"
                value={ADMIN_EMAIL}
              />
            </label>
            <label>
              비밀번호
              <input
                type="password"
                id="gate-password"
                placeholder="비밀번호"
                autocomplete="current-password"
              />
            </label>
            <button class="btn" id="gate-login-btn">로그인</button>
          </div>
          <p class="hint save-status" id="gate-status" />
          <p class="hint">
            한국어판 관리자(/admin/)나 일본어판 관리자(/admin-ja/)에서 이미
            로그인했다면 여기서는 다시 로그인하지 않아도 됩니다.
          </p>
        </div>
      )
    }

    <div id="admin-dashboard" hidden>
      <div class="admin-topbar">
        <span id="admin-summary"></span>
        <button class="btn ghost" id="admin-logout">로그아웃</button>
      </div>

      <nav class="admin-nav" aria-label="러시아어판 관리 메뉴">
        <a href="#rg-panel" data-tab="rg-panel">📘 용어집</a>
        <a href="#rf-panel" data-tab="rf-panel">❓ 자주 묻는 질문</a>
        <a href="#rp-panel" data-tab="rp-panel">📄 본문 페이지</a>
        <a href="#rv-panel" data-tab="rv-panel">🎬 추천 영상</a>
        <a href="#rn-panel" data-tab="rn-panel">🧭 상단 메뉴 표시</a>
        <a href="#rs-panel" data-tab="rs-panel">🚀 사이트 반영 상태</a>
        <a href="#rt-panel" data-tab="rt-panel">🔑 GitHub 연동</a>
      </nav>

      <!-- ── 1. 용어집 ────────────────────────────────────── -->
      <section class="panel" id="rg-panel">
        <div class="panel-head">
          <h2>📘 용어집 (Словарь терминов)</h2>
          <button class="btn ghost" id="rg-refresh">새로고침</button>
        </div>
        <p class="section-desc">러시아어판 <code>/ru/glossary/</code>의 용어 목록입니다.</p>
        <p class="warn-box">
          <strong>주소 표시(id)는 바꿀 수 없습니다.</strong> id는
          <code>/ru/glossary/#roszdravnadzor</code> 처럼 그 용어로 바로 가는
          주소가 됩니다. 이미 공개된 id를 바꾸면 다른 사이트나 검색 결과에
          걸려 있던 링크가 전부 끊어집니다. 그래서 기존 용어의 id 칸은
          잠가 두었습니다.
        </p>
        <div id="rg-list" class="posts">불러오는 중…</div>

        <h3 class="panel-subhead" id="rg-form-head">➕ 용어 추가</h3>
        <div class="form-grid">
          <label>
            주소 표시(id) <span class="hint-inline">(영어 소문자·숫자·붙임표만)</span>
            <input type="text" id="rg-id" placeholder="예: data-localization" />
          </label>
          <label>
            분류(category) <span class="hint-inline">괄호 안이 한국어 뜻입니다</span>
            <select id="rg-category">
              {
                categoryRows.map((c) => (
                  <option value={c.value}>
                    {c.value}
                    {c.ko ? ` (${c.ko})` : ''}
                  </option>
                ))
              }
            </select>
          </label>
        </div>
        <label class="block">
          용어(term) <span class="hint-inline">러시아어</span>
          <input type="text" id="rg-term" placeholder="напр.: Локализация данных" />
        </label>
        <label class="block">
          뜻(definition) <span class="hint-inline">러시아어</span>
          <textarea id="rg-definition" rows="3"></textarea>
        </label>
        <label class="block">
          왜 중요한가(whyMatters) <span class="hint-inline">러시아어</span>
          <textarea id="rg-why" rows="3"></textarea>
        </label>
        <label class="block">
          출처 주소 <span class="hint-inline">한 줄에 하나씩. 없으면 비워 둡니다</span>
          <textarea id="rg-sources" rows="3" placeholder="https://roszdravnadzor.gov.ru/..."></textarea>
        </label>
        <div class="row">
          <button class="btn" id="rg-save">추가</button>
          <button class="btn ghost" id="rg-cancel" hidden>새 용어 입력으로 돌아가기</button>
        </div>
        <p class="hint save-status" id="rg-status"></p>
      </section>

      <!-- ── 2. FAQ ──────────────────────────────────────── -->
      <section class="panel" id="rf-panel">
        <div class="panel-head">
          <h2>❓ 자주 묻는 질문 (Частые вопросы)</h2>
          <button class="btn ghost" id="rf-refresh">새로고침</button>
        </div>
        <p class="section-desc">
          러시아어판 <code>/ru/faq/</code>의 질문 목록입니다. 여기 적힌 순서가
          화면 순서입니다.
        </p>
        <p class="warn-box">
          질문을 <strong>중간에 끼워 넣거나 지우면</strong> 각 질문으로 바로
          가는 주소(<code>#q1</code>, <code>#q2</code> …)가 한 칸씩 밀립니다.
          꼭 필요할 때만 하시고, 되도록 맨 뒤에 추가하세요.
        </p>
        <div id="rf-list" class="posts">불러오는 중…</div>

        <h3 class="panel-subhead" id="rf-form-head">➕ 질문 추가</h3>
        <label class="block">
          질문(question) <span class="hint-inline">러시아어</span>
          <textarea id="rf-question" rows="2"></textarea>
        </label>
        <label class="block">
          답변(answer) <span class="hint-inline">러시아어</span>
          <textarea id="rf-answer" rows="6"></textarea>
        </label>
        <label class="block">
          출처 주소 <span class="hint-inline">한 줄에 하나씩. 없으면 비워 둡니다</span>
          <textarea id="rf-sources" rows="3"></textarea>
        </label>
        <div class="row">
          <button class="btn" id="rf-save">추가</button>
          <button class="btn ghost" id="rf-cancel" hidden>새 질문 입력으로 돌아가기</button>
        </div>
        <p class="hint save-status" id="rf-status"></p>
      </section>

      <!-- ── 3. 본문 페이지 ──────────────────────────────── -->
      <section class="panel" id="rp-panel">
        <h2>📄 본문 페이지</h2>
        <p class="section-desc">
          먼저 고칠 페이지를 고르고, 그 안의 항목(섹션)을 하나씩 편집합니다.
        </p>
        <div class="row">
          <label style="flex:1 1 18rem">
            페이지 선택
            <select id="rp-page">
              <option value="">— 고르세요 —</option>
              <option value="guide">С чего начать (입문 가이드)</option>
              <option value="checklist">Чек-лист внедрения (도입 체크리스트)</option>
              <option value="tips">Практические советы (실무 팁)</option>
            </select>
          </label>
          <button class="btn ghost" id="rp-refresh">새로고침</button>
        </div>

        <div id="rp-body" hidden>
          <h3 class="panel-subhead">페이지 제목·안내문</h3>
          <div class="form-grid">
            <label>
              브라우저 제목(title)
              <input type="text" id="rp-meta-title" />
            </label>
            <label>
              화면 큰 제목(pageTitle)
              <input type="text" id="rp-meta-pagetitle" />
            </label>
          </div>
          <label class="block">
            검색결과 설명(description)
            <textarea id="rp-meta-description" rows="2"></textarea>
          </label>
          <label class="block">
            첫머리 안내문(lead)
            <textarea id="rp-meta-lead" rows="3"></textarea>
          </label>
          <div class="row">
            <button class="btn" id="rp-meta-save">제목·안내문 저장</button>
          </div>
          <p class="hint save-status" id="rp-meta-status"></p>

          <h3 class="panel-subhead">항목(섹션) 목록</h3>
          <p class="section-desc">
            순서를 바꾸면 <code>/ru/guide/#s1</code> 같은 항목별 주소가
            달라집니다. 꼭 필요할 때만 옮기세요.
          </p>
          <div id="rp-sections" class="posts"></div>
          <div class="row">
            <button class="btn ghost" id="rp-add">➕ 맨 뒤에 항목 추가</button>
          </div>
          <p class="hint save-status" id="rp-status"></p>

          <div id="rp-editor" class="editor" hidden>
            <h3><span id="rp-editor-name"></span></h3>
            <label class="block">
              소제목(heading) <span class="hint-inline">러시아어</span>
              <input type="text" id="rp-heading" />
            </label>
            <label class="block">
              설명글(body) <span class="hint-inline">비워도 됩니다</span>
              <textarea id="rp-body-text" rows="4"></textarea>
            </label>
            <label class="block">
              목록 항목(items) <span class="hint-inline">한 줄에 하나씩. 없으면 비워 둡니다</span>
              <textarea id="rp-items" rows="8"></textarea>
            </label>
            <div class="row">
              <button class="btn" id="rp-editor-save">저장</button>
              <button class="btn ghost" id="rp-editor-cancel">닫기</button>
            </div>
            <p class="hint save-status" id="rp-editor-status"></p>
          </div>
        </div>
      </section>

      <!-- ── 4. 추천 영상 ─────────────────────────────────── -->
      <section class="panel" id="rv-panel">
        <div class="panel-head">
          <h2>🎬 추천 영상 (Рекомендуемые видео)</h2>
          <button class="btn ghost" id="rv-refresh">새로고침</button>
        </div>
        <p class="section-desc">
          러시아어판 <code>/ru/videos/</code>에 나오는 영상 목록입니다. 전부
          연구소장이 직접 만든 한국어 음성 영상(12강)이고, 여기서는
          <strong>러시아어 제목·설명만</strong> 고칩니다. 영상을 추가·삭제하는
          기능은 아직 없습니다(한국어판에 새 "직접 만든 영상"이 생기면
          개발자에게 요청하세요).
        </p>
        <div id="rv-list" class="posts">불러오는 중…</div>

        <div id="rv-editor" class="editor" hidden>
          <h3>영상 수정: <span id="rv-editor-name"></span></h3>
          <label class="block">
            러시아어 제목
            <input type="text" id="rv-edit-title" />
          </label>
          <label class="block">
            러시아어 설명 <span class="hint-inline">비워도 됩니다</span>
            <textarea id="rv-edit-note" rows="3"></textarea>
          </label>
          <div class="row">
            <button class="btn" id="rv-edit-save">저장</button>
            <button class="btn ghost" id="rv-edit-cancel">닫기</button>
          </div>
          <p class="hint save-status" id="rv-edit-status"></p>
        </div>
      </section>

      <!-- ── 5. 상단 메뉴 표시 ────────────────────────────── -->
      <section class="panel" id="rn-panel">
        <div class="panel-head">
          <h2>🧭 상단 메뉴 표시</h2>
          <button class="btn ghost" id="rn-refresh">새로고침</button>
        </div>
        <p class="section-desc">
          러시아어판 화면 <strong>맨 위 메뉴줄</strong>에 어떤 분야를 보여줄지만
          정하는 설정입니다. 체크를 풀면 그 항목이 <strong>메뉴줄에서만</strong>
          사라집니다.
        </p>
        <p class="warn-box">
          ⚠️ <strong>이것은 "페이지 내리기"가 아닙니다.</strong> 체크를 풀어도
          페이지 자체와 사이트맵 등록은 그대로 남습니다. 정말로 검색에 안
          나오게 하고 싶다면 개발자에게 알려 주세요.
        </p>
        <p class="warn-box">홈(Главная)은 러시아어판의 입구라 끌 수 없습니다.</p>
        <div id="rn-list" class="posts">불러오는 중…</div>
        <div class="row">
          <button class="btn" id="rn-save">저장</button>
        </div>
        <p class="hint save-status" id="rn-status"></p>
      </section>

      <!-- ── 6. 사이트 반영 상태 ─────────────────────────── -->
      <section class="panel" id="rs-panel">
        <div class="panel-head">
          <h2>🚀 사이트 반영 상태</h2>
          <button class="btn ghost" id="rs-refresh">새로고침</button>
        </div>
        <p class="section-desc">
          저장한 내용이 실제 사이트에 반영되는 과정입니다. ✅ 성공이 뜨면
          반영이 끝난 것입니다. ⏳ 진행 중이면 잠시 후 '새로고침'을 눌러
          주세요.
        </p>
        <div id="rs-runs" class="runs">불러오는 중…</div>
      </section>

      <!-- ── 7. GitHub 연동 ─────────────────────────────── -->
      <section class="panel" id="rt-panel">
        <h2>🔑 GitHub 연동</h2>
        <p class="section-desc">
          러시아어판 내용을 저장하려면 GitHub 토큰이 필요합니다. 한국어판이나
          일본어판 관리자에서 이미 저장해 두었다면 여기서는 아무것도 하지
          않아도 됩니다 — 같은 토큰을 함께 씁니다.
        </p>
        <p class="status-line" id="token-status">
          <span class="dot dot-off"></span>확인 중…
        </p>
        <div class="row">
          <input
            type="password"
            id="token-input"
            placeholder="GitHub Fine-grained 토큰 (github_pat_...)"
            autocomplete="off"
          />
          <button class="btn" id="token-save">저장</button>
        </div>
        <details>
          <summary>토큰 만드는 방법 (처음 한 번)</summary>
          <ol>
            <li>GitHub 로그인 → 우측 상단 프로필 → <strong>Settings</strong></li>
            <li>
              왼쪽 맨 아래 <strong>Developer settings → Personal access tokens
              → Fine-grained tokens → Generate new token</strong>
            </li>
            <li>Repository access: <strong>Only select repositories → hospital-ai-lab</strong></li>
            <li>
              Permissions → Repository permissions에서
              <strong>Contents: Read and write</strong>, <strong>Actions: Read-only</strong>로 설정
            </li>
            <li>Generate token 후 생성된 <code>github_pat_...</code> 값을 위 칸에 붙여넣고 저장</li>
          </ol>
        </details>
      </section>
    </div>

    <!-- 분류(category)의 러시아어/한국어 대응표 -->
    <template
      id="ru-category-ko"
      data-values={categoryRows.map((c) => `${c.value}\t${c.ko}`).join('\n')}
    ></template>
    <!-- 메뉴 항목의 러시아어/한국어 이름 대응표 -->
    <template
      id="ru-nav-labels"
      data-values={navRows.map((n) => `${n.key}\t${n.ru}\t${n.ko}`).join('\n')}
    ></template>
  </div>
</BaseLayout>

<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, ADMIN_EMAIL }}>
  // 로그인 + GitHub 토큰 불러오기 + 탭 전환.
  // define:vars를 쓰므로 이 스크립트는 반드시 is:inline(번들 불가, 순수 JS)이다.
  (async () => {
    if (!SUPABASE_URL || !document.getElementById('admin-login-gate')) return;
    const { createClient } = await import(
      'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.0/+esm'
    );
    const sb = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    const $ = (id) => document.getElementById(id);

    function updateTokenPanelUI() {
      const el = $('token-status');
      if (!el) return;
      el.innerHTML = window.__adminGithubToken
        ? '<span class="dot dot-on"></span>GitHub 연동되어 있습니다. 어느 기기에서 로그인해도 그대로 적용됩니다.'
        : '<span class="dot dot-off"></span>아직 GitHub 토큰이 없습니다. 아래에 붙여넣고 저장하세요.';
    }

    async function loadGithubToken() {
      const { data, error } = await sb
        .from('admin_secrets')
        .select('value')
        .eq('key', 'github_pat')
        .maybeSingle();
      window.__adminGithubToken = error ? '' : (data && data.value) || '';
      updateTokenPanelUI();
      if (error && $('token-status')) {
        $('token-status').textContent =
          '연동 상태 확인 실패: ' +
          (error.message || '') +
          ' — 저장소의 supabase/setup.sql을 Supabase 대시보드 → SQL Editor에 붙여넣고 한 번 실행하면 해결되는 경우가 많습니다.';
      }
    }

    async function saveGithubToken() {
      const status = $('token-status');
      const v = $('token-input').value.trim();
      if (!v) return;
      const { error } = await sb
        .from('admin_secrets')
        .upsert({ key: 'github_pat', value: v, updated_at: new Date().toISOString() });
      if (error) {
        status.textContent = '저장 실패: ' + (error.message || '');
        return;
      }
      window.__adminGithubToken = v;
      $('token-input').value = '';
      updateTokenPanelUI();
      window.dispatchEvent(new CustomEvent('admin-github-token-ready'));
    }

    function initAdminTabs() {
      const navLinks = [...document.querySelectorAll('.admin-nav a[data-tab]')];
      const panels = navLinks
        .map((a) => document.getElementById(a.dataset.tab))
        .filter(Boolean);

      function showTab(id) {
        panels.forEach((p) => {
          p.hidden = p.id !== id;
        });
        navLinks.forEach((a) => a.classList.toggle('active', a.dataset.tab === id));
      }

      navLinks.forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          showTab(a.dataset.tab);
          history.replaceState(null, '', '#' + a.dataset.tab);
        });
      });

      const fromHash = location.hash.slice(1);
      const initial = panels.some((p) => p.id === fromHash)
        ? fromHash
        : panels[0] && panels[0].id;
      if (initial) showTab(initial);
    }

    async function showAdminIfLoggedIn() {
      const {
        data: { session },
      } = await sb.auth.getSession();
      const isAdmin = session && session.user.email === ADMIN_EMAIL;
      $('admin-login-gate').hidden = !!isAdmin;
      $('admin-dashboard').hidden = !isAdmin;
      if (isAdmin) {
        await loadGithubToken();
        window.dispatchEvent(new CustomEvent('admin-ready'));
      }
    }

    $('gate-login-btn').addEventListener('click', async () => {
      const status = $('gate-status');
      status.textContent = '로그인 중…';
      const { data, error } = await sb.auth.signInWithPassword({
        email: $('gate-email').value.trim(),
        password: $('gate-password').value,
      });
      if (error) {
        status.textContent = '로그인 실패: 이메일 또는 비밀번호를 확인하세요.';
        return;
      }
      if (data.user.email !== ADMIN_EMAIL) {
        status.textContent = '관리자 계정이 아닙니다.';
        await sb.auth.signOut();
        return;
      }
      status.textContent = '';
      $('gate-password').value = '';
      showAdminIfLoggedIn();
    });

    $('gate-password').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') $('gate-login-btn').click();
    });

    $('admin-logout').addEventListener('click', async () => {
      await sb.auth.signOut();
      window.__adminGithubToken = '';
      showAdminIfLoggedIn();
    });

    $('token-save').addEventListener('click', saveGithubToken);

    initAdminTabs();
    showAdminIfLoggedIn();
  })();
</script>

<script is:inline>
  // sticky 탭 바가 사이트 헤더에 가리지 않도록 헤더 실측 높이를 CSS 변수로 반영.
  (() => {
    const header = document.querySelector('.site-header');
    if (!header || typeof ResizeObserver === 'undefined') return;
    const apply = () =>
      document.documentElement.style.setProperty(
        '--site-header-h',
        header.offsetHeight + 'px'
      );
    new ResizeObserver(apply).observe(header);
    apply();
  })();
</script>

<script>
  // ── 공통 ────────────────────────────────────────────────
  const REPO = 'BuminAI/hospital-ai-lab';
  const API = `https://api.github.com/repos/${REPO}`;

  const P = {
    nav: 'src/data/ru/content/nav.json',
    glossary: 'src/data/ru/content/glossary.json',
    faq: 'src/data/ru/content/faq.json',
    guide: 'src/data/ru/content/guide.json',
    checklist: 'src/data/ru/content/checklist.json',
    tips: 'src/data/ru/content/tips.json',
    videos: 'src/data/ru/content/videos.json',
  };

  const APPLIED = ' 사이트에 반영되기까지 2~3분 걸립니다.';

  const $ = (id: string) => document.getElementById(id) as any;

  function getToken(): string {
    return (window as any).__adminGithubToken || '';
  }

  async function gh(path: string, options: RequestInit = {}) {
    const token = getToken();
    if (!token)
      throw new Error(
        "아직 GitHub 연동이 안 됐습니다. 위 탭에서 'GitHub 연동'을 눌러 토큰을 저장하면 이 목록이 나타납니다."
      );
    const res = await fetch(`${API}${path}`, {
      ...options,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28',
        ...(options.headers || {}),
      },
    });
    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      const reason = body.message ? ` (GitHub: ${body.message})` : '';
      if (res.status === 401)
        throw new Error(`토큰이 유효하지 않습니다. 새 토큰을 설정하세요.${reason}`);
      if (res.status === 403)
        throw new Error(
          `권한이 없습니다(403). 토큰 설정에서 저장소 선택(hospital-ai-lab)과 권한(Contents: Read and write, Actions: Read-only)을 확인하세요.${reason}`
        );
      if (res.status === 404)
        throw new Error(`찾을 수 없습니다(404). 토큰의 저장소 권한을 확인하세요.${reason}`);
      throw new Error(`GitHub API 오류 ${res.status}: ${body.message || ''}`);
    }
    return res.status === 204 ? null : res.json();
  }

  // UTF-8 안전 base64 (러시아어·한글 등 멀티바이트 처리). 한 글자도 바꾸지 말 것.
  function b64encode(str: string): string {
    const bytes = new TextEncoder().encode(str);
    let bin = '';
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin);
  }

  function b64decode(b64: string): string {
    const bin = atob(b64.replace(/\n/g, ''));
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }

  function esc(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // ── JSON 파일 읽기·쓰기 ─────────────────────────────────
  type Loaded = { sha: string; data: any };

  async function loadJson(path: string): Promise<Loaded> {
    const file = await gh(`/contents/${path}`);
    const raw = b64decode(file.content);
    let data: any;
    try {
      data = JSON.parse(raw);
    } catch (e: any) {
      throw new Error(
        `저장소의 ${path} 파일이 올바른 JSON 형식이 아닙니다. 이 화면에서는 고칠 수 없으니 개발자에게 알려 주세요. (원래 오류: ${e.message})`
      );
    }
    return { sha: file.sha, data };
  }

  /**
   * 저장 직전에 파일을 다시 읽어 sha가 그대로인지 확인한다.
   * 그 사이 다른 사람이나 자동 수집이 같은 파일을 바꿨으면
   * **덮어쓰지 않고** 한국어 안내와 함께 중단한다.
   */
  async function saveJson(
    path: string,
    data: any,
    expectedSha: string,
    message: string
  ): Promise<string> {
    const fresh = await gh(`/contents/${path}`);
    if (fresh.sha !== expectedSha) {
      throw new Error(
        '저장하지 않았습니다 — 이 화면을 연 뒤에 같은 파일이 다른 곳에서 바뀌었습니다. ' +
          '그대로 저장하면 그 변경분이 지워지므로 중단했습니다. ' +
          "'새로고침'을 눌러 최신 내용을 불러온 뒤 다시 고쳐 주세요."
      );
    }
    const res = await gh(`/contents/${path}`, {
      method: 'PUT',
      body: JSON.stringify({
        message,
        content: b64encode(JSON.stringify(data, null, 2) + '\n'),
        sha: expectedSha,
      }),
    });
    return res.content.sha as string;
  }

  // ── 검증 도우미 ─────────────────────────────────────────
  // 여기서 막지 못한 값은 빌드를 깨뜨리고, 빌드가 깨지면 러시아어판뿐 아니라
  // 한국어판까지 갱신이 멈춘다. 그래서 "저장 전에 막는다"가 원칙이다.

  function req(value: string, label: string): string | null {
    return value.trim() ? null : `${label}을(를) 입력하세요. 비워 둘 수 없습니다.`;
  }

  /**
   * 자유 입력 칸(제목·뜻·답변 등)에 HTML 조각이 섞이는 것을 막는다.
   *
   * ⚠️ 지우지 말 것 — 보안 장치다. 여기 적는 글은 러시아어판 페이지의
   *    구조화 데이터(검색엔진용 JSON) 안에도 그대로 실린다. 거기에 스크립트
   *    닫는 태그가 들어가면 그 자리에서 페이지의 스크립트가 끊기고, 뒤에
   *    이어 붙인 내용이 방문자의 브라우저에서 실제로 실행되어 버린다.
   */
  const CLOSE_TAG = '<' + '/script';
  const HTML_TAGISH_RE = /<\s*\/?\s*[a-zA-Z!/]/;
  const CLOSE_TAG_RE = new RegExp('<\\s*/\\s*script', 'i');

  function checkText(value: string, label: string): string | null {
    if (CLOSE_TAG_RE.test(value)) {
      return `${label}에 "${CLOSE_TAG}" 라는 글자가 들어 있어 저장하지 않았습니다. 이 글자가 들어가면 러시아어판 페이지가 깨지고 위험한 내용이 실행될 수 있습니다. 꺾쇠(<, >)를 지워 주세요.`;
    }
    if (HTML_TAGISH_RE.test(value)) {
      return `${label}에 "<" 로 시작하는 태그 같은 글자가 들어 있어 저장하지 않았습니다. 러시아어판은 글자만 받고 HTML 태그는 받지 않습니다. 꺾쇠(<)를 지워 주세요.`;
    }
    return null;
  }

  function checkTexts(pairs: [string, string][]): string | null {
    for (const [v, label] of pairs) {
      const e = checkText(v, label);
      if (e) return e;
    }
    return null;
  }

  function parseLines(text: string): string[] {
    return text
      .split('\n')
      .map((s) => s.trim())
      .filter(Boolean);
  }

  /** 출처 주소 검증: http(s)로 시작하는 절대 주소만 허용 */
  function checkSources(list: string[]): string | null {
    for (const s of list) {
      if (!/^https?:\/\//i.test(s)) {
        return `출처 주소 "${s}" 는 http:// 또는 https:// 로 시작해야 합니다. 브라우저 주소창의 주소를 앞부분까지 통째로 복사해 붙여넣어 주세요. (이대로 저장하면 사이트 전체가 만들어지지 않습니다)`;
      }
      try {
        new URL(s);
      } catch {
        return `출처 주소 "${s}" 를 주소로 읽을 수 없습니다. 공백이나 빠진 글자가 없는지 확인해 주세요.`;
      }
    }
    return null;
  }

  const GLOSSARY_ID_RE = /^[a-z0-9]+(-[a-z0-9]+)*$/;

  // ── 화면 표시 도우미 ────────────────────────────────────
  function ok(id: string, msg: string) {
    const el = $(id);
    el.classList.remove('bad');
    el.textContent = msg;
  }

  function bad(id: string, msg: string) {
    const el = $(id);
    el.classList.add('bad');
    el.textContent = msg;
  }

  function appendNote(id: string, msg: string) {
    const el = $(id);
    el.classList.add('bad');
    el.textContent = (el.textContent ? el.textContent + ' ' : '') + msg;
  }

  const REOPEN = "다시 '수정'을 눌러 주세요. (입력하던 내용은 저장되지 않았습니다)";

  /** 저장 버튼 이중 클릭 잠금 */
  function lock(btnId: string, fn: () => Promise<void>) {
    $(btnId).addEventListener('click', async () => {
      const btn = $(btnId);
      if (btn.disabled) return;
      btn.disabled = true;
      try {
        await fn();
      } finally {
        btn.disabled = false;
      }
    });
  }

  function setAdminSummary(key: string, text: string) {
    const el = document.getElementById('admin-summary');
    if (!el) return;
    el.dataset[key] = text;
    el.textContent = [el.dataset.deploy].filter(Boolean).join(' · ');
  }

  /** 항목을 배열 안에서 위/아래로 옮긴다. 옮길 수 없으면 false */
  function moveItem(arr: any[], i: number, dir: number): boolean {
    const j = i + dir;
    if (j < 0 || j >= arr.length) return false;
    const [x] = arr.splice(i, 1);
    arr.splice(j, 0, x);
    return true;
  }

  // 분류(category)의 러시아어/한국어 대응표
  const CATEGORIES: string[] = (() => {
    const tpl = document.getElementById('ru-category-ko');
    const raw = tpl ? (tpl as HTMLElement).dataset.values || '' : '';
    return raw
      .split('\n')
      .filter(Boolean)
      .map((line) => line.split('\t')[0]);
  })();

  const CATEGORY_KO: Record<string, string> = {};
  {
    const tpl = document.getElementById('ru-category-ko');
    const raw = tpl ? (tpl as HTMLElement).dataset.values || '' : '';
    raw
      .split('\n')
      .filter(Boolean)
      .forEach((line) => {
        const [ru, ko] = line.split('\t');
        if (ru) CATEGORY_KO[ru] = ko || '';
      });
  }

  function categoryLabel(c: string): string {
    const ko = CATEGORY_KO[c];
    return ko ? `${c} (${ko})` : c;
  }

  // 메뉴 항목의 러시아어/한국어 이름 대응표
  const NAV_LABELS: Record<string, { ru: string; ko: string }> = {};
  {
    const tpl = document.getElementById('ru-nav-labels');
    const raw = tpl ? (tpl as HTMLElement).dataset.values || '' : '';
    raw
      .split('\n')
      .filter(Boolean)
      .forEach((line) => {
        const [key, ruLabel, koLabel] = line.split('\t');
        if (key) NAV_LABELS[key] = { ru: ruLabel, ko: koLabel };
      });
  }

  // ══ 1. 용어집 ═════════════════════════════════════════
  let rgSha = '';
  let rgTerms: any[] = [];
  let rgEditIndex = -1; // -1 = 새 용어 추가
  let rgEditId = '';

  async function loadGlossary() {
    const el = $('rg-list');
    el.textContent = '불러오는 중…';
    try {
      const { sha, data } = await loadJson(P.glossary);
      if (!Array.isArray(data)) throw new Error('glossary.json 이 목록(배열) 형태가 아닙니다.');
      rgSha = sha;
      rgTerms = data;
      rgResyncEditor();
      el.innerHTML =
        data
          .map(
            (t: any, i: number) => `
        <div class="post-row">
          <span class="post-title">${esc(t.term)}</span>
          <span class="post-file">${esc(categoryLabel(t.category))} · id: ${esc(t.id)}</span>
          <span class="post-actions">
            <button class="btn ghost" data-rgedit="${i}">수정</button>
            <button class="btn ghost danger" data-rgdel="${i}">삭제</button>
          </span>
        </div>`
          )
          .join('') || '<p class="hint">아직 등록된 용어가 없습니다.</p>';
      el.querySelectorAll('[data-rgedit]').forEach((b: any) =>
        b.addEventListener('click', () => rgOpen(Number(b.dataset.rgedit)))
      );
      el.querySelectorAll('[data-rgdel]').forEach((b: any) =>
        b.addEventListener('click', () => rgDelete(Number(b.dataset.rgdel)))
      );
    } catch (e: any) {
      el.textContent = e.message;
    }
  }

  function rgResyncEditor() {
    if (rgEditIndex < 0) return;
    const i = rgTerms.findIndex((t: any) => t.id === rgEditId);
    if (i < 0) {
      rgReset();
      appendNote(
        'rg-status',
        '※ 수정 중이던 용어가 목록에서 사라져 입력칸을 새 용어 추가로 되돌렸습니다. (입력하던 내용은 저장되지 않았습니다)'
      );
      return;
    }
    rgEditIndex = i;
  }

  function rgOpen(i: number) {
    rgEditIndex = i;
    const t = rgTerms[i];
    rgEditId = t.id;
    $('rg-form-head').textContent = `✏️ 용어 수정: ${t.term}`;
    $('rg-id').value = t.id;
    $('rg-id').disabled = true;
    $('rg-category').value = t.category;
    $('rg-term').value = t.term;
    $('rg-definition').value = t.definition || '';
    $('rg-why').value = t.whyMatters || '';
    $('rg-sources').value = (t.sources || []).join('\n');
    $('rg-save').textContent = '수정 저장';
    $('rg-cancel').hidden = false;
    ok('rg-status', '');
    $('rg-form-head').scrollIntoView({ block: 'start' });
  }

  function rgReset() {
    rgEditIndex = -1;
    rgEditId = '';
    $('rg-form-head').textContent = '➕ 용어 추가';
    $('rg-id').value = '';
    $('rg-id').disabled = false;
    $('rg-category').selectedIndex = 0;
    $('rg-term').value = '';
    $('rg-definition').value = '';
    $('rg-why').value = '';
    $('rg-sources').value = '';
    $('rg-save').textContent = '추가';
    $('rg-cancel').hidden = true;
  }

  $('rg-cancel').addEventListener('click', () => {
    rgReset();
    ok('rg-status', '');
  });

  lock('rg-save', async () => {
    const isNew = rgEditIndex < 0;
    const id = $('rg-id').value.trim();
    const category = $('rg-category').value;
    const term = $('rg-term').value.trim();
    const definition = $('rg-definition').value.trim();
    const whyMatters = $('rg-why').value.trim();
    const sources = parseLines($('rg-sources').value);

    if (!isNew) {
      const target = rgTerms[rgEditIndex];
      if (!target || target.id !== rgEditId) {
        bad(
          'rg-status',
          `수정을 시작한 뒤 용어 목록이 바뀌었습니다. 엉뚱한 용어를 덮어쓰지 않도록 저장하지 않았습니다. '새로고침'을 누른 뒤 ${REOPEN}`
        );
        return;
      }
    }
    if (isNew) {
      if (!id) {
        bad('rg-status', '주소 표시(id)를 입력하세요. 이 용어로 바로 가는 주소가 됩니다.');
        return;
      }
      if (!GLOSSARY_ID_RE.test(id)) {
        bad(
          'rg-status',
          `주소 표시(id) "${id}" 는 쓸 수 없습니다. 영어 소문자와 숫자, 붙임표(-)만 쓸 수 있습니다. (예: data-localization)`
        );
        return;
      }
      if (rgTerms.some((t: any) => t.id === id)) {
        bad(
          'rg-status',
          `주소 표시(id) "${id}" 는 이미 다른 용어가 쓰고 있습니다. 다른 id를 지어 주세요.`
        );
        return;
      }
    }
    if (!CATEGORIES.includes(category)) {
      bad(
        'rg-status',
        `분류(category) "${category}" 는 정해진 3개 값이 아닙니다. 목록에서 골라 주세요. (정해진 값이 아니면 그 용어가 러시아어판 화면에서 조용히 사라집니다)`
      );
      return;
    }
    for (const [v, label] of [
      [term, '용어(term)'],
      [definition, '뜻(definition)'],
      [whyMatters, '왜 중요한가(whyMatters)'],
    ] as [string, string][]) {
      const e = req(v, label);
      if (e) {
        bad('rg-status', e);
        return;
      }
    }
    const textErr = checkTexts([
      [term, '용어(term)'],
      [definition, '뜻(definition)'],
      [whyMatters, '왜 중요한가(whyMatters)'],
    ]);
    if (textErr) {
      bad('rg-status', textErr);
      return;
    }
    const srcErr = checkSources(sources);
    if (srcErr) {
      bad('rg-status', srcErr);
      return;
    }

    try {
      ok('rg-status', '저장 중…');
      const entry = { id, term, category, definition, whyMatters, sources };
      let next: any[];
      if (isNew) {
        next = [...rgTerms, entry];
      } else {
        next = rgTerms.map((t: any, i: number) => (i === rgEditIndex ? { ...entry, id: t.id } : t));
      }
      rgSha = await saveJson(
        P.glossary,
        next,
        rgSha,
        `수정: 러시아어판 용어집 ${isNew ? '추가' : '수정'} - ${term}`
      );
      ok('rg-status', (isNew ? '용어를 추가했습니다.' : '용어를 수정했습니다.') + APPLIED);
      rgReset();
      loadGlossary();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('rg-status', e.message);
    }
  });

  async function rgDelete(i: number) {
    const t = rgTerms[i];
    if (
      !confirm(
        `용어를 지웁니다.\n\n${t.term} (id: ${t.id})\n\n이 용어로 바로 가던 주소 /ru/glossary/#${t.id} 도 함께 사라집니다.\n계속할까요?`
      )
    )
      return;
    if (prompt('확인을 위해 "삭제"라고 입력하세요') !== '삭제') return;
    try {
      ok('rg-status', '삭제 중…');
      const { sha, data } = await loadJson(P.glossary);
      const idx = data.findIndex((x: any) => x.id === t.id);
      if (idx < 0) throw new Error("이미 지워진 용어입니다. '새로고침'을 눌러 주세요.");
      data.splice(idx, 1);
      rgSha = await saveJson(P.glossary, data, sha, `수정: 러시아어판 용어집 삭제 - ${t.term}`);
      ok('rg-status', '삭제했습니다.' + APPLIED);
      loadGlossary();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('rg-status', e.message);
    }
  }

  $('rg-refresh').addEventListener('click', loadGlossary);

  // ══ 2. 자주 묻는 질문 ═════════════════════════════════
  let rfSha = '';
  let rfItems: any[] = [];
  let rfEditIndex = -1;
  let rfEditQuestion = '';

  async function loadFaq() {
    const el = $('rf-list');
    el.textContent = '불러오는 중…';
    try {
      const { sha, data } = await loadJson(P.faq);
      if (!Array.isArray(data)) throw new Error('faq.json 이 목록(배열) 형태가 아닙니다.');
      rfSha = sha;
      rfItems = data;
      rfResyncEditor();
      el.innerHTML =
        data
          .map(
            (q: any, i: number) => `
        <div class="post-row">
          <span class="post-title">${esc(q.question)}</span>
          <span class="post-file">#q${i + 1}</span>
          <span class="post-actions">
            <button class="btn ghost tiny" data-rfmove="${i}" data-dir="-1" ${i === 0 ? 'disabled' : ''} title="위로">↑</button>
            <button class="btn ghost tiny" data-rfmove="${i}" data-dir="1" ${i === data.length - 1 ? 'disabled' : ''} title="아래로">↓</button>
            <button class="btn ghost" data-rfedit="${i}">수정</button>
            <button class="btn ghost danger" data-rfdel="${i}">삭제</button>
          </span>
        </div>`
          )
          .join('') || '<p class="hint">아직 등록된 질문이 없습니다.</p>';
      el.querySelectorAll('[data-rfmove]').forEach((b: any) =>
        b.addEventListener('click', () => rfMove(Number(b.dataset.rfmove), Number(b.dataset.dir)))
      );
      el.querySelectorAll('[data-rfedit]').forEach((b: any) =>
        b.addEventListener('click', () => rfOpen(Number(b.dataset.rfedit)))
      );
      el.querySelectorAll('[data-rfdel]').forEach((b: any) =>
        b.addEventListener('click', () => rfDelete(Number(b.dataset.rfdel)))
      );
    } catch (e: any) {
      el.textContent = e.message;
    }
  }

  function rfResyncEditor() {
    if (rfEditIndex < 0) return;
    const i = rfItems.findIndex((q: any) => q.question === rfEditQuestion);
    if (i < 0) {
      rfReset();
      appendNote(
        'rf-status',
        '※ 수정 중이던 질문이 목록에서 사라져 입력칸을 새 질문 추가로 되돌렸습니다. (입력하던 내용은 저장되지 않았습니다)'
      );
      return;
    }
    if (i !== rfEditIndex) {
      rfEditIndex = i;
      $('rf-form-head').textContent = `✏️ 질문 수정 (#q${i + 1})`;
      appendNote('rf-status', '※ 수정 중이던 질문의 위치가 바뀌어 입력칸을 그 질문에 다시 맞췄습니다.');
    }
  }

  function rfOpen(i: number) {
    rfEditIndex = i;
    const q = rfItems[i];
    rfEditQuestion = q.question;
    $('rf-form-head').textContent = `✏️ 질문 수정 (#q${i + 1})`;
    $('rf-question').value = q.question || '';
    $('rf-answer').value = q.answer || '';
    $('rf-sources').value = (q.sources || []).join('\n');
    $('rf-save').textContent = '수정 저장';
    $('rf-cancel').hidden = false;
    ok('rf-status', '');
    $('rf-form-head').scrollIntoView({ block: 'start' });
  }

  function rfReset() {
    rfEditIndex = -1;
    rfEditQuestion = '';
    $('rf-form-head').textContent = '➕ 질문 추가';
    $('rf-question').value = '';
    $('rf-answer').value = '';
    $('rf-sources').value = '';
    $('rf-save').textContent = '추가';
    $('rf-cancel').hidden = true;
  }

  $('rf-cancel').addEventListener('click', () => {
    rfReset();
    ok('rf-status', '');
  });

  lock('rf-save', async () => {
    const isNew = rfEditIndex < 0;
    const question = $('rf-question').value.trim();
    const answer = $('rf-answer').value.trim();
    const sources = parseLines($('rf-sources').value);

    if (!isNew) {
      const target = rfItems[rfEditIndex];
      if (!target || target.question !== rfEditQuestion) {
        bad(
          'rf-status',
          `수정을 시작한 뒤 질문 목록이 바뀌었습니다. 엉뚱한 질문을 덮어쓰지 않도록 저장하지 않았습니다. '새로고침'을 누른 뒤 ${REOPEN}`
        );
        return;
      }
    }
    for (const [v, label] of [
      [question, '질문(question)'],
      [answer, '답변(answer)'],
    ] as [string, string][]) {
      const e = req(v, label);
      if (e) {
        bad('rf-status', e);
        return;
      }
    }
    const textErr = checkTexts([
      [question, '질문(question)'],
      [answer, '답변(answer)'],
    ]);
    if (textErr) {
      bad('rf-status', textErr);
      return;
    }
    const srcErr = checkSources(sources);
    if (srcErr) {
      bad('rf-status', srcErr);
      return;
    }

    try {
      ok('rf-status', '저장 중…');
      const entry = { question, answer, sources };
      const next = isNew
        ? [...rfItems, entry]
        : rfItems.map((q: any, i: number) => (i === rfEditIndex ? entry : q));
      rfSha = await saveJson(P.faq, next, rfSha, `수정: 러시아어판 FAQ ${isNew ? '추가' : '수정'}`);
      ok('rf-status', (isNew ? `맨 뒤(#q${next.length})에 추가했습니다.` : '수정했습니다.') + APPLIED);
      rfReset();
      loadFaq();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('rf-status', e.message);
    }
  });

  async function rfMove(i: number, dir: number) {
    if (
      !confirm(
        '질문의 순서를 바꾸면 각 질문으로 바로 가던 주소(#q1, #q2 …)가 달라집니다.\n다른 곳에 걸어 둔 링크가 다른 질문을 가리키게 될 수 있습니다.\n\n계속할까요?'
      )
    )
      return;
    try {
      const { sha, data } = await loadJson(P.faq);
      if (!data[i] || data[i].question !== rfItems[i].question) {
        throw new Error(
          "그 사이 질문 목록이 다른 곳에서 바뀌었습니다. 엉뚱한 질문을 옮기지 않도록 중단했습니다. '새로고침'을 누른 뒤 다시 해 주세요."
        );
      }
      if (!moveItem(data, i, dir)) return;
      rfSha = await saveJson(P.faq, data, sha, '수정: 러시아어판 FAQ 순서 변경');
      ok('rf-status', '순서를 바꿨습니다.' + APPLIED);
      loadFaq();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('rf-status', e.message);
    }
  }

  async function rfDelete(i: number) {
    const q = rfItems[i];
    if (
      !confirm(
        `질문을 지웁니다.\n\n${q.question}\n\n뒤에 있는 질문들의 주소(#q${i + 2} 이후)가 한 칸씩 앞당겨집니다.\n계속할까요?`
      )
    )
      return;
    if (prompt('확인을 위해 "삭제"라고 입력하세요') !== '삭제') return;
    try {
      ok('rf-status', '삭제 중…');
      const { sha, data } = await loadJson(P.faq);
      if (data.length !== rfItems.length || !data[i] || data[i].question !== q.question) {
        throw new Error(
          "그 사이 질문 목록이 바뀌었습니다. 엉뚱한 질문을 지우지 않도록 중단했습니다. '새로고침'을 눌러 다시 확인해 주세요."
        );
      }
      data.splice(i, 1);
      rfSha = await saveJson(P.faq, data, sha, '수정: 러시아어판 FAQ 삭제');
      ok('rf-status', '삭제했습니다.' + APPLIED);
      loadFaq();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('rf-status', e.message);
    }
  }

  $('rf-refresh').addEventListener('click', loadFaq);

  // ══ 3. 본문 페이지 (guide·checklist) ═══════════════════
  let rpKey = '';
  let rpSha = '';
  let rpData: any = null;
  let rpEditIndex = -1;
  let rpEditHeading = '';

  function rpPath(): string {
    return (P as any)[rpKey];
  }

  async function loadPage() {
    rpKey = $('rp-page').value;
    if (!rpKey) {
      $('rp-body').hidden = true;
      return;
    }
    $('rp-body').hidden = false;
    $('rp-editor').hidden = true;
    rpEditIndex = -1;
    rpEditHeading = '';
    $('rp-sections').textContent = '불러오는 중…';
    try {
      const { sha, data } = await loadJson(rpPath());
      if (!data || typeof data !== 'object' || Array.isArray(data) || !Array.isArray(data.sections)) {
        throw new Error(
          `${rpPath()} 의 형태가 예상과 다릅니다(meta·sections 구조가 아닙니다). 개발자에게 알려 주세요.`
        );
      }
      rpSha = sha;
      rpData = data;
      const m = data.meta || {};
      $('rp-meta-title').value = m.title || '';
      $('rp-meta-pagetitle').value = m.pageTitle || '';
      $('rp-meta-description').value = m.description || '';
      $('rp-meta-lead').value = m.lead || '';
      renderSections();
      ok('rp-status', '');
      ok('rp-meta-status', '');
    } catch (e: any) {
      $('rp-sections').textContent = e.message;
    }
  }

  function rpResyncEditor() {
    if (rpEditIndex < 0) return;
    const i = rpData.sections.findIndex((s: any) => s.heading === rpEditHeading);
    if (i < 0) {
      $('rp-editor').hidden = true;
      rpEditIndex = -1;
      rpEditHeading = '';
      appendNote('rp-status', `※ 수정 중이던 항목이 목록에서 사라져 편집창을 닫았습니다. ${REOPEN}`);
      return;
    }
    if (i !== rpEditIndex) {
      rpEditIndex = i;
      $('rp-editor-name').textContent = `✏️ 항목 수정 (#s${i + 1})`;
      appendNote('rp-status', '※ 수정 중이던 항목의 위치가 바뀌어 편집창을 그 항목에 다시 맞췄습니다.');
    }
  }

  function renderSections() {
    const el = $('rp-sections');
    const secs = rpData.sections;
    rpResyncEditor();
    el.innerHTML =
      secs
        .map(
          (s: any, i: number) => `
      <div class="post-row">
        <span class="post-title">${esc(s.heading)}</span>
        <span class="post-file">#s${i + 1} · 목록 ${Array.isArray(s.items) ? s.items.length : 0}개</span>
        <span class="post-actions">
          <button class="btn ghost tiny" data-rpmove="${i}" data-dir="-1" ${i === 0 ? 'disabled' : ''} title="위로">↑</button>
          <button class="btn ghost tiny" data-rpmove="${i}" data-dir="1" ${i === secs.length - 1 ? 'disabled' : ''} title="아래로">↓</button>
          <button class="btn ghost" data-rpedit="${i}">수정</button>
          <button class="btn ghost danger" data-rpdel="${i}">삭제</button>
        </span>
      </div>`
        )
        .join('') || '<p class="hint">항목이 하나도 없습니다.</p>';
    el.querySelectorAll('[data-rpmove]').forEach((b: any) =>
      b.addEventListener('click', () => rpMove(Number(b.dataset.rpmove), Number(b.dataset.dir)))
    );
    el.querySelectorAll('[data-rpedit]').forEach((b: any) =>
      b.addEventListener('click', () => rpOpen(Number(b.dataset.rpedit)))
    );
    el.querySelectorAll('[data-rpdel]').forEach((b: any) =>
      b.addEventListener('click', () => rpDelete(Number(b.dataset.rpdel)))
    );
  }

  function rpOpen(i: number) {
    rpEditIndex = i;
    const s = i < 0 ? { heading: '', body: '', items: [] } : rpData.sections[i];
    rpEditHeading = i < 0 ? '' : s.heading;
    $('rp-editor-name').textContent = i < 0 ? '➕ 새 항목 추가' : `✏️ 항목 수정 (#s${i + 1})`;
    $('rp-heading').value = s.heading || '';
    $('rp-body-text').value = s.body || '';
    $('rp-items').value = (s.items || []).join('\n');
    ok('rp-editor-status', '');
    $('rp-editor').hidden = false;
    $('rp-editor').scrollIntoView({ block: 'center' });
  }

  $('rp-add').addEventListener('click', () => rpOpen(-1));
  $('rp-editor-cancel').addEventListener('click', () => {
    $('rp-editor').hidden = true;
    rpEditIndex = -1;
    rpEditHeading = '';
  });

  lock('rp-editor-save', async () => {
    const heading = $('rp-heading').value.trim();
    const body = $('rp-body-text').value.trim();
    const items = parseLines($('rp-items').value);

    const e1 = req(heading, '소제목(heading)');
    if (e1) {
      bad('rp-editor-status', e1);
      return;
    }
    if (rpEditIndex >= 0) {
      const target = rpData.sections[rpEditIndex];
      if (!target || target.heading !== rpEditHeading) {
        bad(
          'rp-editor-status',
          `수정을 시작한 뒤 항목 목록이 바뀌었습니다. 엉뚱한 항목을 덮어쓰지 않도록 저장하지 않았습니다. '새로고침'을 누른 뒤 ${REOPEN}`
        );
        return;
      }
    }
    const textErr = checkTexts([
      [heading, '소제목(heading)'],
      [body, '설명글(body)'],
      ...items.map((it, n) => [it, `목록 ${n + 1}번째 줄`] as [string, string]),
    ]);
    if (textErr) {
      bad('rp-editor-status', textErr);
      return;
    }
    try {
      ok('rp-editor-status', '저장 중…');
      const section = { heading, body, items };
      const next = {
        ...rpData,
        sections:
          rpEditIndex < 0
            ? [...rpData.sections, section]
            : rpData.sections.map((s: any, i: number) => (i === rpEditIndex ? section : s)),
      };
      rpSha = await saveJson(
        rpPath(),
        next,
        rpSha,
        `수정: 러시아어판 ${rpKey} 항목 ${rpEditIndex < 0 ? '추가' : '수정'} - ${heading}`
      );
      rpData = next;
      ok('rp-editor-status', (rpEditIndex < 0 ? '맨 뒤에 항목을 추가했습니다.' : '항목을 저장했습니다.') + APPLIED);
      $('rp-editor').hidden = true;
      rpEditIndex = -1;
      rpEditHeading = '';
      renderSections();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('rp-editor-status', e.message);
    }
  });

  async function rpMove(i: number, dir: number) {
    if (
      !confirm(
        `항목 순서를 바꾸면 항목별 주소(/ru/${rpKey}/#s1 등)가 달라집니다.\n다른 곳에 걸어 둔 링크가 다른 항목을 가리키게 될 수 있습니다.\n\n계속할까요?`
      )
    )
      return;
    try {
      const { sha, data } = await loadJson(rpPath());
      if (!data.sections[i] || data.sections[i].heading !== rpData.sections[i].heading) {
        throw new Error(
          "그 사이 항목 목록이 다른 곳에서 바뀌었습니다. 엉뚱한 항목을 옮기지 않도록 중단했습니다. '새로고침'을 누른 뒤 다시 해 주세요."
        );
      }
      if (!moveItem(data.sections, i, dir)) return;
      rpSha = await saveJson(rpPath(), data, sha, `수정: 러시아어판 ${rpKey} 항목 순서 변경`);
      rpData = data;
      ok('rp-status', '순서를 바꿨습니다.' + APPLIED);
      renderSections();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('rp-status', e.message);
    }
  }

  async function rpDelete(i: number) {
    const s = rpData.sections[i];
    if (rpData.sections.length <= 1) {
      bad('rp-status', '마지막 남은 항목은 지울 수 없습니다. 내용이 없는 페이지가 됩니다.');
      return;
    }
    if (
      !confirm(
        `항목을 지웁니다.\n\n${s.heading}\n(목록 ${(s.items || []).length}개도 함께 사라집니다)\n\n뒤에 있는 항목들의 주소(#s${i + 2} 이후)도 한 칸씩 앞당겨집니다.\n계속할까요?`
      )
    )
      return;
    if (prompt('확인을 위해 "삭제"라고 입력하세요') !== '삭제') return;
    try {
      ok('rp-status', '삭제 중…');
      const { sha, data } = await loadJson(rpPath());
      if (
        data.sections.length !== rpData.sections.length ||
        !data.sections[i] ||
        data.sections[i].heading !== s.heading
      ) {
        throw new Error(
          "그 사이 항목 목록이 바뀌었습니다. 엉뚱한 항목을 지우지 않도록 중단했습니다. '새로고침'을 눌러 다시 확인해 주세요."
        );
      }
      data.sections.splice(i, 1);
      rpSha = await saveJson(rpPath(), data, sha, `수정: 러시아어판 ${rpKey} 항목 삭제 - ${s.heading}`);
      rpData = data;
      ok('rp-status', '삭제했습니다.' + APPLIED);
      renderSections();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('rp-status', e.message);
    }
  }

  lock('rp-meta-save', async () => {
    const meta = {
      title: $('rp-meta-title').value.trim(),
      description: $('rp-meta-description').value.trim(),
      pageTitle: $('rp-meta-pagetitle').value.trim(),
      lead: $('rp-meta-lead').value.trim(),
    };
    for (const [v, label] of [
      [meta.title, '브라우저 제목(title)'],
      [meta.description, '검색결과 설명(description)'],
      [meta.pageTitle, '화면 큰 제목(pageTitle)'],
      [meta.lead, '첫머리 안내문(lead)'],
    ] as [string, string][]) {
      const e = req(v, label);
      if (e) {
        bad('rp-meta-status', e);
        return;
      }
    }
    const textErr = checkTexts([
      [meta.title, '브라우저 제목(title)'],
      [meta.description, '검색결과 설명(description)'],
      [meta.pageTitle, '화면 큰 제목(pageTitle)'],
      [meta.lead, '첫머리 안내문(lead)'],
    ]);
    if (textErr) {
      bad('rp-meta-status', textErr);
      return;
    }
    try {
      ok('rp-meta-status', '저장 중…');
      const next = { ...rpData, meta };
      rpSha = await saveJson(rpPath(), next, rpSha, `수정: 러시아어판 ${rpKey} 제목·안내문`);
      rpData = next;
      ok('rp-meta-status', '저장했습니다.' + APPLIED);
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('rp-meta-status', e.message);
    }
  });

  $('rp-page').addEventListener('change', loadPage);
  $('rp-refresh').addEventListener('click', loadPage);

  // ══ 4. 추천 영상 ═══════════════════════════════════════
  let rvSha = '';
  let rvVideos: any[] = [];
  // 편집 중인 영상은 '몇 번째'가 아니라 '어느 영상'인지(videoId)로 기억한다.
  let rvEditVideoId = '';

  async function loadVideos() {
    const el = $('rv-list');
    el.textContent = '불러오는 중…';
    try {
      const { sha, data } = await loadJson(P.videos);
      if (!Array.isArray(data)) throw new Error('videos.json 이 목록(배열) 형태가 아닙니다.');
      rvSha = sha;
      rvVideos = data;
      el.innerHTML =
        data
          .map((v: any, i: number) => {
            const off = !v.titleRu || !v.titleRu.trim();
            return `
        <div class="post-row">
          <img class="thumb-sm" src="https://img.youtube.com/vi/${esc(v.videoId)}/default.jpg" alt="" />
          <span class="post-title">
            ${esc(v.titleRu || '(러시아어 제목 없음 — 비공개)')}
            ${off ? '<span class="chip off">비공개</span>' : ''}
          </span>
          <span class="post-file">${esc(v.videoId)}</span>
          <span class="post-actions">
            <button class="btn ghost" data-rvedit="${i}">수정</button>
          </span>
        </div>`;
          })
          .join('') || '<p class="hint">등록된 영상이 없습니다.</p>';
      el.querySelectorAll('[data-rvedit]').forEach((b: any) =>
        b.addEventListener('click', () => rvOpen(Number(b.dataset.rvedit)))
      );
    } catch (e: any) {
      el.textContent = e.message;
    }
  }

  function rvOpen(i: number) {
    const v = rvVideos[i];
    rvEditVideoId = v.videoId;
    $('rv-editor-name').textContent = v.videoId;
    $('rv-edit-title').value = v.titleRu || '';
    $('rv-edit-note').value = v.note || '';
    ok('rv-edit-status', '');
    $('rv-editor').hidden = false;
    $('rv-editor').scrollIntoView({ block: 'center' });
  }

  $('rv-edit-cancel').addEventListener('click', () => {
    $('rv-editor').hidden = true;
    rvEditVideoId = '';
  });

  lock('rv-edit-save', async () => {
    const titleRu = $('rv-edit-title').value.trim();
    const note = $('rv-edit-note').value.trim();
    const textErr = checkTexts([
      [titleRu, '러시아어 제목'],
      [note, '러시아어 설명'],
    ]);
    if (textErr) {
      bad('rv-edit-status', textErr);
      return;
    }
    try {
      ok('rv-edit-status', '저장 중…');
      const { sha, data } = await loadJson(P.videos);
      const idx = data.findIndex((x: any) => x.videoId === rvEditVideoId);
      if (idx < 0) {
        throw new Error("그 사이 영상 목록이 바뀌었습니다. '새로고침'을 눌러 다시 확인해 주세요.");
      }
      data[idx] = { ...data[idx], titleRu, note };
      rvSha = await saveJson(
        P.videos,
        data,
        sha,
        `수정: 러시아어판 영상 정보 수정 - ${rvEditVideoId}`
      );
      ok('rv-edit-status', '저장했습니다.' + APPLIED);
      $('rv-editor').hidden = true;
      rvEditVideoId = '';
      loadVideos();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('rv-edit-status', e.message);
    }
  });

  $('rv-refresh').addEventListener('click', loadVideos);

  // ══ 5. 상단 메뉴 표시 ═══════════════════════════════════
  let rnSha = '';

  async function loadNav() {
    const el = $('rn-list');
    el.textContent = '불러오는 중…';
    try {
      const { sha, data } = await loadJson(P.nav);
      if (!Array.isArray(data)) throw new Error('nav.json 이 목록(배열) 형태가 아닙니다.');
      rnSha = sha;
      el.innerHTML = data
        .map((n: any, i: number) => {
          const isHome = n.href === '/ru/';
          const label = NAV_LABELS[n.key] || { ru: n.key, ko: n.key };
          return `
          <div class="post-row">
            <span class="post-title">
              <label class="check">
                <input type="checkbox" data-rnrow="${i}" ${n.enabled || isHome ? 'checked' : ''} ${isHome ? 'disabled' : ''} />
                ${esc(label.ru)} <span class="hint-inline">(${esc(label.ko)})</span>
              </label>
            </span>
            <span class="post-file">${esc(n.href)}${isHome ? ' · 끌 수 없음' : ''}</span>
          </div>`;
        })
        .join('');
      ok('rn-status', '');
    } catch (e: any) {
      el.textContent = e.message;
    }
  }

  lock('rn-save', async () => {
    try {
      ok('rn-status', '저장 중…');
      const { sha, data } = await loadJson(P.nav);
      if (sha !== rnSha) {
        throw new Error(
          "이 화면을 연 뒤에 메뉴 설정이 다른 곳에서 바뀌었습니다. '새로고침'을 눌러 최신 내용을 확인한 뒤 다시 설정해 주세요."
        );
      }
      const boxes = [...$('rn-list').querySelectorAll('[data-rnrow]')] as any[];
      if (boxes.length !== data.length) {
        throw new Error("화면과 저장된 내용의 항목 수가 다릅니다. '새로고침'을 눌러 주세요.");
      }
      const next = data.map((n: any, i: number) => ({
        href: n.href,
        key: n.key,
        enabled: n.href === '/ru/' ? true : !!boxes[i].checked,
      }));
      if (!next.some((n: any) => n.enabled)) {
        throw new Error('메뉴가 하나도 남지 않습니다. 최소 한 개는 켜 두어야 합니다.');
      }
      rnSha = await saveJson(P.nav, next, rnSha, '수정: 러시아어판 메뉴 공개 상태 변경');
      const onCount = next.filter((n: any) => n.enabled).length;
      ok('rn-status', `저장했습니다. 러시아어판 상단 메뉴에 ${onCount}개가 표시됩니다.` + APPLIED);
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('rn-status', e.message);
    }
  });

  $('rn-refresh').addEventListener('click', loadNav);

  // ══ 6. 사이트 반영 상태 ═════════════════════════════════
  const WORKFLOW_KO: Record<string, string> = {
    'Deploy to GitHub Pages': '사이트 반영(배포)',
    'Update AI News': 'AI 뉴스 수집(한국어판)',
    'Update RU News': 'AI 뉴스 수집(러시아어판)',
    'Update Gov Programs': '정부 지원사업 수집',
    'Update AI Events': 'AI 행사 수집',
    'Update Recommended Videos': '추천 영상 수집',
    'Update JA Subsidies': '일본 보조금 수집',
  };

  function workflowKo(name: string): string {
    return WORKFLOW_KO[name] || name;
  }

  const CONCLUSION_KO: Record<string, string> = {
    success: '성공',
    failure: '실패',
    cancelled: '취소됨',
    timed_out: '시간 초과',
    startup_failure: '시작 실패',
    skipped: '건너뜀',
    neutral: '실행하지 않음',
    action_required: '사람의 조치 필요',
    stale: '너무 오래되어 취소됨',
  };

  function conclusionKo(c: string): string {
    return CONCLUSION_KO[c] || c || '알 수 없음';
  }

  let runsAutoRefreshLeft = 4;
  async function loadRuns() {
    const el = $('rs-runs');
    try {
      const data = await gh('/actions/runs?per_page=8');
      const rows = data.workflow_runs.map((r: any) => {
        const state =
          r.status === 'completed'
            ? r.conclusion === 'success'
              ? '✅ 성공'
              : `❌ ${conclusionKo(r.conclusion)}`
            : '⏳ 진행 중';
        const t = new Date(r.created_at).toLocaleString('ko-KR', {
          timeZone: 'Asia/Seoul',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
        });
        return `<div class="run"><span>${state}</span><span>${esc(workflowKo(r.name))}</span><span>${t}</span><a href="${esc(r.html_url)}" target="_blank" rel="noopener">로그</a></div>`;
      });
      el.innerHTML = rows.join('') || '실행 기록이 없습니다.';
      const latest = data.workflow_runs[0];
      if (latest) {
        setAdminSummary(
          'deploy',
          '최근 반영 ' +
            (latest.status === 'completed'
              ? latest.conclusion === 'success'
                ? '성공'
                : '실패'
              : '진행 중')
        );
      }
      const hasPending = data.workflow_runs.some((r: any) => r.status !== 'completed');
      if (hasPending) {
        if (runsAutoRefreshLeft > 0) {
          runsAutoRefreshLeft--;
          setTimeout(loadRuns, 15000);
        }
      } else {
        runsAutoRefreshLeft = 4;
      }
    } catch (e: any) {
      el.textContent = e.message;
    }
  }

  $('rs-refresh').addEventListener('click', () => {
    runsAutoRefreshLeft = 4;
    loadRuns();
  });

  // ══ 부팅 ══════════════════════════════════════════════
  async function loadAllPanels() {
    loadGlossary();
    loadFaq();
    loadVideos();
    loadNav();
    loadRuns();
  }
  window.addEventListener('admin-ready', loadAllPanels);
  window.addEventListener('admin-github-token-ready', loadAllPanels);
</script>

