---
// Updates (2026-11-06) — what was recently added to the English edition, by date.
// Dates: news publication, document date, date a video was added, article date — not the site build time.
import '../../styles/ph-guide.css';
import PhLayout from '../../layouts/PhLayout.astro';
import { getEnUpdates, KIND_LABEL } from '../../utils/ph-updates';
import { withBase } from '../../utils/site';

const DAYS = 45;
const items = await getEnUpdates(DAYS);
const fmtDay = new Intl.DateTimeFormat('fil-PH', { timeZone: 'Asia/Manila', year: 'numeric', month: 'long', day: 'numeric', weekday: 'short' });
const dayKey = (iso: string) => new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Manila' }).format(new Date(iso));

const groups: { key: string; label: string; list: typeof items }[] = [];
for (const it of items) {
  const k = dayKey(it.date);
  let g = groups[groups.length - 1];
  if (!g || g.key !== k) {
    g = { key: k, label: fmtDay.format(new Date(it.date)), list: [] };
    groups.push(g);
  }
  g.list.push(it);
}
const count = (kind: string) => items.filter((i) => i.kind === kind).length;

const title = 'Mga update: balita sa AI, ulat ng mga ahensya, video at artikulo';
const description = `Mga balita sa AI, bagong ulat ng mga ahensya ng kalusugan, video at artikulong naidagdag sa nakaraang ${DAYS} araw, ayon sa petsa. Awtomatikong kinokolekta at sinusuri araw-araw.`;
const latest = items.length ? new Date(items[0].date) : undefined;
const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${siteRoot}${withBase('/ph/updates/')}#collection`,
name: 'Updates',
    inLanguage: 'fil-PH',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: items.length,
      itemListElement: items.slice(0, 30).map((it, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: it.title,
        url: it.external ? it.href : `${siteRoot}${it.href}`,
      })),
    },
  },
];
---

<PhLayout title={title} description={description} crumb="Mga update" standalone updated={latest} schema={schema}>
<h1>Mga update</h1>
  <p class="tg-lead">
Ang mga naidagdag sa edisyong Filipino sa nakaraang {DAYS} araw, ayon sa petsa. Ilang beses sa isang araw sinusuri ang balita at mga ulat ng ahensya at mga video; idinaragdag ang mga artikulo kapag handa na.
  </p>
  <p class="tg-meta">
Nakaraang {DAYS} araw: {KIND_LABEL.news} {count('news')} · {KIND_LABEL.notice} {count('notice')} · {KIND_LABEL.video} {count('video')} · {KIND_LABEL.blog} {count('blog')}
  </p>
  <div class="tg-box">
Ang mga petsa sa screen ay ang petsa ng paglalathala ng balita, petsa ng dokumento, petsa ng pagdaragdag ng video o petsa ng artikulo, hindi ang oras ng pagbuo ng site. Ang mga panlabas na link ay patungo sa mga pahina ng mga ahensya at publisher.
  </div>

  {
    groups.length > 0 ? (
      groups.map((g) => (
        <section class="tg-sec" aria-label={g.label}>
          <h2>{g.label}</h2>
          <ul class="tg-list">
            {g.list.map((it) => (
              <li>
                <span class="tg-tag">{KIND_LABEL[it.kind]}</span>
                <a href={it.href} {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
                  {it.title}
{it.external && <span class="sr-only">(opens in a new tab)</span>}
                </a>
                {it.note && <small> · {it.note}</small>}
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
<p>Walang bagong naidagdag sa panahong ito.</p>
    )
  }
</PhLayout>
