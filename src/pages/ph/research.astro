---
// 의료 기술·논문 (2026-11-14, 오너 지시). 데이터는 scripts/fetch-research.mjs 가 수집한 src/data/research/ph.json
import PhLayout from '../../layouts/PhLayout.astro';
import ResearchView from '../../components/ResearchView.astro';
import { RESEARCH_STRINGS, researchSchema } from '../../data/research/strings';
import data from '../../data/research/ph.json';

const t = RESEARCH_STRINGS.ph;
const schema = [researchSchema('ph', data, t.metaTitle, t.metaDescription)];
---

<PhLayout
  title={t.metaTitle}
  description={t.metaDescription}
  crumb={t.nav}
  koPath="/research/"
  jaPath="/ja/research/"
  ruPath="/ru/research/"
  idPath="/id/research/"
  twPath="/tw/research/"
  enPath="/en/research/"
  inPath="/in/research/"
  sgPath="/sg/research/"
  updated={new Date(data.updatedAt)}
  schema={schema}
>
  <h1>{t.h1}</h1>
  <ResearchView loc="ph" />
</PhLayout>
