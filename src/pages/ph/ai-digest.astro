---
// AI digest — a collection of AI stories from general technology publications (new 2026-11-06)
//
// /ph/news/ 는 의료 AI 전용이고 이 페이지는 그 밖의 AI 기사다. 둘을 섞지 않는다
// (섞으면 의료 AI 뉴스 페이지의 주제가 흐려진다 — scripts/fetch-ai-digest.mjs 머리말).
//
// ⚠️ hreflang 을 걸지 않는다(standalone). 자동 수집 목록은 언어판마다 기사가
//    완전히 달라 번역 관계가 아니다. /ph/news/ 와 같은 원칙.
// ⚠️ 이 페이지는 **링크 모음**이다. 검색·답변 엔진이 인용할 수 있으려면 목록
//    말고도 이 사이트만의 문장이 있어야 하므로, "왜 병원 행정에 필요한가"를
//    설명하는 문단을 함께 둔다. 그 문단을 지우면 그냥 스크랩 페이지가 된다.
import PhLayout from '../../layouts/PhLayout.astro';
import en from '../../i18n/ph.json';
import { withBase } from '../../utils/site';
import digest from '../../data/ph/ai-digest.json';

const fmt = new Intl.DateTimeFormat('fil-PH', {
  timeZone: 'Asia/Manila',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const items = digest.items;
const sources = [...new Set(items.map((i) => i.source))].sort();

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/ph/ai-digest/')}`;

const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: en.aiDigest.pageTitle,
  description: en.aiDigest.metaDescription,
  inLanguage: 'fil-PH',
  isPartOf: { '@id': `${siteUrl}/#website-ph` },
  dateModified: digest.updatedAt ?? new Date().toISOString(),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<PhLayout
  title={en.nav.aiDigest}
  description={en.aiDigest.metaDescription}
  crumb={en.nav.aiDigest}
  standalone
  updated={new Date(digest.updatedAt ?? Date.now())}
  schema={[collectionPage]}
>
  <h1>{en.aiDigest.pageTitle}</h1>
  <p class="en-lead">{en.aiDigest.lead}</p>

  <div class="en-note">
    <p><strong>{en.aiDigest.why}</strong></p>
    <p style="margin-top:6px">{en.aiDigest.whyBody}</p>
  </div>

  <p class="en-caution">{en.aiDigest.notice}</p>

  <p class="en-src-line">
    <strong>{en.aiDigest.sourcesTitle}:</strong> {sources.join(' · ')}
  </p>

  {
    items.length > 0 ? (
      <ul class="en-news-list">
        {items.map((item) => (
          <li>
            <a href={item.link} target="_blank" rel="noopener">
              {item.title}
              <span class="sr-only"> ({en.ui.external})</span>
            </a>
            <span class="en-meta">
              {item.source} · <time datetime={item.pubDate}>{fmt.format(new Date(item.pubDate))}</time>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p>{en.aiDigest.empty}</p>
    )
  }
</PhLayout>

<style>
  .en-src-line {
    font-size: 13px;
    color: var(--ph-text-sub);
    margin-top: 18px;
  }
  .en-news-list {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }
  .en-news-list li {
    padding: 11px 0;
    border-bottom: 1px solid var(--ph-border);
  }
  .en-news-list a {
    color: var(--ph-text);
    text-decoration: none;
    font-size: 14.5px;
    line-height: 1.7;
  }
  .en-news-list a:hover {
    color: var(--ph-primary);
    text-decoration: underline;
  }
  .en-meta {
    display: block;
    margin-top: 4px;
    font-size: 12.5px;
    color: var(--ph-text-sub);
  }
</style>
