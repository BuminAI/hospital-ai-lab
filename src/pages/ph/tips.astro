---
import PhLayout from '../../layouts/PhLayout.astro';
import PhSections from '../../components/PhSections.astro';
import { tipsEn } from '../../data/ph/pages';
import en from '../../i18n/ph.json';

const p = tipsEn;

const schema = [
  {
    '@type': 'ItemList',
    name: p.meta.pageTitle,
    numberOfItems: p.sections.length,
    itemListElement: p.sections.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.heading,
    })),
  },
];
---

<PhLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={en.nav.tips}
  koPath="/tips/"
  idPath="/id/tips/"
  ruPath="/ru/tips/"
  twPath="/tw/tips/"
  enPath="/en/tips/"
  inPath="/in/tips/" sgPath="/sg/tips/"
  jaPath="/ja/tips/"
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="en-lead">{p.meta.lead}</p>

  {/* 원내 규정 확인을 도구 소개보다 먼저 안내 */}
  <p class="en-caution">
Bago gamitin sa trabaho ang alinmang tool dito, tiyaking pinapayagan ito ng patakaran sa seguridad ng impormasyon ng inyong ospital. Huwag magpasok ng datos ng pasyente o staff sa mga panlabas na serbisyo: iyan ang pangkalahatang patakaran para sa bawat tool.
  </p>

  <PhSections sections={p.sections} />
</PhLayout>

<style>
  .en-lead {
    color: var(--ph-text-sub);
  }
  .en-caution {
    border: 1px solid var(--ph-border);
    border-left: 4px solid var(--ph-accent);
    background: var(--ph-surface);
    padding: 12px 14px;
    font-size: 13.5px;
    line-height: 1.85;
    margin-bottom: 26px;
  }
</style>
