---
// Key facts for citation (2026-11-15) — a page for AEO/GEO.
// One item = question + short answer + section + primary source. Data: src/data/ae/guides/facts.ts.
// Each item has an anchor (#id) for direct linking.
import '../../../styles/ae-guide.css';
import AeLayout from '../../../layouts/AeLayout.astro';
import AeGuideFoot from '../../../components/AeGuideFoot.astro';
import { FACTS, FACT_TOPICS, FACTS_CHECKED } from '../../../data/ae/guides/facts';
import { SRC } from '../../../data/ae/guides/milestones';
import { withBase } from '../../../utils/site';

const title = 'Key facts: AI policies, patient data and device rules in the UAE';
const description = `${FACTS.length} short answers you can cite on Abu Dhabi’s and Dubai’s AI policies, the 2026 DoH data standards, medical device reporting and breach timelines.`;

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/ae/facts/')}`;

const faqLd = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  url: pageUrl,
  inLanguage: 'en-AE',
  isPartOf: { '@id': `${siteRoot}/#website-ae` },
  mainEntity: FACTS.map((f) => ({
    '@type': 'Question',
    '@id': `${pageUrl}#${f.id}`,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: `${f.a} (Basis: ${f.basis}.)`, citation: SRC[f.src].url },
  })),
};
const articleLd = {
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: title,
  description,
  inLanguage: 'en-AE',
  author: { '@id': `${siteRoot}/#person` },
  publisher: { '@id': `${siteRoot}/#organization` },
  isPartOf: { '@id': `${siteRoot}/#website-ae` },
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  datePublished: '2026-11-15T00:00:00+04:00',
  dateModified: '2026-11-15T00:00:00+04:00',
  isAccessibleForFree: true,
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.tg-answer', 'h1'] },
  citation: Object.values(SRC).map((s) => ({ '@type': 'CreativeWork', name: s.label, url: s.url })),
};

const sources = [SRC.dohAi, SRC.dhaAi, SRC.dpgs, SRC.dataAccess, SRC.analytics, SRC.mdr, SRC.cyber, SRC.hie];
---

<AeLayout title={title} description={description} crumb="Key facts" standalone updated={new Date('2026-11-15T00:00:00+04:00')} schema={[articleLd, faqLd]}>
  <h1>Key facts: AI policies, patient data and device rules in the UAE</h1>
  <p class="tg-lead">
    Short answers to the questions that come up most in purchasing and compliance meetings. Each answer was written after the text of the document was opened, and gives the section and a link to the primary source.
  </p>
  <p class="tg-meta">Checked: {FACTS_CHECKED} · {FACTS.length} items · For: administrators, nurses and patients</p>

  <p class="tg-answer">
    In short: Abu Dhabi’s Department of Health has an AI policy (2018) and 2026 standards on digital products, data access, analytics and device reporting; Dubai’s Health Authority has its own AI policy asking for vendor disclosure and independent validation; hospitals must keep health data in the UAE unless DoH authorises otherwise; and connected-device cyber incidents are reported immediately, with exchange breaches notified to patients within 60 days.
  </p>

  <div class="tg-box">
    <strong>How to use this page</strong><br />
    Copy an answer together with its section, and check the text of the rule at the primary source. There are no deadlines or rules here whose text we did not read; this is not legal advice.
    <br />
    {
      FACT_TOPICS.map((t, i) => (
        <>
          <a href={`#t-${i}`}>{t}</a>
          {i < FACT_TOPICS.length - 1 ? ' · ' : ''}
        </>
      ))
    }
  </div>

  {
    FACT_TOPICS.map((topic, i) => (
      <section class="tg-sec" aria-labelledby={`t-${i}`}>
        <h2 id={`t-${i}`}>{topic}</h2>
        <dl class="tg-facts">
          {FACTS.filter((f) => f.topic === topic).map((f) => (
            <>
              <dt id={f.id}>
                <a href={`#${f.id}`}>{f.q}</a>
              </dt>
              <dd>
                <p>{f.a}</p>
                <p class="tg-basis">
                  Basis: {f.basis} ·{' '}
                  <a href={SRC[f.src].url} target="_blank" rel="noopener">
                    primary source<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </p>
              </dd>
            </>
          ))}
        </dl>
      </section>
    ))
  }

  <section class="tg-sec" aria-labelledby="h-next">
    <h2 id="h-next">Next</h2>
    <div class="tg-cards">
      <a class="tg-card" href={withBase('/ae/dx-roadmap/')}><b>Roadmap</b><span>Key rules on one timeline.</span></a>
      <a class="tg-card" href={withBase('/ae/data-checklist/')}><b>Patient data protection checklist</b><span>Items from the DoH standards and the two AI policies.</span></a>
      <a class="tg-card" href={withBase('/ae/glossary/')}><b>Glossary</b><span>Medical AI terms in plain language.</span></a>
    </div>
  </section>

  <AeGuideFoot sources={sources} checked={FACTS_CHECKED} />
</AeLayout>
