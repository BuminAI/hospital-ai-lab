---
// Частые вопросы — 러시아 제도 기준으로 새로 쓴 FAQ
import IdLayout from '../../layouts/IdLayout.astro';
import id from '../../i18n/id.json';
import { faqItemsId } from '../../data/id/faq';
import { withBase } from '../../utils/site';

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/id/faq/')}`;

// FAQPage — AI 답변 엔진이 Q&A 쌍을 그대로 인용할 수 있게 한다.
// 답변이 <details> 안에 실제로 렌더되므로 '숨겨진 콘텐츠 마크업'이 아니다.
const faqPage = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  url: pageUrl,
  inLanguage: 'id-ID',
  isPartOf: { '@id': `${siteRoot}/#website-id` },
  mainEntity: faqItemsId.map((it, i) => ({
    '@type': 'Question',
    '@id': `${pageUrl}#q${i + 1}`,
    name: it.question,
    acceptedAnswer: { '@type': 'Answer', text: it.answer },
  })),
};
---

<IdLayout
  title={id.faq.pageTitle}
  description={id.faq.metaDescription}
  crumb={id.nav.faq}
  koPath="/faq/"
  jaPath="/ja/faq/"
  ruPath="/ru/faq/"
  schema={[faqPage]}
>
  <h1>{id.faq.pageTitle}</h1>
  <p>{id.faq.pageLead}</p>

  <div class="id-faq">
    {faqItemsId.map((item) => (
      <details class="id-faq-item">
        <summary>{item.question}</summary>
        <div class="id-faq-a">
          <p>{item.answer}</p>
          {item.sources.length > 0 && (
            <p class="id-src">
              {id.ui.source}:{' '}
              {item.sources.map((src, i) => (
                <>
                  {i > 0 && ' / '}
                  <a class="id-ext" href={src} target="_blank" rel="noopener">
                    {new URL(src).hostname.replace(/^www\./, '')}
                    <span class="sr-only"> ({id.ui.external})</span>
                  </a>
                </>
              ))}
            </p>
          )}
        </div>
      </details>
    ))}
  </div>

  <div class="id-note"><p>{id.faq.notice}</p></div>
</IdLayout>

<style>
  .id-faq { margin-top: 16px; border-top: 1px solid var(--id-border); }
  .id-faq-item { border-bottom: 1px solid var(--id-border); }
  .id-faq-item summary {
    cursor: pointer; padding: 14px 4px; font-size: 15px; line-height: 1.7;
    list-style-position: outside;
  }
  .id-faq-item summary:hover { color: var(--id-primary); }
  .id-faq-item[open] summary { color: var(--id-primary); }
  .id-faq-a { padding: 0 4px 16px; }
  .id-src { margin-top: 8px; font-size: 12.5px; }
</style>
