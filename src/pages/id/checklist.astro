---
import IdLayout from '../../layouts/IdLayout.astro';
import InteractiveChecklist from '../../components/InteractiveChecklist.astro';
import SubscribeCta from '../../components/SubscribeCta.astro';
import { getCollection } from 'astro:content';
import { checklistRelated } from '../../data/checklist-related';
import { COLLECTION, postHref } from '../../utils/locale';
import { checklistId } from '../../data/id/pages';
import idI18n from '../../i18n/id.json';
import { withBase } from '../../utils/site';

const p = checklistId;

// 점검표를 체크해 가며 쓰는 형태로 그린다(2026-09-20). 체크 상태는 이 기기의 브라우저에만 저장된다.
const sections = p.sections.map((s, i) => ({
  title: s.heading,
  body: s.body,
  items: s.items,
  plain: false,
}));
const posts = await getCollection(COLLECTION.id, ({ data }) => !data.draft);
const titleOf = new Map(posts.map((x) => [x.id, x.data.title]));
const relatedByTitle: Record<string, { href: string; title: string }[]> = {};
for (const [idx, ids] of Object.entries(checklistRelated.id)) {
  const sec = sections[Number(idx)];
  if (!sec) throw new Error('[checklist:id] 관련 글의 섹션 번호 ' + idx + '가 없습니다.');
  relatedByTitle[sec.title] = ids.map((id) => {
    const title = titleOf.get(id);
    if (!title) throw new Error('[checklist:id] 관련 글 ID ' + id + '가 없습니다.');
    return { href: postHref('id', id), title };
  });
}

// 화면에 보이는 소제목·순서 그대로 ItemList로 알린다(보이지 않는 정보는 넣지 않는다).
const schema = [
  {
    '@type': 'ItemList',
    name: p.meta.pageTitle,
    numberOfItems: p.sections.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: p.sections.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.heading,
    })),
  },
];
---

<IdLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={idI18n.nav.checklist}
  koPath="/checklist/"
  ruPath="/ru/checklist/"
  twPath="/tw/checklist/"
  jaPath="/ja/checklist/"
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="id-lead">{p.meta.lead}</p>

  <InteractiveChecklist id="ai-adoption-id" loc="id" sections={sections} related={relatedByTitle} />

  <SubscribeCta loc="id" />

  <section class="id-next">
    <h2>Bacaan lanjutan</h2>
    <ul>
      <li>
        <a href={withBase('/id/glossary/')}>{idI18n.nav.glossary}</a> —
      Penjelasan istilah yang dipakai di daftar periksa ini.
      </li>
      <li>
        <a href={withBase('/id/faq/')}>{idI18n.nav.faq}</a> —
      Pertanyaan yang paling sering muncul saat rumah sakit menilai AI.
      </li>
      <li>
        <a href={withBase('/id/guide/')}>{idI18n.nav.guide}</a> —
      Urutan belajar bagi yang tidak berlatar teknis.
      </li>
    </ul>
  </section>
</IdLayout>

<style>
  .id-lead {
    color: var(--id-text-sub);
  }
  .id-next {
    margin-top: 36px;
    border-top: 1px solid var(--id-border);
    padding-top: 20px;
  }
  .id-next h2 {
    font-size: 15px;
    color: var(--id-text-sub);
    margin-bottom: 10px;
    border: 0;
    padding: 0;
    background: none;
  }
  .id-next ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .id-next li {
    font-size: 14px;
    line-height: 1.85;
  }
</style>
