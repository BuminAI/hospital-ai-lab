---
// Словарь терминов — 러시아 제도를 새로 조사해 쓴 용어집(번역 아님)
//
// ⚠️ 제도 관련 항목(152-ФЗ, Постановление №1684 등)은 러시아 제도로
//    새로 조사해 썼고, 출처를 실제 접속해 확인했다(src/data/id/content/glossary.json).
//    고칠 때도 같은 원칙을 지킬 것.
import IdLayout from '../../layouts/IdLayout.astro';
import id from '../../i18n/id.json';
import { glossaryTermsId, glossaryCategoriesId } from '../../data/id/glossary';
import { withBase } from '../../utils/site';

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/id/glossary/')}`;

// DefinedTermSet — AI 답변 엔진이 용어 정의를 딥링크로 인용할 수 있게 한다
const definedTermSet = {
  '@type': 'DefinedTermSet',
  '@id': `${pageUrl}#termset`,
  url: pageUrl,
  name: id.glossary.pageTitle,
  description: id.glossary.metaDescription,
  inLanguage: 'id-ID',
  isPartOf: { '@id': `${siteRoot}/#website-id` },
  hasDefinedTerm: glossaryTermsId.map((t) => ({
    '@type': 'DefinedTerm',
    '@id': `${pageUrl}#${t.id}`,
    url: `${pageUrl}#${t.id}`,
    name: t.term,
    description: t.definition,
    termCode: t.id,
    inDefinedTermSet: { '@id': `${pageUrl}#termset` },
  })),
};
---

<IdLayout
  title={id.glossary.pageTitle}
  description={id.glossary.metaDescription}
  crumb={id.nav.glossary}
  koPath="/glossary/"
  jaPath="/ja/glossary/"
  ruPath="/ru/glossary/"
  schema={[definedTermSet]}
>
  <h1>{id.glossary.pageTitle}</h1>
  <p>{id.glossary.pageLead}</p>

  <p class="id-caution">{id.glossary.caution}</p>

  <nav class="id-index" aria-label="Указатель терминов">
    <ul>
      {glossaryTermsId.map((t) => (
        <li><a href={`#${t.id}`}>{t.term}</a></li>
      ))}
    </ul>
  </nav>

  {glossaryCategoriesId.map((cat) => {
    const terms = glossaryTermsId.filter((t) => t.category === cat);
    if (terms.length === 0) return null;
    return (
      <section>
        <h2>{cat}</h2>
        <dl class="id-terms">
          {terms.map((t) => (
            <div class="id-term" id={t.id}>
              <dt>{t.term}</dt>
              <dd>
                <p>{t.definition}</p>
                <p class="id-why"><span>Практическое значение</span>{t.whyMatters}</p>
                {t.sources.length > 0 && (
                  <p class="id-src">
                    {id.ui.source}:{' '}
                    {t.sources.map((src, i) => (
                      <>
                        {i > 0 && ' / '}
                        <a class="id-ext" href={src} target="_blank" rel="noopener">
                          {new URL(src).hostname.replace(/^www\./, '')}
                          <span class="sr-only"> ({id.ui.external})</span>
                        </a>
                      </>
                    ))}
                  </p>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    );
  })}

  <div class="id-note"><p>{id.glossary.notice}</p></div>
</IdLayout>

<style>
  .id-index {
    border: 1px solid var(--id-border);
    background: var(--id-surface);
    padding: 12px 14px;
    margin: 16px 0 8px;
  }
  .id-index ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 6px 14px;
    font-size: 13.5px;
  }
  .id-terms { margin: 0; }
  .id-term { scroll-margin-top: 4rem; padding: 14px 0; border-bottom: 1px solid var(--id-border); }
  .id-term dt { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
  .id-term dd { margin: 0; }
  .id-why { margin-top: 8px; font-size: 14px; color: var(--id-text-sub); }
  .id-why span {
    display: inline-block; margin-right: 8px; padding: 0 8px;
    background: var(--id-surface-2); border-radius: 3px; font-size: 12.5px;
  }
  .id-src { margin-top: 6px; font-size: 12.5px; }
</style>
