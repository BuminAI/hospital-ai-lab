---
// Blog — 인도네시아어판 블로그 목록. 다른 언어판 글과는 번역 관계가 아니라
// hreflang을 걸지 않는다(뉴스 목록과 같은 이유, HANDOFF.md 5-3절 참고).
import { getCollection } from 'astro:content';
import IdLayout from '../../../layouts/IdLayout.astro';
import idI18n from '../../../i18n/id.json';
import { withBase } from '../../../utils/site';

const posts = (await getCollection('blogId', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = new Intl.DateTimeFormat('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });

// CollectionPage + ItemList — AI 답변 엔진이 "이 블로그에 어떤 글이 있는가"를
// 순서대로 읽을 수 있게 한다(ko blog/category 페이지와 같은 패턴).
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/id/blog/')}`;
const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: idI18n.nav.blog,
  inLanguage: 'id-ID',
  isPartOf: { '@id': `${siteUrl}/#website-id` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: post.data.title,
      url: `${siteUrl}${withBase(`/id/blog/${post.id}/`)}`,
    })),
  },
};
---

<IdLayout
  title={idI18n.nav.blog}
  description="Kolom tentang AI kesehatan di rumah sakit — pelindungan data pribadi, perizinan alat kesehatan, dan arah regulasi di Indonesia."
  crumb={idI18n.nav.blog}
  koPath="/blog/"
  jaPath="/ja/blog/"
  ruPath="/ru/blog/"
  jaPath="/ja/blog/"
  schema={[collectionPage]}
>
  <h1>{idI18n.nav.blog}</h1>
  <p class="id-lead">
    Tulisan tentang hal-hal yang benar-benar muncul saat rumah sakit
    mempertimbangkan AI, dengan rujukan regulasi Indonesia yang sumbernya
    diperiksa langsung.
  </p>

  {
    posts.length > 0 ? (
      <ul class="id-blog-list">
        {posts.map((post) => (
          <li>
            <a class="id-blog-title" href={withBase(`/id/blog/${post.id}/`)}>
              {post.data.title}
            </a>
            <p class="id-blog-desc">{post.data.description}</p>
            <span class="id-blog-meta">
              {post.data.category} · <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="id-empty">{idI18n.ui.noItems}</p>
    )
  }
</IdLayout>

<style>
  .id-lead {
    color: var(--id-text-sub);
  }
  .id-blog-list {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--id-border);
  }
  .id-blog-list li {
    padding: 16px 0;
    border-bottom: 1px solid var(--id-border);
  }
  .id-blog-title {
    display: block;
    font-size: 16px;
    font-weight: 600;
    color: var(--id-primary);
    line-height: 1.6;
  }
  .id-blog-desc {
    margin-top: 6px;
    font-size: 13.5px;
    color: var(--id-text-sub);
    line-height: 1.75;
  }
  .id-blog-meta {
    display: block;
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--id-text-sub);
  }
  .id-empty {
    margin-top: 20px;
    color: var(--id-text-sub);
  }
</style>
