---
import { execSync } from 'node:child_process';
import { getCollection, render } from 'astro:content';
import IdLayout from '../../../layouts/IdLayout.astro';
import idI18n from '../../../i18n/id.json';
import { withBase } from '../../../utils/site';

const fmt = new Intl.DateTimeFormat('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });

export async function getStaticPaths() {
  const posts = await getCollection('blogId', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Baca juga(관련 글) — 한국어판 blog/[id].astro와 같은 방식.
// 그전에는 러시아어판 글 하단이 목록으로 돌아가는 링크 하나뿐이라 글끼리
// 이어지는 문맥 링크가 0건이었다. 같은 분류를 먼저 채우고 모자라면
// 최신순으로 채운다. 새 콘텐츠를 만들지 않고 기존 데이터만 쓴다.
const RELATED_COUNT = 3;
const others = (await getCollection('blogId', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const related = [
  ...others.filter((p) => p.data.category === post.data.category),
  ...others.filter((p) => p.data.category !== post.data.category),
].slice(0, RELATED_COUNT);

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const canonicalUrl = `${siteUrl}${withBase(`/id/blog/${post.id}/`)}`;

// 수정일 — 이 글 파일의 마지막 git 커밋 시각(ko blog/[id].astro와 같은 방식).
let dateModifiedIso = post.data.pubDate.toISOString();
try {
  const gitDate = execSync(
    `git log -1 --format=%cI -- "src/content/blog-id/${post.id}.md"`
  )
    .toString()
    .trim();
  if (gitDate) dateModifiedIso = gitDate;
} catch {
  // 폴백: 위에서 이미 발행일로 초기화해 두었다.
}

// BlogPosting — author는 ko/ja와 같은 Person 엔티티를 @id로 참조한다
// (같은 사람이므로 언어판마다 엔티티를 새로 만들지 않는다).
const blogPosting = {
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  url: canonicalUrl,
  inLanguage: 'id-ID',
  datePublished: post.data.pubDate.toISOString(),
  dateModified: dateModifiedIso,
  articleSection: post.data.category,
  author: { '@id': `${siteUrl}/#person` },
  publisher: { '@id': `${siteUrl}/#organization` },
  isPartOf: { '@id': `${siteUrl}/#website-id` },
  // 레이아웃이 같은 URL에 대해 `<canonical>#webpage` WebPage 노드를 이미 내보낸다.
  // 여기서 canonicalUrl(끝에 #webpage 없음)을 쓰면 같은 페이지를 가리키는
  // WebPage 노드가 그래프에 둘 생겨 검색엔진이 별개 개체로 읽는다.
  // 그 노드를 그대로 참조해 하나로 묶는다(2026-09-06 정리, 네 언어판 공통).
  mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
};

// hreflang을 내지 않는 이유(standalone):
//   언어판마다 주제가 다른 독립 집필이라 이 글에 대응하는 한국어판이 없다.
//   koPath="/blog/"는 상단 언어 전환 링크를 한국어 블로그 목록으로 보내려는
//   것일 뿐인데, 2026-09-06 이전에는 그 값이 hreflang에도 쓰여서 글마다
//   "이 글의 한국어판은 /blog/(목록)"이라고 잘못 선언하고 있었다. /blog/는
//   되짚어 가리키지 않아 상호참조가 깨졌고 x-default까지 한국어 목록을
//   가리켰다. 짝이 생기면 그때 standalone을 빼고 koPath를 실제 짝으로 바꾼다.

---

<IdLayout
  title={post.data.title}
  description={post.data.description}
  crumb={post.data.title}
  koPath="/blog/"
  standalone
  updated={new Date(dateModifiedIso)}
  schema={[blogPosting]}
>
  <div class="id-post-meta">
    <span class="id-chip">{post.data.category}</span>
    <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
    {/* 저자 표시 — BlogPosting JSON-LD가 author를 선언하므로 화면에도
        같은 사실이 보여야 한다(구글은 비가시 콘텐츠 마크업을 금지한다). */}
    <span class="id-byline">
      <a href={withBase('/id/about/')} rel="author">{idI18n.profile.nameShort}</a>
    </span>
  </div>
  <h1>{post.data.title}</h1>
  <p class="id-lead">{post.data.description}</p>

  <div class="id-prose">
    <Content />
  </div>

  {
    related.length > 0 && (
      <section class="id-related" aria-labelledby="id-related-heading">
        <h2 id="id-related-heading">Baca juga</h2>
        <ul>
          {related.map((p) => (
            <li>
              <a href={withBase(`/id/blog/${p.id}/`)}>{p.data.title}</a>
              <span class="id-related-meta">
                {p.data.category} ·{' '}
                <time datetime={p.data.pubDate.toISOString()}>{fmt.format(p.data.pubDate)}</time>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p class="id-back"><a href={withBase('/id/blog/')}>← {idI18n.nav.blog}</a></p>
</IdLayout>

<style>
  .id-post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--id-text-sub);
    margin-bottom: 8px;
  }
  .id-chip {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--id-primary);
    color: #fff;
  }
  .id-byline a {
    color: inherit;
    text-decoration: underline;
  }
  .id-lead {
    color: var(--id-text-sub);
  }
  .id-prose {
    margin-top: 20px;
  }
  .id-prose :global(h2) {
    font-size: 19px;
    border-left: 4px solid var(--id-primary);
    padding-left: 10px;
    background: var(--id-surface);
    margin: 28px 0 14px;
  }
  .id-prose :global(p) {
    line-height: 1.85;
    margin: 0 0 14px;
  }
  .id-prose :global(li) {
    line-height: 1.8;
  }
  .id-prose :global(em) {
    color: var(--id-text-sub);
    font-size: 13.5px;
  }
  .id-related {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--id-border);
  }
  .id-related h2 {
    font-size: 15px;
    color: var(--id-text-sub);
    margin-bottom: 12px;
  }
  .id-related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .id-related a {
    display: block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--id-primary);
    line-height: 1.6;
  }
  .id-related-meta {
    display: block;
    margin-top: 3px;
    font-size: 12.5px;
    color: var(--id-text-sub);
  }
  .id-back {
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--id-border);
    font-weight: 600;
  }
</style>
