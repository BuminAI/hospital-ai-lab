---
import IdLayout from '../../layouts/IdLayout.astro';
import IdSections from '../../components/IdSections.astro';
import { guideId } from '../../data/id/pages';
import idI18n from '../../i18n/id.json';
import { withBase } from '../../utils/site';

const p = guideId;

// 소제목이 순서를 가지므로 HowTo로 표시한다. 화면에 보이는 것만 마크업한다.
//
// ⚠️ 단계 판정은 소제목이 「Langkah N」으로 시작하는 것만 본다. 다른 형태의 절을
//    추가하면 마크업에서 조용히 빠지므로, 절을 늘릴 때 이 정규식도 볼 것.
//    구글은 2023년에 HowTo 리치결과를 없앴다 — 이 마크업은 검색 장식이
//    아니라 AI 답변 엔진용이다(ru·ja판과 같은 판단).
const stepSections = p.sections.filter((s) => /^Langkah\s*\d+/.test(s.heading));
const schema = [
  {
    '@type': 'HowTo',
    name: p.meta.pageTitle,
    description: p.meta.description,
    inLanguage: 'id-ID',
    step: stepSections.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.heading,
      text: s.body,
    })),
  },
];
---

<IdLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={idI18n.nav.guide}
  koPath="/guide/"
  ruPath="/ru/guide/"
  twPath="/tw/guide/"
  jaPath="/ja/guide/"
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="id-lead">{p.meta.lead}</p>

  <IdSections sections={p.sections} />

  <section class="id-next">
    <h2>Bacaan lanjutan</h2>
    <ul>
      <li>
        <a href={withBase('/id/glossary/')}>{idI18n.nav.glossary}</a> —
      Istilah yang muncul di proposal dan rapat internal.
      </li>
      <li>
        <a href={withBase('/id/checklist/')}>{idI18n.nav.checklist}</a> —
      Daftar untuk menelusuri proposal yang konkret.
      </li>
    </ul>
  </section>
</IdLayout>

<style>
  .id-lead {
    color: var(--id-text-sub);
  }
  .id-next {
    margin-top: 36px;
    border-top: 1px solid var(--id-border);
    padding-top: 20px;
  }
  .id-next h2 {
    font-size: 15px;
    color: var(--id-text-sub);
    margin-bottom: 10px;
    border: 0;
    padding: 0;
    background: none;
  }
  .id-next ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .id-next li {
    font-size: 14px;
    line-height: 1.85;
  }
</style>
