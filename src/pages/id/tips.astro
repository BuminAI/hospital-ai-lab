---
import IdLayout from '../../layouts/IdLayout.astro';
import IdSections from '../../components/IdSections.astro';
import { tipsId } from '../../data/id/pages';
import idI18n from '../../i18n/id.json';

const p = tipsId;

const schema = [
  {
    '@type': 'ItemList',
    name: p.meta.pageTitle,
    numberOfItems: p.sections.length,
    itemListElement: p.sections.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.heading,
    })),
  },
];
---

<IdLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={idI18n.nav.tips}
  koPath="/tips/"
  ruPath="/ru/tips/"
  twPath="/tw/tips/"
  jaPath="/ja/tips/"
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="id-lead">{p.meta.lead}</p>

  {/* 원내 규정 확인을 도구 소개보다 먼저 안내 */}
  <p class="id-caution">
      Sebelum memakai alat-alat di halaman ini untuk pekerjaan, pastikan dulu
      aturan keamanan informasi di rumah sakit Anda mengizinkannya. Apa pun
      alatnya, tidak memasukkan data pasien dan data pegawai ke layanan luar
      adalah syarat yang berlaku sama.
  </p>

  <IdSections sections={p.sections} />
</IdLayout>

<style>
  .id-lead {
    color: var(--id-text-sub);
  }
  .id-caution {
    border: 1px solid var(--id-border);
    border-left: 4px solid var(--id-accent);
    background: var(--id-surface);
    padding: 12px 14px;
    font-size: 13.5px;
    line-height: 1.85;
    margin-bottom: 26px;
  }
</style>
