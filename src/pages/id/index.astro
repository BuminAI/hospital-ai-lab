---
// Beranda edisi Indonesia (2026-10-31, desain ulang — susunan sama dengan edisi Taiwan dan Jepang: keterbacaan, daya tarik, kesan profesional dan tepercaya)
//
// Susunan (atas ke bawah):
//   1) Hero: janji satu kalimat + dua tindakan + "Pembaruan terbaru" di kanan (bukti situs hidup)
//   2) Deretan angka kepercayaan: semuanya data nyata. Tidak ada angka karangan
//   3) "Ketika Anda menghadapi ini": enam pintu masuk berdasarkan tujuan
//   4) Informasi pembaruan, peraturan baru JDIH Kemenkes, artikel pilihan, seri
//   5) Prinsip situs, pustaka, pertanyaan umum, tentang situs
// ⚠️ Masa kerja penulis tidak ditulis di badan beranda dan deskripsi meta (profil di sidebar tetap seperti semula).
// ⚠️ Angka dihitung dari data, atau hanya fakta yang sudah ada di situs.
import '../../styles/id-home.css';
import { getCollection } from 'astro:content';
import IdLayout from '../../layouts/IdLayout.astro';
import id from '../../i18n/id.json';
import notices from '../../data/id/gov-notices.json';
import newsData from '../../data/id/news.json';
import linkHealth from '../../data/id/link-health.json';
import HomeSeries from '../../components/HomeSeries.astro';
import { withBase } from '../../utils/site';
import { getResolvedSeries } from '../../utils/series';
import { getIdUpdates, KIND_LABEL } from '../../utils/id-updates';

const updated = new Date(notices.updatedAt);
const fmtMD = new Intl.DateTimeFormat('id-ID', { timeZone: 'Asia/Jakarta', month: 'numeric', day: 'numeric' });
const fmtYMD = new Intl.DateTimeFormat('id-ID', { timeZone: 'Asia/Jakarta', year: 'numeric', month: 'long', day: 'numeric' });

const posts = (await getCollection('blogId', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.slice(0, 4);

const feed = await getIdUpdates(30);
const heroFeed = feed.slice(0, 4);
const newsFeed = feed.slice(0, 8);
const weekly = feed.filter((u) => Date.now() - new Date(u.date).getTime() <= 7 * 86400000);
const weeklyCount = (k: 'news' | 'notice' | 'event' | 'video' | 'blog') => weekly.filter((u) => u.kind === k).length;

// Peraturan baru dari JDIH Kemenkes (terbaru di atas)
const topNotices = notices.items.slice(0, 5);

// Angka kepercayaan (semuanya dari data nyata)
const stats = [
  { n: posts.length, unit: '', label: 'Artikel terbit', href: '/id/blog/' },
  { n: linkHealth.total, unit: '', label: 'Tautan sumber diperiksa tiap hari', href: '/id/updates/' },
  { n: notices.items.length, unit: '', label: 'Peraturan baru JDIH Kemenkes', href: '/id/calendar/' },
  { n: newsData.items.length, unit: '', label: 'Berita AI (diperiksa tiap 3 jam)', href: '/id/news/' },
];
const checkedDay = linkHealth.checkedAt ? fmtYMD.format(new Date(linkHealth.checkedAt)) : '';

const tasks = [
  { q: 'Apa saja tonggak yang perlu diketahui?', t: 'Peta waktu digital kesehatan dan AI', d: 'Permenkes 24/2022, UU PDP, UU 17/2023, PP 28/2024, SATUSEHAT RME, dan Kepmenkes 951/2026 dalam satu garis waktu.', href: '/id/dx-roadmap/' },
  { q: 'Peraturan apa yang baru terbit?', t: 'Kalender regulasi dan acara', d: 'Peraturan baru dari JDIH Kemenkes serta pelatihan dan acara terbaru.', href: '/id/calendar/' },
  { q: 'Vendor menawarkan sistem RME atau AI?', t: 'Daftar periksa RME dan vendor AI', d: 'Status alat kesehatan, registrasi sistem elektronik, interoperabilitas, penyimpanan, dan masa simpan.', href: '/id/rme-checklist/' },
  { q: 'Data pasien kami sudah aman?', t: 'Daftar periksa keamanan data pasien', d: '20 butir dari UU PDP, Permenkes 24/2022, dan PP 28/2024, lengkap dengan pasalnya.', href: '/id/cyber-checklist/' },
  { q: 'Sebelum menerapkan AI', t: 'Contoh kebijakan dan 20 pertanyaan untuk vendor', d: 'Draf dokumen yang bisa disalin dan disesuaikan saat proposal masuk.', href: '/id/templates/' },
  { q: 'Pasien dan keluarga ingin tahu', t: 'Sudut pasien', d: 'Sebelum bertanya soal kesehatan ke AI, hak saat rumah sakit memakai AI, dan hak atas rekam medis.', href: '/id/patients/' },
];

const promises = [
  { t: 'Berpegang pada sumber primer', d: 'Hanya menulis hal yang naskah resminya sudah dibuka dan dibaca (JDIH Kemenkes, JDIH Komdigi, siaran pers Kemenkes), disertai tautan.' },
  { t: 'Menampilkan tanggal verifikasi', d: 'Di bagian bawah setiap halaman panduan praktis dan sudut pasien ada "Sumber dan tanggal verifikasi". Peraturan berubah, jadi tanggal wajib ditampilkan.' },
  { t: 'Memeriksa tautan sumber setiap hari', d: `Tautan eksternal edisi Indonesia berjumlah ${linkHealth.total}, diperiksa otomatis setiap hari; yang tidak ditemukan ${linkHealth.dead.length}${checkedDay ? ` (${checkedDay})` : ''}.` },
  { t: 'Tidak merekomendasikan produk atau rumah sakit tertentu', d: 'Yang dibahas adalah apakah sesuatu dapat dipakai di rumah sakit Anda dan apa dasarnya — bukan merek, dan bukan dorongan untuk segera menerapkan.' },
];

const library = [
  { t: id.nav.guide, d: id.home.guideDesc, href: '/id/guide/' },
  { t: id.nav.glossary, d: id.home.glossaryDesc, href: '/id/glossary/' },
  { t: id.nav.faq, d: id.home.faqDesc, href: '/id/faq/' },
  { t: id.nav.checklist, d: id.home.checklistDesc, href: '/id/checklist/' },
  { t: id.nav.tips, d: id.home.tipsDesc, href: '/id/tips/' },
  { t: id.nav.videos, d: id.home.videosDesc, href: '/id/videos/' },
];

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/id/')}`;
const homeFaqLd = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#home-faq`,
  url: pageUrl,
  inLanguage: 'id',
  isPartOf: { '@id': `${siteRoot}/#website-id` },
  mainEntity: id.home.homeFaq.map((f, i) => ({
    '@type': 'Question',
    '@id': `${pageUrl}#home-q${i + 1}`,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const homeSeries = (await getResolvedSeries('id'))
  .slice()
  .sort((a, b) => b.posts.length - a.posts.length)
  .slice(0, 3);
---

<IdLayout
  title={id.home.metaTitle}
  description={id.home.metaDescription}
  koPath="/"
  twPath="/tw/"
  jaPath="/ja/"
  ruPath="/ru/"
  updated={updated}
  schema={[homeFaqLd]}
>
  <Fragment slot="hero">
    <section class="th-hero">
      <div class="th-hero-inner">
        <div class="th-hero-copy">
          <p class="th-eyebrow">RME, SATUSEHAT, dan AI untuk administrasi dan keperawatan rumah sakit</p>
          <h1>Keputusan menerapkan AI di rumah sakit,<br />dibaca dari peraturan Indonesia dan sumber primer.</h1>
          <p class="th-lead">
            Apakah produknya alat kesehatan, bolehkah data pasien diproses seperti itu, di mana data harus disimpan, dan dalam berapa jam insiden harus diberitahukan. Disusun dari naskah resmi JDIH Kemenkes dan JDIH Komdigi, setiap butir dengan sumber dan tanggal verifikasi.
          </p>
          <p class="th-cta">
            <a class="th-btn th-btn-main" href={withBase('/id/dx-roadmap/')}>Lihat peta waktu</a>
            <a class="th-btn th-btn-sub" href={withBase('/id/calendar/')}>Lihat peraturan baru</a>
          </p>
        </div>
        <aside class="th-hero-card" aria-labelledby="th-live-h">
          <h2 id="th-live-h"><span class="th-dot" aria-hidden="true"></span>Pembaruan terbaru</h2>
          <ul>
            {heroFeed.map((it) => (
              <li>
                <time datetime={it.date}>{fmtMD.format(new Date(it.date))}</time>
                <span class="th-chip">{KIND_LABEL[it.kind]}</span>
                <a href={it.href} {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
                  {it.title}
                  {it.external && <span class="sr-only">({id.ui.external})</span>}
                </a>
              </li>
            ))}
          </ul>
          <a class="th-hero-more" href={withBase('/id/updates/')}>Semua informasi pembaruan →</a>
        </aside>
      </div>
    </section>

    <section class="th-stats" aria-label="Kondisi situs">
      <ul>
        {
          stats.map((s) => (
            <li>
              <a href={withBase(s.href)}>
                <span class="th-num">{s.n.toLocaleString('id-ID')}<small>{s.unit}</small></span>
                <span class="th-lab">{s.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Fragment>

  <section class="th-sec" aria-labelledby="th-tasks-h">
    <h2 class="th-h" id="th-tasks-h"><span>Ketika Anda menghadapi ini</span><small>BY PURPOSE</small></h2>
    <div class="th-tasks">
      {
        tasks.map((x) => (
          <a class="th-task" href={withBase(x.href)}>
            <span class="th-task-q">{x.q}</span>
            <span class="th-task-t">{x.t}</span>
            <span class="th-task-d">{x.d}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="th-sec" aria-labelledby="th-feed-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-feed-h"><span>Informasi pembaruan</span><small>WHAT'S NEW</small></h2>
      <a class="th-more" href={withBase('/id/updates/')}>Lihat semua →</a>
    </div>
    <p class="th-note">
      7 hari terakhir: {KIND_LABEL.news} {weeklyCount('news')} · {KIND_LABEL.notice} {weeklyCount('notice')} · {KIND_LABEL.event} {weeklyCount('event')} · {KIND_LABEL.video} {weeklyCount('video')}
    </p>
    <ul class="th-feed">
      {
        newsFeed.map((it) => (
          <li>
            <time datetime={it.date}>{fmtYMD.format(new Date(it.date))}</time>
            <span class="th-chip">{KIND_LABEL[it.kind]}</span>
            <a href={it.href} {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
              {it.title}
              {it.external && <span class="sr-only">({id.ui.external})</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-gov-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-gov-h"><span>Peraturan baru dari JDIH Kemenkes</span><small>NEW REGULATIONS</small></h2>
      <a class="th-more" href={withBase('/id/calendar/')}>Lihat semua →</a>
    </div>
    <p class="th-note">Tanggal adalah tanggal penetapan peraturan, bukan tenggat. Isi dan status berlaku harus dibaca pada naskah resminya.</p>
    <ul class="th-feed th-feed-sub">
      {
        topNotices.map((n) => (
          <li>
            <time datetime={n.pubDate}>{fmtYMD.format(new Date(n.pubDate))}</time>
            <span class="th-chip th-chip-gov">{n.kind}</span>
            <a href={n.link} target="_blank" rel="noopener">
              {n.title}
              <span class="sr-only">({id.ui.external})</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-posts-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-posts-h"><span>Artikel pilihan</span><small>ARTICLES</small></h2>
      <a class="th-more" href={withBase('/id/blog/')}>Daftar artikel →</a>
    </div>
    <div class="th-posts">
      {
        featured.map((p) => (
          <article class="th-post">
            <p class="th-post-meta">
              <span class="th-chip">{p.data.category}</span>
              <time datetime={p.data.pubDate.toISOString()}>{fmtYMD.format(p.data.pubDate)}</time>
            </p>
            <h3><a href={withBase(`/id/blog/${p.id}/`)}>{p.data.title}</a></h3>
            <p class="th-post-d">{p.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <HomeSeries loc="id" list={homeSeries} />

  <section class="th-sec th-promise" aria-labelledby="th-promise-h">
    <h2 class="th-h" id="th-promise-h"><span>Prinsip situs ini</span><small>OUR PRINCIPLES</small></h2>
    <ul>
      {
        promises.map((x, i) => (
          <li>
            <span class="th-no">{i + 1}</span>
            <div>
              <strong>{x.t}</strong>
              <p>{x.d}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="th-note"><a href={withBase('/id/about/#principles')}>Prinsip penulisan dan verifikasi →</a></p>
  </section>

  <section class="th-sec" aria-labelledby="th-lib-h">
    <h2 class="th-h" id="th-lib-h"><span>Belajar dan referensi</span><small>LIBRARY</small></h2>
    <ul class="th-lib">
      {
        library.map((x) => (
          <li>
            <a href={withBase(x.href)}>
              <strong>{x.t}</strong>
              <span>{x.d}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-faq-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-faq-h"><span>{id.home.homeFaqTitle}</span><small>ABOUT THIS SITE</small></h2>
      <a class="th-more" href={withBase('/id/faq/')}>{id.home.homeFaqMore}</a>
    </div>
    <dl class="th-faq">
      {
        id.home.homeFaq.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <section class="th-sec" aria-labelledby="th-intro-h">
    <h2 class="th-h" id="th-intro-h"><span>{id.home.notTranslationTitle}</span><small>ABOUT</small></h2>
    <p>{id.home.notTranslationBody}</p>
    <h3>{id.home.sourceNoteTitle}</h3>
    <p>{id.home.sourceNoteBody}</p>
    <div class="id-note">
      <p><strong>{id.home.koNoticeTitle}</strong></p>
      <p style="margin-top:6px">{id.home.koNoticeBody}</p>
      <p style="margin-top:8px"><a href={withBase('/')} hreflang="ko">{id.ui.langKo} →</a></p>
    </div>
  </section>
</IdLayout>
