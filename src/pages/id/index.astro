---
// 인도네시아어판 홈 (Fase A — 2026-09-05 신설).
//
// 2026-09-06: 뉴스·정부 프로그램·추천 영상이 생기면서 카드 그리드를 넣었다.
// 처음 만들 때는 참조 페이지가 없어 일부러 카드를 안 뒀다 — 내용 없는
// 페이지로 링크를 걸면 방문자 신뢰도 떨어지고 검색엔진도 빈약한 페이지로
// 취급하기 때문이다. 지금은 여섯 곳 다 실제 내용이 있어 입구를 연다.
// ⚠️ 카드는 **내용이 있는 페이지만** 건다. 새 페이지를 만들 때 카드부터
//    추가하지 말 것.
import IdLayout from '../../layouts/IdLayout.astro';
import id from '../../i18n/id.json';
import { withBase } from '../../utils/site';
---

<IdLayout
  title={id.home.metaTitle}
  description={id.home.metaDescription}
  koPath="/"
  twPath="/tw/"
  jaPath="/ja/"
  ruPath="/ru/"
>
  <p class="id-updated" style="letter-spacing:.06em">{id.home.heroEyebrow}</p>
  <h1>{id.home.heroTitle}</h1>
  <p>{id.home.heroLead}</p>

  <p style="margin-top:16px">
    <a class="id-cta" href={withBase('/id/about/')}>{id.nav.about} →</a>
  </p>

  <div class="id-cards">
    <a class="id-card" href={withBase('/id/glossary/')}>
      <span class="id-card-t">{id.nav.glossary}</span>
      <span class="id-card-d">{id.home.glossaryDesc}</span>
    </a>
    <a class="id-card" href={withBase('/id/faq/')}>
      <span class="id-card-t">{id.nav.faq}</span>
      <span class="id-card-d">{id.home.faqDesc}</span>
    </a>
    <a class="id-card" href={withBase('/id/news/')}>
      <span class="id-card-t">{id.nav.news}</span>
      <span class="id-card-d">{id.home.newsDesc}</span>
    </a>
    <a class="id-card" href={withBase('/id/gov-support/')}>
      <span class="id-card-t">{id.nav.govSupport}</span>
      <span class="id-card-d">{id.home.govSupportDesc}</span>
    </a>
    <a class="id-card" href={withBase('/id/videos/')}>
      <span class="id-card-t">{id.nav.videos}</span>
      <span class="id-card-d">{id.home.videosDesc}</span>
    </a>
    <a class="id-card" href={withBase('/id/blog/')}>
      <span class="id-card-t">{id.nav.blog}</span>
      <span class="id-card-d">{id.home.blogDesc}</span>
    </a>
  </div>

  <h2>{id.home.notTranslationTitle}</h2>
  <p>{id.home.notTranslationBody}</p>

  <h2>{id.home.sourceNoteTitle}</h2>
  <p>{id.home.sourceNoteBody}</p>

  <div class="id-note">
    <p><strong>{id.home.koNoticeTitle}</strong></p>
    <p style="margin-top:6px">{id.home.koNoticeBody}</p>
    <p style="margin-top:8px"><a href={withBase('/')} hreflang="ko">{id.ui.langKo} →</a></p>
  </div>

  <p class="id-wip">{id.ui.underConstruction}</p>
</IdLayout>

<style>
  .id-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 12px;
    margin: 26px 0 8px;
  }
  .id-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid var(--id-border);
    background: var(--id-base);
    padding: 14px 16px;
    text-decoration: none;
    color: var(--id-text);
  }
  .id-card:hover {
    background: var(--id-surface);
    border-color: var(--id-primary);
  }
  .id-card-t {
    font-weight: 700;
    color: var(--id-primary);
    font-size: 15px;
  }
  .id-card-d {
    font-size: 13px;
    line-height: 1.8;
    color: var(--id-text-sub);
  }

  .id-wip {
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid var(--id-border);
    font-size: 13.5px;
    color: var(--id-text-sub);
  }
</style>
