---
// Program Pemerintah — 인도네시아 정부 지원·제도 안내 (2026-09-06 신설)
//
// ⚠️ 한국어판 /gov-support/·일본어판 /ja/subsidies/와 달리 **자동 수집이
//    아니다.** 인도네시아에는 jGrants(일본)나 보건복지부 공고 목록(한국)처럼
//    기계로 읽을 수 있는 공고 소스를 찾지 못했다(사유는 gov-support.json의
//    _comment에 적어 뒀다). 그래서 hreflang으로 한국어판과 짝지우지 않는다 —
//    성격이 다른 페이지에 alternate를 걸면 잘못된 신호가 된다.
//
// ⚠️ 자동 수집이 아니라는 사실을 화면에서 숨기지 않는다. 방문자가 최신
//    공고로 착각하면 신뢰를 해친다. notice와 확인일을 반드시 함께 노출한다.
import IdLayout from '../../layouts/IdLayout.astro';
import idI18n from '../../i18n/id.json';
import { govSupportId } from '../../data/id/pages';
import { withBase } from '../../utils/site';

const p = govSupportId;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/id/gov-support/')}`;

// ItemList로만 전달한다. 각 항목은 우리가 만든 공고가 아니라 정부 페이지로
// 가는 안내이므로 GovernmentService 등으로 단정하지 않는다.
const schema = [
  {
    '@type': 'ItemList',
    '@id': `${pageUrl}#programs`,
    name: p.meta.pageTitle,
    numberOfItems: p.programs.length,
    itemListElement: p.programs.map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.name,
      url: it.url,
    })),
  },
];
---

<IdLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={idI18n.nav.govSupport}
  koPath="/gov-support/"
  standalone
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="id-lead">{p.meta.lead}</p>

  <p class="id-notice">{p.notice}</p>

  <ul class="id-programs">
    {
      p.programs.map((it) => (
        <li>
          <h2>
            <a href={it.url} target="_blank" rel="noopener">
              {it.name}
              <span class="sr-only"> ({idI18n.ui.external})</span>
            </a>
          </h2>
          <p class="id-org">{it.org}</p>
          <p class="id-body">{it.body}</p>
          <p class="id-audience">
            <strong>Untuk siapa:</strong> {it.audience}
          </p>
          <p class="id-src">
            {idI18n.ui.source}:{' '}
            <a href={it.sourceUrl} target="_blank" rel="noopener">
              {it.sourceLabel}
              <span class="sr-only"> ({idI18n.ui.external})</span>
            </a>{' '}
            · diperiksa {p.checkedAt}
          </p>
        </li>
      ))
    }
  </ul>

  <div class="id-note">
    <p>
      Daftar ini tidak memuat seluruh program pemerintah. Yang dicantumkan hanya
      program yang keterangannya dapat diperiksa langsung di halaman resminya.
      Program yang tidak dapat dipastikan dari sumber resmi sengaja tidak
      dimasukkan, agar tidak ada keterangan yang keliru di halaman ini.
    </p>
  </div>
</IdLayout>

<style>
  .id-lead {
    color: var(--id-text-sub);
  }
  .id-notice {
    border: 1px solid var(--id-border);
    border-left: 4px solid var(--id-primary);
    background: var(--id-surface);
    padding: 12px 14px;
    font-size: 13.5px;
    line-height: 1.85;
    margin-bottom: 20px;
  }
  .id-programs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--id-border);
  }
  .id-programs li {
    padding: 18px 0;
    border-bottom: 1px solid var(--id-border);
  }
  .id-programs h2 {
    font-size: 16px;
    margin: 0 0 4px;
    line-height: 1.6;
  }
  .id-programs h2 a {
    color: var(--id-primary);
  }
  .id-org {
    margin: 0 0 8px;
    font-size: 13px;
    color: var(--id-text-sub);
  }
  .id-body {
    margin: 0 0 8px;
    line-height: 1.9;
  }
  .id-audience {
    margin: 0 0 6px;
    font-size: 13.5px;
    line-height: 1.85;
  }
  .id-src {
    margin: 0;
    font-size: 12.5px;
    color: var(--id-text-sub);
  }
  .id-note {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--id-border);
    font-size: 13px;
    line-height: 1.9;
    color: var(--id-text-sub);
  }
</style>
