---
// 인도네시아어판 소개 (Fase A — 2026-09-05 신설).
// 저자 사실은 briefing.md에 있는 것만 쓴다(CLAUDE.md 절대 원칙).
// ja·ru판과 같은 범위 — 경력 17년(기획 7년), 통계학 석사·경제학 박사까지만.
import IdLayout from '../../layouts/IdLayout.astro';
import id from '../../i18n/id.json';
import { withBase, CONTACT_EMAIL, YOUTUBE_CHANNEL_URL } from '../../utils/site';

// ProfilePage — 화면에 보이는 사실만 마크업한다(구글은 비가시 콘텐츠
// 마크업을 금지하고, 이 사이트의 사실 검증 원칙과도 어긋난다).
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const profilePage = {
  '@type': 'ProfilePage',
  '@id': `${siteUrl}${withBase('/id/about/')}#profilepage`,
  url: `${siteUrl}${withBase('/id/about/')}`,
  inLanguage: 'id-ID',
  mainEntity: { '@id': `${siteUrl}/#person` },
  isPartOf: { '@id': `${siteUrl}/#website-id` },
};
---

<IdLayout
  title={id.about.metaTitle}
  description={id.about.metaDescription}
  crumb={id.nav.about}
  koPath="/about/"
  jaPath="/ja/about/"
  ruPath="/ru/about/"
  schema={[profilePage]}
>
  <h1>{id.about.pageTitle}</h1>
  <p class="id-lead">{id.about.lead}</p>

  <h2>{id.about.careerHeading}</h2>
  <dl class="id-profile">
    <dt>Nama</dt>
    <dd>{id.profile.name}</dd>
    <dt>Jabatan</dt>
    <dd>{id.profile.role}</dd>
    <dt>Pengalaman</dt>
    <dd>{id.profile.career}</dd>
    <dt>Pendidikan</dt>
    <dd>{id.profile.education}</dd>
  </dl>

  <h2>{id.about.whyHeading}</h2>
  <p>{id.about.whyBody}</p>

  <h2>{id.about.contactHeading}</h2>
  <ul class="id-contact">
    <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
    <li>
      <a href={YOUTUBE_CHANNEL_URL} target="_blank" rel="noopener">
        {id.profile.youtube}
        <span class="sr-only"> ({id.ui.external})</span>
      </a>
    </li>
  </ul>
</IdLayout>

<style>
  .id-lead {
    color: var(--id-text-sub);
  }
  .id-profile {
    margin: 16px 0 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 18px;
    font-size: 14.5px;
    line-height: 1.75;
  }
  .id-profile dt {
    font-weight: 600;
    color: var(--id-text-sub);
  }
  .id-profile dd {
    margin: 0;
  }
  .id-contact {
    margin: 12px 0 0;
    padding-left: 18px;
    font-size: 14.5px;
    line-height: 1.9;
  }
</style>
