---

<IdLayout title={title} description={description} crumb="Contoh dokumen" standalone updated={new Date('2026-10-31T00:00:00+07:00')}>
  <h1>Contoh kebijakan AI generatif dan 20 pertanyaan untuk vendor</h1>
  <p class="tg-lead">
    "Tidak tahu mulai menulis dari mana" adalah keluhan banyak rumah sakit. Di sini ada empat draf: tekan tombol untuk menyalin, lalu ganti garis bawah (__) dengan isi rumah sakit Anda.
  </p>
  <p class="tg-meta">Diverifikasi: {CHECKED} · Untuk: administrasi dan TI rumah sakit</p>

  <div class="tg-box tg-warn">
    <strong>Mohon perhatikan sebelum memakai</strong><br />
    Ini <strong>draf</strong> buatan penulis, bukan nasihat hukum, dan bukan versi yang "tinggal salin sudah cukup". Sesuaikan dengan ukuran, sistem, dan kontrak rumah sakit Anda, lalu minta bagian hukum/kepatuhan memeriksanya sebelum dijadikan dokumen resmi.
  </div>

  <section class="tg-sec" aria-labelledby="h-toc">
    <h2 id="h-toc">Isi halaman</h2>
    <ul class="tg-list">
      {items.map((it) => <li><a href={`#${it.id}`}>{it.head}</a></li>)}
    </ul>
    <p>
      Penjelasan terkait: <a href={withBase('/id/dx-roadmap/')}>Peta waktu</a>, <a href={withBase('/id/rme-checklist/')}>Daftar periksa RME dan vendor</a>, dan <a href={withBase('/id/cyber-checklist/')}>Daftar periksa keamanan data pasien</a>.
    </p>
  </section>

  {
    items.map((it) => (
      <section class="tg-sec" id={it.id} aria-labelledby={`${it.id}-h`}>
        <h2 id={`${it.id}-h`}>{it.head}</h2>
        <p>{it.lead}</p>
        <div class="tg-copy">
          <button type="button" class="tg-btn" data-target={`${it.id}-text`}>
            Salin
          </button>
          <pre id={`${it.id}-text`}>{it.text}</pre>
        </div>
        <h3>Dasar draf ini</h3>
        <ul class="tg-list">
          {it.basis.map((b) => <li>{b}</li>)}
        </ul>
      </section>
    ))
  }

  <IdGuideFoot sources={sources} checked={CHECKED} />
</IdLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.tg-btn[data-target]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = document.getElementById(btn.dataset.target ?? '');
      if (!el) return;
      const label = btn.textContent;
      try {
        await navigator.clipboard.writeText(el.textContent ?? '');
        btn.textContent = 'Tersalin';
      } catch {
        // Bila papan klip tidak tersedia: pilih isinya agar pengguna menyalin sendiri
        const r = document.createRange();
        r.selectNodeContents(el);
        const s = window.getSelection();
        s?.removeAllRanges();
        s?.addRange(r);
        btn.textContent = 'Terpilih (tekan Ctrl+C)';
      }
      setTimeout(() => (btn.textContent = label), 2500);
    });
  });
</script>
