---
// Чек-лист: электронные медицинские документы и ИИ-поставщик (2026-10-31)
// ⚠️ Пункты составлены автором по тексту приказа Минздрава № 209н (legalacts.ru, полный текст; регистрация — publication.pravo.gov.ru) и приказа Росздравнадзора № 123 (ГАРАНТ).
//    Это не официальный чек-лист. Что именно передаёт конкретное изделие в АИС Росздравнадзора, страница не утверждает.
import '../../styles/ru-guide.css';
import RuLayout from '../../layouts/RuLayout.astro';
import RuGuideFoot from '../../components/RuGuideFoot.astro';
import RuFaq from '../../components/RuFaq.astro';
import { guideSchema } from '../../utils/ru-guide';
import { SRC } from '../../data/ru/guides/milestones';
import { withBase } from '../../utils/site';

const CHECKED = '31 октября 2026 г.';
const title = 'Чек-лист: электронные медицинские документы и ИИ-поставщик';
const description =
  'Что проверить, когда документы ведутся по приказу Минздрава № 209н, а ИИ-сервис готовит черновик или передаёт данные: подпись, регистрация в РЭМД, журналы, приказ Росздравнадзора № 123.';

type Item = { no: string; text: string; basis: string };
type Group = { id: string; head: string; lead?: string; items: Item[] };

const groups: Group[] = [
  {
    id: 'g1',
    head: 'А. Электронные медицинские документы (приказ № 209н)',
    lead: 'Приказ от 25.03.2026 № 209н вступает в силу с 1 сентября 2026 г. и действует до 1 сентября 2032 г.; он заменил приказ № 947н.',
    items: [
      { no: '1', text: 'Документация ведётся в электронной форме без дублирования на бумаге, если пациент или его законный представитель не подал простое письменное заявление о бумажном виде; процедура приёма таких заявлений описана.', basis: 'Приказ № 209н, Порядок, п. 2' },
      { no: '2', text: 'Электронный медицинский документ подписывает усиленной квалифицированной электронной подписью работник, который его сформировал (кроме случаев п. 13 Порядка). В регламенте указано, что работник проверил черновик, подготовленный ИИ, и отвечает за подписанный текст.', basis: 'Приказ № 209н, Порядок, п. 9' },
      { no: '3', text: 'Документы, подлежащие регистрации в РЭМД, регистрируются в течение одного рабочего дня со дня формирования; кто и как отправляет документы на регистрацию, определено.', basis: 'Приказ № 209н, Порядок, раздел о регистрации в РЭМД' },
      { no: '4', text: 'Организация при переходе на электронные документы закрепила в локальном акте перечень форм и видов документов, перечень информационных систем, порядок доступа и порядок определения подписывающих лиц.', basis: 'Приказ № 209н, Порядок, п. 4 (по тексту приказа)' },
    ],
  },
  {
    id: 'g2',
    head: 'Б. ИИ-сервис, который готовит или передаёт документы',
    items: [
      { no: '5', text: 'ИИ-сервис не подписывает документы и не регистрирует их самостоятельно: подпись и ответственность — на работнике, сформировавшем документ.', basis: 'Рекомендация автора на основе п. 9 Порядка' },
      { no: '6', text: 'Определено, где хранятся черновики ИИ и журналы запросов, кто имеет к ним доступ и как они удаляются.', basis: 'Рекомендация автора' },
      { no: '7', text: 'Если ИИ-сервис — медицинское изделие, поставщик объяснил, какие сведения автоматически передаются в АИС Росздравнадзора (приказ № 123, действует до 31.12.2027) и закрепил это в договоре.', basis: 'Приказ Росздравнадзора № 123' },
      { no: '8', text: 'Поставщик письменно описал назначение продукта; для административного ИИ (письма, черновики) — почему он не является медицинским изделием; для диагностического — номер регистрационного удостоверения.', basis: 'Рекомендация автора' },
    ],
  },
];

const total = groups.reduce((n, g) => n + g.items.length, 0);

const faq = [
  {
    q: 'Нужно ли дублировать медицинскую документацию на бумаге с 1 сентября 2026 года?',
    a: 'Нет, если пациент или его законный представитель не подал простое письменное заявление о ведении документации в бумажном виде (приказ № 209н, Порядок, п. 2).',
  },
  {
    q: 'Чем подписывается электронный медицинский документ?',
    a: 'Усиленной квалифицированной электронной подписью работника, сформировавшего документ, за исключением случаев, указанных в пункте 13 Порядка (п. 9).',
  },
  {
    q: 'В какие сроки документы регистрируются в РЭМД?',
    a: 'Электронные медицинские документы, подлежащие регистрации в Федеральном реестре электронных медицинских документов, регистрируются в течение одного рабочего дня со дня их формирования.',
  },
];

const sources = [SRC.order209, SRC.order209off, SRC.rzn123];

const siteRootG = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const guide = guideSchema({
  siteRoot: siteRootG,
  path: '/ru/documents-checklist/',
  headline: title,
  description,
  sources,
  published: '2026-10-31',
  modified: '2026-10-31',
  audience: 'Администрация и врачебно-сестринские руководители больниц',
  faq,
});
---

<RuLayout title={title} description={description} crumb="Электронные документы" standalone updated={new Date('2026-10-31T00:00:00+03:00')} schema={guide}>
  <h1>Чек-лист: электронные медицинские документы и ИИ-поставщик</h1>
  <p class="tg-lead">
    Когда документы ведутся по новому порядку, а черновик готовит ИИ-сервис, возникает вопрос: кто «сформировал» документ и кто за него отвечает? Здесь — пункты приказа № 209н и приказа Росздравнадзора № 123, которые стоит проверить.
  </p>
  <p class="tg-meta">Проверено: {CHECKED} · {total} пунктов · Для: администрации и руководителей больниц</p>

  <p class="tg-answer">
    Главное: приказ № 209н действует с 1 сентября 2026 г. до 1 сентября 2032 г.; документ подписывает усиленной квалифицированной электронной подписью сформировавший его работник (п. 9); регистрация в РЭМД — в течение одного рабочего дня.
  </p>

  <div class="tg-box tg-warn">
    <strong>Сначала важное</strong>
    <ul class="tg-list">
      <li>Это <strong>не официальный чек-лист</strong>, а пункты автора по тексту приказов; сверяйтесь с полным текстом.</li>
      <li>Об ИИ в тексте приказа № 209н ничего не сказано; пункты раздела Б — наши выводы и рекомендации.</li>
    </ul>
  </div>

  {
    groups.map((g) => (
      <section class="tg-sec" id={g.id} aria-labelledby={`${g.id}-h`}>
        <h2 id={`${g.id}-h`}>{g.head}</h2>
        {g.lead && <p>{g.lead}</p>}
        <table class="tg-table">
          <thead>
            <tr>
              <th>№</th>
              <th>Что проверить</th>
              <th>Основание</th>
            </tr>
          </thead>
          <tbody>
            {g.items.map((it) => (
              <tr>
                <th>{it.no}</th>
                <td>{it.text}</td>
                <td>{it.basis}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))
  }

  <section class="tg-sec" aria-labelledby="h-next">
    <h2 id="h-next">Дальше</h2>
    <div class="tg-cards">
      <a class="tg-card" href={withBase('/ru/data-checklist/')}>
        <b>Чек-лист защиты данных пациентов</b>
        <span>Уведомление об инцидентах, локализация баз, КИИ.</span>
      </a>
      <a class="tg-card" href={withBase('/ru/templates/')}>
        <b>Шаблоны документов</b>
        <span>20 вопросов поставщику и политика по генеративному ИИ.</span>
      </a>
    </div>
  </section>

  <RuFaq items={faq} />

  <RuGuideFoot sources={sources} checked={CHECKED} />
</RuLayout>
