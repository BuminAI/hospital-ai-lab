---
// 의료 기술·논문 (2026-11-14, 오너 지시). 데이터는 scripts/fetch-research.mjs 가 수집한 src/data/research/ru.json
import RuLayout from '../../layouts/RuLayout.astro';
import ResearchView from '../../components/ResearchView.astro';
import { RESEARCH_STRINGS, researchSchema } from '../../data/research/strings';
import data from '../../data/research/ru.json';

const t = RESEARCH_STRINGS.ru;
const schema = [researchSchema('ru', data, t.metaTitle, t.metaDescription)];
---

<RuLayout
  title={t.metaTitle}
  description={t.metaDescription}
  crumb={t.nav}
  koPath="/research/"
  jaPath="/ja/research/"
  idPath="/id/research/"
  twPath="/tw/research/"
  enPath="/en/research/"
  inPath="/in/research/"
  sgPath="/sg/research/"
  phPath="/ph/research/"
  updated={new Date(data.updatedAt)}
  schema={schema}
>
  <h1>{t.h1}</h1>
  <ResearchView loc="ru" />
</RuLayout>
