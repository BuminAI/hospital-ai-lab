    <p>
      Смежные страницы: <a href={withBase('/ru/dx-roadmap/')}>Дорожная карта</a>, <a href={withBase('/ru/data-checklist/')}>Чек-лист защиты данных</a>, <a href={withBase('/ru/documents-checklist/')}>Чек-лист: электронные документы и ИИ</a>.
    </p>
  </section>

  {
    items.map((it) => (
