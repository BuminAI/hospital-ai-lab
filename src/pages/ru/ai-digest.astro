---
// ИИ-дайджест — 일반 기술 매체의 AI 기사 모음 (2026-09-10 신설, 오너 지시)
//
// /ru/news/ 는 의료 AI 전용이고 이 페이지는 그 밖의 AI 기사다. 둘을 섞지 않는다
// (섞으면 의료 AI 뉴스 페이지의 주제가 흐려진다 — scripts/fetch-ai-digest.mjs 머리말).
//
// ⚠️ hreflang 을 걸지 않는다(standalone). 자동 수집 목록은 언어판마다 기사가
//    완전히 달라 번역 관계가 아니다. /ru/news/ 와 같은 원칙.
// ⚠️ 이 페이지는 **링크 모음**이다. 검색·답변 엔진이 인용할 수 있으려면 목록
//    말고도 이 사이트만의 문장이 있어야 하므로, "왜 병원 행정에 필요한가"를
//    설명하는 문단을 함께 둔다. 그 문단을 지우면 그냥 스크랩 페이지가 된다.
import RuLayout from '../../layouts/RuLayout.astro';
import ru from '../../i18n/ru.json';
import { withBase } from '../../utils/site';
import digest from '../../data/ru/ai-digest.json';

const fmt = new Intl.DateTimeFormat('ru-RU', {
  timeZone: 'Europe/Moscow',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const items = digest.items;
const sources = [...new Set(items.map((i) => i.source))].sort();

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/ru/ai-digest/')}`;

const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: ru.aiDigest.pageTitle,
  description: ru.aiDigest.metaDescription,
  inLanguage: 'ru-RU',
  isPartOf: { '@id': `${siteUrl}/#website-ru` },
  dateModified: digest.updatedAt,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<RuLayout
  title={ru.nav.aiDigest}
  description={ru.aiDigest.metaDescription}
  crumb={ru.nav.aiDigest}
  standalone
  updated={new Date(digest.updatedAt)}
  schema={[collectionPage]}
>
  <h1>{ru.aiDigest.pageTitle}</h1>
  <p class="ru-lead">{ru.aiDigest.lead}</p>

  <div class="ru-note">
    <p><strong>{ru.aiDigest.why}</strong></p>
    <p style="margin-top:6px">{ru.aiDigest.whyBody}</p>
  </div>

  <p class="ru-caution">{ru.aiDigest.notice}</p>

  <p class="ru-src-line">
    <strong>{ru.aiDigest.sourcesTitle}:</strong> {sources.join(' · ')}
  </p>

  {
    items.length > 0 ? (
      <ul class="ru-news-list">
        {items.map((item) => (
          <li>
            <a href={item.link} target="_blank" rel="noopener">
              {item.title}
              <span class="sr-only"> ({ru.ui.external})</span>
            </a>
            <span class="ru-meta">
              {item.source} · <time datetime={item.pubDate}>{fmt.format(new Date(item.pubDate))}</time>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p>{ru.aiDigest.empty}</p>
    )
  }
</RuLayout>

<style>
  .ru-src-line {
    font-size: 13px;
    color: var(--ru-text-sub);
    margin-top: 18px;
  }
  .ru-news-list {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }
  .ru-news-list li {
    padding: 11px 0;
    border-bottom: 1px solid var(--ru-border);
  }
  .ru-news-list a {
    color: var(--ru-text);
    text-decoration: none;
    font-size: 14.5px;
    line-height: 1.7;
  }
  .ru-news-list a:hover {
    color: var(--ru-primary);
    text-decoration: underline;
  }
  .ru-meta {
    display: block;
    margin-top: 4px;
    font-size: 12.5px;
    color: var(--ru-text-sub);
  }
</style>
