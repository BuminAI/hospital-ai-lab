---
// Практикум (для сотрудников больниц) — обзорная страница (2026-10-31)
import '../../styles/ru-guide.css';
import RuLayout from '../../layouts/RuLayout.astro';
import { withBase } from '../../utils/site';

const title = 'Практикум: данные пациентов, документы и ИИ для администрации';
const description =
  'Дорожная карта, чек-листы по защите данных и электронным документам, календарь новых актов, шаблоны и ключевые факты — по первичным текстам для администрации и сестринской службы больниц.';

const cards = [
  { href: '/ru/fakty/', t: 'Ключевые факты', d: 'Короткие ответы со статьёй и ссылкой на первичный источник — персональные данные, документы, КИИ.' },
  { href: '/ru/dx-roadmap/', t: 'Дорожная карта', d: '152-ФЗ, КоАП 13.11, 265-ФЗ, ФСТЭК № 117, приказы № 209н и № 123 на одной шкале времени.' },
  { href: '/ru/data-checklist/', t: 'Чек-лист защиты данных пациентов', d: 'Основание обработки, локализация, трансграничная передача, инциденты 24/72 часа, КИИ.' },
  { href: '/ru/documents-checklist/', t: 'Чек-лист: электронные документы и ИИ', d: 'Приказ № 209н, подпись, РЭМД и вопросы ИИ-поставщику.' },
  { href: '/ru/calendar/', t: 'Календарь актов', d: 'Новые акты Минздрава, Росздравнадзора, ФСТЭК и Роскомнадзора с официального портала.' },
  { href: '/ru/templates/', t: 'Шаблоны документов', d: 'Политика по генеративному ИИ, 20 вопросов поставщику, текст для пациента, карточка инцидента.' },
  { href: '/ru/checklist/', t: 'Чек-лист внедрения ИИ', d: 'Список для оценки предложений поставщиков ИИ.' },
];
---

<RuLayout title={title} description={description} crumb="Практикум" standalone>
  <h1>Практикум</h1>
  <p class="tg-lead">
    Для администрации, планирования и сестринской службы: материалы, которыми можно воспользоваться завтра. Нормы записаны после того, как тексты открыли и прочитали (КонсультантПлюс, официальный портал опубликования, полные тексты приказов); на каждой странице — источники и дата проверки.
  </p>
  <div class="tg-cards">
    {
      cards.map((c) => (
        <a class="tg-card" href={withBase(c.href)}>
          <b>{c.t}</b>
          <span>{c.d}</span>
        </a>
      ))
    }
  </div>
  <p class="tg-meta" style="margin-top:22px">
    Объяснения для пациентов и их близких — в разделе <a href={withBase('/ru/patients/')}>«Для пациентов»</a>; ими могут пользоваться и сотрудники регистратуры.
  </p>
</RuLayout>
