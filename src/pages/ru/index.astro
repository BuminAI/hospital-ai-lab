---
// 러시아어판 홈 (Phase B — 실제 콘텐츠로 교체)
import RuLayout from '../../layouts/RuLayout.astro';
import ru from '../../i18n/ru.json';
import { withBase } from '../../utils/site';
import newsData from '../../data/ru/news.json';

// ── AEO/GEO — 홈에서 바로 답이 되는 블록 (2026-09-07) ──────────
// 답변 엔진은 "이 사이트는 무엇이고 누구를 위한 것인가"를 물었을 때
// **그 답이 실제로 적혀 있는 페이지**를 인용한다. 홈이 소개 문단만
// 있으면 인용할 문장이 없다. 그래서 사이트 자체에 대한 문답을
// 화면에 그대로 싣고 FAQPage로 표시한다.
//
// ⚠️ 여기 답변은 /ru/faq/ 의 제도 문답과 **내용이 겹치지 않는다.**
//    저쪽은 "AI를 도입할 때 무엇을 확인하나", 여기는 "이 사이트는
//    무엇인가"다. 같은 문답을 두 곳에 복사하면 안 된다.
// ⚠️ 답변에 적은 사실(수집처·갱신 주기)은 scripts/ 의 수집기와
//    .github/workflows/ 의 cron 에서 확인한 것이다. 수집처나 주기를
//    바꾸면 이 문구도 함께 고칠 것.
const recentNews = newsData.items.slice(0, 5);

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/ru/')}`;

const homeFaqLd = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#home-faq`,
  url: pageUrl,
  inLanguage: 'ru',
  isPartOf: { '@id': `${siteRoot}/#website-ru` },
  mainEntity: ru.home.homeFaq.map((f, i) => ({
    '@type': 'Question',
    '@id': `${pageUrl}#home-q${i + 1}`,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<RuLayout
  title={ru.home.metaTitle}
  description={ru.home.metaDescription}
  koPath="/"
  twPath="/tw/"
  jaPath="/ja/"
  idPath="/id/"
  schema={[homeFaqLd]}
>
  <p class="ru-updated" style="letter-spacing:.06em">{ru.home.heroEyebrow}</p>
  <h1>{ru.home.heroTitle}<br />{ru.home.heroTitle2}</h1>
  <p>{ru.home.heroLead}</p>

  <p style="margin-top:16px">
    <a class="ru-cta" href={withBase('/ru/about/')}>{ru.home.ctaAbout}</a>
  </p>

  <h2>{ru.home.resourcesTitle}</h2>
  <div class="ru-cards">
    <a class="ru-card" href={withBase('/ru/ai-digest/')}>
      <span class="ru-card-t">{ru.nav.aiDigest}</span>
      <span class="ru-card-d">{ru.home.aiDigestDesc}</span>
    </a>
    <a class="ru-card" href={withBase('/ru/glossary/')}>
      <span class="ru-card-t">{ru.nav.glossary}</span>
      <span class="ru-card-d">{ru.home.glossaryDesc}</span>
    </a>
    <a class="ru-card" href={withBase('/ru/faq/')}>
      <span class="ru-card-t">{ru.nav.faq}</span>
      <span class="ru-card-d">{ru.home.faqDesc}</span>
    </a>
    <a class="ru-card" href={withBase('/ru/guide/')}>
      <span class="ru-card-t">{ru.nav.guide}</span>
      <span class="ru-card-d">{ru.home.guideDesc}</span>
    </a>
    <a class="ru-card" href={withBase('/ru/checklist/')}>
      <span class="ru-card-t">{ru.nav.checklist}</span>
      <span class="ru-card-d">{ru.home.checklistDesc}</span>
    </a>
  </div>

  {/* 최신 뉴스 — 홈에 실제 내용이 있어야 검색·답변 엔진이 인용할 거리가 생긴다.
      한국어판 홈이 이미 쓰는 방식이고, 다른 판에는 빠져 있었다(2026-09-07 추가). */}
  {
    recentNews.length > 0 && (
      <section class="ru-home-sec">
        <div class="ru-sec-head">
          <h2>{ru.home.homeNewsTitle}</h2>
          <a class="ru-more" href={withBase('/ru/news/')}>{ru.home.homeNewsMore}</a>
        </div>
        <ul class="ru-news-preview">
          {recentNews.map((item) => (
            <li>
              <a href={item.link} target="_blank" rel="noopener">
                {item.title}
                <span class="sr-only"> ({ru.ui.external})</span>
              </a>
              {item.source && <span class="ru-src">{item.source}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* 사이트 자체에 대한 문답. /ru/faq/ 의 제도 문답과 내용이 겹치지 않는다. */}
  <section class="ru-home-sec">
    <div class="ru-sec-head">
      <h2>{ru.home.homeFaqTitle}</h2>
      <a class="ru-more" href={withBase('/ru/faq/')}>{ru.home.homeFaqMore}</a>
    </div>
    <dl class="ru-home-faq">
      {
        ru.home.homeFaq.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <h2>{ru.home.introTitle}</h2>
  <p>{ru.home.introBody}</p>

  <div class="ru-note">
    <p><strong>{ru.home.koNoticeTitle}</strong></p>
    <p style="margin-top:6px">{ru.home.koNoticeBody}</p>
    <p style="margin-top:8px"><a href={withBase('/')} hreflang="ko">{ru.ui.langKo} →</a></p>
  </div>
</RuLayout>

<style>
  .ru-cta {
    display: inline-block;
    background: var(--ru-btn-bg);
    color: var(--ru-btn-fg);
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 4px;
    font-size: 14.5px;
  }
  .ru-cta:hover {
    background: var(--ru-btn-bg-hover);
  }

  .ru-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 14px;
    margin-top: 4px;
  }
  .ru-card {
    display: block;
    border: 1px solid var(--ru-border);
    border-left: 4px solid var(--ru-primary);
    background: var(--ru-base);
    padding: 14px 16px;
    text-decoration: none;
    color: var(--ru-text);
  }
  .ru-card:hover {
    background: var(--ru-surface);
  }
  .ru-card-t {
    display: block;
    font-size: 15.5px;
    color: var(--ru-primary);
    margin-bottom: 6px;
  }
  .ru-card-d {
    display: block;
    font-size: 13.5px;
    color: var(--ru-text-sub);
    line-height: 1.8;
  }

  /* 홈 뉴스·문답 (2026-09-07 AEO/GEO) */
  .ru-home-sec {
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--ru-border);
  }
  .ru-sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ru-sec-head h2 {
    margin: 0;
  }
  .ru-more {
    font-size: 13px;
    color: var(--ru-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .ru-more:hover { text-decoration: underline; }
  .ru-news-preview {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }
  .ru-news-preview li {
    padding: 9px 0;
    border-bottom: 1px solid var(--ru-border);
    font-size: 14px;
    line-height: 1.7;
  }
  .ru-news-preview a {
    color: var(--ru-text);
    text-decoration: none;
  }
  .ru-news-preview a:hover { color: var(--ru-primary); text-decoration: underline; }
  .ru-src {
    display: inline-block;
    margin-left: 8px;
    font-size: 12px;
    color: var(--ru-text-sub);
  }
  .ru-home-faq {
    margin: 14px 0 0;
  }
  .ru-home-faq dt {
    font-weight: 700;
    color: var(--ru-primary);
    margin-top: 16px;
    font-size: 14.5px;
    line-height: 1.7;
  }
  .ru-home-faq dt:first-child { margin-top: 0; }
  .ru-home-faq dd {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.9;
    color: var(--ru-text);
  }
</style>
