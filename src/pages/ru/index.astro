---
// Главная страница русской редакции (2026-10-31, редизайн — та же структура, что в индонезийской, японской и тайваньской редакциях)
//
// Структура (сверху вниз):
//   1) Hero: обещание одной фразой + два действия + «Свежие обновления» справа (доказательство, что сайт живой)
//   2) Ряд цифр доверия: только реальные данные, ничего выдуманного
//   3) «Когда вы столкнулись с этим»: шесть входов по задаче
//   4) Обновления, новые акты с портала официального опубликования, избранные статьи, серии
//   5) Принципы, библиотека, частые вопросы, о сайте
// ⚠️ Стаж автора не пишется в тексте главной и мета-описании (профиль в боковой колонке остаётся прежним).
// ⚠️ Цифры считаются из данных либо это факты, уже имеющиеся на сайте.
import '../../styles/ru-home.css';
import { getCollection } from 'astro:content';
import RuLayout from '../../layouts/RuLayout.astro';
import ru from '../../i18n/ru.json';
import notices from '../../data/ru/gov-notices.json';
import newsData from '../../data/ru/news.json';
import linkHealth from '../../data/ru/link-health.json';
import HomeSeries from '../../components/HomeSeries.astro';
import { withBase } from '../../utils/site';
import { getResolvedSeries } from '../../utils/series';
import { getRuUpdates, KIND_LABEL } from '../../utils/ru-updates';

const updated = new Date(notices.updatedAt);
const fmtMD = new Intl.DateTimeFormat('ru-RU', { timeZone: 'Europe/Moscow', day: 'numeric', month: 'numeric' });
const fmtYMD = new Intl.DateTimeFormat('ru-RU', { timeZone: 'Europe/Moscow', year: 'numeric', month: 'long', day: 'numeric' });
const short = (t: string, n = 150) => (t.length > n ? t.slice(0, n).replace(/\s+\S*$/, '') + '…' : t);

const posts = (await getCollection('blogRu', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.slice(0, 4);

const feed = await getRuUpdates(30);
const heroFeed = feed.slice(0, 4);
const newsFeed = feed.slice(0, 8);
const weekly = feed.filter((u) => Date.now() - new Date(u.date).getTime() <= 7 * 86400000);
const weeklyCount = (k: 'news' | 'notice' | 'event' | 'video' | 'blog') => weekly.filter((u) => u.kind === k).length;

// Новые акты с портала официального опубликования (сверху самые новые)
const topNotices = notices.items.slice(0, 5);

// Цифры доверия (все из реальных данных)
const stats = [
  { n: posts.length, unit: '', label: 'Опубликованных статей', href: '/ru/blog/' },
  { n: linkHealth.total, unit: '', label: 'Ссылок на источники проверяется ежедневно', href: '/ru/updates/' },
  { n: notices.items.length, unit: '', label: 'Новых актов в ленте портала', href: '/ru/calendar/' },
  { n: newsData.items.length, unit: '', label: 'Новостей об ИИ (проверка каждый час)', href: '/ru/news/' },
];
const checkedDay = linkHealth.checkedAt ? fmtYMD.format(new Date(linkHealth.checkedAt)) : '';

const tasks = [
  { q: 'Какие вехи нужно знать?', t: 'Дорожная карта цифровизации и ИИ', d: '152-ФЗ, 323-ФЗ, 187-ФЗ, приказ ФСТЭК № 117, приказ Минздрава № 209н и закон № 265-ФЗ на одной шкале времени.', href: '/ru/dx-roadmap/' },
  { q: 'Какие акты вышли недавно?', t: 'Календарь: новые акты', d: 'Новые документы с портала официального опубликования правовых актов — автоматически.', href: '/ru/calendar/' },
  { q: 'Поставщик предлагает МИС или ИИ?', t: 'Чек-лист: электронные документы и ИИ-поставщик', d: 'Подпись, регистрация в РЭМД, журналы, приказ Росздравнадзора № 123 — с основаниями.', href: '/ru/documents-checklist/' },
  { q: 'Данные пациентов защищены?', t: 'Чек-лист защиты данных пациентов', d: '18 пунктов из 152-ФЗ, 323-ФЗ, КоАП, 187-ФЗ и приказа ФСТЭК — со статьями.', href: '/ru/data-checklist/' },
  { q: 'Перед внедрением ИИ', t: 'Шаблоны: политика и 20 вопросов поставщику', d: 'Черновики, которые можно скопировать и доработать, когда приходит предложение.', href: '/ru/templates/' },
  { q: 'Пациентам и близким', t: 'Для пациентов', d: 'Прежде чем спрашивать ИИ о здоровье, права при использовании ИИ в больнице, права на медицинские документы.', href: '/ru/patients/' },
];

const promises = [
  { t: 'Опора на первоисточники', d: 'Пишем только то, чьи официальные тексты открыты и прочитаны (КонсультантПлюс, портал официального опубликования, Минздрав, Росздравнадзор), со ссылками.' },
  { t: 'Дата проверки на виду', d: 'Внизу каждой страницы практикума и раздела для пациентов — «Источники и дата проверки». Нормы меняются, поэтому дата обязательна.' },
  { t: 'Ссылки на источники проверяются ежедневно', d: `Внешних ссылок русской редакции — ${linkHealth.total}; проверяются автоматически каждый день, недоступных (404/410) — ${linkHealth.dead.length}${checkedDay ? ` (${checkedDay})` : ''}.` },
  { t: 'Без рекомендаций конкретных продуктов и больниц', d: 'Разбираем, можно ли это использовать в вашей больнице и на каком основании — а не бренды и не призыв внедрять скорее.' },
];

const library = [
  { t: ru.nav.guide, d: ru.home.guideDesc, href: '/ru/guide/' },
  { t: ru.nav.glossary, d: ru.home.glossaryDesc, href: '/ru/glossary/' },
  { t: ru.nav.faq, d: ru.home.faqDesc, href: '/ru/faq/' },
  { t: ru.nav.checklist, d: ru.home.checklistDesc, href: '/ru/checklist/' },
  { t: ru.nav.tips, d: 'Практические советы для работы с ИИ-сервисами в больнице.', href: '/ru/tips/' },
  { t: ru.nav.videos, d: 'Подборка видео об ИИ в здравоохранении.', href: '/ru/videos/' },
];

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/ru/')}`;
const homeFaqLd = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#home-faq`,
  url: pageUrl,
  inLanguage: 'ru',
  isPartOf: { '@id': `${siteRoot}/#website-ru` },
  mainEntity: ru.home.homeFaq.map((f, i) => ({
    '@type': 'Question',
    '@id': `${pageUrl}#home-q${i + 1}`,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const homeSeries = (await getResolvedSeries('ru'))
  .slice()
  .sort((a, b) => b.posts.length - a.posts.length)
  .slice(0, 3);
---

<RuLayout
  title={ru.home.metaTitle}
  description={ru.home.metaDescription}
  koPath="/"
  twPath="/tw/"
  jaPath="/ja/"
  idPath="/id/"
  updated={updated}
  schema={[homeFaqLd]}
>
  <Fragment slot="hero">
    <section class="th-hero">
      <div class="th-hero-inner">
        <div class="th-hero-copy">
          <p class="th-eyebrow">Персональные данные, электронные документы и ИИ — для администрации и сестринских служб</p>
          <h1>Решение о внедрении ИИ в больнице —<br />по российским нормам и первоисточникам.</h1>
          <p class="th-lead">
            Является ли продукт медицинским изделием, на каком основании обрабатываются данные пациентов, где хранятся базы и в какой срок сообщать об инциденте. Сведено по текстам КонсультантПлюс и официальным источникам; у каждого пункта — статья и дата проверки.
          </p>
          <p class="th-cta">
            <a class="th-btn th-btn-main" href={withBase('/ru/dx-roadmap/')}>Дорожная карта</a>
            <a class="th-btn th-btn-sub" href={withBase('/ru/calendar/')}>Новые акты</a>
          </p>
        </div>
        <aside class="th-hero-card" aria-labelledby="th-live-h">
          <h2 id="th-live-h"><span class="th-dot" aria-hidden="true"></span>Свежие обновления</h2>
          <ul>
            {heroFeed.map((it) => (
              <li>
                <time datetime={it.date}>{fmtMD.format(new Date(it.date))}</time>
                <span class="th-chip">{KIND_LABEL[it.kind]}</span>
                <a href={it.href} {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
                  {it.title}
                  {it.external && <span class="sr-only">({ru.ui.external})</span>}
                </a>
              </li>
            ))}
          </ul>
          <a class="th-hero-more" href={withBase('/ru/updates/')}>Все обновления →</a>
        </aside>
      </div>
    </section>

    <section class="th-stats" aria-label="Состояние сайта">
      <ul>
        {
          stats.map((s) => (
            <li>
              <a href={withBase(s.href)}>
                <span class="th-num">{s.n.toLocaleString('id-ID')}<small>{s.unit}</small></span>
                <span class="th-lab">{s.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Fragment>

  <section class="th-sec" aria-labelledby="th-tasks-h">
    <h2 class="th-h" id="th-tasks-h"><span>Когда вы столкнулись с этим</span><small>BY PURPOSE</small></h2>
    <div class="th-tasks">
      {
        tasks.map((x) => (
          <a class="th-task" href={withBase(x.href)}>
            <span class="th-task-q">{x.q}</span>
            <span class="th-task-t">{x.t}</span>
            <span class="th-task-d">{x.d}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="th-sec" aria-labelledby="th-feed-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-feed-h"><span>Обновления</span><small>WHAT'S NEW</small></h2>
      <a class="th-more" href={withBase('/ru/updates/')}>Смотреть все →</a>
    </div>
    <p class="th-note">
      За 7 дней: {KIND_LABEL.news} {weeklyCount('news')} · {KIND_LABEL.notice} {weeklyCount('notice')} · {KIND_LABEL.event} {weeklyCount('event')} · {KIND_LABEL.video} {weeklyCount('video')}
    </p>
    <ul class="th-feed">
      {
        newsFeed.map((it) => (
          <li>
            <time datetime={it.date}>{fmtYMD.format(new Date(it.date))}</time>
            <span class="th-chip">{KIND_LABEL[it.kind]}</span>
            <a href={it.href} {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
              {it.title}
              {it.external && <span class="sr-only">({ru.ui.external})</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-gov-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-gov-h"><span>Новые акты с портала официального опубликования</span><small>NEW REGULATIONS</small></h2>
      <a class="th-more" href={withBase('/ru/calendar/')}>Смотреть все →</a>
    </div>
    <p class="th-note">Дата — дата публикации акта, а не срок. Содержание и действие акта читайте по официальному тексту; список отражает все акты портала, а не только касающиеся больниц.</p>
    <ul class="th-feed th-feed-sub">
      {
        topNotices.map((n) => (
          <li>
            <time datetime={n.pubDate}>{fmtYMD.format(new Date(n.pubDate))}</time>
            <span class="th-chip th-chip-gov">{n.kind}</span>
            <a href={n.link} target="_blank" rel="noopener">
              {short(n.title)}
              <span class="sr-only">({ru.ui.external})</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-posts-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-posts-h"><span>Избранные статьи</span><small>ARTICLES</small></h2>
      <a class="th-more" href={withBase('/ru/blog/')}>Все статьи →</a>
    </div>
    <div class="th-posts">
      {
        featured.map((p) => (
          <article class="th-post">
            <p class="th-post-meta">
              <span class="th-chip">{p.data.category}</span>
              <time datetime={p.data.pubDate.toISOString()}>{fmtYMD.format(p.data.pubDate)}</time>
            </p>
            <h3><a href={withBase(`/ru/blog/${p.id}/`)}>{p.data.title}</a></h3>
            <p class="th-post-d">{p.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <HomeSeries loc="ru" list={homeSeries} />

  <section class="th-sec th-promise" aria-labelledby="th-promise-h">
    <h2 class="th-h" id="th-promise-h"><span>Принципы сайта</span><small>OUR PRINCIPLES</small></h2>
    <ul>
      {
        promises.map((x, i) => (
          <li>
            <span class="th-no">{i + 1}</span>
            <div>
              <strong>{x.t}</strong>
              <p>{x.d}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="th-note"><a href={withBase('/ru/about/#principles')}>Принципы написания и проверки →</a></p>
  </section>

  <section class="th-sec" aria-labelledby="th-lib-h">
    <h2 class="th-h" id="th-lib-h"><span>Учебные материалы и справка</span><small>LIBRARY</small></h2>
    <ul class="th-lib">
      {
        library.map((x) => (
          <li>
            <a href={withBase(x.href)}>
              <strong>{x.t}</strong>
              <span>{x.d}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-faq-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-faq-h"><span>{ru.home.homeFaqTitle}</span><small>ABOUT THIS SITE</small></h2>
      <a class="th-more" href={withBase('/ru/faq/')}>{ru.home.homeFaqMore}</a>
    </div>
    <dl class="th-faq">
      {
        ru.home.homeFaq.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <section class="th-sec" aria-labelledby="th-intro-h">
    <h2 class="th-h" id="th-intro-h"><span>{ru.home.introTitle}</span><small>ABOUT</small></h2>
    <p>{ru.home.introBody}</p>
    <div class="ru-note">
      <p><strong>{ru.home.koNoticeTitle}</strong></p>
      <p style="margin-top:6px">{ru.home.koNoticeBody}</p>
      <p style="margin-top:8px"><a href={withBase('/')} hreflang="ko">{ru.ui.langKo} →</a></p>
    </div>
  </section>
</RuLayout>
