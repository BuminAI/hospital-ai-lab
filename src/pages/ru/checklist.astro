---
import RuLayout from '../../layouts/RuLayout.astro';
import InteractiveChecklist from '../../components/InteractiveChecklist.astro';
import SubscribeCta from '../../components/SubscribeCta.astro';
import { getCollection } from 'astro:content';
import { checklistRelated } from '../../data/checklist-related';
import { COLLECTION, postHref } from '../../utils/locale';
import { checklistRu } from '../../data/ru/pages';
import ru from '../../i18n/ru.json';
import { withBase } from '../../utils/site';

const p = checklistRu;

// 점검표를 체크해 가며 쓰는 형태로 그린다(2026-09-20). 체크 상태는 이 기기의 브라우저에만 저장된다.
const sections = p.sections.map((s, i) => ({
  title: s.heading,
  body: s.body,
  items: s.items,
  plain: false,
}));
const posts = await getCollection(COLLECTION.ru, ({ data }) => !data.draft);
const titleOf = new Map(posts.map((x) => [x.id, x.data.title]));
const relatedByTitle: Record<string, { href: string; title: string }[]> = {};
for (const [idx, ids] of Object.entries(checklistRelated.ru)) {
  const sec = sections[Number(idx)];
  if (!sec) throw new Error('[checklist:ru] 관련 글의 섹션 번호 ' + idx + '가 없습니다.');
  relatedByTitle[sec.title] = ids.map((id) => {
    const title = titleOf.get(id);
    if (!title) throw new Error('[checklist:ru] 관련 글 ID ' + id + '가 없습니다.');
    return { href: postHref('ru', id), title };
  });
}

// 화면에 보이는 소제목·순서 그대로 ItemList로 알린다(보이지 않는 정보는 넣지 않는다).
const schema = [
  {
    '@type': 'ItemList',
    name: p.meta.pageTitle,
    numberOfItems: p.sections.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: p.sections.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.heading,
    })),
  },
];
---

<RuLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={ru.nav.checklist}
  koPath="/checklist/"
  idPath="/id/checklist/"
  twPath="/tw/checklist/"
  jaPath="/ja/checklist/"
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="ru-lead">{p.meta.lead}</p>

  <InteractiveChecklist id="ai-adoption-ru" loc="ru" sections={sections} related={relatedByTitle} />

  <SubscribeCta loc="ru" />

  <section class="ru-next">
    <h2>Смотрите также</h2>
    <ul>
      <li>
        <a href={withBase('/ru/glossary/')}>{ru.nav.glossary}</a> —
        объяснение терминов, использованных в этом чек-листе.
      </li>
      <li>
        <a href={withBase('/ru/faq/')}>{ru.nav.faq}</a> —
        ответы на частые вопросы о внедрении ИИ.
      </li>
      <li>
        <a href={withBase('/ru/guide/')}>{ru.nav.guide}</a> —
        с чего начать, если вы впервые сталкиваетесь с этой темой.
      </li>
    </ul>
  </section>
</RuLayout>

<style>
  .ru-lead {
    color: var(--ru-text-sub);
  }
  .ru-next {
    margin-top: 36px;
    border-top: 1px solid var(--ru-border);
    padding-top: 20px;
  }
  .ru-next h2 {
    font-size: 15px;
    color: var(--ru-text-sub);
    margin-bottom: 10px;
    border: 0;
    padding: 0;
    background: none;
  }
  .ru-next ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ru-next li {
    font-size: 14px;
    line-height: 1.85;
  }
</style>
