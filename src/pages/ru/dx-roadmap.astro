---
// Дорожная карта цифрового здравоохранения и ИИ в России (2026-10-31) — по первичным источникам.
// Факты собраны в src/data/ru/guides/milestones.ts; страница отвечает только за вёрстку.
import '../../styles/ru-guide.css';
import RuLayout from '../../layouts/RuLayout.astro';
import RuGuideFoot from '../../components/RuGuideFoot.astro';
import RuFaq from '../../components/RuFaq.astro';
import { guideSchema } from '../../utils/ru-guide';
import { MILESTONES, THEMES, SRC, CHECKED } from '../../data/ru/guides/milestones';
import { withBase } from '../../utils/site';

const done = MILESTONES.filter((m) => m.status === 'done').sort((a, b) => b.sort.localeCompare(a.sort));

const title = 'Дорожная карта: 152-ФЗ, 209н, КИИ и ИИ в российских больницах';
const description =
  'Ключевые даты для администрации и сестринской службы: уведомление об инцидентах, штрафы КоАП 13.11, 265-ФЗ, приказ ФСТЭК № 117, приказ Минздрава № 209н, приказ Росздравнадзора № 123 — с первичными источниками.';

const sources = [SRC.fz152_21, SRC.koap1311, SRC.fz265, SRC.fstek117, SRC.order209, SRC.rzn123, SRC.fz187];

const faq = [
  {
    q: 'В какой срок нужно уведомить Роскомнадзор об утечке персональных данных пациентов?',
    a: 'По части 3.1 статьи 21 закона № 152-ФЗ — в течение 24 часов о самом инциденте, причинах, вреде и принятых мерах и в течение 72 часов о результатах внутреннего расследования; срок идёт с момента выявления инцидента.',
  },
  {
    q: 'С какого числа в больницах действует новый порядок ведения электронной медицинской документации?',
    a: 'Приказ Минздрава от 25.03.2026 № 209н вступает в силу с 1 сентября 2026 г. и действует до 1 сентября 2032 г.; он заменил приказ № 947н.',
  },
  {
    q: 'Можно ли хранить персональные данные пациентов в зарубежном облаке?',
    a: 'Часть 5 статьи 18 закона № 152-ФЗ не допускает при сборе персональных данных граждан России их запись, хранение и иные операции с использованием баз данных за пределами России, за исключением случаев из пунктов 2, 3, 4 и 8 части 1 статьи 6. Трансграничная передача — отдельный вопрос статьи 12 (в редакции 265-ФЗ).',
  },
  {
    q: 'Относится ли больница к субъектам критической информационной инфраструктуры?',
    a: 'Статья 2 закона № 187-ФЗ называет субъектами КИИ государственные органы, государственные учреждения и российские юридические лица, которым принадлежат информационные системы, функционирующие в том числе в сфере здравоохранения. Статус конкретной больницы определяется по процедуре категорирования — уточняйте у специалиста по ИБ.',
  },
  {
    q: 'Есть ли подтверждённые новые сроки для больниц?',
    a: 'На этой странице указаны только даты из текстов актов и официальных публикаций. Подтверждённых по первичным источникам новых сроков для больниц мы не нашли и потому их не указываем. Новые акты появляются в разделе «Календарь актов».',
  },
];

const siteRootG = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const schema = guideSchema({
  siteRoot: siteRootG,
  path: '/ru/dx-roadmap/',
  headline: title,
  description,
  sources,
  published: '2026-10-31',
  modified: '2026-10-31',
  audience: 'Администрация и сестринская служба больниц',
  faq,
});
---

<RuLayout title={title} description={description} crumb="Дорожная карта" standalone updated={new Date('2026-10-31T00:00:00+03:00')} schema={schema}>
  <h1>Дорожная карта цифрового здравоохранения и ИИ</h1>
  <p class="tg-lead">
    «Что и к какому сроку должна сделать наша больница?» Чем больше новостей об ИИ, тем труднее ответить. Здесь собраны даты из текстов актов и официальных публикаций — со статьями и ссылками на источники.
  </p>
  <p class="tg-meta">Проверено: {CHECKED} · Для: администрации и сестринской службы больниц</p>

  <p class="tg-answer">
    Коротко: об инциденте с персональными данными — уведомление Роскомнадзора в течение 24 и 72 часов (152-ФЗ, ст. 21, ч. 3.1); базы данных граждан России — на территории России (ст. 18, ч. 5); электронные медицинские документы по приказу № 209н — с 1 сентября 2026 г.; передача данных ИИ-изделий в АИС Росздравнадзора — приказ № 123 (до 31.12.2027).
  </p>

  <div class="tg-box">
    <strong>Как читать страницу</strong><br />
    Каждый пункт записан после того, как текст акта открыли и прочитали. Мы не добавляем сроки, которые ходят только в пересказах. Обязанности конкретной больницы зависят от её формы и статуса — сверяйтесь с текстом и консультируйтесь с юристом.
  </div>

  <section class="tg-sec" aria-labelledby="h-done">
    <h2 id="h-done">Что уже произошло</h2>
    <ol class="tg-tl">
      {
        done.map((m) => (
          <li>
            <div class="when">{m.when}</div>
            <div class="what">
              <b>
                <span class="tg-tag">{THEMES[m.theme]}</span>
                {m.title}
              </b>
              <span>{m.body}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="tg-sec" aria-labelledby="h-ahead">
    <h2 id="h-ahead">Предстоящие сроки</h2>
    <p>
      Подтверждённых по первичным источникам новых сроков для больниц мы не нашли, поэтому раздел намеренно пуст. Новые акты, опубликованные на официальном портале, автоматически попадают в <a href={withBase('/ru/calendar/')}>Календарь актов</a>.
    </p>
  </section>

  <section class="tg-sec" aria-labelledby="h-next">
    <h2 id="h-next">Страницы, которые дополняют эту</h2>
    <div class="tg-cards">
      <a class="tg-card" href={withBase('/ru/data-checklist/')}>
        <b>Чек-лист защиты данных пациентов</b>
        <span>152-ФЗ, КоАП, КИИ и ФСТЭК: по статьям.</span>
      </a>
      <a class="tg-card" href={withBase('/ru/documents-checklist/')}>
        <b>Чек-лист: электронные документы и ИИ-поставщик</b>
        <span>Приказ № 209н, приказ № 123 и вопросы поставщику.</span>
      </a>
      <a class="tg-card" href={withBase('/ru/templates/')}>
        <b>Шаблоны документов</b>
        <span>Политика по генеративному ИИ, 20 вопросов поставщику, карточка инцидента.</span>
      </a>
    </div>
  </section>

  <RuFaq items={faq} />

  <RuGuideFoot sources={sources} checked={CHECKED} />
</RuLayout>
