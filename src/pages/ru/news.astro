---
// Новости об ИИ — Медвестник·Vademecum 자동 수집 목록 (ko news.astro와 같은 패턴).
// hreflang을 걸지 않는다 — 자동 수집 목록은 언어판마다 완전히 다른 기사
// 목록이라, 번역 관계가 아닌 페이지에 alternate를 걸면 검색엔진에 잘못된
// 신호가 된다(ko news.astro도 jaPath가 없다 — 같은 원칙).
import RuLayout from '../../layouts/RuLayout.astro';
import ru from '../../i18n/ru.json';
import { withBase } from '../../utils/site';
import news from '../../data/ru/news.json';

const fmt = new Intl.DateTimeFormat('ru-RU', {
  timeZone: 'Europe/Moscow',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const items = news.items;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/ru/news/')}`;
const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: ru.nav.news,
  description:
    'Статьи об искусственном интеллекте в здравоохранении из Медвестника и Vademecum, собранные автоматически.',
  inLanguage: 'ru-RU',
  isPartOf: { '@id': `${siteUrl}/#website-ru` },
  dateModified: news.updatedAt,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<RuLayout
  title={ru.nav.news}
  description="Статьи об искусственном интеллекте в здравоохранении из Медвестника и Vademecum, собранные автоматически несколько раз в день."
  crumb={ru.nav.news}
  koPath="/news/"
  updated={new Date(news.updatedAt)}
  schema={[collectionPage]}
>
  <h1>{ru.nav.news}</h1>
  <p class="ru-lead">
    Материалы из раздела «Искусственный интеллект» Медвестника и раздела «ИИ» Vademecum
    собираются автоматически несколько раз в день. Старые статьи не удаляются.
  </p>

  {
    items.length > 0 ? (
      <ul class="ru-news-list">
        {items.map((item) => (
          <li>
            <a href={item.link} target="_blank" rel="noopener">
              {item.title}
              <span class="sr-only"> ({ru.ui.external})</span>
            </a>
            <span class="ru-news-meta">
              {item.source} · <time datetime={item.pubDate}>{fmt.format(new Date(item.pubDate))}</time>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="ru-empty">{ru.ui.noItems}</p>
    )
  }

  <div class="ru-note">
    <p>
      Этот список составлен автоматически из статей Медвестника и Vademecum, где
      упоминается искусственный интеллект. Это не редакционная подборка — сайт
      не отбирает и не рекомендует конкретные материалы. Заголовок ведёт на
      оригинальную статью на сайте издания.
    </p>
  </div>
</RuLayout>

<style>
  .ru-lead {
    color: var(--ru-text-sub);
  }
  .ru-news-list {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ru-border);
  }
  .ru-news-list li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid var(--ru-border);
  }
  .ru-news-list a {
    color: var(--ru-text);
    font-weight: 600;
    line-height: 1.6;
  }
  .ru-news-list a:hover {
    color: var(--ru-primary);
  }
  .ru-news-meta {
    font-size: 13px;
    color: var(--ru-text-sub);
  }
  .ru-empty {
    margin-top: 20px;
    color: var(--ru-text-sub);
  }
</style>
