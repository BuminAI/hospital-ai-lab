---
// Чек-лист защиты данных пациентов (2026-10-31)
// ⚠️ В России нет единого официального чек-листа, составленного именно для больниц. Пункты составлены автором по статьям, тексты которых
//    открывали и читали: 152-ФЗ (ст. 10, 12, 18, 21), КоАП 13.11, 323-ФЗ (ст. 13, 91), 187-ФЗ (ст. 2), приказ ФСТЭК № 117.
// ⚠️ К каким категориям относится конкретная больница (частная, государственное учреждение и т. п.) — решают примечания и учредительные документы;
//    эта страница такого вывода не делает.
import '../../styles/ru-guide.css';
import RuLayout from '../../layouts/RuLayout.astro';
import RuGuideFoot from '../../components/RuGuideFoot.astro';
import RuFaq from '../../components/RuFaq.astro';
import { guideSchema } from '../../utils/ru-guide';
import { SRC } from '../../data/ru/guides/milestones';
import { withBase } from '../../utils/site';

const CHECKED = '31 октября 2026 г.';
const title = 'Чек-лист защиты данных пациентов: 152-ФЗ, 323-ФЗ, КИИ, ФСТЭК';
const description =
  '18 пунктов для администрации и ИТ больницы: основание обработки, локализация баз, трансграничная передача, уведомление об инцидентах 24/72 часа, КИИ и приказ ФСТЭК № 117 — по статьям.';

type Item = { no: string; text: string; basis: string };
type Group = { id: string; head: string; lead?: string; items: Item[] };

const groups: Group[] = [
  {
    id: 'g1',
    head: 'А. Основание обработки и врачебная тайна',
    lead: 'Сведения о состоянии здоровья — специальная категория персональных данных (152-ФЗ, ст. 10, ч. 1); они же составляют врачебную тайну (323-ФЗ, ст. 13).',
    items: [
      { no: '1', text: 'Для каждого потока данных пациента определено основание: например, обработка в медико-профилактических целях, для установления диагноза, оказания медицинских услуг лицом, обязанным хранить врачебную тайну.', basis: '152-ФЗ, ст. 10, ч. 2, п. 4' },
      { no: '2', text: 'Для целей, которые не сводятся к лечению (например, обучение модели ИИ у поставщика), определено отдельное основание, а не подразумевается из лечебного.', basis: '152-ФЗ, ст. 10, ч. 1–2' },
      { no: '3', text: 'Разглашение сведений, составляющих врачебную тайну, третьим лицам, — только с письменного согласия пациента или его законного представителя ; согласие может быть частью информированного добровольного согласия.', basis: '323-ФЗ, ст. 13, ч. 3' },
      { no: '4', text: 'Сотрудникам запрещено разглашать сведения, ставшие им известными при исполнении обязанностей; это отражено в локальных актах и обучении.', basis: '323-ФЗ, ст. 13, ч. 2' },
    ],
  },
  {
    id: 'g2',
    head: 'Б. Где хранятся данные и передача за границу',
    items: [
      { no: '5', text: 'Базы данных, в которых записываются, хранятся и извлекаются персональные данные граждан России, находятся на территории России (кроме случаев, указанных в ст. 18, ч. 5).', basis: '152-ФЗ, ст. 18, ч. 5' },
      { no: '6', text: 'Поставщик письменно указал, где физически расположены серверы и в какой стране зарегистрирован получатель; это закреплено в договоре.', basis: '152-ФЗ, ст. 18, ч. 5; ст. 12' },
      { no: '7', text: 'Если данные передаются за границу: оператор направил уведомление Роскомнадзору до начала передачи; для стран вне перечня учтён срок рассмотрения (десять рабочих дней, ч. 9).', basis: '152-ФЗ, ст. 12 (ред. 265-ФЗ), ч. 3, 9–11' },
      { no: '8', text: 'В договоре предусмотрено: если Роскомнадзор запретит или ограничит передачу, получатель уничтожает ранее переданные данные.', basis: '152-ФЗ, ст. 12, ч. 14' },
    ],
  },
  {
    id: 'g3',
    head: 'В. Инциденты',
    items: [
      { no: '9', text: 'Назначено лицо, которое подаёт уведомление в Роскомнадзор и взаимодействует с ним по инциденту.', basis: '152-ФЗ, ст. 21, ч. 3.1, п. 1' },
      { no: '10', text: 'Есть процедура: в течение 24 часов с момента выявления инцидента — уведомление о случившемся, причинах, вреде и принятых мерах; в течение 72 часов — о результатах внутреннего расследования.', basis: '152-ФЗ, ст. 21, ч. 3.1' },
      { no: '11', text: 'В договоре с поставщиком — срок немедленного уведомления больницы об инциденте, перечень субподрядчиков, журнал доступа, порядок удаления данных.', basis: 'Рекомендация автора (не требование закона)' },
      { no: '12', text: 'Руководство знает размеры ответственности: за несвоевременное уведомление Роскомнадзора (ч. 11) и за неправомерную передачу информации со специальной категорией данных (ч. 16).', basis: 'КоАП РФ, ст. 13.11, ч. 11, 16' },
    ],
  },
  {
    id: 'g4',
    head: 'Г. Информационные системы, КИИ и ФСТЭК',
    items: [
      { no: '13', text: 'Медицинские информационные системы организации учтены как информационные системы в сфере здравоохранения.', basis: '323-ФЗ, ст. 91, ч. 1' },
      { no: '14', text: 'Специалист по ИБ определил, является ли организация субъектом КИИ (системы, функционирующие в сфере здравоохранения) и проведено ли категорирование.', basis: '187-ФЗ, ст. 2, п. 8' },
      { no: '15', text: 'Уточнено, распространяется ли на больницу и её информационные системы приказ ФСТЭК № 117 (в силе с 1 марта 2026 г.), если она — государственное учреждение или унитарное предприятие.', basis: 'Приказ ФСТЭК № 117' },
      { no: '16', text: 'ИИ-модуль, подключаемый к медицинской информационной системе, включён в тот же контур защиты и учёта, что и сама система.', basis: 'Рекомендация автора' },
    ],
  },
  {
    id: 'g5',
    head: 'Д. ЕГИСЗ и телемедицина',
    items: [
      { no: '17', text: 'Понятно, какие сведения и в каком порядке выгружаются в ЕГИСЗ (положение о единой системе утверждает Правительство).', basis: '323-ФЗ, ст. 91.1, ч. 1–2' },
      { no: '18', text: 'Консультации с применением телемедицинских технологий организуются в целях, указанных в законе (в том числе решение о необходимости очного приёма).', basis: '323-ФЗ, ст. 36.2, ч. 2' },
    ],
  },
];

const total = groups.reduce((n, g) => n + g.items.length, 0);

const faq = [
  {
    q: 'Как быстро нужно сообщить об утечке?',
    a: 'В течение 24 часов с момента выявления инцидента — уведомление Роскомнадзора о случившемся, причинах и вреде, принятых мерах (152-ФЗ, ст. 21, ч. 3.1, п. 1); в течение 72 часов — о результатах внутреннего расследования (п. 2).',
  },
  {
    q: 'Какие штрафы за утечку персональных данных со сведениями о здоровье?',
    a: 'Часть 16 статьи 13.11 КоАП РФ: для юридических лиц от 10 до 15 млн руб., для должностных лиц от 1 до 1,3 млн руб., для граждан от 300 до 400 тыс. руб. Какие лица считаются «юридическими» и «должностными» в частях 10–18, определяют примечания к статье.',
  },
  {
    q: 'Можно ли без согласия пациента передать данные поставщику ИИ?',
    a: 'Статья 10 допускает обработку в медико-профилактических целях, для диагноза и оказания медицинских услуг лицом, обязанным хранить врачебную тайну. Передача поставщику для других целей (например, обучения модели) этим основанием не очевидна — определите основание отдельно и проконсультируйтесь с юристом.',
  },
];

const sources = [SRC.fz152_10, SRC.fz152_12, SRC.fz152_18, SRC.fz152_21, SRC.koap1311, SRC.fz323_13, SRC.fz323_91, SRC.fz187, SRC.fstek117];

const siteRootG = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const guide = guideSchema({
  siteRoot: siteRootG,
  path: '/ru/data-checklist/',
  headline: title,
  description,
  sources,
  published: '2026-10-31',
  modified: '2026-10-31',
  audience: 'Администрация и ИТ больниц',
  faq,
});
---

<RuLayout title={title} description={description} crumb="Защита данных пациентов" standalone updated={new Date('2026-10-31T00:00:00+03:00')} schema={guide}>
  <h1>Чек-лист защиты данных пациентов</h1>
  <p class="tg-lead">
    Требования к защите данных пациентов разбросаны по нескольким актам: 152-ФЗ, КоАП, 323-ФЗ, 187-ФЗ, приказ ФСТЭК. Здесь они сведены в список, который можно проходить по пунктам.
  </p>
  <p class="tg-meta">Проверено: {CHECKED} · {total} пунктов · Для: администрации и ИТ больниц</p>

  <p class="tg-answer">
    Главное: об инциденте — уведомление Роскомнадзора в течение 24 часов, итоги расследования — в течение 72 часов (152-ФЗ, ст. 21, ч. 3.1); базы данных граждан России — на территории России (ст. 18, ч. 5); передача за границу — с предварительным уведомлением (ст. 12).
  </p>

  <div class="tg-box tg-warn">
    <strong>Сначала важное</strong>
    <ul class="tg-list">
      <li>Это <strong>не официальный чек-лист</strong>, а список автора по прочитанным статьям; к каждому пункту указано основание — сверяйтесь с текстом.</li>
      <li>К какой категории относится ваша организация в частях 10–18 статьи 13.11 КоАП, решают примечания к статье и ваши учредительные документы; страница такого вывода не делает.</li>
      <li>Пункты, помеченные «Рекомендация автора», не являются требованием закона.</li>
    </ul>
  </div>

  {
    groups.map((g) => (
      <section class="tg-sec" id={g.id} aria-labelledby={`${g.id}-h`}>
        <h2 id={`${g.id}-h`}>{g.head}</h2>
        {g.lead && <p>{g.lead}</p>}
        <table class="tg-table">
          <thead>
            <tr>
              <th>№</th>
              <th>Что проверить</th>
              <th>Основание</th>
            </tr>
          </thead>
          <tbody>
            {g.items.map((it) => (
              <tr>
                <th>{it.no}</th>
                <td>{it.text}</td>
                <td>{it.basis}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))
  }

  <section class="tg-sec" aria-labelledby="h-how">
    <h2 id="h-how">Как пользоваться (совет автора)</h2>
    <ol class="tg-list">
      <li><strong>Разделите пункты на «сделано», «не сделано», «не уверены».</strong> Неуверенное — к ИТ или поставщику.</li>
      <li><strong>Начните с раздела Б.</strong> Он требует участия поставщика и обычно занимает больше всего времени.</li>
      <li><strong>Сделайте карточку инцидента на одной странице.</strong> Кто подаёт уведомление, куда, и сроки 24 и 72 часа — там, где найдут ночью и в выходные.</li>
    </ol>
    <p>Вопросы поставщику — в <a href={withBase('/ru/templates/')}>шаблонах</a>; электронные документы — в <a href={withBase('/ru/documents-checklist/')}>отдельном чек-листе</a>.</p>
  </section>

  <RuFaq items={faq} />

  <RuGuideFoot sources={sources} checked={CHECKED} />
</RuLayout>
