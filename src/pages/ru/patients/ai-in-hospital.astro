---
// Права пациента, когда больница использует ИИ (2026-10-31). Только статьи, тексты которых читали: 323-ФЗ ст. 13, 19, 20, 22; 152-ФЗ ст. 10.
import '../../../styles/ru-guide.css';
import RuLayout from '../../../layouts/RuLayout.astro';
import RuGuideFoot from '../../../components/RuGuideFoot.astro';
import RuFaq from '../../../components/RuFaq.astro';
import { guideSchema } from '../../../utils/ru-guide';
import { SRC } from '../../../data/ru/guides/milestones';
import { withBase } from '../../../utils/site';

const CHECKED = '31 октября 2026 г.';
const title = 'Когда больница использует ИИ: что гарантирует закон пациенту';
const description =
  'Право на информацию, информированное согласие, защиту врачебной тайны и ознакомление с медицинской документацией — по закону № 323-ФЗ, простым языком.';

const rights = [
  { h: 'Получить информацию о своих правах и состоянии здоровья', p: 'Пациент имеет право на получение информации о своих правах и обязанностях, состоянии своего здоровья, выбор лиц, которым в его интересах может быть передана информация (323-ФЗ, ст. 19, п. 5).' },
  { h: 'Информированное добровольное согласие', p: 'Необходимое предварительное условие медицинского вмешательства — информированное добровольное согласие на основании предоставленной в доступной форме полной информации о целях, методах, связанном риске, возможных вариантах, последствиях и ожидаемых результатах (ст. 20, ч. 1). Пациент вправе и отказаться от вмешательства (ст. 19, п. 8).' },
  { h: 'Защита врачебной тайны', p: 'Сведения о факте обращения за медицинской помощью, состоянии здоровья и диагнозе, иные сведения, полученные при обследовании и лечении, составляют врачебную тайну (ст. 13, ч. 1); пациент имеет право на защиту этих сведений (ст. 19, п. 7). Их разглашение другим лицам, в том числе для научных исследований или публикаций, допускается с письменного согласия пациента или его законного представителя (ст. 13, ч. 3).' },
  { h: 'Знакомиться с медицинской документацией', p: 'Пациент либо его законный представитель имеет право непосредственно знакомиться с медицинской документацией, отражающей состояние здоровья, и получать на её основании консультации других специалистов (ст. 22, ч. 4).' },
  { h: 'Консультации врачей-специалистов', p: 'Пациент имеет право на получение консультаций врачей-специалистов (ст. 19, п. 3).' },
  { h: 'Специальная категория персональных данных', p: 'Сведения о состоянии здоровья относятся к специальным категориям персональных данных; их обработка допускается только в случаях, предусмотренных статьёй 10 закона № 152-ФЗ (ст. 10, ч. 1).' },
];

const faq = [
  {
    q: 'Обязана ли больница сообщать мне, что использует ИИ?',
    a: 'Отдельной нормы именно об ИИ в прочитанных нами статьях 323-ФЗ и 152-ФЗ мы не нашли. Но пациент имеет право на информацию о состоянии здоровья и на информированное добровольное согласие на основании полной информации о методах оказания помощи (ст. 19–20). Вы вправе спросить об этом у больницы.',
  },
  {
    q: 'Можно ли без моего согласия передать мои данные компании, которая разрабатывает ИИ?',
    a: 'Разглашение сведений, составляющих врачебную тайну, другим лицам, в том числе для научных исследований, допускается с письменного согласия пациента или его законного представителя (323-ФЗ, ст. 13, ч. 3). Обработка данных о здоровье возможна только в случаях статьи 10 закона № 152-ФЗ. Для вашей ситуации обратитесь к юристу.',
  },
  {
    q: 'Как увидеть свою медицинскую документацию?',
    a: 'Пациент имеет право непосредственно знакомиться с ней (ст. 22, ч. 4). Порядок подачи запроса уточните в регистратуре или у лечащего врача.',
  },
];

const sources = [SRC.fz323_13, SRC.fz323_19, SRC.fz323_20, SRC.fz323_22, SRC.fz152_10];

const siteRootG = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const schema = guideSchema({
  siteRoot: siteRootG,
  path: '/ru/patients/ai-in-hospital/',
  headline: title,
  description,
  sources,
  published: '2026-10-31',
  modified: '2026-10-31',
  audience: 'Пациенты и их близкие',
  faq,
});
---

<RuLayout title={title} description={description} crumb="Права пациента и ИИ" standalone updated={new Date('2026-10-31T00:00:00+03:00')} schema={schema}>
  <h1>Когда больница использует ИИ: что гарантирует закон пациенту</h1>
  <p class="tg-lead">
    Больницы всё чаще используют инструменты с ИИ. Какие у вас права? Здесь — права пациента из закона № 323-ФЗ простыми словами, со ссылками на статьи.
  </p>
  <p class="tg-meta">Проверено: {CHECKED} · Для: пациентов и их близких</p>

  <div class="tg-box tg-warn">
    Это общая информация, не юридическая консультация и не медицинская рекомендация по конкретной ситуации. При жалобах на здоровье обратитесь в медицинскую организацию, где вы наблюдаетесь.
  </div>

  <section class="tg-sec" aria-labelledby="h-rights">
    <h2 id="h-rights">Права, записанные в законе</h2>
    {
      rights.map((r) => (
        <>
          <h3>{r.h}</h3>
          <p>{r.p}</p>
        </>
      ))
    }
  </section>

  <section class="tg-sec" aria-labelledby="h-ask">
    <h2 id="h-ask">Что можно спросить у больницы</h2>
    <p>Совет автора, не требование закона:</p>
    <ul class="tg-list">
      <li>Используются ли в моём обслуживании инструменты с ИИ? Для чего?</li>
      <li>Кто принимает окончательное решение — медицинский работник или инструмент?</li>
      <li>Где хранятся мои данные и кто имеет к ним доступ?</li>
      <li>Если записываются голос или изображение — для чего и как долго хранятся?</li>
    </ul>
    <p>Подробнее о документах — в статье <a href={withBase('/ru/patients/medical-records/')}>«Ваши права на медицинские документы»</a>.</p>
  </section>

  <RuFaq items={faq} />

  <RuGuideFoot sources={sources} checked={CHECKED} patient />
</RuLayout>
