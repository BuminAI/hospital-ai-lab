---
// Права на медицинские документы (2026-10-31). Основания: 323-ФЗ ст. 13, 22; приказ Минздрава № 209н (п. 2, 9).
import '../../../styles/ru-guide.css';
import RuLayout from '../../../layouts/RuLayout.astro';
import RuGuideFoot from '../../../components/RuGuideFoot.astro';
import RuFaq from '../../../components/RuFaq.astro';
import { guideSchema } from '../../../utils/ru-guide';
import { SRC } from '../../../data/ru/guides/milestones';
import { withBase } from '../../../utils/site';

const CHECKED = '31 октября 2026 г.';
const title = 'Ваши права на медицинские документы: ознакомление и электронный вид';
const description =
  'Кто может знакомиться с вашей медицинской документацией, когда допустимо разглашение, что меняется с электронными документами по приказу № 209н — простым языком, со статьями.';

const faq = [
  {
    q: 'Кто имеет право знакомиться с моей медицинской документацией?',
    a: 'Вы либо ваш законный представитель — непосредственно (323-ФЗ, ст. 22, ч. 4). Супруг, близкие родственники и иные лица, указанные вами в письменном согласии на разглашение сведений, составляющих врачебную тайну, или в информированном добровольном согласии, имеют это право, в том числе после смерти пациента, если пациент или его законный представитель не запретил этого (ст. 22, ч. 4).',
  },
  {
    q: 'Может ли больница ведёт документы только в электронном виде?',
    a: 'Да. По приказу Минздрава № 209н документация ведётся в электронной форме без дублирования на бумаге, если пациент или его законный представитель не подал простое письменное заявление о ведении документации в бумажном виде (Порядок, п. 2). Приказ действует с 1 сентября 2026 г. до 1 сентября 2032 г.',
  },
  {
    q: 'Что нужно, чтобы сведения о моём здоровье сообщили другим людям?',
    a: 'Разглашение сведений, составляющих врачебную тайну, другим гражданам, в том числе должностным лицам, допускается с письменного согласия гражданина или его законного представителя; согласие может быть выражено и в информированном добровольном согласии на медицинское вмешательство (ст. 13, ч. 3).',
  },
];

const sources = [SRC.fz323_13, SRC.fz323_22, SRC.order209, SRC.order209off];

const siteRootG = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const schema = guideSchema({
  siteRoot: siteRootG,
  path: '/ru/patients/medical-records/',
  headline: title,
  description,
  sources,
  published: '2026-10-31',
  modified: '2026-10-31',
  audience: 'Пациенты и их близкие',
  faq,
});
---

<RuLayout title={title} description={description} crumb="Права на документы" standalone updated={new Date('2026-10-31T00:00:00+03:00')} schema={schema}>
  <h1>Ваши права на медицинские документы</h1>
  <p class="tg-lead">
    Медицинская документация содержит историю вашего здоровья. Кто вправе с ней знакомиться и что меняется, когда документы ведутся в электронном виде? Ответы — со ссылками на статьи.
  </p>
  <p class="tg-meta">Проверено: {CHECKED} · Для: пациентов и их близких</p>

  <p class="tg-answer">
    Коротко: вы (или ваш законный представитель) вправе знакомиться с документацией (323-ФЗ, ст. 22, ч. 4); сведения о здоровье — врачебная тайна (ст. 13); электронные документы по приказу № 209н ведутся без бумажного дубля, если вы не подали заявление о бумажном виде.
  </p>

  <div class="tg-box tg-warn">
    Общая информация, не юридическая консультация. Порядок запроса документов в вашей больнице уточните в регистратуре.
  </div>

  <RuFaq items={faq} heading="Частые вопросы" />

  <section class="tg-sec" aria-labelledby="h-more">
    <h2 id="h-more">Читайте также</h2>
    <div class="tg-cards">
      <a class="tg-card" href={withBase('/ru/patients/ai-in-hospital/')}>
        <b>Когда больница использует ИИ</b>
        <span>Право на информацию, согласие и защиту врачебной тайны.</span>
      </a>
      <a class="tg-card" href={withBase('/ru/patients/ai-health-consult/')}>
        <b>Прежде чем спрашивать ИИ о здоровье</b>
        <span>Шесть вещей, которые стоит знать.</span>
      </a>
    </div>
  </section>

  <RuGuideFoot sources={sources} checked={CHECKED} patient />
</RuLayout>
