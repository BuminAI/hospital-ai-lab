---
// «Для пациентов» (пациенты и близкие) — обзорная страница (2026-10-31)
// ⚠️ Без диагнозов и рекомендаций по лечению. Только общая информация со ссылками на официальные источники.
import '../../../styles/ru-guide.css';
import RuLayout from '../../../layouts/RuLayout.astro';
import { withBase } from '../../../utils/site';

const title = 'Для пациентов: ИИ, медицинские документы и ваши права';
const description =
  'Прежде чем спрашивать ИИ о здоровье, что гарантирует закон, когда больница использует ИИ, и права на медицинские документы — простым языком, по официальным источникам.';

const cards = [
  { href: '/ru/patients/ai-health-consult/', t: 'Прежде чем спрашивать ИИ о здоровье: 6 вещей', d: 'Ответ ИИ — не диагноз, ошибки трудно проследить, как беречь персональные данные и когда не откладывать обращение за помощью.' },
  { href: '/ru/patients/ai-in-hospital/', t: 'Когда больница использует ИИ: ваши права', d: 'Информация, согласие, врачебная тайна и ознакомление с документацией.' },
  { href: '/ru/patients/medical-records/', t: 'Ваши права на медицинские документы', d: 'Кто вправе знакомиться, когда допустимо разглашение, что меняется с электронными документами.' },
];
---

<RuLayout title={title} description={description} crumb="Для пациентов" standalone>
  <h1>Для пациентов</h1>
  <p class="tg-lead">
    О больницах и ИИ много вопросов, которые «хочется задать, но неясно кому». Здесь ответы собраны по официальным источникам и по возможности без сложных терминов.
  </p>
  <div class="tg-box tg-warn">
    Это общая информация, а не диагноз или рекомендация по лечению. При жалобах обратитесь в медицинскую организацию, где вы наблюдаетесь, или воспользуйтесь каналами, указанными на страницах.
  </div>
  <div class="tg-cards">
    {
      cards.map((c) => (
        <a class="tg-card" href={withBase(c.href)}>
          <b>{c.t}</b>
          <span>{c.d}</span>
        </a>
      ))
    }
  </div>
  <p class="tg-meta" style="margin-top:22px">
    Сотрудникам больниц — раздел <a href={withBase('/ru/practice/')}>«Практикум»</a>.
  </p>
</RuLayout>
