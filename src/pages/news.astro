---
import { withBase } from '../utils/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import news from '../data/news.json';

const fmtFull = new Intl.DateTimeFormat('ko-KR', {
  timeZone: 'Asia/Seoul',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
const fmtDay = new Intl.DateTimeFormat('ko-KR', {
  timeZone: 'Asia/Seoul',
  month: 'long',
  day: 'numeric',
});
const fmtTime = new Intl.DateTimeFormat('ko-KR', {
  timeZone: 'Asia/Seoul',
  hour: '2-digit',
  minute: '2-digit',
});

const updatedAt = fmtFull.format(new Date(news.updatedAt));
const items = news.items;

// CollectionPage + ItemList 구조화 데이터.
// 이 페이지는 자동 수집 목록이라 본문 글이 아니다. AI 답변 엔진과 검색엔진에
// '무엇을 모은 목록이고 지금 몇 건인지'를 명시해 준다. 개별 항목은 외부 원문
// 링크라 url만 싣고 본문은 옮기지 않는다(저작권).
const siteUrl = Astro.site
  ? Astro.site.href.replace(/\/$/, '')
  : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/news/')}`;
const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: 'AI 뉴스',
  description: '메디칼타임즈와 병원신문의 의료 AI 관련 기사를 매시간 확인해 쌓아 온 목록.',
  inLanguage: 'ko-KR',
  isPartOf: { '@id': `${siteUrl}/#website` },
  dateModified: news.updatedAt,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<BaseLayout
  title="AI 뉴스"
  description="메디칼타임즈 '의료기기·AI' 지면과 병원신문에 올라온 의료 AI 기사를 하루 여러 차례 챙겨 한자리에 쌓아 둡니다."
  alternates={{ ru: '/ru/news/' }}
  schema={[collectionPage]}
>
  <div class="container">
    <header class="page-head">
      <h1>AI 뉴스</h1>
      <p class="lead">
        메디칼타임즈 '의료기기·AI' 지면과 병원신문에서 AI 관련 기사를 하루에도
        몇 번씩 새로 챙겨 옵니다. 지난 기사는 지우지 않아 그대로 쌓입니다.
      </p>
    </header>

    <p class="updated">
      마지막 업데이트: <time datetime={news.updatedAt}>{updatedAt}</time>
    </p>

    {
      items.length > 0 ? (
        <ul class="news-list">
          {items.map((item) => {
            const d = new Date(item.pubDate);
            return (
              <li>
                <a href={item.link} target="_blank" rel="noopener">
                  {item.title}
                  <span class="sr-only"> (새 탭으로 열림)</span>
                </a>
                <span class="meta">
                  {item.source && <>{item.source} · </>}
                  <time datetime={item.pubDate}>
                    {fmtDay.format(d)} {fmtTime.format(d)}
                  </time>
                </span>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="empty">아직 담긴 기사가 없습니다.</p>
      )
    }

    <section class="notice">
      <p>
        이 목록은 메디칼타임즈 '의료기기·AI' 지면과 병원신문에 실린 기사 가운데
        AI 관련 표현이 들어간 것을 골라 제목과 링크만 걸어 둔 것입니다. 연구소가
        읽어 보고 고른 기사도, 추천하는 기사도 아닙니다. 제목을 누르면 해당
        매체의 원문으로 이동합니다.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .updated {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .news-list {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 52rem;
  }

  .news-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .news-list li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .news-list a {
    color: var(--color-text);
    font-weight: 600;
    line-height: 1.5;
  }

  .news-list a:hover {
    color: var(--color-primary);
  }

  .meta {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .empty {
    margin-top: 1.75rem;
    color: var(--color-muted);
  }

  .notice {
    margin-top: 2.5rem;
    max-width: 52rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
