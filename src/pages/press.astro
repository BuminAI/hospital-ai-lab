---
import { withBase } from '../utils/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import press from '../data/press.json';

const fmtFull = new Intl.DateTimeFormat('ko-KR', {
  timeZone: 'Asia/Seoul',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
const fmtDay = new Intl.DateTimeFormat('ko-KR', {
  timeZone: 'Asia/Seoul',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedAt = fmtFull.format(new Date(press.updatedAt));
const items = press.items;
const mb = (b: number) => (b >= 1048576 ? `${(b / 1048576).toFixed(1)}MB` : `${Math.max(1, Math.round(b / 1024))}KB`);

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/press/')}`;
const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: '보건복지부 보도자료',
  description: '보건복지부가 누리집에 올린 보도자료 원문(PDF·hwpx)을 모아 둔 목록.',
  inLanguage: 'ko-KR',
  isPartOf: { '@id': `${siteUrl}/#website` },
  dateModified: press.updatedAt,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<BaseLayout
  title="보건복지부 보도자료"
  description="보건복지부 누리집에 올라온 보도자료를 하루 여러 차례 확인해 원문 파일(PDF·hwpx)과 함께 모아 둡니다."
  schema={[collectionPage]}
>
  <div class="container">
    <header class="page-head">
      <h1>보건복지부 보도자료</h1>
      <p class="lead">
        보건복지부 누리집의 보도자료를 하루에도 몇 번씩 새로 확인해, 원문 파일을 그대로
        내려받을 수 있게 모아 둡니다. 병원 행정·간호 현장에 영향을 주는 정책 발표를
        찾아볼 때 쓰세요. 최근 {items.length}건을 보관합니다.
      </p>
    </header>

    <p class="updated">
      마지막 업데이트: <time datetime={press.updatedAt}>{updatedAt}</time>
    </p>

    {
      items.length > 0 ? (
        <ul class="press-list">
          {items.map((item) => (
            <li>
              <a class="title" href={item.link} target="_blank" rel="noopener">
                {item.title}
                <span class="sr-only"> (새 탭으로 열림)</span>
              </a>
              <span class="meta">
                <time datetime={item.pubDate}>{fmtDay.format(new Date(item.pubDate))}</time>
                {item.dept && <> · {item.dept}</>}
                {item.ai && <span class="badge">AI·디지털</span>}
              </span>
              <span class="files">
                {item.files.length > 0 ? (
                  item.files.map((f) => (
                    <a href={withBase(f.path)} download>
                      {f.ext.toUpperCase()} 내려받기 <small>({mb(f.bytes)})</small>
                    </a>
                  ))
                ) : (
                  <span class="nofile">원문 파일은 보건복지부 누리집에서 받으세요</span>
                )}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">아직 담긴 보도자료가 없습니다.</p>
      )
    }

    <section class="notice">
      <p>
        출처: 보건복지부 보도자료. 각 자료는 공공누리 제1유형(출처표시) 또는 제3유형(출처표시·변경금지)
        조건으로 개방된 것만 파일을 함께 싣고, 그 밖의 유형은 원문 링크만 겁니다. 파일은 내려받은
        그대로이며 연구소가 고치지 않았습니다. 내용의 정확한 기준은 보건복지부 누리집의 원문입니다.
        자료를 쓰실 때는 출처를 '보건복지부'로 밝혀 주세요. 제목의 'AI·디지털' 표시는 제목에 관련
        표현이 있는지만 기계적으로 가린 것이며, 연구소가 내용을 검토하거나 추천한다는 뜻이 아닙니다.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .updated {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .press-list {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 52rem;
  }
  .press-list li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .press-list li:first-child {
    border-top: 1px solid var(--color-border);
  }
  .title {
    color: var(--color-text);
    font-weight: 600;
    line-height: 1.5;
  }
  .title:hover {
    color: var(--color-primary);
  }
  .meta {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .badge {
    margin-left: 0.5rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.75rem;
  }
  .files {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.875rem;
  }
  .files small,
  .nofile {
    color: var(--color-muted);
  }
  .empty {
    margin-top: 1.75rem;
    color: var(--color-muted);
  }
  .notice {
    margin-top: 2.5rem;
    max-width: 52rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
