---
// AI news — automatically collected list from Singapore news outlets (see scripts/wide-sources.mjs; same pattern as ko news.astro).
// hreflang을 걸지 않는다 — 자동 수집 목록은 언어판마다 완전히 다른 기사
// 목록이라, 번역 관계가 아닌 페이지에 alternate를 걸면 검색엔진에 잘못된
// 신호가 된다(ko news.astro도 jaPath가 없다 — 같은 원칙).
import SgLayout from '../../layouts/SgLayout.astro';
import en from '../../i18n/sg.json';
import { withBase } from '../../utils/site';
import news from '../../data/sg/news.json';

const fmt = new Intl.DateTimeFormat('en-SG', {
  timeZone: 'Asia/Singapore',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const items = news.items;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/sg/news/')}`;
const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: en.nav.news,
  description:
    'Headlines about artificial intelligence in health care from The Straits Times, CNA, Business Times, Mothership, e27 and Singapore Business Review, collected automatically.',
  inLanguage: 'en-SG',
  isPartOf: { '@id': `${siteUrl}/#website-sg` },
  dateModified: news.updatedAt ?? new Date().toISOString(),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<SgLayout
  title="AI news for Singapore health care"
  description="Headlines about AI in Singapore health care from The Straits Times, CNA, Business Times, Mothership, e27 and Singapore Business Review, collected automatically several times a day."
  crumb={en.nav.news}
  koPath="/news/"
  standalone
  updated={new Date(news.updatedAt ?? Date.now())}
  schema={[collectionPage]}
>
  <h1>{en.nav.news}</h1>
  <p class="en-lead">
    Headlines that mention artificial intelligence and health are collected several times a day from The Straits Times, CNA, Business Times, Mothership, e27 and Singapore Business Review. Older items are not deleted.
  </p>

  {
    items.length > 0 ? (
      <ul class="en-news-list">
        {items.map((item) => (
          <li>
            <a href={item.link} target="_blank" rel="noopener">
              {item.title}
              <span class="sr-only"> ({en.ui.external})</span>
            </a>
            <span class="en-news-meta">
              {item.source} · <time datetime={item.pubDate}>{fmt.format(new Date(item.pubDate))}</time>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="en-empty">{en.ui.noItems}</p>
    )
  }

  <div class="en-note">
    <p>
      This list is built automatically from articles of the outlets named above that mention artificial intelligence and health. It is not an editorial selection: the site
      does not choose or recommend particular items. A headline leads to the original article on the
      publisher’s site. We copy only the headline, date and link.
    </p>
  </div>
</SgLayout>

<style>
  .en-lead {
    color: var(--sg-text-sub);
  }
  .en-news-list {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--sg-border);
  }
  .en-news-list li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid var(--sg-border);
  }
  .en-news-list a {
    color: var(--sg-text);
    font-weight: 600;
    line-height: 1.6;
  }
  .en-news-list a:hover {
    color: var(--sg-primary);
  }
  .en-news-meta {
    font-size: 13px;
    color: var(--sg-text-sub);
  }
  .en-empty {
    margin-top: 20px;
    color: var(--sg-text-sub);
  }
</style>
