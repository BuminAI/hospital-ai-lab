---
// For patients (patients and families) — overview page (2026-11-14)
// ⚠️ No diagnosis or treatment advice. General information with links to official sources.
import '../../../styles/sg-guide.css';
import SgLayout from '../../../layouts/SgLayout.astro';
import { withBase } from '../../../utils/site';

const title = 'For patients: AI, your data and your rights';
const description =
  'Before you ask an AI about your health, and what to expect when a hospital uses AI in your care. Plain language, with official sources.';

const cards = [
  {
    "href": "/sg/patients/ai-health-consult/",
    "t": "Before you ask an AI about your health: six things",
    "d": "An AI answer is not a diagnosis, what you type may not be protected as you assume, and when not to wait."
  },
  {
    "href": "/sg/patients/ai-in-hospital/",
    "t": "When your hospital uses AI: what the Ministry of Health’s guidelines say",
    "d": "What you can expect to be told, who stays responsible, and what you can ask."
  }
];
---

<SgLayout title={title} description={description} crumb="For patients" standalone>
  <h1>For patients</h1>
  <p class="tg-lead">
    People have many questions about hospitals and AI that they would like to ask but are not sure whom to ask. The answers here come from official sources and use as few technical terms as possible.
  </p>
  <div class="tg-box tg-warn">
    This is general information, not a diagnosis or a treatment recommendation. For a health concern, contact the clinician or hospital that treats you. In an emergency, call 995 (the Singapore Civil Defence Force’s number for life-threatening emergencies, per the Ministry of Home Affairs).
  </div>
  <div class="tg-cards">
    {
      cards.map((c) => (
        <a class="tg-card" href={withBase(c.href)}>
          <b>{c.t}</b>
          <span>{c.d}</span>
        </a>
      ))
    }
  </div>
  <p class="tg-meta" style="margin-top:22px">
    For hospital staff, see the <a href={withBase('/sg/practice/')}>Practice guides</a>.
  </p>
</SgLayout>
