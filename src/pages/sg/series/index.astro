---
import SgLayout from '../../../layouts/SgLayout.astro';
import SeriesIndexView from '../../../components/SeriesIndexView.astro';
import { getResolvedSeries } from '../../../utils/series';
import { seriesIndexDescription, seriesIndexSchema } from '../../../utils/series-schema';
import { growth } from '../../../i18n/growth';

// 연재 시리즈 목록 (2026-09-20 신설) — 한국어판 /series/ 와 같은 공용 컴포넌트.
// 목록 허브는 다섯 언어판이 같은 역할이라 hreflang으로 서로 잇는다(글 하나하나는 독립 집필이라 잇지 않는다).
const list = await getResolvedSeries('sg');
---

<SgLayout
  title={growth.sg.hub.title}
  description={seriesIndexDescription('sg')}
  crumb={growth.sg.seriesName}
  koPath="/series/" jaPath="/ja/series/" idPath="/id/series/" ruPath="/ru/series/" twPath="/tw/series/" enPath="/en/series/" inPath="/in/series/"
  schema={[seriesIndexSchema('sg', list, Astro.site)]}
>
  <SeriesIndexView loc="sg" list={list} />
</SgLayout>
