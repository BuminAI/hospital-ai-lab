---
// 일본어판(病院AI研究所) 전용 관리자 대시보드 — /admin-ja/
//
// ⚠️ 한국어판 관리자(src/pages/admin.astro)는 절대 수정하지 않는다.
//    이 페이지는 인증 방식(Supabase 로그인 + admin_secrets의 GitHub PAT)과
//    CSS 클래스만 같은 방식으로 복제한 별도 페이지다.
//
// ⚠️ 반드시 BaseLayout + noindex. JaLayout에는 noindex 기능이 없고
//    robots.txt도 아무것도 막지 않으므로, JaLayout으로 만들면 관리자
//    페이지가 검색엔진에 색인된다.
//
// ⚠️ 경로를 바꾸지 말 것. astro.config.mjs의 사이트맵 필터가
//    page.includes('/admin')으로 제외하므로 '/admin-ja/'여야 빠진다.
//
// 편집 대상 데이터(모두 GitHub Contents API로 커밋 → Actions 재빌드):
//    src/data/ja/content/videos.json      おすすめ動画
//    src/data/ja/content/videos-meta.json おすすめ動画ページの題名・案内文
//    src/data/ja/content/nav.json         上部メニューの表示/非表示
//    src/data/ja/content/glossary.json    用語集
//    src/data/ja/content/faq.json         よくあるご質問
//    src/data/ja/content/guide.json       はじめての医療AI
//    src/data/ja/content/checklist.json   導入チェックリスト
//    src/data/ja/content/tips.json        現場ノウハウ
// 읽기 전용:
//    src/data/ja/subsidies.json           jGrants 자동 수집 결과
//    src/data/recommended-videos.json     한국어판 영상(동기화 대조용)
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUPABASE_URL, SUPABASE_ANON_KEY, ADMIN_EMAIL } from '../utils/site';
import { glossaryCategoriesJa } from '../data/ja/glossary';
import navConfig from '../data/ja/content/nav.json';
import ja from '../i18n/ja.json';

// 화면의 카테고리 선택 상자는 glossary.ts의 5개 값에서 그대로 만든다.
// (자유 입력을 허용하면 오타 하나로 그 용어가 일본어판 화면에서 조용히 사라진다)
const categories = glossaryCategoriesJa;

// 분류(category)의 한국어 이름 — 운영자는 일본어를 읽지 못하므로
// 선택 상자와 목록 양쪽에 한국어를 병기한다. 병기가 없으면 무엇을 고르는지
// 모른 채 아무거나 고르게 되고, 그 용어가 /ja/glossary/ 의 엉뚱한 절에 실린다.
// ⚠️ 저장되는 값(value)은 반드시 일본어 원문 그대로여야 한다.
//    glossary.ts의 GlossaryCategoryJa 5개 값과 한 글자라도 다르면
//    그 용어가 일본어판 화면에서 조용히 사라진다.
const categoryKo: Record<string, string> = {
  性能指標: '성능 지표',
  '規制・認証': '규제·인증',
  '技術・モデル': '기술·모델',
  'データ・個人情報': '데이터·개인정보',
  '導入・運用': '도입·운용',
};
const categoryRows = categories.map((c) => ({ value: c, ko: categoryKo[c] ?? '' }));

// 메뉴 항목의 한국어 설명 — 운영자는 일본어를 읽지 못하므로
// 일본어 메뉴명 옆에 한국어 이름을 함께 보여준다.
const navLabelKo: Record<string, string> = {
  home: '홈',
  about: '운영자 소개',
  subsidies: '보조금·조성금',
  videos: '추천 영상',
  tips: '현장 노하우',
  guide: '의료 AI 입문',
  checklist: '도입 체크리스트',
  glossary: '용어집',
  faq: '자주 묻는 질문',
};
const navLabels = ja.nav as Record<string, string>;
const navRows = navConfig.map((n) => ({
  href: n.href,
  key: n.key,
  ja: navLabels[n.key] ?? n.key,
  ko: navLabelKo[n.key] ?? n.key,
}));
---

<BaseLayout
  title="일본어판 관리자"
  description="일본어판(病院AI研究所) 콘텐츠 관리 대시보드"
  noindex
>
  <div class="container admin-ja">
    <header class="page-head">
      <h1>일본어판 관리자</h1>
      <p class="lead">
        일본어판 사이트(病院AI研究所, /ja/)의 내용을 여기서 고칩니다. 화면
        안내는 모두 한국어이고, <strong>입력하는 내용만 일본어</strong>입니다.
        저장하면 사이트에 반영되기까지 2~3분 걸립니다.
      </p>
    </header>

    {
      !SUPABASE_URL ? (
        <p class="hint">
          회원 기능이 아직 연결되지 않았습니다. supabase/SETUP-GUIDE.md의
          안내대로 개통한 뒤 사용할 수 있습니다.
        </p>
      ) : (
        <div id="admin-login-gate" class="panel">
          <h2>관리자 로그인</h2>
          <p class="hint">관리자 계정({ADMIN_EMAIL})으로 로그인하세요.</p>
          <div class="row gate-row">
            <label>
              이메일
              <input
                type="email"
                id="gate-email"
                placeholder="관리자 이메일"
                autocomplete="username"
                value={ADMIN_EMAIL}
              />
            </label>
            <label>
              비밀번호
              <input
                type="password"
                id="gate-password"
                placeholder="비밀번호"
                autocomplete="current-password"
              />
            </label>
            <button class="btn" id="gate-login-btn">로그인</button>
          </div>
          <p class="hint save-status" id="gate-status" />
          <p class="hint">
            한국어판 관리자(/admin/)에서 이미 로그인했다면 여기서는 다시
            로그인하지 않아도 됩니다.
          </p>
        </div>
      )
    }

    <div id="admin-dashboard" hidden>
      <div class="admin-topbar">
        <span id="admin-summary"></span>
        <button class="btn ghost" id="admin-logout">로그아웃</button>
      </div>

      <nav class="admin-nav" aria-label="일본어판 관리 메뉴">
        <a href="#jv-panel" data-tab="jv-panel">▶️ 추천 영상</a>
        <a href="#jn-panel" data-tab="jn-panel">🧭 상단 메뉴 표시</a>
        <a href="#jg-panel" data-tab="jg-panel">📘 용어집</a>
        <a href="#jf-panel" data-tab="jf-panel">❓ 자주 묻는 질문</a>
        <a href="#jp-panel" data-tab="jp-panel">📄 본문 페이지</a>
        <a href="#js-panel" data-tab="js-panel">🔄 자동 수집·반영 상태</a>
        <a href="#jt-panel" data-tab="jt-panel">🔑 GitHub 연동</a>
      </nav>

      <!-- ── 1. 추천 영상 ─────────────────────────────────── -->
      <section class="panel" id="jv-panel">
        <div class="panel-head">
          <h2>▶️ 추천 영상 (おすすめ動画)</h2>
          <button class="btn ghost" id="jv-refresh">새로고침</button>
        </div>
        <p class="section-desc">
          일본어판 <code>/ja/videos/</code> 페이지에 나오는 영상 목록입니다.
          여기 적힌 <strong>순서 그대로</strong> 화면에 표시됩니다.
        </p>
        <p class="warn-box">
          일본어 제목이 비어 있는 영상은 <strong>일본어판에 표시되지 않습니다.</strong>
          한국어 제목을 그대로 내보내지 않기 위한 장치입니다. 나중에 일본어
          제목을 채우면 그때 자동으로 공개됩니다.<br />
          ⚠️ 영상을 늘리거나 줄였다면, 페이지 첫머리 안내문에 사람이 손으로
          적어 둔 <code>全12回</code>(전 12회) 같은 숫자는 <strong>자동으로 바뀌지
          않습니다.</strong> 목록 바로 위의 편수 표시(<code>全○回</code>)만 자동으로
          바뀌기 때문에, 그대로 두면 같은 화면에서 두 숫자가 서로 다른 말을 하게
          됩니다. 위 <strong>「📄 본문 페이지」</strong> 탭에서
          <strong>「おすすめ動画 (추천 영상)」</strong>을 골라 설명(description)과
          첫머리 안내문(lead)의 숫자를 함께 고쳐 주세요.
        </p>
        <div id="jv-list" class="posts">불러오는 중…</div>
        <p class="hint save-status" id="jv-list-status"></p>

        <div id="jv-editor" class="editor" hidden>
          <h3>영상 수정: <span id="jv-editor-name"></span></h3>
          <label class="block">
            일본어 제목 <span class="hint-inline">(비우면 비공개)</span>
            <input type="text" id="jv-edit-title" />
          </label>
          <label class="block">
            일본어 설명
            <textarea id="jv-edit-note" rows="3"></textarea>
          </label>
          <div class="row">
            <button class="btn" id="jv-edit-save">저장</button>
            <button class="btn ghost" id="jv-edit-cancel">닫기</button>
          </div>
          <p class="hint save-status" id="jv-edit-status"></p>
        </div>

        <h3 class="panel-subhead">🔗 한국어판과 맞추기</h3>
        <p class="section-desc">
          한국어판의 "직접 만든 영상"(<code>source: own</code>) 가운데
          일본어판 목록에 <strong>아직 없는 영상</strong>만 찾아서 보여줍니다.
          한국어 원제를 참고해 일본어 제목·설명을 적고 "일본어판에 추가"를
          누르세요. 일본어 제목을 비운 채 추가해도 되지만, 그 영상은
          <strong>제목을 채울 때까지 일본어판에 나오지 않습니다.</strong>
        </p>
        <div id="jv-sync" class="posts">불러오는 중…</div>
        <p class="hint save-status" id="jv-sync-status"></p>

        <h3 class="panel-subhead">➕ 유튜브 링크로 직접 추가</h3>
        <p class="section-desc">
          한국어판에 없는 영상을 일본어판에만 넣을 때 사용합니다. 링크를
          붙여넣으면 썸네일이 미리 보입니다.
        </p>
        <label class="block">
          ① 유튜브 링크
          <input
            type="text"
            id="jv-url"
            placeholder="https://www.youtube.com/watch?v=..."
          />
        </label>
        <div class="video-preview" id="jv-preview" hidden>
          <img id="jv-preview-img" alt="" />
          <span class="video-preview-label" id="jv-preview-label"></span>
        </div>
        <label class="block">
          ② 일본어 제목
          <input type="text" id="jv-title" placeholder="日本語のタイトル" />
        </label>
        <label class="block">
          ③ 일본어 설명
          <textarea id="jv-note" rows="3" placeholder="日本語の説明"></textarea>
        </label>
        <div class="row">
          <button class="btn" id="jv-add">④ 추가</button>
        </div>
        <p class="hint save-status" id="jv-status"></p>
      </section>

      <!-- ── 2. 상단 메뉴 표시 ────────────────────────────── -->
      <section class="panel" id="jn-panel">
        <div class="panel-head">
          <h2>🧭 상단 메뉴 표시</h2>
          <button class="btn ghost" id="jn-refresh">새로고침</button>
        </div>
        <p class="section-desc">
          일본어판 화면 <strong>맨 위 메뉴줄</strong>에 어떤 분야를 보여줄지만
          정하는 설정입니다. 체크를 풀면 그 항목이 <strong>메뉴줄에서만</strong>
          사라집니다.
        </p>
        <p class="warn-box">
          ⚠️ <strong>이것은 "페이지 내리기"가 아닙니다.</strong> 체크를 풀어도
          다음 세 가지는 그대로 남습니다.
          <br />① 페이지 자체는 남아 있어, 주소를 아는 사람은 그대로 열 수
          있습니다.
          <br />② 검색엔진에 제출하는 목록(사이트맵)에도 그대로 남아,
          <strong>구글·야후 검색 결과에 계속 나옵니다.</strong>
          <br />③ 화면 아래(푸터)와 오른쪽(사이드바), 그리고 일본어판 첫
          화면에 있는 링크도 그대로 남아 계속 눌립니다. 특히
          「運営者について(운영자 소개)」 링크는 모든 일본어 페이지의 푸터·사이드바에
          붙박이로 들어가 있습니다.
          <br />내용이 부실해서 <strong>정말로 검색에 안 나오게 하고 싶다면</strong>,
          여기서 체크를 푸는 것만으로는 안 됩니다. 개발자에게 "○○ 페이지를
          검색에서 빼 달라"고 알려 주세요.
        </p>
        <p class="warn-box">
          홈(ホーム)은 일본어판의 입구라 끌 수 없습니다.
        </p>
        <div id="jn-list" class="posts">불러오는 중…</div>
        <div class="row">
          <button class="btn" id="jn-save">저장</button>
        </div>
        <p class="hint save-status" id="jn-status"></p>
      </section>

      <!-- ── 3. 용어집 ────────────────────────────────────── -->
      <section class="panel" id="jg-panel">
        <div class="panel-head">
          <h2>📘 용어집 (用語集)</h2>
          <button class="btn ghost" id="jg-refresh">새로고침</button>
        </div>
        <p class="section-desc">
          일본어판 <code>/ja/glossary/</code>의 용어 목록입니다.
        </p>
        <p class="warn-box">
          <strong>주소 표시(id)는 바꿀 수 없습니다.</strong> id는
          <code>/ja/glossary/#sensitivity</code> 처럼 그 용어로 바로 가는
          주소가 됩니다. 이미 공개된 id를 바꾸면 다른 사이트나 검색 결과에
          걸려 있던 링크가 전부 끊어집니다. 그래서 기존 용어의 id 칸은
          잠가 두었습니다.
        </p>
        <div id="jg-list" class="posts">불러오는 중…</div>

        <h3 class="panel-subhead" id="jg-form-head">➕ 용어 추가</h3>
        <div class="form-grid">
          <label>
            주소 표시(id) <span class="hint-inline">(영어 소문자·숫자·붙임표만)</span>
            <input type="text" id="jg-id" placeholder="예: sensitivity" />
          </label>
          <label>
            분류(category) <span class="hint-inline">괄호 안이 한국어 뜻입니다</span>
            <select id="jg-category">
              {
                categoryRows.map((c) => (
                  <option value={c.value}>
                    {c.value}
                    {c.ko ? ` (${c.ko})` : ''}
                  </option>
                ))
              }
            </select>
          </label>
          <label>
            용어(term) <span class="hint-inline">일본어</span>
            <input type="text" id="jg-term" placeholder="例: 感度" />
          </label>
          <label>
            읽는 법(reading) <span class="hint-inline">비워도 됩니다</span>
            <input type="text" id="jg-reading" placeholder="例: かんど" />
          </label>
        </div>
        <label class="block">
          뜻(definition) <span class="hint-inline">일본어</span>
          <textarea id="jg-definition" rows="3"></textarea>
        </label>
        <label class="block">
          왜 중요한가(whyMatters) <span class="hint-inline">일본어</span>
          <textarea id="jg-why" rows="3"></textarea>
        </label>
        <label class="block">
          출처 주소 <span class="hint-inline">한 줄에 하나씩. 없으면 비워 둡니다</span>
          <textarea
            id="jg-sources"
            rows="3"
            placeholder="https://www.mhlw.go.jp/..."></textarea>
        </label>
        <div class="row">
          <button class="btn" id="jg-save">추가</button>
          <button class="btn ghost" id="jg-cancel" hidden>새 용어 입력으로 돌아가기</button>
        </div>
        <p class="hint save-status" id="jg-status"></p>
      </section>

      <!-- ── 4. FAQ ──────────────────────────────────────── -->
      <section class="panel" id="jf-panel">
        <div class="panel-head">
          <h2>❓ 자주 묻는 질문 (よくあるご質問)</h2>
          <button class="btn ghost" id="jf-refresh">새로고침</button>
        </div>
        <p class="section-desc">
          일본어판 <code>/ja/faq/</code>의 질문 목록입니다. 여기 적힌 순서가
          화면 순서입니다.
        </p>
        <p class="warn-box">
          질문을 <strong>중간에 끼워 넣거나 지우면</strong> 각 질문으로 바로
          가는 주소(<code>#q1</code>, <code>#q2</code> …)가 한 칸씩 밀립니다.
          꼭 필요할 때만 하시고, 되도록 맨 뒤에 추가하세요.
        </p>
        <div id="jf-list" class="posts">불러오는 중…</div>

        <h3 class="panel-subhead" id="jf-form-head">➕ 질문 추가</h3>
        <label class="block">
          질문(question) <span class="hint-inline">일본어</span>
          <textarea id="jf-question" rows="2"></textarea>
        </label>
        <label class="block">
          답변(answer) <span class="hint-inline">일본어</span>
          <textarea id="jf-answer" rows="6"></textarea>
        </label>
        <label class="block">
          출처 주소 <span class="hint-inline">한 줄에 하나씩. 없으면 비워 둡니다</span>
          <textarea id="jf-sources" rows="3"></textarea>
        </label>
        <div class="row">
          <button class="btn" id="jf-save">추가</button>
          <button class="btn ghost" id="jf-cancel" hidden>새 질문 입력으로 돌아가기</button>
        </div>
        <p class="hint save-status" id="jf-status"></p>
      </section>

      <!-- ── 5. 본문 페이지 ──────────────────────────────── -->
      <section class="panel" id="jp-panel">
        <h2>📄 본문 페이지</h2>
        <p class="section-desc">
          먼저 고칠 페이지를 고르고, 그 안의 항목(섹션)을 하나씩 편집합니다.
        </p>
        <div class="row">
          <label style="flex:1 1 18rem">
            페이지 선택
            <select id="jp-page">
