<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, ADMIN_EMAIL }}>
  // 로그인 + GitHub 토큰 불러오기 + 탭 전환.
  // define:vars를 쓰므로 이 스크립트는 반드시 is:inline(번들 불가, 순수 JS)이다.
  // 아래 번들 스크립트와는 window.__adminGithubToken 과
  // admin-ready / admin-github-token-ready 이벤트로만 통신한다.
  (async () => {
    if (!SUPABASE_URL || !document.getElementById('admin-login-gate')) return;
    const { createClient } = await import(
      'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.0/+esm'
    );
    const sb = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    const $ = (id) => document.getElementById(id);

    function updateTokenPanelUI() {
      const el = $('token-status');
      if (!el) return; // 토큰 패널이 없는 화면에서도 죽지 않도록 방어
      el.innerHTML = window.__adminGithubToken
        ? '<span class="dot dot-on"></span>GitHub 연동되어 있습니다. 어느 기기에서 로그인해도 그대로 적용됩니다.'
        : '<span class="dot dot-off"></span>아직 GitHub 토큰이 없습니다. 아래에 붙여넣고 저장하세요.';
    }

    async function loadGithubToken() {
      const { data, error } = await sb
        .from('admin_secrets')
        .select('value')
        .eq('key', 'github_pat')
        .maybeSingle();
      window.__adminGithubToken = error ? '' : (data && data.value) || '';
      updateTokenPanelUI();
      if (error && $('token-status')) {
        $('token-status').textContent =
          '연동 상태 확인 실패: ' +
          (error.message || '') +
          ' — 저장소의 supabase/setup.sql을 Supabase 대시보드 → SQL Editor에 붙여넣고 한 번 실행하면 해결되는 경우가 많습니다.';
      }
    }

    async function saveGithubToken() {
      const status = $('token-status');
      const v = $('token-input').value.trim();
      if (!v) return;
      const { error } = await sb
        .from('admin_secrets')
        .upsert({ key: 'github_pat', value: v, updated_at: new Date().toISOString() });
      if (error) {
        status.textContent = '저장 실패: ' + (error.message || '');
        return;
      }
      window.__adminGithubToken = v;
      $('token-input').value = '';
      updateTokenPanelUI();
      window.dispatchEvent(new CustomEvent('admin-github-token-ready'));
    }

    // 탭: 누른 항목의 패널만 보이고 나머지는 숨긴다. 클릭 리스너 중복을
    // 막기 위해 이 함수는 부팅 시 딱 한 번만 부른다.
    function initAdminTabs() {
      const navLinks = [...document.querySelectorAll('.admin-nav a[data-tab]')];
      const panels = navLinks
        .map((a) => document.getElementById(a.dataset.tab))
        .filter(Boolean);

      function showTab(id) {
        panels.forEach((p) => {
          p.hidden = p.id !== id;
        });
        navLinks.forEach((a) => a.classList.toggle('active', a.dataset.tab === id));
      }

      navLinks.forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          showTab(a.dataset.tab);
          history.replaceState(null, '', '#' + a.dataset.tab);
        });
      });

      const fromHash = location.hash.slice(1);
      const initial = panels.some((p) => p.id === fromHash)
        ? fromHash
        : panels[0] && panels[0].id;
      if (initial) showTab(initial);
    }

    async function showAdminIfLoggedIn() {
      const {
        data: { session },
      } = await sb.auth.getSession();
      const isAdmin = session && session.user.email === ADMIN_EMAIL;
      $('admin-login-gate').hidden = !!isAdmin;
      $('admin-dashboard').hidden = !isAdmin;
      if (isAdmin) {
        await loadGithubToken();
        window.dispatchEvent(new CustomEvent('admin-ready'));
      }
    }

    $('gate-login-btn').addEventListener('click', async () => {
      const status = $('gate-status');
      status.textContent = '로그인 중…';
      const { data, error } = await sb.auth.signInWithPassword({
        email: $('gate-email').value.trim(),
        password: $('gate-password').value,
      });
      if (error) {
        status.textContent = '로그인 실패: 이메일 또는 비밀번호를 확인하세요.';
        return;
      }
      if (data.user.email !== ADMIN_EMAIL) {
        status.textContent = '관리자 계정이 아닙니다.';
        await sb.auth.signOut();
        return;
      }
      status.textContent = '';
      $('gate-password').value = '';
      showAdminIfLoggedIn();
    });

    $('gate-password').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') $('gate-login-btn').click();
    });

    $('admin-logout').addEventListener('click', async () => {
      await sb.auth.signOut();
      window.__adminGithubToken = '';
      showAdminIfLoggedIn();
    });

    $('token-save').addEventListener('click', saveGithubToken);

    initAdminTabs();
    showAdminIfLoggedIn();
  })();
</script>

<script is:inline>
  // sticky 탭 바가 사이트 헤더에 가리지 않도록 헤더 실측 높이를 CSS 변수로 반영.
  (() => {
    const header = document.querySelector('.site-header');
    if (!header || typeof ResizeObserver === 'undefined') return;
    const apply = () =>
      document.documentElement.style.setProperty(
        '--site-header-h',
        header.offsetHeight + 'px'
      );
    new ResizeObserver(apply).observe(header);
    apply();
  })();
</script>

<script>
  // ── 공통 ────────────────────────────────────────────────
  const REPO = 'BuminAI/hospital-ai-lab';
  const API = `https://api.github.com/repos/${REPO}`;

  const P = {
    videos: 'src/data/ja/content/videos.json',
    nav: 'src/data/ja/content/nav.json',
    glossary: 'src/data/ja/content/glossary.json',
    faq: 'src/data/ja/content/faq.json',
    guide: 'src/data/ja/content/guide.json',
    checklist: 'src/data/ja/content/checklist.json',
    tips: 'src/data/ja/content/tips.json',
    // おすすめ動画 페이지의 제목·안내문. 이 파일만 meta 항목이 최상위에 있고
    // sections(항목 목록)가 없다 — '본문 페이지' 패널이 별도로 다룬다.
    videosMeta: 'src/data/ja/content/videos-meta.json',
    subsidies: 'src/data/ja/subsidies.json',
    koVideos: 'src/data/recommended-videos.json',
  };

  const APPLIED = ' 사이트에 반영되기까지 2~3분 걸립니다.';

  const $ = (id: string) => document.getElementById(id) as any;

  function getToken(): string {
    return (window as any).__adminGithubToken || '';
  }

  async function gh(path: string, options: RequestInit = {}) {
    const token = getToken();
    if (!token)
      throw new Error(
        "아직 GitHub 연동이 안 됐습니다. 위 탭에서 'GitHub 연동'을 눌러 토큰을 저장하면 이 목록이 나타납니다."
      );
    const res = await fetch(`${API}${path}`, {
      ...options,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28',
        ...(options.headers || {}),
      },
    });
    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      const reason = body.message ? ` (GitHub: ${body.message})` : '';
      if (res.status === 401)
        throw new Error(`토큰이 유효하지 않습니다. 새 토큰을 설정하세요.${reason}`);
      if (res.status === 403)
        throw new Error(
          `권한이 없습니다(403). 토큰 설정에서 저장소 선택(hospital-ai-lab)과 권한(Contents: Read and write, Actions: Read-only)을 확인하세요.${reason}`
        );
      if (res.status === 404)
        throw new Error(`찾을 수 없습니다(404). 토큰의 저장소 권한을 확인하세요.${reason}`);
      throw new Error(`GitHub API 오류 ${res.status}: ${body.message || ''}`);
    }
    return res.status === 204 ? null : res.json();
  }

  // UTF-8 안전 base64 (일본어·한글 등 멀티바이트 처리). 한 글자도 바꾸지 말 것.
  function b64encode(str: string): string {
    const bytes = new TextEncoder().encode(str);
    let bin = '';
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin);
  }

  function b64decode(b64: string): string {
    // GitHub이 돌려주는 content는 60자마다 줄바꿈이 들어간 base64다.
    const bin = atob(b64.replace(/\n/g, ''));
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }

  // innerHTML 삽입용 HTML 이스케이프
  function esc(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // ── JSON 파일 읽기·쓰기 ─────────────────────────────────
  type Loaded = { sha: string; data: any };

  async function loadJson(path: string): Promise<Loaded> {
    const file = await gh(`/contents/${path}`);
    const raw = b64decode(file.content);
    let data: any;
    try {
      data = JSON.parse(raw);
    } catch (e: any) {
      throw new Error(
        `저장소의 ${path} 파일이 올바른 JSON 형식이 아닙니다. 이 화면에서는 고칠 수 없으니 개발자에게 알려 주세요. (원래 오류: ${e.message})`
      );
    }
    return { sha: file.sha, data };
  }

  /**
   * 저장 직전에 파일을 다시 읽어 sha가 그대로인지 확인한다.
   * 그 사이 다른 사람이나 자동 수집이 같은 파일을 바꿨으면
   * **덮어쓰지 않고** 한국어 안내와 함께 중단한다.
   * 성공하면 새 sha를 돌려준다.
   */
  async function saveJson(
    path: string,
    data: any,
    expectedSha: string,
    message: string
  ): Promise<string> {
    const fresh = await gh(`/contents/${path}`);
    if (fresh.sha !== expectedSha) {
      throw new Error(
        '저장하지 않았습니다 — 이 화면을 연 뒤에 같은 파일이 다른 곳에서 바뀌었습니다. ' +
          '그대로 저장하면 그 변경분이 지워지므로 중단했습니다. ' +
          "'새로고침'을 눌러 최신 내용을 불러온 뒤 다시 고쳐 주세요. " +
          '(지금 입력한 내용은 화면에 그대로 남아 있으니 복사해 두셔도 됩니다)'
      );
    }
    const res = await gh(`/contents/${path}`, {
      method: 'PUT',
      body: JSON.stringify({
        message,
        content: b64encode(JSON.stringify(data, null, 2) + '\n'),
        sha: expectedSha,
      }),
    });
    return res.content.sha as string;
  }

  // ── 검증 도우미 ─────────────────────────────────────────
  // 여기서 막지 못한 값은 빌드를 깨뜨리고, 빌드가 깨지면 일본어판뿐 아니라
  // 한국어판까지 갱신이 멈춘다. 그래서 "저장 전에 막는다"가 원칙이다.

  function req(value: string, label: string): string | null {
    return value.trim() ? null : `${label}을(를) 입력하세요. 비워 둘 수 없습니다.`;
  }

  /**
   * 자유 입력 칸(제목·뜻·답변 등)에 HTML 조각이 섞이는 것을 막는다.
   *
   * ⚠️ 지우지 말 것 — 보안 장치다.
   *    여기 적는 글은 일본어판 페이지의 구조화 데이터(검색엔진용 JSON) 안에도
   *    그대로 실린다. 거기에 스크립트 닫는 태그가 들어가면 그 자리에서
   *    페이지의 스크립트가 끊기고, 뒤에 이어 붙인 내용이 방문자의 브라우저에서
   *    실제로 실행되어 버린다(광고 삽입·가짜 로그인창 등).
   *    페이지 쪽(JaLayout.astro)에도 방어를 넣어 두었지만, 애초에 저장소에
   *    들어가지 않게 여기서도 막는다.
   *
   * ⚠️ 이 파일 안에서는 스크립트 닫는 태그를 글자 그대로 쓸 수 없다.
   *    (여기가 바로 그 태그가 통하는 자리라서, 적는 순간 이 화면이 깨진다)
   *    그래서 아래처럼 '<' 와 '/script' 를 따로 이어 붙여 만든다.
   */
  const CLOSE_TAG = '<' + '/script';
  const HTML_TAGISH_RE = /<\s*\/?\s*[a-zA-Z!/]/;
  const CLOSE_TAG_RE = new RegExp('<\\s*/\\s*script', 'i');

  function checkText(value: string, label: string): string | null {
    if (CLOSE_TAG_RE.test(value)) {
      return `${label}에 "${CLOSE_TAG}" 라는 글자가 들어 있어 저장하지 않았습니다. 이 글자가 들어가면 일본어판 페이지가 깨지고 위험한 내용이 실행될 수 있습니다. 꺾쇠(<, >)를 지우거나, 전각 기호(＜, ＞)로 바꿔 주세요.`;
    }
    if (HTML_TAGISH_RE.test(value)) {
      return `${label}에 "<" 로 시작하는 태그 같은 글자가 들어 있어 저장하지 않았습니다. 일본어판은 글자만 받고 HTML 태그는 받지 않습니다. 꺾쇠(<)를 지우거나 전각 기호(＜)로 바꿔 주세요.`;
    }
    return null;
  }

  /** 자유 입력 칸 여러 개를 한꺼번에 검사한다. 문제가 있으면 첫 오류 문구를 돌려준다. */
  function checkTexts(pairs: [string, string][]): string | null {
    for (const [v, label] of pairs) {
      const e = checkText(v, label);
      if (e) return e;
    }
    return null;
  }

  function parseLines(text: string): string[] {
    return text
      .split('\n')
      .map((s) => s.trim())
      .filter(Boolean);
  }

  /** 출처 주소 검증: http(s)로 시작하는 절대 주소만 허용 */
  function checkSources(list: string[]): string | null {
    for (const s of list) {
      if (!/^https?:\/\//i.test(s)) {
        return `출처 주소 "${s}" 는 http:// 또는 https:// 로 시작해야 합니다. 브라우저 주소창의 주소를 앞부분까지 통째로 복사해 붙여넣어 주세요. (이대로 저장하면 사이트 전체가 만들어지지 않습니다)`;
      }
      try {
        new URL(s);
      } catch {
        return `출처 주소 "${s}" 를 주소로 읽을 수 없습니다. 공백이나 빠진 글자가 없는지 확인해 주세요.`;
      }
    }
    return null;
  }

  const VIDEO_ID_RE = /^[A-Za-z0-9_-]{11}$/;
  const GLOSSARY_ID_RE = /^[a-z0-9]+(-[a-z0-9]+)*$/;

  function extractVideoId(url: string): string | null {
    const m = url.match(
      /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/
    );
    return m ? m[1] : null;
  }

  // ── 화면 표시 도우미 ────────────────────────────────────
  function ok(id: string, msg: string) {
    const el = $(id);
    el.classList.remove('bad');
    el.textContent = msg;
  }

  function bad(id: string, msg: string) {
    const el = $(id);
    el.classList.add('bad');
    el.textContent = msg;
  }

  /**
   * 이미 떠 있는 안내문을 지우지 않고 뒤에 주의 문구만 덧붙인다.
   * (예: "삭제했습니다." 뒤에 "편집창을 닫았습니다."를 이어 붙이는 경우)
   */
  function appendNote(id: string, msg: string) {
    const el = $(id);
    el.classList.add('bad');
    el.textContent = (el.textContent ? el.textContent + ' ' : '') + msg;
  }

  const REOPEN =
    "다시 '수정'을 눌러 주세요. (입력하던 내용은 저장되지 않았습니다)";

  /** 저장 버튼 이중 클릭 잠금 */
  function lock(btnId: string, fn: () => Promise<void>) {
    $(btnId).addEventListener('click', async () => {
      const btn = $(btnId);
      if (btn.disabled) return;
      btn.disabled = true;
      try {
        await fn();
      } finally {
        btn.disabled = false;
      }
    });
  }

  function fmtJst(iso: string): string {
    if (!iso) return '(기록 없음)';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return `(읽을 수 없는 날짜: ${iso})`;
    return d.toLocaleString('ko-KR', {
      timeZone: 'Asia/Tokyo',
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  function setAdminSummary(key: string, text: string) {
    const el = document.getElementById('admin-summary');
    if (!el) return;
    el.dataset[key] = text;
    el.textContent = [el.dataset.videos, el.dataset.deploy].filter(Boolean).join(' · ');
  }

  /** 항목을 배열 안에서 위/아래로 옮긴다. 옮길 수 없으면 false */
  function moveItem(arr: any[], i: number, dir: number): boolean {
    const j = i + dir;
    if (j < 0 || j >= arr.length) return false;
    const [x] = arr.splice(i, 1);
    arr.splice(j, 0, x);
    return true;
  }

  // ══ 1. 추천 영상 ═══════════════════════════════════════
  let jvSha = '';
  let jvVideos: any[] = [];
  // 편집 중인 영상은 '몇 번째'가 아니라 '어느 영상'인지로 기억한다.
  // 번호(index)만 들고 있으면, 편집창을 열어 둔 채 목록에서 다른 영상을
  // 지우거나 순서를 바꿨을 때 번호가 밀려 엉뚱한 영상을 덮어쓰게 된다.
  let jvEditIndex = -1;
  let jvEditVideoId = '';

  function jvRow(v: any, i: number, last: number): string {
    const hasTitle = String(v.titleJa || '').trim() !== '';
    const chip = hasTitle
      ? ''
      : '<span class="chip off">비공개 · 일본어 제목 없음</span> ';
    const title = hasTitle ? esc(v.titleJa) : '(일본어 제목을 아직 넣지 않았습니다)';
    return `
      <div class="post-row">
        <span class="post-title">
          <img class="thumb-sm" src="https://img.youtube.com/vi/${esc(v.videoId)}/default.jpg" alt="" />
          ${chip}${title}
        </span>
        <span class="post-actions">
          <button class="btn ghost tiny" data-jvmove="${i}" data-dir="-1" ${i === 0 ? 'disabled' : ''} title="위로">↑</button>
          <button class="btn ghost tiny" data-jvmove="${i}" data-dir="1" ${i === last ? 'disabled' : ''} title="아래로">↓</button>
          <a class="btn ghost" href="https://www.youtube.com/watch?v=${esc(v.videoId)}" target="_blank" rel="noopener">보기</a>
          <button class="btn ghost" data-jvedit="${i}">수정</button>
          <button class="btn ghost danger" data-jvdel="${i}">삭제</button>
        </span>
        <span class="post-sub">${v.note ? esc(v.note) : '<em>설명 없음</em>'}</span>
      </div>`;
  }

  async function loadVideos() {
    const el = $('jv-list');
    el.textContent = '불러오는 중…';
    try {
      const { sha, data } = await loadJson(P.videos);
      if (!Array.isArray(data)) throw new Error('videos.json 이 목록(배열) 형태가 아닙니다.');
      jvSha = sha;
      jvVideos = data;
      const shown = data.filter((v: any) => String(v.titleJa || '').trim()).length;
      el.innerHTML =
        data.map((v: any, i: number) => jvRow(v, i, data.length - 1)).join('') ||
        '<p class="hint">아직 등록된 영상이 없습니다.</p>';
      setAdminSummary('videos', `영상 ${shown}/${data.length}편 공개`);
      jvResyncEditor();
      el.querySelectorAll('[data-jvmove]').forEach((b: any) =>
        b.addEventListener('click', () =>
          jvMove(Number(b.dataset.jvmove), Number(b.dataset.dir))
        )
      );
      el.querySelectorAll('[data-jvedit]').forEach((b: any) =>
        b.addEventListener('click', () => jvOpenEditor(Number(b.dataset.jvedit)))
      );
      el.querySelectorAll('[data-jvdel]').forEach((b: any) =>
        b.addEventListener('click', () => jvDelete(Number(b.dataset.jvdel)))
      );
      renderSync();
    } catch (e: any) {
      el.textContent = e.message;
    }
  }

  /** 화면에 그린 목록과 방금 다시 읽은 목록이 같은 영상을 가리키는지 확인 */
  function jvSameSlot(data: any[], i: number, videoId: string) {
    if (!data[i] || data[i].videoId !== videoId) {
      throw new Error(
        "그 사이 영상 목록이 다른 곳에서 바뀌었습니다. 엉뚱한 영상을 건드리지 않도록 중단했습니다. '새로고침'을 누른 뒤 다시 해 주세요."
      );
    }
  }

  async function jvMove(i: number, dir: number) {
    try {
      ok('jv-list-status', '저장 중…');
      const { sha, data } = await loadJson(P.videos);
      jvSameSlot(data, i, jvVideos[i].videoId);
      if (!moveItem(data, i, dir)) return;
      await saveJson(P.videos, data, sha, '수정: 일본어판 추천 영상 순서 변경');
      ok('jv-list-status', '순서를 바꿨습니다.' + APPLIED);
      loadVideos();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jv-list-status', e.message);
    }
  }

  async function jvDelete(i: number) {
    const v = jvVideos[i];
    const name = String(v.titleJa || '').trim() || v.videoId;
    if (!confirm(`일본어판 목록에서 영상을 지웁니다.\n\n${name}\n\n지우면 일본어판 화면에서 사라집니다. 계속할까요?`))
      return;
    if (prompt('확인을 위해 "삭제"라고 입력하세요') !== '삭제') return;
    try {
      ok('jv-list-status', '삭제 중…');
      const { sha, data } = await loadJson(P.videos);
      jvSameSlot(data, i, v.videoId);
      data.splice(i, 1);
      await saveJson(P.videos, data, sha, `수정: 일본어판 추천 영상 삭제 - ${v.videoId}`);
      ok('jv-list-status', '삭제했습니다.' + APPLIED);
      loadVideos();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jv-list-status', e.message);
    }
  }

  /**
   * 목록을 다시 읽은 뒤, 편집창이 가리키는 번호를 그 영상의 새 위치로 다시 맞춘다.
   * 편집하던 영상이 사라졌으면 편집창을 닫고 한국어로 알린다.
   * (이것이 없으면 앞쪽 영상을 지웠을 때 번호가 한 칸 밀려, 저장 시
   *  전혀 다른 영상의 일본어 제목·설명이 통째로 덮어써진다)
   */
  function jvResyncEditor() {
    if (jvEditIndex < 0) return;
    const i = jvVideos.findIndex((v: any) => v.videoId === jvEditVideoId);
    if (i < 0) {
      jvCloseEditor();
      appendNote(
        'jv-list-status',
        `※ 편집 중이던 영상이 목록에서 사라져 편집창을 닫았습니다. ${REOPEN}`
      );
      return;
    }
    if (i !== jvEditIndex) {
      jvEditIndex = i;
      appendNote('jv-list-status', '※ 편집 중이던 영상의 위치가 바뀌어 편집창을 그 영상에 다시 맞췄습니다.');
    }
  }

  function jvCloseEditor() {
    $('jv-editor').hidden = true;
    jvEditIndex = -1;
    jvEditVideoId = '';
  }

  function jvOpenEditor(i: number) {
    jvEditIndex = i;
    const v = jvVideos[i];
    jvEditVideoId = v.videoId;
    $('jv-editor-name').textContent = v.videoId;
    $('jv-edit-title').value = v.titleJa || '';
    $('jv-edit-note').value = v.note || '';
    ok('jv-edit-status', '');
    $('jv-editor').hidden = false;
    $('jv-editor').scrollIntoView({ block: 'center' });
  }

  $('jv-edit-cancel').addEventListener('click', jvCloseEditor);

  lock('jv-edit-save', async () => {
    if (jvEditIndex < 0) return;
    const title = $('jv-edit-title').value.trim();
    const noteText = $('jv-edit-note').value.trim();

    // ⚠️ 저장 직전에 '지금 이 번호가 정말 그 영상인지' 다시 대조한다.
    //    목록이 밀린 상태로 저장하면 엉뚱한 영상의 내용을 덮어써 버린다.
    const target = jvVideos[jvEditIndex];
    if (!target || target.videoId !== jvEditVideoId) {
      bad(
        'jv-edit-status',
        `수정을 시작한 뒤 영상 목록이 바뀌었습니다. 엉뚱한 영상을 덮어쓰지 않도록 저장하지 않았습니다. '새로고침'을 누른 뒤 ${REOPEN}`
      );
      return;
    }
    const textErr = checkTexts([
      [title, '일본어 제목'],
      [noteText, '일본어 설명'],
    ]);
    if (textErr) {
      bad('jv-edit-status', textErr);
      return;
    }
    try {
      ok('jv-edit-status', '저장 중…');
      const data = jvVideos.map((v, i) =>
        i === jvEditIndex ? { ...v, titleJa: title, note: noteText } : v
      );
      jvSha = await saveJson(
        P.videos,
        data,
        jvSha,
        `수정: 일본어판 추천 영상 - ${jvEditVideoId}`
      );
      ok(
        'jv-edit-status',
        (title ? '저장했습니다.' : '저장했습니다. 일본어 제목이 비어 있어 이 영상은 아직 공개되지 않습니다.') +
          APPLIED
      );
      jvCloseEditor();
      loadVideos();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jv-edit-status', e.message);
    }
  });

  // ── 한국어판과 맞추기 ───────────────────────────────────
  let koOwn: any[] = [];

  async function loadKoVideos() {
    try {
      const { data } = await loadJson(P.koVideos);
      koOwn = Array.isArray(data) ? data.filter((v: any) => v.source === 'own') : [];
    } catch {
      koOwn = [];
    }
  }

  function renderSync() {
    const el = $('jv-sync');
    const have = new Set(jvVideos.map((v: any) => v.videoId));
    const missing = koOwn.filter((v: any) => !have.has(v.videoId));
    if (!koOwn.length) {
      el.innerHTML = '<p class="hint">한국어판 영상 목록을 아직 불러오지 못했습니다. 새로고침을 눌러 보세요.</p>';
      return;
    }
    if (!missing.length) {
      el.innerHTML =
        '<p class="hint">✅ 한국어판에서 직접 만든 영상은 모두 일본어판에 들어가 있습니다. 추가할 것이 없습니다.</p>';
      return;
    }
    el.innerHTML =
      `<p class="hint"><strong>일본어판에 없는 영상 ${missing.length}편</strong>입니다.</p>` +
      missing
        .map(
          (v: any) => `
        <div class="post-row">
          <span class="post-title">
            <img class="thumb-sm" src="https://img.youtube.com/vi/${esc(v.videoId)}/default.jpg" alt="" />
            ${esc(v.title)}
          </span>
          <span class="post-sub">한국어 원제입니다. 아래에 일본어 제목·설명을 적어 주세요.</span>
          <span class="post-sub">
            <input type="text" data-synctitle="${esc(v.videoId)}" placeholder="日本語のタイトル (비우면 공개되지 않습니다)" />
          </span>
          <span class="post-sub">
            <textarea rows="2" data-syncnote="${esc(v.videoId)}" placeholder="日本語の説明"></textarea>
          </span>
          <span class="post-actions">
            <a class="btn ghost" href="https://www.youtube.com/watch?v=${esc(v.videoId)}" target="_blank" rel="noopener">영상 보기</a>
            <button class="btn" data-syncadd="${esc(v.videoId)}">일본어판에 추가</button>
          </span>
        </div>`
        )
        .join('');
    el.querySelectorAll('[data-syncadd]').forEach((b: any) =>
      b.addEventListener('click', async () => {
        if (b.disabled) return;
        b.disabled = true;
        try {
          await syncAdd(b.dataset.syncadd);
        } finally {
          b.disabled = false;
        }
      })
    );
  }

  async function syncAdd(videoId: string) {
    const titleEl = document.querySelector(
      `[data-synctitle="${CSS.escape(videoId)}"]`
    ) as HTMLInputElement | null;
    const noteEl = document.querySelector(
      `[data-syncnote="${CSS.escape(videoId)}"]`
    ) as HTMLTextAreaElement | null;
    const titleJa = titleEl ? titleEl.value.trim() : '';
    const note = noteEl ? noteEl.value.trim() : '';
    if (!VIDEO_ID_RE.test(videoId)) {
      bad('jv-sync-status', `영상 주소(${videoId})가 올바르지 않습니다.`);
      return;
    }
    const textErr = checkTexts([
      [titleJa, '일본어 제목'],
      [note, '일본어 설명'],
    ]);
    if (textErr) {
      bad('jv-sync-status', textErr);
      return;
    }
    if (!titleJa) {
      if (
        !confirm(
          '일본어 제목이 비어 있습니다.\n\n이대로 추가하면 목록에는 들어가지만, 일본어 제목을 채울 때까지 일본어판 화면에는 나오지 않습니다.\n(한국어 제목을 그대로 일본어판에 내보내지 않기 위한 장치입니다)\n\n계속할까요?'
        )
      )
        return;
    }
    try {
      ok('jv-sync-status', '저장 중…');
      const { sha, data } = await loadJson(P.videos);
      if (data.some((v: any) => v.videoId === videoId)) {
        throw new Error('이미 일본어판 목록에 있는 영상입니다. 새로고침을 눌러 주세요.');
      }
      data.push({ videoId, titleJa, note });
      await saveJson(P.videos, data, sha, `수정: 일본어판 추천 영상 추가 - ${videoId}`);
      ok(
        'jv-sync-status',
        (titleJa
          ? '일본어판에 추가했습니다.'
          : '목록에 넣었습니다. 일본어 제목이 없어 아직 공개되지 않습니다 — 위 목록의 "수정"에서 제목을 채우면 공개됩니다.') + APPLIED
      );
      loadVideos();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jv-sync-status', e.message);
    }
  }

  // ── 유튜브 링크로 직접 추가 ─────────────────────────────
  let lastPreviewId: string | null = null;

  $('jv-url').addEventListener('input', () => {
    const id = extractVideoId($('jv-url').value.trim());
    const preview = $('jv-preview');
    if (!id) {
      preview.hidden = true;
      lastPreviewId = null;
      return;
    }
    if (id === lastPreviewId) return;
    lastPreviewId = id;
    $('jv-preview-img').src = `https://img.youtube.com/vi/${id}/hqdefault.jpg`;
    $('jv-preview-label').textContent = '✓ 유튜브 영상을 찾았습니다.';
    preview.hidden = false;
  });

  lock('jv-add', async () => {
    const url = $('jv-url').value.trim();
    const videoId = extractVideoId(url);
    if (!videoId) {
      bad(
        'jv-status',
        '올바른 유튜브 링크가 아닙니다. 주소창의 주소를 그대로 붙여넣어 주세요. (예: https://www.youtube.com/watch?v=… 또는 https://youtu.be/…)'
      );
      return;
    }
    const titleJa = $('jv-title').value.trim();
    const note = $('jv-note').value.trim();
    const e1 = req(titleJa, '일본어 제목');
    if (e1) {
      bad(
        'jv-status',
        e1 + ' (일본어 제목이 없으면 일본어판에 표시되지 않습니다)'
      );
      return;
    }
    const textErr = checkTexts([
      [titleJa, '일본어 제목'],
      [note, '일본어 설명'],
    ]);
    if (textErr) {
      bad('jv-status', textErr);
      return;
    }
    try {
      ok('jv-status', '저장 중…');
      const { sha, data } = await loadJson(P.videos);
      if (data.some((v: any) => v.videoId === videoId)) {
        throw new Error('이미 목록에 있는 영상입니다. 같은 영상을 두 번 넣을 수 없습니다.');
      }
      data.push({ videoId, titleJa, note });
      await saveJson(P.videos, data, sha, `수정: 일본어판 추천 영상 추가 - ${videoId}`);
      ok('jv-status', '추가했습니다.' + APPLIED);
      $('jv-url').value = '';
      $('jv-title').value = '';
      $('jv-note').value = '';
      $('jv-preview').hidden = true;
      lastPreviewId = null;
      loadVideos();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jv-status', e.message);
    }
  });

  $('jv-refresh').addEventListener('click', async () => {
    await loadKoVideos();
    loadVideos();
  });

  // ══ 2. 공개 상태 (메뉴 노출) ═══════════════════════════
  let jnSha = '';

  // 일본어 메뉴명 옆에 한국어 이름을 함께 보여주기 위한 대응표
  const NAV_LABELS: Record<string, { ja: string; ko: string }> = {};
  {
    const tpl = document.getElementById('ja-nav-labels');
    const raw = tpl ? (tpl as HTMLElement).dataset.values || '' : '';
    raw
      .split('\n')
      .filter(Boolean)
      .forEach((line) => {
        const [key, jaLabel, koLabel] = line.split('\t');
        NAV_LABELS[key] = { ja: jaLabel, ko: koLabel };
      });
  }

  async function loadNav() {
    const el = $('jn-list');
    el.textContent = '불러오는 중…';
    try {
      const { sha, data } = await loadJson(P.nav);
      if (!Array.isArray(data)) throw new Error('nav.json 이 목록(배열) 형태가 아닙니다.');
      jnSha = sha;
      el.innerHTML = data
        .map((n: any, i: number) => {
          const isHome = n.href === '/ja/';
          const label = NAV_LABELS[n.key] || { ja: n.key, ko: n.key };
          return `
          <div class="post-row">
            <span class="post-title">
              <label class="check">
                <input type="checkbox" data-jnrow="${i}" ${n.enabled || isHome ? 'checked' : ''} ${isHome ? 'disabled' : ''} />
                ${esc(label.ja)} <span class="hint-inline">(${esc(label.ko)})</span>
              </label>
            </span>
            <span class="post-file">${esc(n.href)}${isHome ? ' · 끌 수 없음' : ''}</span>
          </div>`;
        })
        .join('');
      ok('jn-status', '');
    } catch (e: any) {
      el.textContent = e.message;
    }
  }

  lock('jn-save', async () => {
    try {
      ok('jn-status', '저장 중…');
      const { sha, data } = await loadJson(P.nav);
      if (sha !== jnSha) {
        throw new Error(
          "이 화면을 연 뒤에 메뉴 설정이 다른 곳에서 바뀌었습니다. '새로고침'을 눌러 최신 내용을 확인한 뒤 다시 설정해 주세요."
        );
      }
      const boxes = [...$('jn-list').querySelectorAll('[data-jnrow]')] as any[];
      if (boxes.length !== data.length) {
        throw new Error("화면과 저장된 내용의 항목 수가 다릅니다. '새로고침'을 눌러 주세요.");
      }
      const next = data.map((n: any, i: number) => ({
        href: n.href,
        key: n.key,
        // 홈은 언제나 켜 둔다 (체크박스가 disabled라 값을 못 읽을 수 있음)
        enabled: n.href === '/ja/' ? true : !!boxes[i].checked,
      }));
      if (!next.some((n: any) => n.enabled)) {
        throw new Error('메뉴가 하나도 남지 않습니다. 최소 한 개는 켜 두어야 합니다.');
      }
      jnSha = await saveJson(P.nav, next, jnSha, '수정: 일본어판 메뉴 공개 상태 변경');
      const onCount = next.filter((n: any) => n.enabled).length;
      ok(
        'jn-status',
        `저장했습니다. 일본어판 상단 메뉴에 ${onCount}개가 표시됩니다. (체크를 푼 페이지도 지워지지 않고 검색 결과·푸터 링크에는 그대로 남습니다.)` +
          APPLIED
      );
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jn-status', e.message);
    }
  });

  $('jn-refresh').addEventListener('click', loadNav);

  // ══ 3. 용어집 ═════════════════════════════════════════
  let jgSha = '';
  let jgTerms: any[] = [];
  let jgEditIndex = -1; // -1 = 새 용어 추가
  // 수정 중인 용어의 신원(id). 번호(index)만 믿으면, 앞쪽 용어를 지웠을 때
  // 번호가 밀려 엉뚱한 용어의 내용이 통째로 덮어써진다.
  let jgEditId = '';

  const CATEGORIES: string[] = (() => {
    const tpl = document.getElementById('ja-categories');
    const raw = tpl ? (tpl as HTMLElement).dataset.values || '' : '';
    return raw.split('\n').filter(Boolean);
  })();

  // 분류(category)의 한국어 이름. 목록 행에 일본어와 함께 보여 준다.
  const CATEGORY_KO: Record<string, string> = {};
  {
    const tpl = document.getElementById('ja-category-ko');
    const raw = tpl ? (tpl as HTMLElement).dataset.values || '' : '';
    raw
      .split('\n')
      .filter(Boolean)
      .forEach((line) => {
        const [ja, ko] = line.split('\t');
        if (ja) CATEGORY_KO[ja] = ko || '';
      });
  }

  /** '規制・認証 (규제·인증)' 처럼 한국어를 병기해 돌려준다. */
  function categoryLabel(c: string): string {
    const ko = CATEGORY_KO[c];
    return ko ? `${c} (${ko})` : c;
  }

  async function loadGlossary() {
    const el = $('jg-list');
    el.textContent = '불러오는 중…';
    try {
      const { sha, data } = await loadJson(P.glossary);
      if (!Array.isArray(data)) throw new Error('glossary.json 이 목록(배열) 형태가 아닙니다.');
      jgSha = sha;
      jgTerms = data;
      jgResyncEditor();
      el.innerHTML =
        data
          .map(
            (t: any, i: number) => `
        <div class="post-row">
          <span class="post-title">${esc(t.term)} <span class="hint-inline">${esc(t.reading || '')}</span></span>
          <span class="post-file">${esc(categoryLabel(t.category))} · id: ${esc(t.id)}</span>
          <span class="post-actions">
            <button class="btn ghost" data-jgedit="${i}">수정</button>
            <button class="btn ghost danger" data-jgdel="${i}">삭제</button>
          </span>
        </div>`
          )
          .join('') || '<p class="hint">아직 등록된 용어가 없습니다.</p>';
      el.querySelectorAll('[data-jgedit]').forEach((b: any) =>
        b.addEventListener('click', () => jgOpen(Number(b.dataset.jgedit)))
      );
      el.querySelectorAll('[data-jgdel]').forEach((b: any) =>
        b.addEventListener('click', () => jgDelete(Number(b.dataset.jgdel)))
      );
    } catch (e: any) {
      el.textContent = e.message;
    }
  }

  /**
   * 목록을 다시 읽은 뒤, 수정 중인 용어가 몇 번째로 옮겨졌는지 다시 맞춘다.
   * 그 용어가 사라졌으면 입력칸을 '새 용어 추가'로 되돌리고 한국어로 알린다.
   */
  function jgResyncEditor() {
    if (jgEditIndex < 0) return;
    const i = jgTerms.findIndex((t: any) => t.id === jgEditId);
    if (i < 0) {
      jgReset();
      appendNote(
        'jg-status',
        '※ 수정 중이던 용어가 목록에서 사라져 입력칸을 새 용어 추가로 되돌렸습니다. (입력하던 내용은 저장되지 않았습니다)'
      );
      return;
    }
    jgEditIndex = i;
  }

  function jgOpen(i: number) {
    jgEditIndex = i;
    const t = jgTerms[i];
    jgEditId = t.id;
    $('jg-form-head').textContent = `✏️ 용어 수정: ${t.term}`;
    $('jg-id').value = t.id;
    // 이미 공개된 id는 바꿀 수 없다 — 바꾸면 외부 링크가 끊어진다.
    $('jg-id').disabled = true;
    $('jg-category').value = t.category;
    $('jg-term').value = t.term;
    $('jg-reading').value = t.reading || '';
    $('jg-definition').value = t.definition || '';
    $('jg-why').value = t.whyMatters || '';
    $('jg-sources').value = (t.sources || []).join('\n');
    $('jg-save').textContent = '수정 저장';
    $('jg-cancel').hidden = false;
    ok('jg-status', '');
    $('jg-form-head').scrollIntoView({ block: 'start' });
  }

  function jgReset() {
    jgEditIndex = -1;
    jgEditId = '';
    $('jg-form-head').textContent = '➕ 용어 추가';
    $('jg-id').value = '';
    $('jg-id').disabled = false;
    $('jg-category').selectedIndex = 0;
    $('jg-term').value = '';
    $('jg-reading').value = '';
    $('jg-definition').value = '';
    $('jg-why').value = '';
    $('jg-sources').value = '';
    $('jg-save').textContent = '추가';
    $('jg-cancel').hidden = true;
  }

  $('jg-cancel').addEventListener('click', () => {
    jgReset();
    ok('jg-status', '');
  });

  lock('jg-save', async () => {
    const isNew = jgEditIndex < 0;
    const id = $('jg-id').value.trim();
    const category = $('jg-category').value;
    const term = $('jg-term').value.trim();
    const reading = $('jg-reading').value.trim();
    const definition = $('jg-definition').value.trim();
    const whyMatters = $('jg-why').value.trim();
    const sources = parseLines($('jg-sources').value);

    // ── 검증 ──
    // ⚠️ 수정일 때는 '지금 이 번호가 정말 그 용어인지' 먼저 대조한다.
    //    목록이 밀린 상태로 저장하면, id는 그대로 둔 채 다른 용어의 뜻·내용만
    //    이 입력값으로 바뀌는 최악의 형태가 된다.
    if (!isNew) {
      const target = jgTerms[jgEditIndex];
      if (!target || target.id !== jgEditId) {
        bad(
          'jg-status',
          `수정을 시작한 뒤 용어 목록이 바뀌었습니다. 엉뚱한 용어를 덮어쓰지 않도록 저장하지 않았습니다. '새로고침'을 누른 뒤 ${REOPEN}`
        );
        return;
      }
    }
    if (isNew) {
      if (!id) {
        bad('jg-status', '주소 표시(id)를 입력하세요. 이 용어로 바로 가는 주소가 됩니다.');
        return;
      }
      if (!GLOSSARY_ID_RE.test(id)) {
        bad(
          'jg-status',
          `주소 표시(id) "${id}" 는 쓸 수 없습니다. 영어 소문자와 숫자, 붙임표(-)만 쓸 수 있고, 공백·한글·일본어·대문자는 넣을 수 없습니다. (예: post-market-surveillance)`
        );
        return;
      }
      if (jgTerms.some((t: any) => t.id === id)) {
        bad(
          'jg-status',
          `주소 표시(id) "${id}" 는 이미 다른 용어가 쓰고 있습니다. 두 용어가 같은 주소를 쓰면 뒤에 있는 용어로는 영영 이동할 수 없게 되므로 저장하지 않았습니다. 다른 id를 지어 주세요.`
        );
        return;
      }
    }
    if (!CATEGORIES.includes(category)) {
      bad(
        'jg-status',
        `분류(category) "${category}" 는 정해진 5개 값이 아닙니다. 목록에서 골라 주세요. (정해진 값이 아니면 그 용어가 일본어판 화면에서 조용히 사라집니다)`
      );
      return;
    }
    for (const [v, label] of [
      [term, '용어(term)'],
      [definition, '뜻(definition)'],
      [whyMatters, '왜 중요한가(whyMatters)'],
    ] as [string, string][]) {
      const e = req(v, label);
      if (e) {
        bad('jg-status', e);
        return;
      }
    }
    const textErr = checkTexts([
      [term, '용어(term)'],
      [reading, '읽는 법(reading)'],
      [definition, '뜻(definition)'],
      [whyMatters, '왜 중요한가(whyMatters)'],
    ]);
    if (textErr) {
      bad('jg-status', textErr);
      return;
    }
    const srcErr = checkSources(sources);
    if (srcErr) {
      bad('jg-status', srcErr);
      return;
    }

    try {
      ok('jg-status', '저장 중…');
      const entry = { id, term, reading, category, definition, whyMatters, sources };
      let next: any[];
      if (isNew) {
        next = [...jgTerms, entry];
      } else {
        // id는 화면에서 잠갔지만, 만에 하나라도 바뀌지 않도록 원본 id를 그대로 쓴다.
        next = jgTerms.map((t: any, i: number) =>
          i === jgEditIndex ? { ...entry, id: t.id } : t
        );
      }
      jgSha = await saveJson(
        P.glossary,
        next,
        jgSha,
        `수정: 일본어판 용어집 ${isNew ? '추가' : '수정'} - ${term}`
      );
      ok('jg-status', (isNew ? '용어를 추가했습니다.' : '용어를 수정했습니다.') + APPLIED);
      jgReset();
      loadGlossary();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jg-status', e.message);
    }
  });

  async function jgDelete(i: number) {
    const t = jgTerms[i];
    if (
      !confirm(
        `용어를 지웁니다.\n\n${t.term} (id: ${t.id})\n\n이 용어로 바로 가던 주소 /ja/glossary/#${t.id} 도 함께 사라집니다.\n계속할까요?`
      )
    )
      return;
    if (prompt('확인을 위해 "삭제"라고 입력하세요') !== '삭제') return;
    try {
      ok('jg-status', '삭제 중…');
      const { sha, data } = await loadJson(P.glossary);
      const idx = data.findIndex((x: any) => x.id === t.id);
      if (idx < 0) throw new Error("이미 지워진 용어입니다. '새로고침'을 눌러 주세요.");
      data.splice(idx, 1);
      jgSha = await saveJson(P.glossary, data, sha, `수정: 일본어판 용어집 삭제 - ${t.term}`);
      ok('jg-status', '삭제했습니다.' + APPLIED);
      // 편집 중이던 용어의 번호 재조정은 loadGlossary() → jgResyncEditor()가 한다.
      // (앞쪽 용어를 지우면 뒤쪽 번호가 한 칸 당겨지므로 여기서 조건 없이 맡긴다)
      loadGlossary();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jg-status', e.message);
    }
  }

  $('jg-refresh').addEventListener('click', loadGlossary);

  // ══ 4. 자주 묻는 질문 ══════════════════════════════════
  let jfSha = '';
  let jfItems: any[] = [];
  let jfEditIndex = -1;
  // 수정 중인 질문의 신원(질문 글). 번호만 믿으면 순서를 바꾸거나 앞쪽 질문을
  // 지웠을 때 엉뚱한 질문의 내용이 덮어써진다.
  let jfEditQuestion = '';

  async function loadFaq() {
    const el = $('jf-list');
    el.textContent = '불러오는 중…';
    try {
      const { sha, data } = await loadJson(P.faq);
      if (!Array.isArray(data)) throw new Error('faq.json 이 목록(배열) 형태가 아닙니다.');
      jfSha = sha;
      jfItems = data;
      jfResyncEditor();
      el.innerHTML =
        data
          .map(
            (q: any, i: number) => `
        <div class="post-row">
          <span class="post-title">${esc(q.question)}</span>
          <span class="post-file">#q${i + 1}</span>
          <span class="post-actions">
            <button class="btn ghost tiny" data-jfmove="${i}" data-dir="-1" ${i === 0 ? 'disabled' : ''} title="위로">↑</button>
            <button class="btn ghost tiny" data-jfmove="${i}" data-dir="1" ${i === data.length - 1 ? 'disabled' : ''} title="아래로">↓</button>
            <button class="btn ghost" data-jfedit="${i}">수정</button>
            <button class="btn ghost danger" data-jfdel="${i}">삭제</button>
          </span>
        </div>`
          )
          .join('') || '<p class="hint">아직 등록된 질문이 없습니다.</p>';
      el.querySelectorAll('[data-jfmove]').forEach((b: any) =>
        b.addEventListener('click', () =>
          jfMove(Number(b.dataset.jfmove), Number(b.dataset.dir))
        )
      );
      el.querySelectorAll('[data-jfedit]').forEach((b: any) =>
        b.addEventListener('click', () => jfOpen(Number(b.dataset.jfedit)))
      );
      el.querySelectorAll('[data-jfdel]').forEach((b: any) =>
        b.addEventListener('click', () => jfDelete(Number(b.dataset.jfdel)))
      );
    } catch (e: any) {
      el.textContent = e.message;
    }
  }

  /**
   * 목록을 다시 읽은 뒤, 수정 중인 질문이 몇 번째로 옮겨졌는지 다시 맞춘다.
   * 그 질문이 사라졌으면 입력칸을 '새 질문 추가'로 되돌리고 한국어로 알린다.
   */
  function jfResyncEditor() {
    if (jfEditIndex < 0) return;
    const i = jfItems.findIndex((q: any) => q.question === jfEditQuestion);
    if (i < 0) {
      jfReset();
      appendNote(
        'jf-status',
        '※ 수정 중이던 질문이 목록에서 사라져 입력칸을 새 질문 추가로 되돌렸습니다. (입력하던 내용은 저장되지 않았습니다)'
      );
      return;
    }
    if (i !== jfEditIndex) {
      jfEditIndex = i;
      $('jf-form-head').textContent = `✏️ 질문 수정 (#q${i + 1})`;
      appendNote('jf-status', '※ 수정 중이던 질문의 위치가 바뀌어 입력칸을 그 질문에 다시 맞췄습니다.');
    }
  }

  function jfOpen(i: number) {
    jfEditIndex = i;
    const q = jfItems[i];
    jfEditQuestion = q.question;
    $('jf-form-head').textContent = `✏️ 질문 수정 (#q${i + 1})`;
    $('jf-question').value = q.question || '';
    $('jf-answer').value = q.answer || '';
    $('jf-sources').value = (q.sources || []).join('\n');
    $('jf-save').textContent = '수정 저장';
    $('jf-cancel').hidden = false;
    ok('jf-status', '');
    $('jf-form-head').scrollIntoView({ block: 'start' });
  }

  function jfReset() {
    jfEditIndex = -1;
    jfEditQuestion = '';
    $('jf-form-head').textContent = '➕ 질문 추가';
    $('jf-question').value = '';
    $('jf-answer').value = '';
    $('jf-sources').value = '';
    $('jf-save').textContent = '추가';
    $('jf-cancel').hidden = true;
  }

  $('jf-cancel').addEventListener('click', () => {
    jfReset();
    ok('jf-status', '');
  });

  lock('jf-save', async () => {
    const isNew = jfEditIndex < 0;
    const question = $('jf-question').value.trim();
    const answer = $('jf-answer').value.trim();
    const sources = parseLines($('jf-sources').value);

    // ⚠️ 수정일 때는 '지금 이 번호가 정말 그 질문인지' 먼저 대조한다.
    if (!isNew) {
      const target = jfItems[jfEditIndex];
      if (!target || target.question !== jfEditQuestion) {
        bad(
          'jf-status',
          `수정을 시작한 뒤 질문 목록이 바뀌었습니다. 엉뚱한 질문을 덮어쓰지 않도록 저장하지 않았습니다. '새로고침'을 누른 뒤 ${REOPEN}`
        );
        return;
      }
    }
    for (const [v, label] of [
      [question, '질문(question)'],
      [answer, '답변(answer)'],
    ] as [string, string][]) {
      const e = req(v, label);
      if (e) {
        bad('jf-status', e);
        return;
      }
    }
    const textErr = checkTexts([
      [question, '질문(question)'],
      [answer, '답변(answer)'],
    ]);
    if (textErr) {
      bad('jf-status', textErr);
      return;
    }
    const srcErr = checkSources(sources);
    if (srcErr) {
      bad('jf-status', srcErr);
      return;
    }

    try {
      ok('jf-status', '저장 중…');
      const entry = { question, answer, sources };
      // 새 질문은 항상 맨 뒤에 붙인다 — 중간에 끼우면 기존 #q 주소가 밀린다.
      const next = isNew
        ? [...jfItems, entry]
        : jfItems.map((q: any, i: number) => (i === jfEditIndex ? entry : q));
      jfSha = await saveJson(
        P.faq,
        next,
        jfSha,
        `수정: 일본어판 FAQ ${isNew ? '추가' : '수정'}`
      );
      ok(
        'jf-status',
        (isNew ? `맨 뒤(#q${next.length})에 추가했습니다.` : '수정했습니다.') + APPLIED
      );
      jfReset();
      loadFaq();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jf-status', e.message);
    }
  });

  async function jfMove(i: number, dir: number) {
    if (
      !confirm(
        '질문의 순서를 바꾸면 각 질문으로 바로 가던 주소(#q1, #q2 …)가 달라집니다.\n다른 곳에 걸어 둔 링크가 다른 질문을 가리키게 될 수 있습니다.\n\n계속할까요?'
      )
    )
      return;
    try {
      const { sha, data } = await loadJson(P.faq);
      if (!data[i] || data[i].question !== jfItems[i].question) {
        throw new Error(
          "그 사이 질문 목록이 다른 곳에서 바뀌었습니다. 엉뚱한 질문을 옮기지 않도록 중단했습니다. '새로고침'을 누른 뒤 다시 해 주세요."
        );
      }
      if (!moveItem(data, i, dir)) return;
      jfSha = await saveJson(P.faq, data, sha, '수정: 일본어판 FAQ 순서 변경');
      ok('jf-status', '순서를 바꿨습니다.' + APPLIED);
      loadFaq();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jf-status', e.message);
    }
  }

  async function jfDelete(i: number) {
    const q = jfItems[i];
    if (
      !confirm(
        `질문을 지웁니다.\n\n${q.question}\n\n뒤에 있는 질문들의 주소(#q${i + 2} 이후)가 한 칸씩 앞당겨집니다.\n계속할까요?`
      )
    )
      return;
    if (prompt('확인을 위해 "삭제"라고 입력하세요') !== '삭제') return;
    try {
      ok('jf-status', '삭제 중…');
      const { sha, data } = await loadJson(P.faq);
      if (data.length !== jfItems.length || !data[i] || data[i].question !== q.question) {
        throw new Error(
          "그 사이 질문 목록이 바뀌었습니다. 엉뚱한 질문을 지우지 않도록 중단했습니다. '새로고침'을 눌러 다시 확인해 주세요."
        );
      }
      data.splice(i, 1);
      jfSha = await saveJson(P.faq, data, sha, '수정: 일본어판 FAQ 삭제');
      ok('jf-status', '삭제했습니다.' + APPLIED);
      // 편집 중이던 질문의 번호 재조정은 loadFaq() → jfResyncEditor()가 한다.
      // (앞쪽 질문을 지우면 뒤쪽 번호가 한 칸 당겨지므로 여기서 조건 없이 맡긴다)
      loadFaq();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jf-status', e.message);
    }
  }

  $('jf-refresh').addEventListener('click', loadFaq);

  // ══ 5. 본문 페이지 ════════════════════════════════════
  const PAGE_LABEL: Record<string, string> = {
    guide: 'はじめての医療AI (의료 AI 입문)',
    checklist: '導入チェックリスト (도입 체크리스트)',
    tips: '現場ノウハウ (현장 노하우)',
    videosMeta: 'おすすめ動画 (추천 영상) 제목·안내문',
  };

  // 이 페이지들은 meta 항목만 있고 '항목(섹션) 목록'이 없다.
  // videos-meta.json은 {title, description, pageTitle, lead, notice} 가 최상위에
  // 그대로 있는 납작한 구조라, 다른 페이지처럼 data.meta 안을 보면 안 된다.
  const JP_META_ONLY = new Set(['videosMeta']);
  const jpIsMetaOnly = () => JP_META_ONLY.has(jpKey);

  let jpKey = '';
  let jpSha = '';
  let jpData: any = null;
  let jpEditIndex = -1; // -1 = 새 항목
  // 수정 중인 항목의 신원(소제목). 번호만 믿으면 순서 변경·삭제 뒤에
  // 엉뚱한 항목이 덮어써진다.
  let jpEditHeading = '';

  function jpPath(): string {
    return (P as any)[jpKey];
  }

  async function loadPage() {
    jpKey = $('jp-page').value;
    if (!jpKey) {
      $('jp-body').hidden = true;
      return;
    }
    const metaOnly = jpIsMetaOnly();
    $('jp-body').hidden = false;
    $('jp-editor').hidden = true;
    $('jp-sections-block').hidden = metaOnly;
    $('jp-meta-only-note').hidden = !metaOnly;
    jpEditIndex = -1;
    jpEditHeading = '';
    if (!metaOnly) $('jp-sections').textContent = '불러오는 중…';
    try {
      const { sha, data } = await loadJson(jpPath());
      if (!data || typeof data !== 'object' || Array.isArray(data)) {
        throw new Error(
          `${jpPath()} 의 형태가 예상과 다릅니다. 이 화면에서는 고칠 수 없으니 개발자에게 알려 주세요.`
        );
      }
      if (!metaOnly && !Array.isArray(data.sections)) {
        throw new Error(
          `${jpPath()} 의 형태가 예상과 다릅니다(meta·sections 구조가 아닙니다). 개발자에게 알려 주세요.`
        );
      }
      jpSha = sha;
      jpData = data;
      const m = metaOnly ? data : data.meta || {};
      $('jp-meta-title').value = m.title || '';
      $('jp-meta-pagetitle').value = m.pageTitle || '';
      $('jp-meta-description').value = m.description || '';
      $('jp-meta-lead').value = m.lead || '';
      if (!metaOnly) renderSections();
      ok('jp-status', '');
      ok('jp-meta-status', '');
    } catch (e: any) {
      if (metaOnly) bad('jp-meta-status', e.message);
      else $('jp-sections').textContent = e.message;
    }
  }

  /**
   * 목록을 다시 읽은 뒤, 편집창이 가리키는 번호를 그 항목의 새 위치로 맞춘다.
   * 그 항목이 사라졌으면 편집창을 닫고 한국어로 알린다.
   */
  function jpResyncEditor() {
    // jpEditIndex < 0 은 '새 항목 추가' 중이라 번호와 무관하다.
    if (jpEditIndex < 0) return;
    const i = jpData.sections.findIndex((s: any) => s.heading === jpEditHeading);
    if (i < 0) {
      $('jp-editor').hidden = true;
      jpEditIndex = -1;
      jpEditHeading = '';
      appendNote(
        'jp-status',
        `※ 수정 중이던 항목이 목록에서 사라져 편집창을 닫았습니다. ${REOPEN}`
      );
      return;
    }
    if (i !== jpEditIndex) {
      jpEditIndex = i;
      $('jp-editor-name').textContent = `✏️ 항목 수정 (#s${i + 1})`;
      appendNote('jp-status', '※ 수정 중이던 항목의 위치가 바뀌어 편집창을 그 항목에 다시 맞췄습니다.');
    }
  }

  function renderSections() {
    const el = $('jp-sections');
    const secs = jpData.sections;
    jpResyncEditor();
    el.innerHTML =
      secs
        .map(
          (s: any, i: number) => `
      <div class="post-row">
        <span class="post-title">${esc(s.heading)}</span>
        <span class="post-file">#s${i + 1} · 목록 ${Array.isArray(s.items) ? s.items.length : 0}개</span>
        <span class="post-actions">
          <button class="btn ghost tiny" data-jpmove="${i}" data-dir="-1" ${i === 0 ? 'disabled' : ''} title="위로">↑</button>
          <button class="btn ghost tiny" data-jpmove="${i}" data-dir="1" ${i === secs.length - 1 ? 'disabled' : ''} title="아래로">↓</button>
          <button class="btn ghost" data-jpedit="${i}">수정</button>
          <button class="btn ghost danger" data-jpdel="${i}">삭제</button>
        </span>
      </div>`
        )
        .join('') || '<p class="hint">항목이 하나도 없습니다.</p>';
    el.querySelectorAll('[data-jpmove]').forEach((b: any) =>
      b.addEventListener('click', () => jpMove(Number(b.dataset.jpmove), Number(b.dataset.dir)))
    );
    el.querySelectorAll('[data-jpedit]').forEach((b: any) =>
      b.addEventListener('click', () => jpOpen(Number(b.dataset.jpedit)))
    );
    el.querySelectorAll('[data-jpdel]').forEach((b: any) =>
      b.addEventListener('click', () => jpDelete(Number(b.dataset.jpdel)))
    );
  }

  function jpOpen(i: number) {
    jpEditIndex = i;
    const s = i < 0 ? { heading: '', body: '', items: [] } : jpData.sections[i];
    jpEditHeading = i < 0 ? '' : s.heading;
    $('jp-editor-name').textContent =
      i < 0 ? '➕ 새 항목 추가' : `✏️ 항목 수정 (#s${i + 1})`;
    $('jp-heading').value = s.heading || '';
    $('jp-body-text').value = s.body || '';
    $('jp-items').value = (s.items || []).join('\n');
    ok('jp-editor-status', '');
    $('jp-editor').hidden = false;
    $('jp-editor').scrollIntoView({ block: 'center' });
  }

  $('jp-add').addEventListener('click', () => jpOpen(-1));
  $('jp-editor-cancel').addEventListener('click', () => {
    $('jp-editor').hidden = true;
    jpEditIndex = -1;
    jpEditHeading = '';
  });

  lock('jp-editor-save', async () => {
    const heading = $('jp-heading').value.trim();
    const body = $('jp-body-text').value.trim();
    // ⚠️ items는 비어도 반드시 [] 로 넣는다. 키를 빼면 JaSections.astro의
    //    s.items.length 에서 빌드가 통째로 실패한다.
    const items = parseLines($('jp-items').value);

    const e1 = req(heading, '소제목(heading)');
    if (e1) {
      bad('jp-editor-status', e1);
      return;
    }
    // ⚠️ 수정일 때는 '지금 이 번호가 정말 그 항목인지' 먼저 대조한다.
    if (jpEditIndex >= 0) {
      const target = jpData.sections[jpEditIndex];
      if (!target || target.heading !== jpEditHeading) {
        bad(
          'jp-editor-status',
          `수정을 시작한 뒤 항목 목록이 바뀌었습니다. 엉뚱한 항목을 덮어쓰지 않도록 저장하지 않았습니다. '새로고침'을 누른 뒤 ${REOPEN}`
        );
        return;
      }
    }
    const textErr = checkTexts([
      [heading, '소제목(heading)'],
      [body, '설명글(body)'],
      ...items.map((it, n) => [it, `목록 ${n + 1}번째 줄`] as [string, string]),
    ]);
    if (textErr) {
      bad('jp-editor-status', textErr);
      return;
    }
    try {
      ok('jp-editor-status', '저장 중…');
      const section = { heading, body, items };
      const next = {
        ...jpData,
        sections:
          jpEditIndex < 0
            ? [...jpData.sections, section]
            : jpData.sections.map((s: any, i: number) => (i === jpEditIndex ? section : s)),
      };
      jpSha = await saveJson(
        jpPath(),
        next,
        jpSha,
        `수정: 일본어판 ${jpKey} 항목 ${jpEditIndex < 0 ? '추가' : '수정'} - ${heading}`
      );
      jpData = next;
      ok(
        'jp-editor-status',
        (jpEditIndex < 0 ? '맨 뒤에 항목을 추가했습니다.' : '항목을 저장했습니다.') + APPLIED
      );
      $('jp-editor').hidden = true;
      jpEditIndex = -1;
      jpEditHeading = '';
      renderSections();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jp-editor-status', e.message);
    }
  });

  async function jpMove(i: number, dir: number) {
    if (
      !confirm(
        `항목 순서를 바꾸면 항목별 주소(/ja/${jpKey}/#s1 등)가 달라집니다.\n다른 곳에 걸어 둔 링크가 다른 항목을 가리키게 될 수 있습니다.\n\n계속할까요?`
      )
    )
      return;
    try {
      const { sha, data } = await loadJson(jpPath());
      if (!data.sections[i] || data.sections[i].heading !== jpData.sections[i].heading) {
        throw new Error(
          "그 사이 항목 목록이 다른 곳에서 바뀌었습니다. 엉뚱한 항목을 옮기지 않도록 중단했습니다. '새로고침'을 누른 뒤 다시 해 주세요."
        );
      }
      if (!moveItem(data.sections, i, dir)) return;
      jpSha = await saveJson(jpPath(), data, sha, `수정: 일본어판 ${jpKey} 항목 순서 변경`);
      jpData = data;
      ok('jp-status', '순서를 바꿨습니다.' + APPLIED);
      renderSections();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jp-status', e.message);
    }
  }

  async function jpDelete(i: number) {
    const s = jpData.sections[i];
    if (jpData.sections.length <= 1) {
      bad('jp-status', '마지막 남은 항목은 지울 수 없습니다. 내용이 없는 페이지가 됩니다.');
      return;
    }
    if (
      !confirm(
        `항목을 지웁니다.\n\n${s.heading}\n(목록 ${(s.items || []).length}개도 함께 사라집니다)\n\n뒤에 있는 항목들의 주소(#s${i + 2} 이후)도 한 칸씩 앞당겨집니다.\n계속할까요?`
      )
    )
      return;
    if (prompt('확인을 위해 "삭제"라고 입력하세요') !== '삭제') return;
    try {
      ok('jp-status', '삭제 중…');
      const { sha, data } = await loadJson(jpPath());
      if (
        data.sections.length !== jpData.sections.length ||
        !data.sections[i] ||
        data.sections[i].heading !== s.heading
      ) {
        throw new Error(
          "그 사이 항목 목록이 바뀌었습니다. 엉뚱한 항목을 지우지 않도록 중단했습니다. '새로고침'을 눌러 다시 확인해 주세요."
        );
      }
      data.sections.splice(i, 1);
      jpSha = await saveJson(jpPath(), data, sha, `수정: 일본어판 ${jpKey} 항목 삭제 - ${s.heading}`);
      jpData = data;
      ok('jp-status', '삭제했습니다.' + APPLIED);
      // 편집창 처리(번호 재조정 또는 닫기)는 renderSections() → jpResyncEditor()가 한다.
      renderSections();
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jp-status', e.message);
    }
  }

  lock('jp-meta-save', async () => {
    const meta = {
      title: $('jp-meta-title').value.trim(),
      description: $('jp-meta-description').value.trim(),
      pageTitle: $('jp-meta-pagetitle').value.trim(),
      lead: $('jp-meta-lead').value.trim(),
    };
    for (const [v, label] of [
      [meta.title, '브라우저 제목(title)'],
      [meta.description, '검색결과 설명(description)'],
      [meta.pageTitle, '화면 큰 제목(pageTitle)'],
      [meta.lead, '첫머리 안내문(lead)'],
    ] as [string, string][]) {
      const e = req(v, label);
      if (e) {
        bad('jp-meta-status', e);
        return;
      }
    }
    if (/｜病院AI研究所|\|病院AI研究所/.test(meta.title)) {
      bad(
        'jp-meta-status',
        '브라우저 제목에 「｜病院AI研究所」를 넣지 마세요. 사이트가 자동으로 붙이기 때문에 두 번 나옵니다.'
      );
      return;
    }
    const textErr = checkTexts([
      [meta.title, '브라우저 제목(title)'],
      [meta.description, '검색결과 설명(description)'],
      [meta.pageTitle, '화면 큰 제목(pageTitle)'],
      [meta.lead, '첫머리 안내문(lead)'],
    ]);
    if (textErr) {
      bad('jp-meta-status', textErr);
      return;
    }
    try {
      ok('jp-meta-status', '저장 중…');
      // videos-meta.json은 meta 항목이 최상위에 납작하게 놓인 구조라
      // { ...jpData, meta } 로 감싸면 안 된다. 감싸면 일본어판 빌드가 깨진다.
      // (notice 같은 다른 항목은 ...jpData 로 그대로 보존한다)
      const next = jpIsMetaOnly() ? { ...jpData, ...meta } : { ...jpData, meta };
      jpSha = await saveJson(jpPath(), next, jpSha, `수정: 일본어판 ${jpKey} 제목·안내문`);
      jpData = next;
      ok('jp-meta-status', '저장했습니다.' + APPLIED);
      setTimeout(loadRuns, 4000);
    } catch (e: any) {
      bad('jp-meta-status', e.message);
    }
  });

  $('jp-page').addEventListener('change', loadPage);
  $('jp-refresh').addEventListener('click', loadPage);

  // ══ 6. 자동 수집·반영 상태 (읽기 전용) ════════════════
  async function loadSubsidies() {
    const el = $('js-subsidies');
    el.textContent = '불러오는 중…';
    try {
      const { data } = await loadJson(P.subsidies);
      const items = Array.isArray(data.items) ? data.items : [];
      const when = fmtJst(data.updatedAt);
      const ageMs = Date.now() - new Date(data.updatedAt).getTime();
      const stale = isNaN(ageMs) || ageMs > 36 * 60 * 60 * 1000;
      el.innerHTML = `
        <div class="post-row">
          <span class="post-title">마지막 수집: ${esc(when)} (일본 시간)</span>
          <span class="post-file">${items.length}건</span>
        </div>
        <p class="hint">${
          stale
            ? `⚠️ 하루 반 넘게 갱신되지 않았습니다. jGrants 쪽 점검이나 수집 오류일 수 있습니다. 아래 "🚀 사이트 반영 상태" 목록에서 「${esc(WF_JGRANTS_KO)}」 줄에 ❌ 표시가 있는지 확인해 보세요.`
            : '✅ 정상적으로 갱신되고 있습니다.'
        }</p>`;
    } catch (e: any) {
      el.textContent = e.message;
    }
  }

  // 저장소의 워크플로 이름은 전부 영어라 운영자가 읽을 수 없다.
  // .github/workflows/*.yml 의 name: 값 그대로를 열쇠로 쓴다.
  // ⚠️ 워크플로 이름을 바꾸면 여기도 함께 바꿔야 한다(못 찾으면 영어가 그대로 나온다).
  const WORKFLOW_KO: Record<string, string> = {
    'Deploy to GitHub Pages': '사이트 반영(배포)',
    'Update JA Subsidies': '일본 보조금 수집',
    'Update AI News': 'AI 뉴스 수집',
    'Update Gov Programs': '정부 지원사업 수집',
    'Update AI Events': 'AI 행사 수집',
    'Update Recommended Videos': '추천 영상 수집',
  };
  // 위 표에서 '일본 보조금 수집'에 해당하는 이름. 안내문에서 같은 말을 쓰기 위해
  // 한 곳에서만 정의한다(안내문과 목록에 다른 이름이 나오면 운영자가 찾지 못한다).
  const WF_JGRANTS_KO = WORKFLOW_KO['Update JA Subsidies'];

  function workflowKo(name: string): string {
    return WORKFLOW_KO[name] || name;
  }

  // GitHub이 돌려주는 실패 사유도 영어다.
  const CONCLUSION_KO: Record<string, string> = {
    success: '성공',
    failure: '실패',
    cancelled: '취소됨',
    timed_out: '시간 초과',
    startup_failure: '시작 실패',
    skipped: '건너뜀',
    neutral: '실행하지 않음',
    action_required: '사람의 조치 필요',
    stale: '너무 오래되어 취소됨',
  };

  function conclusionKo(c: string): string {
    return CONCLUSION_KO[c] || c || '알 수 없음';
  }

  let runsAutoRefreshLeft = 4;
  async function loadRuns() {
    const el = $('js-runs');
    try {
      const data = await gh('/actions/runs?per_page=8');
      const rows = data.workflow_runs.map((r: any) => {
        const state =
          r.status === 'completed'
            ? r.conclusion === 'success'
              ? '✅ 성공'
              : `❌ ${conclusionKo(r.conclusion)}`
            : '⏳ 진행 중';
        const t = new Date(r.created_at).toLocaleString('ko-KR', {
          timeZone: 'Asia/Seoul',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
        });
        return `<div class="run"><span>${state}</span><span>${esc(workflowKo(r.name))}</span><span>${t}</span><a href="${esc(r.html_url)}" target="_blank" rel="noopener">로그</a></div>`;
      });
      el.innerHTML = rows.join('') || '실행 기록이 없습니다.';
      const latest = data.workflow_runs[0];
      if (latest) {
        setAdminSummary(
          'deploy',
          '최근 반영 ' +
            (latest.status === 'completed'
              ? latest.conclusion === 'success'
                ? '성공'
                : '실패'
              : '진행 중')
        );
      }
      const hasPending = data.workflow_runs.some((r: any) => r.status !== 'completed');
      if (hasPending) {
        if (runsAutoRefreshLeft > 0) {
          runsAutoRefreshLeft--;
          setTimeout(loadRuns, 15000);
        }
      } else {
        runsAutoRefreshLeft = 4;
      }
    } catch (e: any) {
      el.textContent = e.message;
    }
  }

  $('js-refresh').addEventListener('click', () => {
    runsAutoRefreshLeft = 4;
    loadSubsidies();
    loadRuns();
  });

  // ══ 부팅 ══════════════════════════════════════════════
  // 위 Supabase 스크립트가 로그인·토큰 준비를 마치면 이벤트를 쏜다.
  async function loadAllPanels() {
    await loadKoVideos();
    loadVideos();
    loadNav();
    loadGlossary();
    loadFaq();
    loadSubsidies();
    loadRuns();
  }
  window.addEventListener('admin-ready', loadAllPanels);
  window.addEventListener('admin-github-token-ready', loadAllPanels);
</script>

