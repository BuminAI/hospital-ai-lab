---
// Modèles (2026-11-15) : charte d'usage de l'IA générative, 20 questions aux fournisseurs, texte pour les patients, fiche d'incident
// ⚠️ Tout ce qui suit est un BROUILLON de l'auteur, pas un avis juridique. Cité seulement d'après des documents lus en texte intégral (règlement sur l'IA, RGPD, RDM,
//    fiche CNIL « IA et santé », projet de guide HAS-CNIL — document de travail, toujours signalé comme projet).
import '../../styles/fr-guide.css';
import FrLayout from '../../layouts/FrLayout.astro';
import FrGuideFoot from '../../components/FrGuideFoot.astro';
import { SRC } from '../../data/fr/guides/milestones';
import { withBase } from '../../utils/site';

const CHECKED = '15 novembre 2026';
const title = 'Modèles : charte d’usage de l’IA générative et 20 questions aux fournisseurs';
const description =
  'Quatre brouillons à copier pour les hôpitaux français : une charte d’usage de l’IA générative, 20 questions aux fournisseurs, un texte pour les patients et une fiche d’incident avec les délais.';

const policy = [
  "CHARTE D'USAGE DE L'IA GÉNÉRATIVE, HÔPITAL « __ » (BROUILLON)",
  "",
  "1. Objet",
  "   Fixe les règles pour les agents de « __ » qui utilisent des outils d'IA générative (agents conversationnels, outils de synthèse, de traduction).",
