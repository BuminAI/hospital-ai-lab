const sources = [SRC.aiAct, SRC.rgpd, SRC.rdm, SRC.cnilSante, SRC.guideHasCnil];
---

<FrLayout title={title} description={description} crumb="Modèles" standalone updated={new Date('2026-11-15T00:00:00+01:00')}>
  <h1>Modèles : charte d’usage de l’IA générative et 20 questions aux fournisseurs</h1>
  <p class="tg-lead">
    « Nous ne savons pas par où commencer à rédiger » : c’est un problème courant dans les hôpitaux. Voici quatre brouillons : cliquez, copiez et remplacez « __ » par vos informations.
  </p>
  <p class="tg-meta">Vérifié le {CHECKED} · Pour : direction et DSI des hôpitaux</p>

  <div class="tg-box tg-warn">
    <strong>Avant de les utiliser</strong><br />
    Ce sont des <strong>brouillons</strong> de l’auteur, pas un avis juridique ni une version prête à copier telle quelle. Adaptez-les à la taille, aux systèmes et aux contrats de votre hôpital, et montrez-les à un juriste ou à votre service de conformité avant d’en faire des documents.
  </div>

  <section class="tg-sec" aria-labelledby="h-toc">
    <h2 id="h-toc">Sommaire</h2>
    <ul class="tg-list">
      {items.map((it) => <li><a href={`#${it.id}`}>{it.head}</a></li>)}
    </ul>
    <p>
      Pages liées : <a href={withBase('/fr/dx-roadmap/')}>Feuille de route</a>, <a href={withBase('/fr/data-checklist/')}>Liste « données des patients »</a>, <a href={withBase('/fr/documents-checklist/')}>Liste « fournisseurs et documents »</a>.
    </p>
  </section>

  {
    items.map((it) => (
      <section class="tg-sec" id={it.id} aria-labelledby={`${it.id}-h`}>
        <h2 id={`${it.id}-h`}>{it.head}</h2>
        <p>{it.lead}</p>
        <div class="tg-copy">
          <button type="button" class="tg-btn" data-target={`${it.id}-text`}>
            Copier
          </button>
          <pre id={`${it.id}-text`}>{it.text}</pre>
        </div>
        <h3>Base du modèle</h3>
        <ul class="tg-list">
          {it.basis.map((b) => <li>{b}</li>)}
        </ul>
      </section>
    ))
  }

  <FrGuideFoot sources={sources} checked={CHECKED} />
</FrLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.tg-btn[data-target]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = document.getElementById(btn.dataset.target ?? '');
      if (!el) return;
      const label = btn.textContent;
      try {
        await navigator.clipboard.writeText(el.textContent ?? '');
        btn.textContent = 'Copié';
      } catch {
        const r = document.createRange();
        r.selectNodeContents(el);
        const s = window.getSelection();
        s?.removeAllRanges();
        s?.addRange(r);
        btn.textContent = 'Sélectionné (Ctrl+C)';
      }
      setTimeout(() => (btn.textContent = label), 2500);
    });
  });
</script>
