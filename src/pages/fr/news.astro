---
// Actualités IA — liste collectée automatiquement auprès des médias français (see scripts/wide-sources.mjs; same pattern as ko news.astro).
// hreflang을 걸지 않는다 — 자동 수집 목록은 언어판마다 완전히 다른 기사
// 목록이라, 번역 관계가 아닌 페이지에 alternate를 걸면 검색엔진에 잘못된
// 신호가 된다(ko news.astro도 jaPath가 없다 — 같은 원칙).
import FrLayout from '../../layouts/FrLayout.astro';
import en from '../../i18n/fr.json';
import { withBase } from '../../utils/site';
import news from '../../data/fr/news.json';

const fmt = new Intl.DateTimeFormat('fr-FR', {
  timeZone: 'Europe/Paris',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const items = news.items;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/fr/news/')}`;
const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: en.nav.news,
  description:
    'Titres sur l’intelligence artificielle dans la santé issus de Le Monde, Le Figaro, franceinfo, 20 Minutes, Ouest-France, Sud Ouest, Numerama, Les Numériques, ZDNet France, Le Quotidien du Médecin, Le Quotidien du Pharmacien, Infirmiers.com, DSIH et d’autres médias français, collectés automatiquement.',
  inLanguage: 'fr-FR',
  isPartOf: { '@id': `${siteUrl}/#website-fr` },
  dateModified: news.updatedAt ?? new Date().toISOString(),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<FrLayout
  title="Actualités de l’IA dans la santé en France"
  description="Titres sur l’IA dans la santé en France issus de Le Monde, Le Figaro, franceinfo, 20 Minutes, Ouest-France, Sud Ouest, Numerama, Les Numériques, ZDNet France, Le Quotidien du Médecin, Le Quotidien du Pharmacien, Infirmiers.com, DSIH et d’autres médias français, collectés automatiquement plusieurs fois par jour."
  crumb={en.nav.news}
  koPath="/news/"
  standalone
  updated={new Date(news.updatedAt ?? Date.now())}
  schema={[collectionPage]}
>
  <h1>{en.nav.news}</h1>
  <p class="en-lead">
    Les titres qui mentionnent l’intelligence artificielle et la santé sont collectés plusieurs fois par jour auprès de Le Monde, Le Figaro, franceinfo, 20 Minutes, Ouest-France, Sud Ouest, Numerama, Les Numériques, ZDNet France, Le Quotidien du Médecin, Le Quotidien du Pharmacien, Infirmiers.com, DSIH et d’autres médias français. Beaucoup sont trouvés par des recherches Google Actualités limitées à ces médias, et chaque lien ouvre l’article du média lui-même. Seuls les titres publiés au cours du dernier mois sont conservés ; les plus anciens sont supprimés.
  </p>

  {
    items.length > 0 ? (
      <ul class="en-news-list">
        {items.map((item) => (
          <li>
            <a href={item.link} target="_blank" rel="noopener">
              {item.title}
              <span class="sr-only"> ({en.ui.external})</span>
            </a>
            <span class="en-news-meta">
              {item.source} · <time datetime={item.pubDate}>{fmt.format(new Date(item.pubDate))}</time>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="en-empty">{en.ui.noItems}</p>
    )
  }

  <div class="en-note">
    <p>
      Cette liste est construite automatiquement à partir d’articles des médias nommés ci-dessus qui mentionnent l’intelligence artificielle et la santé. Ce n’est pas une sélection éditoriale : le site
      ne choisit ni ne recommande d’articles en particulier. Un titre mène à l’article d’origine sur le
      site de l’éditeur. Nous ne copions que le titre, la date et le lien.
    </p>
  </div>
</FrLayout>

<style>
  .en-lead {
    color: var(--fr-text-sub);
  }
  .en-news-list {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--fr-border);
  }
  .en-news-list li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid var(--fr-border);
  }
  .en-news-list a {
    color: var(--fr-text);
    font-weight: 600;
    line-height: 1.6;
  }
  .en-news-list a:hover {
    color: var(--fr-primary);
  }
  .en-news-meta {
    font-size: 13px;
    color: var(--fr-text-sub);
  }
  .en-empty {
    margin-top: 20px;
    color: var(--fr-text-sub);
  }
</style>
