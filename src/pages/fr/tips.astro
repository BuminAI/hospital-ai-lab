---
import FrLayout from '../../layouts/FrLayout.astro';
import FrSections from '../../components/FrSections.astro';
import { tipsEn } from '../../data/fr/pages';
import en from '../../i18n/fr.json';

const p = tipsEn;

const schema = [
  {
    '@type': 'ItemList',
    name: p.meta.pageTitle,
    numberOfItems: p.sections.length,
    itemListElement: p.sections.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.heading,
    })),
  },
];
---

<FrLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={en.nav.tips}
  koPath="/tips/"
  idPath="/id/tips/"
  ruPath="/ru/tips/"
  twPath="/tw/tips/"
  enPath="/en/tips/"
  inPath="/in/tips/" phPath="/ph/tips/" sgPath="/sg/tips/" aePath="/ae/tips/" iePath="/ie/tips/"
  jaPath="/ja/tips/"
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="en-lead">{p.meta.lead}</p>

  {/* 원내 규정 확인을 도구 소개보다 먼저 안내 */}
  <p class="en-caution">
Avant d’utiliser pour le travail l’un des outils listés ici, vérifiez que la politique de sécurité de l’information de votre hôpital l’autorise. Ne saisissez pas de données de patients ou de personnel dans des services extérieurs : c’est la règle générale pour tout outil.
  </p>

  <FrSections sections={p.sections} />
</FrLayout>

<style>
  .en-lead {
    color: var(--fr-text-sub);
  }
  .en-caution {
    border: 1px solid var(--fr-border);
    border-left: 4px solid var(--fr-accent);
    background: var(--fr-surface);
    padding: 12px 14px;
    font-size: 13.5px;
    line-height: 1.85;
    margin-bottom: 26px;
  }
</style>
