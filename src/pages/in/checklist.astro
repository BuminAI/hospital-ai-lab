---
import InLayout from '../../layouts/InLayout.astro';
import InteractiveChecklist from '../../components/InteractiveChecklist.astro';
import SubscribeCta from '../../components/SubscribeCta.astro';
import { getCollection } from 'astro:content';
import { checklistRelated } from '../../data/checklist-related';
import { COLLECTION, postHref } from '../../utils/locale';
import { checklistEn } from '../../data/in/pages';
import en from '../../i18n/in.json';
import { withBase } from '../../utils/site';

const p = checklistEn;

// 점검표를 체크해 가며 쓰는 형태로 그린다(2026-09-20). 체크 상태는 이 기기의 브라우저에만 저장된다.
const sections = p.sections.map((s, i) => ({
  title: s.heading,
  body: s.body,
  items: s.items,
  plain: false,
}));
const posts = await getCollection(COLLECTION.in, ({ data }) => !data.draft);
const titleOf = new Map(posts.map((x) => [x.id, x.data.title]));
const relatedByTitle: Record<string, { href: string; title: string }[]> = {};
for (const [idx, ids] of Object.entries(checklistRelated.in)) {
  const sec = sections[Number(idx)];
  if (!sec) throw new Error('[checklist:in] 관련 글의 섹션 번호 ' + idx + '가 없습니다.');
  relatedByTitle[sec.title] = ids.map((id) => {
    const title = titleOf.get(id);
    if (!title) throw new Error('[checklist:in] 관련 글 ID ' + id + '가 없습니다.');
    return { href: postHref('in', id), title };
  });
}

// 화면에 보이는 소제목·순서 그대로 ItemList로 알린다(보이지 않는 정보는 넣지 않는다).
const schema = [
  {
    '@type': 'ItemList',
    name: p.meta.pageTitle,
    numberOfItems: p.sections.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: p.sections.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.heading,
    })),
  },
];
---

<InLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={en.nav.checklist}
  koPath="/checklist/"
  idPath="/id/checklist/"
  ruPath="/ru/checklist/"
  twPath="/tw/checklist/"
  enPath="/en/checklist/"
  sgPath="/sg/checklist/" phPath="/ph/checklist/"
  jaPath="/ja/checklist/"
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="en-lead">{p.meta.lead}</p>

  <InteractiveChecklist id="ai-adoption-in" loc="in" sections={sections} related={relatedByTitle} />

  <SubscribeCta loc="in" />

  <section class="en-next">
<h2>See also</h2>
    <ul>
      <li>
        <a href={withBase('/in/glossary/')}>{en.nav.glossary}</a> —
explanations of the terms used in this checklist.
      </li>
      <li>
        <a href={withBase('/in/faq/')}>{en.nav.faq}</a> —
answers to common questions about adopting AI.
      </li>
      <li>
        <a href={withBase('/in/guide/')}>{en.nav.guide}</a> —
where to start if this topic is new to you.
      </li>
    </ul>
  </section>
</InLayout>

<style>
  .en-lead {
    color: var(--in-text-sub);
  }
  .en-next {
    margin-top: 36px;
    border-top: 1px solid var(--in-border);
    padding-top: 20px;
  }
  .en-next h2 {
    font-size: 15px;
    color: var(--in-text-sub);
    margin-bottom: 10px;
    border: 0;
    padding: 0;
    background: none;
  }
  .en-next ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .en-next li {
    font-size: 14px;
    line-height: 1.85;
  }
</style>
