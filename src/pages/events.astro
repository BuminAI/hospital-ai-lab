---
import { withBase } from '../utils/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import events from '../data/events.json';

const fmtFull = new Intl.DateTimeFormat('ko-KR', {
  timeZone: 'Asia/Seoul',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
const fmtDay = new Intl.DateTimeFormat('ko-KR', {
  timeZone: 'Asia/Seoul',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedAt = fmtFull.format(new Date(events.updatedAt));
const items = events.items;
const sources = [...new Set(items.map((i) => i.source))];

// CollectionPage + ItemList 구조화 데이터.
// 이 페이지는 자동 수집 목록이라 본문 글이 아니다. AI 답변 엔진과 검색엔진에
// '무엇을 모은 목록이고 지금 몇 건인지'를 명시해 준다. 개별 항목은 외부 원문
// 링크라 url만 싣고 본문은 옮기지 않는다(저작권).
const siteUrl = Astro.site
  ? Astro.site.href.replace(/\/$/, '')
  : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/events/')}`;
const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: 'AI 교육·행사',
  description: '병원·의료 분야의 AI·디지털 관련 교육, 세미나, 컨퍼런스, 학술대회 소식 목록.',
  inLanguage: 'ko-KR',
  isPartOf: { '@id': `${siteUrl}/#website` },
  dateModified: events.updatedAt,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<BaseLayout
  title="AI 교육·행사"
  description="병원·의료 분야의 AI·디지털 관련 교육, 세미나, 컨퍼런스, 학술대회 소식을 매일 자동으로 모아 원문 링크로 안내합니다."
  schema={[collectionPage]}
>
  <div class="container">
    <header class="page-head">
      <h1>AI 교육·행사</h1>
      <p class="lead">
        병원·의료 분야의 AI·디지털 관련 교육, 세미나, 컨퍼런스, 학술대회 소식을
        매일 자동으로 모읍니다. 제목을 누르면 원문 기사·공고로 이동합니다.
      </p>
    </header>

    <p class="updated">
      마지막 업데이트: <time datetime={events.updatedAt}>{updatedAt}</time>
      {sources.length > 0 && <> · 수집처: {sources.join(' · ')}</>}
    </p>

    <p class="caution">
      행사에는 <strong>신청 기간과 정원이 있습니다.</strong> 아래 날짜는 소식이
      실린 날이며 행사 날짜가 아닙니다. 일정·장소·참가 방법은 반드시 원문에서
      확인하세요.
    </p>

    {
      items.length > 0 ? (
        <ul class="event-list">
          {items.map((item) => (
            <li>
              <a href={item.link} target="_blank" rel="noopener">
                {item.title}
                <span class="sr-only"> (새 탭으로 열림)</span>
              </a>
              <span class="meta">
                <span class="src">{item.source}</span>
                <time datetime={item.pubDate}>{fmtDay.format(new Date(item.pubDate))}</time>
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">아직 수집된 교육·행사 소식이 없습니다.</p>
      )
    }

    <section class="notice">
      <p>
        이 목록은 메디칼타임즈·병원신문·대한병원협회·한국보건산업진흥원에서
        자동으로 수집한 것으로, 연구소의 편집·추천 의견이 아닙니다. 제목에
        교육·세미나·컨퍼런스 같은 행사 표현과 AI·디지털 관련 표현이 함께 있는
        것만 골라 담습니다.
      </p>
      <p>
        <strong>새 소식이 자주 올라오지는 않습니다.</strong> 병원·의료 분야의
        AI 행사 자체가 아직 많지 않아 대략 주 1건 안팎으로 쌓입니다. 자동
        분류이므로 관련 없는 소식이 섞이거나 필요한 행사가 빠질 수 있습니다 —
        중요한 행사는 주최 기관에서 직접 확인하시기 바랍니다.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .updated {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .caution {
    margin-top: 1.25rem;
    max-width: 52rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-sm, 6px);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .event-list {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 52rem;
  }

  .event-list li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .event-list li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .event-list a {
    color: var(--color-text);
    font-weight: 600;
    line-height: 1.5;
  }

  .event-list a:hover {
    color: var(--color-primary);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .meta .src {
    font-weight: 600;
    color: var(--badge-event-fg);
    background: var(--badge-event-bg);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }

  .empty {
    margin-top: 1.75rem;
    color: var(--color-muted);
  }

  .notice {
    margin-top: 2.5rem;
    max-width: 52rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .notice p + p {
    margin-top: 0.6rem;
  }
</style>
