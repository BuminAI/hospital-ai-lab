---
import { execSync } from 'node:child_process';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { withBase, formatDate } from '../../utils/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 함께 읽으면 좋은 글 — 같은 분류 우선, 모자라면 최신순으로 채운다.
//
// 왜 넣었나: 글 하단이 '블로그 목록으로' 링크 하나뿐이라 글끼리 이어지는 문맥
// 링크가 거의 없었다. 실측(2026-07-27) 결과 16편 중 9편이 다른 글로부터 받는
// 문맥 인바운드 링크가 0건이었다. 검색엔진이 사이트 구조를 이해하고 방문자가
// 다음 글로 넘어가는 데 둘 다 필요하다. 콘텐츠 창작 없이 기존 데이터만 쓴다.
const RELATED_COUNT = 3;
const others = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const sameCategory = others.filter((p) => p.data.category === post.data.category);
const related = [
  ...sameCategory,
  ...others.filter((p) => p.data.category !== post.data.category),
].slice(0, RELATED_COUNT);

const canonicalUrl = Astro.site
  ? new URL(withBase(`/blog/${post.id}/`), Astro.site).href
  : withBase(`/blog/${post.id}/`);
// 대표 이미지는 이 글 전용 OG 이미지(src/pages/og/[...route].ts가 빌드 때 생성).
// 소셜 태그(BaseLayout)와 JSON-LD가 **같은 이미지**를 가리켜야 하므로 여기서 한 번만 만든다.
const ogImagePath = `/og/${post.id}.png`;
const ogImageUrl = Astro.site
  ? new URL(withBase(ogImagePath), Astro.site).href
  : withBase(ogImagePath);
const siteUrl = Astro.site
  ? Astro.site.href.replace(/\/$/, '')
  : 'https://hospital-ai-lab.com';

// 수정일(dateModified) — 이 글 파일의 마지막 git 커밋 시각(2026-08-12 추가).
// 발행 후 오탈자·수치 정정 등으로 글을 고치면 검색·AI 엔진에 "최신 정보"라는
// 신호를 준다(SEO 순위·AEO 최신성 판단 둘 다에 쓰인다). git 정보를 못 구하는
// 예외적 빌드 환경에서는 발행일로 폴백한다(홈 화면의 마지막 커밋일 계산과
// 같은 방식, index.astro 참고).
let dateModifiedIso = post.data.pubDate.toISOString();
try {
  const gitDate = execSync(
    `git log -1 --format=%cI -- "src/content/blog/${post.id}.md"`
  )
    .toString()
    .trim();
  if (gitDate) dateModifiedIso = gitDate;
} catch {
  // 폴백: 위에서 이미 발행일로 초기화해 두었다.
}

// BlogPosting 구조화 데이터.
// 2026-07-27 변경: author를 Organization에서 **저자 Person 엔티티 참조**로 바꿨다.
// 검색엔진·AI가 "누가 쓴 글인가"로 신뢰도를 판정하기 때문이다(오너 지시, SEO/GEO 작업).
// Person·Organization·WebSite 본문은 SchemaOrg 컴포넌트가 전 페이지에 넣으므로
// 여기서는 `@id`로 참조만 하고, 이 노드는 BaseLayout의 schema prop으로 넘겨
// 같은 @graph에 합쳐진다(script 태그를 따로 만들지 않는다).
const blogPosting = {
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  url: canonicalUrl,
  inLanguage: 'ko-KR',
  datePublished: post.data.pubDate.toISOString(),
  dateModified: dateModifiedIso,
  articleSection: post.data.category,
  image: ogImageUrl,
  author: { '@id': `${siteUrl}/#person` },
  publisher: { '@id': `${siteUrl}/#organization` },
  isPartOf: { '@id': `${siteUrl}/#website` },
  // 레이아웃이 같은 URL에 대해 `<canonical>#webpage` WebPage 노드를 이미 내보낸다.
  // 여기서 canonicalUrl(끝에 #webpage 없음)을 쓰면 같은 페이지를 가리키는
  // WebPage 노드가 그래프에 둘 생겨 검색엔진이 별개 개체로 읽는다.
  // 그 노드를 그대로 참조해 하나로 묶는다(2026-09-06 정리, 네 언어판 공통).
  mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  pubDate={post.data.pubDate}
  category={post.data.category}
  ogImage={ogImagePath}
  schema={[blogPosting]}
>
  <div class="container">
    <article>
      <header class="post-head">
        <div class="meta">
          <span class="chip">{post.data.category}</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {/* 저자 표시 — BlogPosting JSON-LD가 author를 선언하므로 화면에도
              같은 사실이 보여야 한다(구글은 비가시 콘텐츠 마크업을 금지한다). */}
          <span class="byline">
            <a href={withBase('/about/')} rel="author">조영호</a> · 병원 AI 연구소 소장
          </span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="description">{post.data.description}</p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer class="post-foot">
        <a href={withBase('/blog/')}>← 블로그 목록으로</a>
      </footer>
    </article>

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-heading">
          <h2 id="related-heading">함께 읽으면 좋은 글</h2>
          <div class="related-grid">
            {related.map((p) => (
              <PostCard post={p} headingLevel="h3" />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .byline {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* 함께 읽으면 좋은 글 */
  .related {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .related h2 {
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .related-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .post-head {
    padding-block: 3.5rem 2.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2.5rem;
    max-width: var(--prose-width);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .post-head h1 {
    margin-top: 1.25rem;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
  }

  .description {
    margin-top: 1rem;
    color: var(--color-muted);
  }

  .post-foot {
    max-width: var(--prose-width);
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .post-foot a {
    font-weight: 600;
  }
</style>
