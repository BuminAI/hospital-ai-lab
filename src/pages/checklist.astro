---
import { withBase } from '../utils/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideRelated from '../components/GuideRelated.astro';
import InteractiveChecklist from '../components/InteractiveChecklist.astro';
import SubscribeCta from '../components/SubscribeCta.astro';
import { getCollection } from 'astro:content';
import { checklistIntro, checklistSections } from '../data/checklist';
import { practicalChecklists } from '../data/checklists';

const [introLead, introNotice] = checklistIntro.split('\n\n');

// 섹션별 '함께 읽을 글' (2026-09-20). 점검 항목의 배경을 설명한 기존 글로 이어 준다.
// 새 글을 쓰지 않고 이미 발행된 글만 연결한다. 없는 글 ID는 빌드를 멈춘다.
const RELATED_IDS: Record<string, string[]> = {
  '성능·검증': [
    '2026-08-09-reading-ai-performance-numbers',
    '2026-07-09-sepsis-ai-external-validation',
    '2026-09-10-five-phase-evaluation-framework-medical-ai',
  ],
  '규제·인증': [
    '2026-07-07-digital-medical-products-act',
    '2026-07-19-ai-approval-vs-reimbursement',
    '2026-08-27-ai-medical-device-change-management-plan',
  ],
  '개인정보·보안': [
    '2026-07-08-sharing-data-with-ai-vendors',
    '2026-08-21-pseudonymized-data-processing-suspension',
    '2026-09-13-privacy-act-amendment-september-2026',
  ],
  '업무흐름·운영': [
    '2026-07-23-automation-bias-overtrust',
    '2026-07-09-alarm-fatigue-ai-alerts',
    '2026-07-25-ai-performance-drift-after-deployment',
  ],
  '계약·비용': ['2026-08-20-ai-compare-vendor-proposals', '2026-07-19-ai-approval-vs-reimbursement'],
};
const posts = await getCollection('blog', ({ data }) => !data.draft);
const titleOf = new Map(posts.map((p) => [p.id, p.data.title]));
const related: Record<string, { href: string; title: string }[]> = {};
for (const [section, ids] of Object.entries(RELATED_IDS)) {
  related[section] = ids.map((id) => {
    const title = titleOf.get(id);
    if (!title) throw new Error(`[checklist] '${section}'의 관련 글 ID '${id}'가 없습니다.`);
    return { href: withBase(`/blog/${id}/`), title };
  });
}

// ItemList 구조화 데이터.
// HowTo를 쓰지 않는 이유: 이건 순서대로 따라 하는 '방법'이 아니라 검토할 항목의
// 모음이다. 게다가 구글은 2023년부터 HowTo 리치 결과를 사실상 내리지 않는다.
// ItemList는 AI 답변 엔진이 '체크리스트 항목 N개'를 그대로 인용하기 좋은 형태다.
const siteUrl = Astro.site
  ? Astro.site.href.replace(/\/$/, '')
  : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/checklist/')}`;
const allChecklistItems = checklistSections.flatMap((sec) =>
  sec.items.map((it) => ({ section: sec.title, text: it }))
);
const itemList = {
  '@type': 'ItemList',
  '@id': `${pageUrl}#checklist`,
  url: pageUrl,
  name: 'AI 도입 검토 체크리스트',
  description:
    '병원이 AI 의료기기·솔루션 도입 제안을 받았을 때 행정·간호 부서가 확인할 항목을 주제별로 정리한 점검 목록.',
  inLanguage: 'ko-KR',
  numberOfItems: allChecklistItems.length,
  isPartOf: { '@id': `${siteUrl}/#website` },
  itemListElement: allChecklistItems.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `[${it.section}] ${it.text}`,
  })),
};
---

<BaseLayout
  alternates={{ ja: '/ja/checklist/', ru: '/ru/checklist/', tw: '/tw/checklist/', id: '/id/checklist/' }}
  title="AI 도입 검토 체크리스트"
  description="병원 AI 의료기기·솔루션 도입 제안을 검토할 때 행정·간호 부서가 확인할 항목을 주제별로 정리한 일반 가이드입니다."
  schema={[itemList]}
>
  <div class="container">
    <header class="page-head">
      <h1>AI 도입 검토 체크리스트</h1>
      <p class="lead">{introLead}</p>
      {introNotice && <p class="notice">{introNotice}</p>}
    </header>

    <div class="ick-wrap">
      <InteractiveChecklist id="ai-adoption" sections={checklistSections} related={related} />
    </div>

    <section class="more">
      <h2>더 쓰기 좋은 실무 점검표</h2>
      <ul class="more-list">
        {
          practicalChecklists.map((c) => (
            <li>
              <a href={withBase(`/checklist/${c.slug}/`)}>{c.title}</a>
              <span>{c.description}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <SubscribeCta />

    <GuideRelated current="checklist" />
  </div>
</BaseLayout>

<style>
  .notice {
    margin-top: 1rem;
    max-width: var(--prose-width);
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  .ick-wrap {
    max-width: var(--prose-width);
  }

  .more {
    margin-top: 3rem;
    max-width: var(--prose-width);
  }

  .more h2 {
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
  }

  .more-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .more-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-border);
  }

  .more-list li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .more-list a {
    font-weight: 600;
  }

  .more-list span {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.65;
  }
</style>
