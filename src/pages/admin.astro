---
import {
  SUPABASE_URL,
  SUPABASE_ANON_KEY,
  ADMIN_EMAIL,
  CSP,
  withBase,
} from '../utils/site';

// 언어판 목록 — 언어판을 새로 만들면 여기에 한 줄 추가하면 사이드바와 카드에 함께 나온다.
const editions = [
  { code: 'ko', flag: 'KO', name: '한국어판', native: '한국어', admin: '/admin-ko/', site: '/', note: '글·AI 뉴스·추천 영상·강의노트·회원·방문자 통계 등 전체 기능' },
  { code: 'ja', flag: 'JA', name: '일본어판', native: '日本語', admin: '/admin-ja/', site: '/ja/', note: '일본어 글·뉴스·용어집·FAQ·보조금' },
  { code: 'ru', flag: 'RU', name: '러시아어판', native: 'Русский', admin: '/admin-ru/', site: '/ru/', note: '러시아어 글·뉴스·AI 다이제스트·용어집' },
  { code: 'id', flag: 'ID', name: '인도네시아어판', native: 'Indonesia', admin: '/admin-id/', site: '/id/', note: '인도네시아어 글·뉴스·AI 다이제스트' },
  { code: 'tw', flag: 'TW', name: '대만어판', native: '繁體中文', admin: '/admin-tw/', site: '/tw/', note: '정체자 글·뉴스·용어집' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>관리자 대시보드 · 병원 AI 연구소</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  </head>
  <body>
    <div id="gate" class="gate" hidden>
      <form class="gate-box" id="gate-form">
        <h1>관리자 로그인</h1>
        <p class="muted">관리자 계정({ADMIN_EMAIL})으로 로그인하세요. 모든 언어판 관리자 화면이 같은 로그인을 씁니다.</p>
        <label>이메일<input type="email" id="gate-email" autocomplete="username" value={ADMIN_EMAIL} /></label>
        <label>비밀번호<input type="password" id="gate-password" autocomplete="current-password" /></label>
        <button type="submit" class="btn" id="gate-login-btn">로그인</button>
        <p class="muted" id="gate-status" aria-live="polite"></p>
      </form>
    </div>

    <div id="shell" class="shell" hidden>
      <aside class="side" aria-label="관리 메뉴">
        <a class="brand" href={withBase('/admin/')}>병원 AI 연구소 <small>관리자</small></a>
        <nav>
          <a class="item active" href={withBase('/admin/')}><i>🏠</i>대시보드</a>
          <div class="group">언어판 관리</div>
          {editions.map((e) => (
            <a class="item" href={withBase(e.admin)}><i>{e.flag}</i>{e.name}</a>
          ))}
          <div class="group">바로가기</div>
          <a class="item" href={withBase('/admin-ko/#judge-panel')}><i>🧪</i>AI 심사 제출<span class="badge" id="side-judge" hidden></span></a>
          <a class="item" href={withBase('/admin-ko/#member-panel')}><i>👥</i>회원<span class="badge" id="side-members" hidden></span></a>
          <a class="item" href={withBase('/admin-ko/#deploy-panel')}><i>🚀</i>사이트 반영 상태</a>
          <a class="item" href={withBase('/admin-ko/#stats-panel')}><i>📊</i>방문자 통계</a>
          <a class="item" href={withBase('/admin-ko/#token-panel')}><i>🔑</i>GitHub 연동</a>
          <a class="item" href={withBase('/')} target="_blank" rel="noopener"><i>🌐</i>사이트 보기</a>
        </nav>
        <button type="button" class="item logout" id="logout"><i>⎋</i>로그아웃</button>
      </aside>

      <main class="main">
        <div class="notice" id="notice" hidden></div>
        <h1>관리자 대시보드</h1>
        <p class="muted lead">
          언어판을 고르면 그 언어에 맞는 관리자 화면으로 들어갑니다. 저장한 내용은 1~2분 안에 사이트에 반영됩니다.
        </p>

        <section class="stats" aria-label="요약">
          <div class="stat"><span class="k">회원</span><span class="v" id="st-members">–</span></div>
          <div class="stat"><span class="k">AI 심사 제출</span><span class="v" id="st-judge">–</span><span class="sub" id="st-judge-sub"></span></div>
          <div class="stat"><span class="k">언어판</span><span class="v">{editions.length}</span><span class="sub">한국어 · 일본어 · 러시아어 · 인도네시아어 · 대만어</span></div>
        </section>

        <h2>언어판</h2>
        <section class="cards">
          {editions.map((e) => (
            <article class="card">
              <div class="card-head"><span class="flag">{e.flag}</span><div><h3>{e.name}</h3><span class="muted">{e.native} · <code>{e.site}</code></span></div></div>
              <p class="muted">{e.note}</p>
              <div class="card-actions">
                <a class="btn" href={withBase(e.admin)}>관리자 열기</a>
                <a class="btn ghost" href={withBase(e.site)} target="_blank" rel="noopener">사이트 보기</a>
              </div>
            </article>
          ))}
        </section>

        <h2>공통 도구</h2>
        <section class="cards">
          <article class="card">
            <div class="card-head"><span class="flag">🧪</span><div><h3>AI 프로그램 심사 제출</h3><span class="muted">모든 언어판의 심사실 제출 모음</span></div></div>
            <p class="muted">방문자가 동의하고 올린 파일을 내려받습니다. 보관은 제출일로부터 1개월입니다.</p>
            <div class="card-actions"><a class="btn" href={withBase('/admin-ko/#judge-panel')}>열기</a></div>
          </article>
          <article class="card">
            <div class="card-head"><span class="flag">🔑</span><div><h3>GitHub 연동</h3><span class="muted">글 저장·사이트 반영에 쓰는 토큰</span></div></div>
            <p class="muted">한 번 저장하면 모든 언어판 관리자에서 그대로 쓰입니다.</p>
            <div class="card-actions"><a class="btn" href={withBase('/admin-ko/#token-panel')}>열기</a></div>
          </article>
        </section>
      </main>
    </div>
  </body>
</html>

<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, ADMIN_EMAIL }}>
  (async () => {
    const $ = (id) => document.getElementById(id);
    if (!SUPABASE_URL) { $('gate').hidden = false; $('gate-status').textContent = '회원 기능이 아직 연결되지 않았습니다.'; return; }
    const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.0/+esm');
    const sb = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    async function count(table) {
      const { count: n, error } = await sb.from(table).select('*', { count: 'exact', head: true });
      return error ? null : n;
    }

    async function render() {
      const { data: { session } } = await sb.auth.getSession();
      const ok = !!session && session.user.email === ADMIN_EMAIL;
      $('gate').hidden = ok;
      $('shell').hidden = !ok;
      if (!ok) return;
      const [members, judge] = await Promise.all([count('profiles'), count('ai_judge_submissions')]);
      if (members != null) {
        $('st-members').textContent = members + '명';
        $('side-members').textContent = members; $('side-members').hidden = false;
      }
      if (judge == null) {
        $('st-judge').textContent = '–';
        $('st-judge-sub').textContent = '아직 준비 전입니다(supabase/setup.sql 실행 필요)';
      } else {
        $('st-judge').textContent = judge + '건';
        if (judge) { $('side-judge').textContent = judge; $('side-judge').hidden = false; }
        const { data } = await sb.from('ai_judge_submissions').select('created_at').order('created_at', { ascending: true }).limit(200);
        const old = (data || []).filter((r) => Date.now() - new Date(r.created_at).getTime() > 30 * 86400000).length;
        $('st-judge-sub').textContent = old ? `보관 1개월이 지난 ${old}건 — 삭제가 필요합니다` : '';
        if (old) { $('notice').hidden = false; $('notice').textContent = `AI 심사 제출 중 보관 1개월이 지난 ${old}건이 있습니다. AI 심사 제출 화면에서 삭제해 주세요.`; }
      }
    }

    $('gate-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const st = $('gate-status');
      st.textContent = '로그인 중…';
      const { data, error } = await sb.auth.signInWithPassword({ email: $('gate-email').value.trim(), password: $('gate-password').value });
      if (error) { st.textContent = '로그인 실패: 이메일 또는 비밀번호를 확인하세요.'; return; }
      if (data.user.email !== ADMIN_EMAIL) { st.textContent = '관리자 계정이 아닙니다.'; await sb.auth.signOut(); return; }
      st.textContent = ''; $('gate-password').value = '';
      render();
    });
    $('logout').addEventListener('click', async () => { await sb.auth.signOut(); render(); });
    render();
  })();
</script>

<style is:global>
  :root {
    --a-bg: #f0f0f1; --a-surface: #fff; --a-ink: #1d2327; --a-muted: #646970; --a-line: #dcdcde;
    --a-side: #1d2327; --a-side-ink: #c3c4c7; --a-side-hover: #2c3338; --a-side-active: #2271b1; --a-accent: #2271b1;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--a-bg); color: var(--a-ink); font: 14px/1.6 system-ui, -apple-system, 'Segoe UI', 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif; }
  [hidden] { display: none !important; }
  a { color: inherit; }
  code { font-size: 0.9em; background: #f0f0f1; border-radius: 3px; padding: 0 4px; }
  .muted { color: var(--a-muted); }
  .btn { display: inline-block; font: inherit; font-weight: 600; padding: 7px 14px; border-radius: 4px; border: 1px solid var(--a-accent); background: var(--a-accent); color: #fff; text-decoration: none; cursor: pointer; }
  .btn:hover { filter: brightness(1.1); }
  .btn.ghost { background: transparent; color: var(--a-accent); }

  .gate { min-height: 100vh; display: grid; place-items: center; padding: 16px; }
  .gate-box { width: min(26rem, 100%); background: var(--a-surface); border: 1px solid var(--a-line); border-radius: 8px; padding: 24px; display: grid; gap: 12px; }
  .gate-box h1 { margin: 0; font-size: 1.25rem; }
  .gate-box label { display: grid; gap: 4px; font-weight: 600; }
  .gate-box input { font: inherit; padding: 8px 10px; border: 1px solid var(--a-line); border-radius: 4px; }

  .shell { display: grid; grid-template-columns: 220px minmax(0, 1fr); min-height: 100vh; }
  .side { background: var(--a-side); color: var(--a-side-ink); display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh; overflow-y: auto; }
  .brand { display: block; padding: 16px 16px 12px; color: #fff; font-weight: 700; text-decoration: none; font-size: 15px; }
  .brand small { display: block; font-weight: 400; color: var(--a-side-ink); font-size: 12px; }
  .side nav { display: flex; flex-direction: column; flex: 1; }
  .item { display: flex; align-items: center; gap: 10px; padding: 9px 16px; color: var(--a-side-ink); text-decoration: none; background: none; border: 0; font: inherit; text-align: left; width: 100%; cursor: pointer; }
  .item i { font-style: normal; width: 1.6em; text-align: center; font-size: 12px; font-weight: 700; }
  .item:hover { background: var(--a-side-hover); color: #fff; }
  .item.active { background: var(--a-side-active); color: #fff; }
  .group { padding: 14px 16px 4px; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: #8c8f94; }
  .badge { margin-left: auto; background: #d63638; color: #fff; border-radius: 999px; font-size: 11px; padding: 0 7px; line-height: 18px; }
  .logout { border-top: 1px solid #3c434a; margin-top: 8px; }

  .main { padding: 20px 28px 48px; max-width: 1100px; }
  .main h1 { margin: 4px 0 4px; font-size: 1.6rem; font-weight: 600; }
  .main h2 { margin: 28px 0 10px; font-size: 1.1rem; }
  .lead { margin: 0 0 16px; }
  .notice { background: #fcf9e8; border-left: 4px solid #dba617; padding: 10px 14px; margin-bottom: 14px; box-shadow: 0 1px 1px rgba(0,0,0,.04); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
  .stat { background: var(--a-surface); border: 1px solid var(--a-line); border-radius: 6px; padding: 12px 14px; display: grid; gap: 2px; }
  .stat .k { color: var(--a-muted); font-size: 12.5px; }
  .stat .v { font-size: 1.6rem; font-weight: 600; line-height: 1.2; }
  .stat .sub { font-size: 12px; color: var(--a-muted); }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .card { background: var(--a-surface); border: 1px solid var(--a-line); border-radius: 6px; padding: 16px; display: grid; gap: 10px; align-content: start; }
  .card h3 { margin: 0; font-size: 1.05rem; }
  .card p { margin: 0; }
  .card-head { display: flex; gap: 12px; align-items: center; }
  .flag { font-size: 1.1rem; font-weight: 700; line-height: 1; display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 8px; background: #e8f0f8; color: var(--a-accent); }
  .card-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  @media (max-width: 760px) {
    .shell { grid-template-columns: 1fr; }
    .side { position: static; height: auto; }
    .side nav { flex-direction: row; flex-wrap: wrap; }
    .item { width: auto; padding: 8px 12px; }
    .group { width: 100%; }
    .main { padding: 16px; }
  }
</style>
