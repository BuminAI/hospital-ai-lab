---
import TwLayout from '../../layouts/TwLayout.astro';
import TwSections from '../../components/TwSections.astro';
import { guideTw } from '../../data/tw/pages';
import tw from '../../i18n/tw.json';
import { withBase } from '../../utils/site';

const p = guideTw;

// 소제목이 순서를 가지므로 HowTo로 표시한다. 화면에 보이는 것만 마크업한다.
//
// ⚠️ 단계 판정은 소제목이 「第N步」로 시작하는 것만 본다. 다른 형태의 절을
//    추가하면 마크업에서 조용히 빠지므로, 절을 늘릴 때 이 정규식도 볼 것.
//    구글은 2023년에 HowTo 리치결과를 없앴다 — 이 마크업은 검색 장식이
//    아니라 AI 답변 엔진용이다(ru·ja판과 같은 판단).
const stepSections = p.sections.filter((s) => /^第.{1,3}步/.test(s.heading));
const schema = [
  {
    '@type': 'HowTo',
    name: p.meta.pageTitle,
    description: p.meta.description,
    inLanguage: 'zh-TW',
    step: stepSections.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.heading,
      text: s.body,
    })),
  },
];
---

<TwLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={tw.nav.guide}
  koPath="/guide/"
  ruPath="/ru/guide/"
  jaPath="/ja/guide/"
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="tw-lead">{p.meta.lead}</p>

  <TwSections sections={p.sections} />

  <section class="tw-next">
    <h2>延伸閱讀</h2>
    <ul>
      <li>
        <a href={withBase('/tw/glossary/')}>{tw.nav.glossary}</a> —
      提案書與院內會議上會出現的詞彙。
      </li>
      <li>
        <a href={withBase('/tw/checklist/')}>{tw.nav.checklist}</a> —
      拿到具體提案時逐項確認的清單。
      </li>
    </ul>
  </section>
</TwLayout>

<style>
  .tw-lead {
    color: var(--tw-text-sub);
  }
  .tw-next {
    margin-top: 36px;
    border-top: 1px solid var(--tw-border);
    padding-top: 20px;
  }
  .tw-next h2 {
    font-size: 15px;
    color: var(--tw-text-sub);
    margin-bottom: 10px;
    border: 0;
    padding: 0;
    background: none;
  }
  .tw-next ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tw-next li {
    font-size: 14px;
    line-height: 1.85;
  }
</style>
