---
// Program Pemerintah — 인도네시아 정부 지원·제도 안내 (2026-09-06 신설)
//
// ⚠️ 한국어판 /gov-support/·일본어판 /ja/subsidies/와 달리 **자동 수집이
//    아니다.** 인도네시아에는 jGrants(일본)나 보건복지부 공고 목록(한국)처럼
//    기계로 읽을 수 있는 공고 소스를 찾지 못했다(사유는 gov-support.json의
//    _comment에 적어 뒀다). 그래서 hreflang으로 한국어판과 짝지우지 않는다 —
//    성격이 다른 페이지에 alternate를 걸면 잘못된 신호가 된다.
//
// ⚠️ 자동 수집이 아니라는 사실을 화면에서 숨기지 않는다. 방문자가 최신
//    공고로 착각하면 신뢰를 해친다. notice와 확인일을 반드시 함께 노출한다.
import TwLayout from '../../layouts/TwLayout.astro';
import twI18n from '../../i18n/tw.json';
import { govSupportTw } from '../../data/tw/pages';
import notices from '../../data/tw/gov-notices.json';
import { withBase } from '../../utils/site';

const p = govSupportTw;
const fmtDay = new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei', year: 'numeric', month: 'long', day: 'numeric' });
// 最新公告(自動收集, 2026-10-31 新增): 衛福部「公告訊息」中的補助·徵求·申請須知·說明會, 食藥署的醫療器材公告
const recent = notices.items.slice(0, 30);

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/tw/gov-support/')}`;

// ItemList로만 전달한다. 각 항목은 우리가 만든 공고가 아니라 정부 페이지로
// 가는 안내이므로 GovernmentService 등으로 단정하지 않는다.
const schema = [
  {
    '@type': 'ItemList',
    '@id': `${pageUrl}#programs`,
    name: p.meta.pageTitle,
    numberOfItems: p.programs.length,
    itemListElement: p.programs.map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.name,
      url: it.url,
    })),
  },
];
---

<TwLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={twI18n.nav.govSupport}
  koPath="/gov-support/"
  standalone
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="tw-lead">{p.meta.lead}</p>

  <p class="tw-notice">{p.notice}</p>

  <section class="tw-notice-sec" aria-labelledby="tw-latest-h">
    <h2 id="tw-latest-h">最新補助、申請與說明會公告（自動收集）</h2>
    <p class="tw-lead">
      自動收集衛福部「公告訊息」中的補助、公開徵求、申請作業須知與說明會，以及食藥署與醫療器材有關的公告，每天確認數次，過去的公告不會刪除。下列日期是<strong>公告上線的日期，不是申請截止日</strong>；申請資格、期間與文件，請一律點進公告原文確認。這些是機關依「政府資料開放授權條款」公開的資料，本站只列標題與連結。
    </p>
    <ul class="tw-programs">
      {
        recent.map((n) => (
          <li>
            <h3>
              <a href={n.link} target="_blank" rel="noopener">
                {n.title}
                <span class="sr-only"> ({twI18n.ui.external})</span>
              </a>
            </h3>
            <p class="tw-org">
              {n.source}{n.dept && <>｜{n.dept}</>}｜{n.kind}｜{fmtDay.format(new Date(n.pubDate))}公告
            </p>
          </li>
        ))
      }
    </ul>
    <p class="tw-note">資料更新：{fmtDay.format(new Date(notices.updatedAt))}。出處：衛生福利部、食品藥物管理署。</p>
  </section>

  <h2>官方入口與法規（人工整理）</h2>

  <ul class="tw-programs">
    {
      p.programs.map((it) => (
        <li>
          <h2>
            <a href={it.url} target="_blank" rel="noopener">
              {it.name}
              <span class="sr-only"> ({twI18n.ui.external})</span>
            </a>
          </h2>
          <p class="tw-org">{it.org}</p>
          <p class="tw-body">{it.body}</p>
          <p class="tw-audience">
            <strong>適用對象：</strong> {it.audience}
          </p>
          <p class="tw-src">
            {twI18n.ui.source}:{' '}
            <a href={it.sourceUrl} target="_blank" rel="noopener">
              {it.sourceLabel}
              <span class="sr-only"> ({twI18n.ui.external})</span>
            </a>{' '}
            · 查證日期 {p.checkedAt}
          </p>
        </li>
      ))
    }
  </ul>

  <div class="tw-note">
    <p>
      本頁並未收錄所有政府方案。這裡只列出能在官方頁面直接查證說明內容的方案。
      無法從官方來源確認的方案刻意不列入，以免本頁出現不正確的說明。
    </p>
  </div>
</TwLayout>

<style>
  .tw-lead {
    color: var(--tw-text-sub);
  }
  .tw-notice {
    border: 1px solid var(--tw-border);
    border-left: 4px solid var(--tw-primary);
    background: var(--tw-surface);
    padding: 12px 14px;
    font-size: 13.5px;
    line-height: 1.85;
    margin-bottom: 20px;
  }
  .tw-programs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--tw-border);
  }
  .tw-programs li {
    padding: 18px 0;
    border-bottom: 1px solid var(--tw-border);
  }
  .tw-programs h2 {
    font-size: 16px;
    margin: 0 0 4px;
    line-height: 1.6;
  }
  .tw-programs h2 a {
    color: var(--tw-primary);
  }
  .tw-org {
    margin: 0 0 8px;
    font-size: 13px;
    color: var(--tw-text-sub);
  }
  .tw-body {
    margin: 0 0 8px;
    line-height: 1.9;
  }
  .tw-audience {
    margin: 0 0 6px;
    font-size: 13.5px;
    line-height: 1.85;
  }
  .tw-src {
    margin: 0;
    font-size: 12.5px;
    color: var(--tw-text-sub);
  }
  .tw-note {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--tw-border);
    font-size: 13px;
    line-height: 1.9;
    color: var(--tw-text-sub);
  }
</style>
