---
// Berita AI — PERSI·ANTARA 자동 수집 목록 (ru/news.astro와 같은 패턴).
//
// hreflang을 걸지 않는다 — 자동 수집 목록은 언어판마다 완전히 다른 기사
// 목록이라, 번역 관계가 아닌 페이지에 alternate를 걸면 검색엔진에 잘못된
// 신호가 된다(ko news.astro·ru news.astro도 같은 원칙).
import TwLayout from '../../layouts/TwLayout.astro';
import twI18n from '../../i18n/tw.json';
import { withBase } from '../../utils/site';
import news from '../../data/tw/news.json';

const fmt = new Intl.DateTimeFormat('zh-TW', {
  timeZone: 'Asia/Taipei',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const items = news.items;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/tw/news/')}`;
const DESC =
  '自動收集中央社、科技新報、健康醫療網當中提到 AI 或醫療數位化的報導，每天更新數次，舊的報導不會刪除。標題直接連到原媒體。';

const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: twI18n.nav.news,
  description: DESC,
  inLanguage: 'zh-TW',
  isPartOf: { '@id': `${siteUrl}/#website-tw` },
  dateModified: news.updatedAt,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<TwLayout
  title={twI18n.nav.news}
  description={DESC}
  crumb={twI18n.nav.news}
  koPath="/news/"
  standalone
  updated={new Date(news.updatedAt)}
  schema={[collectionPage]}
>
  <h1>{twI18n.nav.news}</h1>
  <p class="tw-lead">
    自動收集中央社、科技新報、健康醫療網當中提到 AI 或醫療數位化的報導，
    每天更新數次。舊的報導不會刪除。
  </p>

  {
    items.length > 0 ? (
      <ul class="tw-news-list">
        {items.map((item) => (
          <li>
            <a href={item.link} target="_blank" rel="noopener">
              {item.title}
              <span class="sr-only"> ({twI18n.ui.external})</span>
            </a>
            <span class="tw-news-meta">
              {item.source} ·{' '}
              <time datetime={item.pubDate}>{fmt.format(new Date(item.pubDate))}</time>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="tw-empty">{twI18n.ui.noItems}</p>
    )
  }

  <div class="tw-note">
    <p>
      這份清單是以標題關鍵字自動篩選出來的，不是編輯精選——本站沒有對個別報導
      做評價或推薦。標題會直接連到原媒體的文章。
    </p>
  </div>
</TwLayout>

<style>
  .tw-lead {
    color: var(--tw-text-sub);
  }
  .tw-news-list {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--tw-border);
  }
  .tw-news-list li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid var(--tw-border);
  }
  .tw-news-list a {
    color: var(--tw-text);
    font-weight: 600;
    line-height: 1.6;
  }
  .tw-news-list a:hover {
    color: var(--tw-primary);
  }
  .tw-news-meta {
    font-size: 13px;
    color: var(--tw-text-sub);
  }
  .tw-empty {
    margin-top: 20px;
    color: var(--tw-text-sub);
  }
  .tw-note {
    margin-top: 26px;
    padding-top: 16px;
    border-top: 1px solid var(--tw-border);
    font-size: 13px;
    line-height: 1.9;
    color: var(--tw-text-sub);
  }
</style>
