---
// 教育與活動 — 中央社 검색 + 뉴스 누적분에서 행사성 기사만 추린 목록.
// 한국어판 events.astro와 같은 성격이고, 대만어판 news.astro와 같은 구조다.
//
// hreflang을 걸지 않는다 — 자동 수집 목록은 언어판마다 완전히 다른 목록이라
// 번역 관계가 아니다. 짝이 아닌 페이지에 alternate를 걸면 잘못된 신호가 된다
// (ko events.astro·tw news.astro도 같은 원칙).
import TwLayout from '../../layouts/TwLayout.astro';
import twI18n from '../../i18n/tw.json';
import { withBase } from '../../utils/site';
import events from '../../data/tw/events.json';

const fmt = new Intl.DateTimeFormat('zh-TW', {
  timeZone: 'Asia/Taipei',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const items = events.items;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteUrl}${withBase('/tw/events/')}`;
const DESC =
  '臺灣醫療 AI 相關的研討會、論壇、工作坊與醫療科技展消息，從中央社的報導與衛生福利部的公告自動整理。日期是刊出日，不是活動日期；要參加請點進原文向主辦單位確認。';

const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: twI18n.nav.events,
  description: DESC,
  inLanguage: 'zh-TW',
  isPartOf: { '@id': `${siteUrl}/#website-tw` },
  dateModified: events.updatedAt,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 30).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: it.link,
    })),
  },
};
---

<TwLayout
  title={twI18n.nav.events}
  description={DESC}
  crumb={twI18n.nav.events}
  koPath="/events/"
  standalone
  updated={new Date(events.updatedAt)}
  schema={[collectionPage]}
>
  <h1>{twI18n.nav.events}</h1>
  <p class="tw-lead">
    臺灣醫療 AI 相關的研討會、論壇、工作坊與醫療科技展消息，從<strong>中央社的報導</strong>
    與<strong>衛生福利部的最新消息</strong>自動整理。點標題會連到原本的報導或公告。
  </p>

  {/* 이 안내를 지우지 말 것 — 이 목록은 '행사 안내'가 아니라 '행사를 다룬
      보도'다. 지난 행사가 그대로 남아 있고, 신청 기간·정원도 여기서는 알 수
      없다. 그 사실을 화면에서 밝히지 않으면 방문자를 오해하게 만든다. */}
  <p class="tw-caution">
    <strong>這是報導與公告的整理，不是活動報名頁。</strong>
    下方的日期是<strong>報導或公告刊出的日期</strong>，不是活動舉辦或報名的日期。
    已經結束的活動也會留著——看過去辦過什麼，本身就有參考價值。
    要參加的話，請務必點進原文，並向主辦單位確認日期、名額與報名方式。
  </p>

  {
    items.length > 0 ? (
      <ul class="tw-news-list">
        {items.map((item) => (
          <li>
            <a href={item.link} target="_blank" rel="noopener">
              {item.title}
              <span class="sr-only"> ({twI18n.ui.external})</span>
            </a>
            <span class="tw-news-meta">
              {item.source} ·{' '}
              <time datetime={item.pubDate}>{fmt.format(new Date(item.pubDate))}</time>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="tw-empty">{twI18n.ui.noItems}</p>
    )
  }

  <div class="tw-note">
    <p>
      這份清單是以標題關鍵字自動篩選出來的，不是編輯精選——本站沒有對個別活動
      做評價或推薦，也與主辦單位沒有任何關係。收錄與否不代表品質判斷。
    </p>
  </div>
</TwLayout>

<style>
  .tw-lead {
    color: var(--tw-text-sub);
  }
  .tw-caution {
    border: 1px solid var(--tw-border);
    border-left: 4px solid var(--tw-primary);
    background: var(--tw-surface);
    padding: 12px 14px;
    font-size: 13.5px;
    line-height: 1.85;
    margin: 16px 0 4px;
  }
  .tw-news-list {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--tw-border);
  }
  .tw-news-list li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid var(--tw-border);
  }
  .tw-news-list a {
    color: var(--tw-text);
    font-weight: 600;
    line-height: 1.6;
  }
  .tw-news-list a:hover {
    color: var(--tw-primary);
  }
  .tw-news-meta {
    font-size: 13px;
    color: var(--tw-text-sub);
  }
  .tw-empty {
    margin-top: 20px;
    color: var(--tw-text-sub);
  }
  .tw-note {
    margin-top: 26px;
    padding-top: 16px;
    border-top: 1px solid var(--tw-border);
    font-size: 13px;
    line-height: 1.9;
    color: var(--tw-text-sub);
  }
</style>
