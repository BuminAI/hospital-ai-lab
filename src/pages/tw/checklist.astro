---
import TwLayout from '../../layouts/TwLayout.astro';
import TwSections from '../../components/TwSections.astro';
import { checklistTw } from '../../data/tw/pages';
import tw from '../../i18n/tw.json';
import { withBase } from '../../utils/site';

const p = checklistTw;

// 화면에 보이는 소제목·순서 그대로 ItemList로 알린다(보이지 않는 정보는 넣지 않는다).
const schema = [
  {
    '@type': 'ItemList',
    name: p.meta.pageTitle,
    numberOfItems: p.sections.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: p.sections.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.heading,
    })),
  },
];
---

<TwLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={tw.nav.checklist}
  koPath="/checklist/"
  ruPath="/ru/checklist/"
  jaPath="/ja/checklist/"
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="tw-lead">{p.meta.lead}</p>

  <TwSections sections={p.sections} checkbox />

  <section class="tw-next">
    <h2>延伸閱讀</h2>
    <ul>
      <li>
        <a href={withBase('/tw/glossary/')}>{tw.nav.glossary}</a> —
      這份檢核表用到的詞彙說明。
      </li>
      <li>
        <a href={withBase('/tw/faq/')}>{tw.nav.faq}</a> —
      醫院評估 AI 時最常出現的問題。
      </li>
      <li>
        <a href={withBase('/tw/guide/')}>{tw.nav.guide}</a> —
      沒有技術背景時的學習順序。
      </li>
    </ul>
  </section>
</TwLayout>

<style>
  .tw-lead {
    color: var(--tw-text-sub);
  }
  .tw-next {
    margin-top: 36px;
    border-top: 1px solid var(--tw-border);
    padding-top: 20px;
  }
  .tw-next h2 {
    font-size: 15px;
    color: var(--tw-text-sub);
    margin-bottom: 10px;
    border: 0;
    padding: 0;
    background: none;
  }
  .tw-next ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tw-next li {
    font-size: 14px;
    line-height: 1.85;
  }
</style>
