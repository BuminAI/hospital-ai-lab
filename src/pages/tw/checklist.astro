---
import TwLayout from '../../layouts/TwLayout.astro';
import InteractiveChecklist from '../../components/InteractiveChecklist.astro';
import SubscribeCta from '../../components/SubscribeCta.astro';
import { getCollection } from 'astro:content';
import { checklistRelated } from '../../data/checklist-related';
import { COLLECTION, postHref } from '../../utils/locale';
import { checklistTw } from '../../data/tw/pages';
import tw from '../../i18n/tw.json';
import { withBase } from '../../utils/site';

const p = checklistTw;

// 점검표를 체크해 가며 쓰는 형태로 그린다(2026-09-20). 체크 상태는 이 기기의 브라우저에만 저장된다.
const sections = p.sections.map((s, i) => ({
  title: s.heading,
  body: s.body,
  items: s.items,
  plain: false,
}));
const posts = await getCollection(COLLECTION.tw, ({ data }) => !data.draft);
const titleOf = new Map(posts.map((x) => [x.id, x.data.title]));
const relatedByTitle: Record<string, { href: string; title: string }[]> = {};
for (const [idx, ids] of Object.entries(checklistRelated.tw)) {
  const sec = sections[Number(idx)];
  if (!sec) throw new Error('[checklist:tw] 관련 글의 섹션 번호 ' + idx + '가 없습니다.');
  relatedByTitle[sec.title] = ids.map((id) => {
    const title = titleOf.get(id);
    if (!title) throw new Error('[checklist:tw] 관련 글 ID ' + id + '가 없습니다.');
    return { href: postHref('tw', id), title };
  });
}

// 화면에 보이는 소제목·순서 그대로 ItemList로 알린다(보이지 않는 정보는 넣지 않는다).
const schema = [
  {
    '@type': 'ItemList',
    name: p.meta.pageTitle,
    numberOfItems: p.sections.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: p.sections.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.heading,
    })),
  },
];
---

<TwLayout
  title={p.meta.title}
  description={p.meta.description}
  crumb={tw.nav.checklist}
  koPath="/checklist/"
  idPath="/id/checklist/"
  ruPath="/ru/checklist/"
  jaPath="/ja/checklist/"
  schema={schema}
>
  <h1>{p.meta.pageTitle}</h1>
  <p class="tw-lead">{p.meta.lead}</p>

  <InteractiveChecklist id="ai-adoption-tw" loc="tw" sections={sections} related={relatedByTitle} />

  <SubscribeCta loc="tw" />

  <section class="tw-next">
    <h2>延伸閱讀</h2>
    <ul>
      <li>
        <a href={withBase('/tw/glossary/')}>{tw.nav.glossary}</a> —
      這份檢核表用到的詞彙說明。
      </li>
      <li>
        <a href={withBase('/tw/faq/')}>{tw.nav.faq}</a> —
      醫院評估 AI 時最常出現的問題。
      </li>
      <li>
        <a href={withBase('/tw/guide/')}>{tw.nav.guide}</a> —
      沒有技術背景時的學習順序。
      </li>
    </ul>
  </section>
</TwLayout>

<style>
  .tw-lead {
    color: var(--tw-text-sub);
  }
  .tw-next {
    margin-top: 36px;
    border-top: 1px solid var(--tw-border);
    padding-top: 20px;
  }
  .tw-next h2 {
    font-size: 15px;
    color: var(--tw-text-sub);
    margin-bottom: 10px;
    border: 0;
    padding: 0;
    background: none;
  }
  .tw-next ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tw-next li {
    font-size: 14px;
    line-height: 1.85;
  }
</style>
