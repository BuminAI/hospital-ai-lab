---
// 대만어판(정체자) 홈 (Fase A — 2026-09-05 신설).
//
// 2026-09-06: 뉴스·정부 프로그램·추천 영상이 생기면서 카드 그리드를 넣었다.
// 처음 만들 때는 참조 페이지가 없어 일부러 카드를 안 뒀다 — 내용 없는
// 페이지로 링크를 걸면 방문자 신뢰도 떨어지고 검색엔진도 빈약한 페이지로
// 취급하기 때문이다. 지금은 여섯 곳 다 실제 내용이 있어 입구를 연다.
// ⚠️ 카드는 **내용이 있는 페이지만** 건다. 새 페이지를 만들 때 카드부터
//    추가하지 말 것.
import TwLayout from '../../layouts/TwLayout.astro';
import tw from '../../i18n/tw.json';
import { withBase } from '../../utils/site';
import newsData from '../../data/tw/news.json';

// ── AEO/GEO — 홈에서 바로 답이 되는 블록 (2026-09-07) ──────────
// 답변 엔진은 "이 사이트는 무엇이고 누구를 위한 것인가"를 물었을 때
// **그 답이 실제로 적혀 있는 페이지**를 인용한다. 홈이 소개 문단만
// 있으면 인용할 문장이 없다. 그래서 사이트 자체에 대한 문답을
// 화면에 그대로 싣고 FAQPage로 표시한다.
//
// ⚠️ 여기 답변은 /tw/faq/ 의 제도 문답과 **내용이 겹치지 않는다.**
//    저쪽은 "AI를 도입할 때 무엇을 확인하나", 여기는 "이 사이트는
//    무엇인가"다. 같은 문답을 두 곳에 복사하면 안 된다.
// ⚠️ 답변에 적은 사실(수집처·갱신 주기)은 scripts/ 의 수집기와
//    .github/workflows/ 의 cron 에서 확인한 것이다. 수집처나 주기를
//    바꾸면 이 문구도 함께 고칠 것.
const recentNews = newsData.items.slice(0, 5);

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/tw/')}`;

const homeFaqLd = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#home-faq`,
  url: pageUrl,
  inLanguage: 'zh-TW',
  isPartOf: { '@id': `${siteRoot}/#website-tw` },
  mainEntity: tw.home.homeFaq.map((f, i) => ({
    '@type': 'Question',
    '@id': `${pageUrl}#home-q${i + 1}`,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<TwLayout
  title={tw.home.metaTitle}
  description={tw.home.metaDescription}
  koPath="/"
  idPath="/id/"
  jaPath="/ja/"
  ruPath="/ru/"
  schema={[homeFaqLd]}
>
  <p class="tw-updated" style="letter-spacing:.06em">{tw.home.heroEyebrow}</p>
  <h1>{tw.home.heroTitle}</h1>
  <p>{tw.home.heroLead}</p>

  <p style="margin-top:16px">
    <a class="tw-cta" href={withBase('/tw/about/')}>{tw.nav.about} →</a>
  </p>

  <div class="tw-cards">
    <a class="tw-card" href={withBase('/tw/glossary/')}>
      <span class="tw-card-t">{tw.nav.glossary}</span>
      <span class="tw-card-d">{tw.home.glossaryDesc}</span>
    </a>
    <a class="tw-card" href={withBase('/tw/faq/')}>
      <span class="tw-card-t">{tw.nav.faq}</span>
      <span class="tw-card-d">{tw.home.faqDesc}</span>
    </a>
    <a class="tw-card" href={withBase('/tw/news/')}>
      <span class="tw-card-t">{tw.nav.news}</span>
      <span class="tw-card-d">{tw.home.newsDesc}</span>
    </a>
    <a class="tw-card" href={withBase('/tw/events/')}>
      <span class="tw-card-t">{tw.nav.events}</span>
      <span class="tw-card-d">{tw.home.eventsDesc}</span>
    </a>
    <a class="tw-card" href={withBase('/tw/gov-support/')}>
      <span class="tw-card-t">{tw.nav.govSupport}</span>
      <span class="tw-card-d">{tw.home.govSupportDesc}</span>
    </a>
    <a class="tw-card" href={withBase('/tw/videos/')}>
      <span class="tw-card-t">{tw.nav.videos}</span>
      <span class="tw-card-d">{tw.home.videosDesc}</span>
    </a>
    <a class="tw-card" href={withBase('/tw/blog/')}>
      <span class="tw-card-t">{tw.nav.blog}</span>
      <span class="tw-card-d">{tw.home.blogDesc}</span>
    </a>
    <a class="tw-card" href={withBase('/tw/checklist/')}>
      <span class="tw-card-t">{tw.nav.checklist}</span>
      <span class="tw-card-d">{tw.home.checklistDesc}</span>
    </a>
    <a class="tw-card" href={withBase('/tw/guide/')}>
      <span class="tw-card-t">{tw.nav.guide}</span>
      <span class="tw-card-d">{tw.home.guideDesc}</span>
    </a>
    <a class="tw-card" href={withBase('/tw/tips/')}>
      <span class="tw-card-t">{tw.nav.tips}</span>
      <span class="tw-card-d">{tw.home.tipsDesc}</span>
    </a>
  </div>

  {/* 최신 뉴스 — 홈에 실제 내용이 있어야 검색·답변 엔진이 인용할 거리가 생긴다.
      한국어판 홈이 이미 쓰는 방식이고, 다른 판에는 빠져 있었다(2026-09-07 추가). */}
  {
    recentNews.length > 0 && (
      <section class="tw-home-sec">
        <div class="tw-sec-head">
          <h2>{tw.home.homeNewsTitle}</h2>
          <a class="tw-more" href={withBase('/tw/news/')}>{tw.home.homeNewsMore}</a>
        </div>
        <ul class="tw-news-preview">
          {recentNews.map((item) => (
            <li>
              <a href={item.link} target="_blank" rel="noopener">
                {item.title}
                <span class="sr-only"> ({tw.ui.external})</span>
              </a>
              {item.source && <span class="tw-src">{item.source}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* 사이트 자체에 대한 문답. /tw/faq/ 의 제도 문답과 내용이 겹치지 않는다. */}
  <section class="tw-home-sec">
    <div class="tw-sec-head">
      <h2>{tw.home.homeFaqTitle}</h2>
      <a class="tw-more" href={withBase('/tw/faq/')}>{tw.home.homeFaqMore}</a>
    </div>
    <dl class="tw-home-faq">
      {
        tw.home.homeFaq.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <h2>{tw.home.notTranslationTitle}</h2>
  <p>{tw.home.notTranslationBody}</p>

  <h2>{tw.home.sourceNoteTitle}</h2>
  <p>{tw.home.sourceNoteBody}</p>

  <div class="tw-note">
    <p><strong>{tw.home.koNoticeTitle}</strong></p>
    <p style="margin-top:6px">{tw.home.koNoticeBody}</p>
    <p style="margin-top:8px"><a href={withBase('/')} hreflang="ko">{tw.ui.langKo} →</a></p>
  </div>
</TwLayout>

<style>
  /* .tw-cta 는 마크업에만 있고 스타일이 없어서 평범한 링크로 나왔다
     (2026-09-06 색상 교체 중 발견). ja·ru 홈과 같은 버튼 모양으로 맞춘다. */
  .tw-cta {
    display: inline-block;
    background: var(--tw-btn-bg);
    color: var(--tw-btn-fg);
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 4px;
    font-size: 14.5px;
  }
  .tw-cta:hover { background: var(--tw-btn-bg-hover); }

  .tw-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 12px;
    margin: 26px 0 8px;
  }
  .tw-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid var(--tw-border);
    background: var(--tw-base);
    padding: 14px 16px;
    text-decoration: none;
    color: var(--tw-text);
  }
  .tw-card:hover {
    background: var(--tw-surface);
    border-color: var(--tw-primary);
  }
  .tw-card-t {
    font-weight: 700;
    color: var(--tw-primary);
    font-size: 15px;
  }
  .tw-card-d {
    font-size: 13px;
    line-height: 1.8;
    color: var(--tw-text-sub);
  }

  .tw-wip {
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid var(--tw-border);
    font-size: 13.5px;
    color: var(--tw-text-sub);
  }

  /* 홈 뉴스·문답 (2026-09-07 AEO/GEO) */
  .tw-home-sec {
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--tw-border);
  }
  .tw-sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .tw-sec-head h2 {
    margin: 0;
  }
  .tw-more {
    font-size: 13px;
    color: var(--tw-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .tw-more:hover { text-decoration: underline; }
  .tw-news-preview {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }
  .tw-news-preview li {
    padding: 9px 0;
    border-bottom: 1px solid var(--tw-border);
    font-size: 14px;
    line-height: 1.7;
  }
  .tw-news-preview a {
    color: var(--tw-text);
    text-decoration: none;
  }
  .tw-news-preview a:hover { color: var(--tw-primary); text-decoration: underline; }
  .tw-src {
    display: inline-block;
    margin-left: 8px;
    font-size: 12px;
    color: var(--tw-text-sub);
  }
  .tw-home-faq {
    margin: 14px 0 0;
  }
  .tw-home-faq dt {
    font-weight: 700;
    color: var(--tw-primary);
    margin-top: 16px;
    font-size: 14.5px;
    line-height: 1.7;
  }
  .tw-home-faq dt:first-child { margin-top: 0; }
  .tw-home-faq dd {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.9;
    color: var(--tw-text);
  }
</style>
