---
// 台灣版首頁 (2026-10-31 全面改版，오너 지시: 일본어판과 같은 방법으로 대만판도 — 가독성·후킹·전문성·신뢰)
//
// 구성(위에서 아래로 — 대만 방문자가 "이 사이트는 믿을 만한가 / 내게 필요한가"를 판단하는 순서):
//   1) 청록 히어로: 약속 한 줄 + 행동 2개 + 오른쪽 「最新更新」(살아 있는 사이트라는 증거)
//   2) 신뢰 수치 띠: 전부 실데이터(글 수·출처 링크 확인 수·정부 공고 수·뉴스 수). 지어낸 수치 없음
//   3) 「遇到這些情況時」 목적별 입구 6개 — 질문형 문구로 클릭 이유를 준다
//   4) 更新資訊 → 衛福部 補助·申請 공고 → 注目專欄 → 連載
//   5) 本站的承諾 → 資料 → 常見問題 → 本站說明
// ⚠️ 경력(17년 등)은 홈 본문과 메타 설명에 새로 싣지 않는다(사이드바 프로필에는 기존대로 있음).
// ⚠️ 수치·문구는 데이터에서 계산하거나, 이미 사이트에 있는 사실만 쓴다.
import '../../styles/tw-home.css';
import { getCollection } from 'astro:content';
import TwLayout from '../../layouts/TwLayout.astro';
import tw from '../../i18n/tw.json';
import notices from '../../data/tw/gov-notices.json';
import newsData from '../../data/tw/news.json';
import linkHealth from '../../data/tw/link-health.json';
import HomeSeries from '../../components/HomeSeries.astro';
import { withBase } from '../../utils/site';
import { getResolvedSeries } from '../../utils/series';
import { getTwUpdates, KIND_LABEL } from '../../utils/tw-updates';

const updated = new Date(notices.updatedAt);
const fmtMD = new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei', month: 'numeric', day: 'numeric' });
const fmtYMD = new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei', year: 'numeric', month: 'long', day: 'numeric' });

const posts = (await getCollection('blogTw', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.slice(0, 4);

const feed = await getTwUpdates(30);
const heroFeed = feed.slice(0, 4);
const newsFeed = feed.slice(0, 8);
const weekly = feed.filter((u) => Date.now() - new Date(u.date).getTime() <= 7 * 86400000);
const weeklyCount = (k: 'news' | 'notice' | 'event' | 'video' | 'blog') => weekly.filter((u) => u.kind === k).length;

// 衛福部 補助·申請·說明會 公告(新的在前)
const topNotices = notices.items.slice(0, 5);

// 信賴數字(全部來自實際資料)
const stats = [
  { n: posts.length, unit: '篇', label: '公開的專欄文章', href: '/tw/blog/' },
  { n: linkHealth.total, unit: '筆', label: '出處連結每日檢查', href: '/tw/updates/' },
  { n: notices.items.length, unit: '筆', label: '衛福部補助與申請公告', href: '/tw/gov-support/' },
  { n: newsData.items.length, unit: '筆', label: 'AI 新聞（每 3 小時確認）', href: '/tw/news/' },
];
const checkedDay = linkHealth.checkedAt ? fmtYMD.format(new Date(linkHealth.checkedAt)) : '';

const tasks = [
  { q: '接下來有哪些時間點？', t: '智慧醫療與 AI 規範年表', d: '人工智慧基本法、資通安全管理法、個資法修正與病歷互通，一張年表看完。', href: '/tw/dx-roadmap/' },
  { q: '有什麼補助可以看？', t: '制度日曆', d: '衛福部最近的補助、申請與說明會公告，加上制度時間點。', href: '/tw/calendar/' },
  { q: '民眾沒帶健保卡？', t: '健保卡就醫櫃檯應對', d: '忘記帶卡、停電、讀卡機故障時，依健保署規定怎麼處理。', href: '/tw/nhi-card-reception/' },
  { q: '我們醫院資安夠嗎？', t: '醫院資安自我檢核', d: '依資通安全管理法與電子病歷辦法整理的 20 個檢核重點。', href: '/tw/cyber-checklist/' },
  { q: '導入 AI 之前', t: '使用規範範本與向廠商提問 20 題', d: '收到提案書時，可以直接複製改寫的文件草稿。', href: '/tw/templates/' },
  { q: '病人與家屬想知道', t: '患者專區', d: '問 AI 健康問題之前、醫院用 AI 時的告知、健保卡與健康存摺。', href: '/tw/patients/' },
];

const promises = [
  { t: '以一手資料為準', d: '只寫實際讀過衛福部、健保署、全國法規資料庫等原文，查得到出處的內容，並附上連結。' },
  { t: '標示查證日', d: '實務指南與患者專區的每一頁下方，都有「出處與查證日」。法規會變，所以日期一定要標。' },
  { t: '每天檢查出處連結', d: `台灣版的外部連結 ${linkHealth.total} 筆，每天自動連線確認，找不到頁面的有 ${linkHealth.dead.length} 筆${checkedDay ? `（${checkedDay}）` : ''}。` },
  { t: '不推薦特定產品或醫院', d: '重點是自家醫院能不能用、有沒有依據，不推薦產品，也不催促導入。' },
];

const library = [
  { t: tw.nav.guide, d: tw.home.guideDesc, href: '/tw/guide/' },
  { t: tw.nav.glossary, d: tw.home.glossaryDesc, href: '/tw/glossary/' },
  { t: tw.nav.faq, d: tw.home.faqDesc, href: '/tw/faq/' },
  { t: tw.nav.checklist, d: tw.home.checklistDesc, href: '/tw/checklist/' },
  { t: tw.nav.tips, d: tw.home.tipsDesc, href: '/tw/tips/' },
  { t: tw.nav.videos, d: tw.home.videosDesc, href: '/tw/videos/' },
];

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/tw/')}`;
const homeFaqLd = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#home-faq`,
  url: pageUrl,
  inLanguage: 'zh-TW',
  isPartOf: { '@id': `${siteRoot}/#website-tw` },
  mainEntity: tw.home.homeFaq.map((f, i) => ({
    '@type': 'Question',
    '@id': `${pageUrl}#home-q${i + 1}`,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const homeSeries = (await getResolvedSeries('tw'))
  .slice()
  .sort((a, b) => b.posts.length - a.posts.length)
  .slice(0, 3);
---

<TwLayout
  title={tw.home.metaTitle}
  description={tw.home.metaDescription}
  koPath="/"
  idPath="/id/"
  jaPath="/ja/"
  ruPath="/ru/"
  updated={updated}
  schema={[homeFaqLd]}
>
  <Fragment slot="hero">
    <section class="th-hero">
      <div class="th-hero-inner">
        <div class="th-hero-copy">
          <p class="th-eyebrow">醫事、行政、護理單位的智慧醫療資訊</p>
          <h1>醫療 AI 的「導入判斷」，<br />用台灣的法規與一手資料來看。</h1>
          <p class="th-lead">
            醫療器材算不算、病人資料能不能這樣用、資安事件要多久通報。整理衛福部、健保署與全國法規資料庫的規定，每一項都附出處與查證日。
          </p>
          <p class="th-cta">
            <a class="th-btn th-btn-main" href={withBase('/tw/dx-roadmap/')}>看智慧醫療與 AI 規範年表</a>
            <a class="th-btn th-btn-sub" href={withBase('/tw/gov-support/')}>看衛福部補助公告</a>
          </p>
        </div>
        <aside class="th-hero-card" aria-labelledby="th-live-h">
          <h2 id="th-live-h"><span class="th-dot" aria-hidden="true"></span>最新更新</h2>
          <ul>
            {heroFeed.map((it) => (
              <li>
                <time datetime={it.date}>{fmtMD.format(new Date(it.date))}</time>
                <span class="th-chip">{KIND_LABEL[it.kind]}</span>
                <a href={it.href} {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
                  {it.title}
                  {it.external && <span class="sr-only">（{tw.ui.external}）</span>}
                </a>
              </li>
            ))}
          </ul>
          <a class="th-hero-more" href={withBase('/tw/updates/')}>看全部更新資訊 →</a>
        </aside>
      </div>
    </section>

    <section class="th-stats" aria-label="網站現況">
      <ul>
        {
          stats.map((s) => (
            <li>
              <a href={withBase(s.href)}>
                <span class="th-num">{s.n.toLocaleString('zh-TW')}<small>{s.unit}</small></span>
                <span class="th-lab">{s.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Fragment>

  <section class="th-sec" aria-labelledby="th-tasks-h">
    <h2 class="th-h" id="th-tasks-h"><span>遇到這些情況時</span><small>BY PURPOSE</small></h2>
    <div class="th-tasks">
      {
        tasks.map((x) => (
          <a class="th-task" href={withBase(x.href)}>
            <span class="th-task-q">{x.q}</span>
            <span class="th-task-t">{x.t}</span>
            <span class="th-task-d">{x.d}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="th-sec" aria-labelledby="th-feed-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-feed-h"><span>更新資訊</span><small>WHAT'S NEW</small></h2>
      <a class="th-more" href={withBase('/tw/updates/')}>看全部 →</a>
    </div>
    <p class="th-note">
      最近 7 天：{KIND_LABEL.news} {weeklyCount('news')} 筆／{KIND_LABEL.notice} {weeklyCount('notice')} 筆／{KIND_LABEL.event} {weeklyCount('event')} 筆／{KIND_LABEL.video} {weeklyCount('video')} 筆／{KIND_LABEL.blog} {weeklyCount('blog')} 篇
    </p>
    <ul class="th-feed">
      {
        newsFeed.map((it) => (
          <li>
            <time datetime={it.date}>{fmtYMD.format(new Date(it.date))}</time>
            <span class="th-chip">{KIND_LABEL[it.kind]}</span>
            <a href={it.href} {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
              {it.title}
              {it.external && <span class="sr-only">（{tw.ui.external}）</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-gov-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-gov-h"><span>衛福部補助與申請公告</span><small>GOV NOTICES</small></h2>
      <a class="th-more" href={withBase('/tw/gov-support/')}>看全部 →</a>
    </div>
    <p class="th-note">日期是公告上線的日期，不是截止日。申請資格、期間與文件，請點進公告原文確認。</p>
    <ul class="th-feed th-feed-sub">
      {
        topNotices.map((n) => (
          <li>
            <time datetime={n.pubDate}>{fmtYMD.format(new Date(n.pubDate))}</time>
            <span class="th-chip th-chip-gov">{n.kind}</span>
            <a href={n.link} target="_blank" rel="noopener">
              {n.title}
              <span class="sr-only">（{tw.ui.external}）</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-posts-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-posts-h"><span>注目專欄</span><small>ARTICLES</small></h2>
      <a class="th-more" href={withBase('/tw/blog/')}>專欄列表 →</a>
    </div>
    <div class="th-posts">
      {
        featured.map((p) => (
          <article class="th-post">
            <p class="th-post-meta">
              <span class="th-chip">{p.data.category}</span>
              <time datetime={p.data.pubDate.toISOString()}>{fmtYMD.format(p.data.pubDate)}</time>
            </p>
            <h3><a href={withBase(`/tw/blog/${p.id}/`)}>{p.data.title}</a></h3>
            <p class="th-post-d">{p.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <HomeSeries loc="tw" list={homeSeries} />

  <section class="th-sec th-promise" aria-labelledby="th-promise-h">
    <h2 class="th-h" id="th-promise-h"><span>本站的承諾</span><small>OUR PRINCIPLES</small></h2>
    <ul>
      {
        promises.map((x, i) => (
          <li>
            <span class="th-no">{i + 1}</span>
            <div>
              <strong>{x.t}</strong>
              <p>{x.d}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="th-note"><a href={withBase('/tw/about/#principles')}>看寫作與查證的原則 →</a></p>
  </section>

  <section class="th-sec" aria-labelledby="th-lib-h">
    <h2 class="th-h" id="th-lib-h"><span>學習與查詢</span><small>LIBRARY</small></h2>
    <ul class="th-lib">
      {
        library.map((x) => (
          <li>
            <a href={withBase(x.href)}>
              <strong>{x.t}</strong>
              <span>{x.d}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="th-sec" aria-labelledby="th-faq-h">
    <div class="th-head-row">
      <h2 class="th-h" id="th-faq-h"><span>{tw.home.homeFaqTitle}</span><small>ABOUT THIS SITE</small></h2>
      <a class="th-more" href={withBase('/tw/faq/')}>{tw.home.homeFaqMore}</a>
    </div>
    <dl class="th-faq">
      {
        tw.home.homeFaq.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <section class="th-sec" aria-labelledby="th-intro-h">
    <h2 class="th-h" id="th-intro-h"><span>{tw.home.notTranslationTitle}</span><small>ABOUT</small></h2>
    <p>{tw.home.notTranslationBody}</p>
    <h3>{tw.home.sourceNoteTitle}</h3>
    <p>{tw.home.sourceNoteBody}</p>
    <div class="tw-note">
      <p><strong>{tw.home.koNoticeTitle}</strong></p>
      <p style="margin-top:6px">{tw.home.koNoticeBody}</p>
      <p style="margin-top:8px"><a href={withBase('/')} hreflang="ko">{tw.ui.langKo} →</a></p>
    </div>
  </section>
</TwLayout>
