---
// Video Rekomendasi — 러시아어판 ru/videos.astro와 같은 구조 (2026-09-06 신설).
//
// 영상 자체는 한국어판·일본어판·러시아어판과 같은 12편(연구소장이 직접 만든
// 입문 시리즈)이고, 제목만 인도네시아어로 옮겼다. 음성이 한국어라는 사실은
// 재생 전에 알린다 — 보고 나서 알게 하면 신뢰를 해친다.
import TwLayout from '../../layouts/TwLayout.astro';
import { videosTw, videosMetaTw } from '../../data/tw/pages';
import twI18n from '../../i18n/tw.json';
import { YOUTUBE_CHANNEL_URL } from '../../utils/site';

const p = videosMetaTw;

// ⚠️ VideoObject는 쓰지 않는다. uploadDate·duration을 정확히 모르기 때문이다
//    (recommended-videos.json의 addedAt은 사이트 추가일이지 유튜브 공개일이
//    아니다). 화면에 보이는 목록 순서를 ItemList로만 전달한다 — ru판과 동일.
const schema = [
  {
    '@type': 'ItemList',
    name: p.pageTitle,
    numberOfItems: videosTw.length,
    itemListElement: videosTw.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.titleTw,
      url: `https://www.youtube.com/watch?v=${v.videoId}`,
    })),
  },
];
---

<TwLayout
  title={p.title}
  description={p.description}
  crumb={twI18n.nav.videos}
  koPath="/youtube/"
  idPath="/id/videos/"
  jaPath="/ja/videos/"
  ruPath="/ru/videos/"
  schema={schema}
>
  <h1>{p.pageTitle}</h1>
  <p class="tw-lead">{p.lead}</p>

  {/* 언어 안내는 재생 전에 */}
  <p class="tw-notice">{p.notice}</p>

  <p class="tw-count">Jumlah video: {videosTw.length}</p>

  <ul class="tw-videos">
    {
      videosTw.map((v) => (
        <li>
          <a href={`https://www.youtube.com/watch?v=${v.videoId}`} target="_blank" rel="noopener">
            <img
              src={`https://img.youtube.com/vi/${v.videoId}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              width="320"
              height="180"
            />
            <div class="tw-video-text">
              <span class="tw-video-title">{v.titleTw}</span>
              {v.note && <span class="tw-video-note">{v.note}</span>}
              <span class="tw-video-ext">
                Tonton di YouTube<span class="sr-only"> ({twI18n.ui.external})</span>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="tw-channel">
    <a href={YOUTUBE_CHANNEL_URL} target="_blank" rel="noopener">
      {twI18n.profile.youtube}<span class="sr-only"> ({twI18n.ui.external})</span>
    </a>
  </p>
</TwLayout>

<style>
  .tw-lead {
    color: var(--tw-text-sub);
  }
  .tw-notice {
    border: 1px solid var(--tw-border);
    border-left: 4px solid var(--tw-primary);
    background: var(--tw-surface);
    padding: 12px 14px;
    font-size: 13.5px;
    line-height: 1.85;
    margin-bottom: 18px;
  }
  .tw-count {
    font-size: 13px;
    color: var(--tw-text-sub);
    margin-bottom: 16px;
  }
  .tw-videos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .tw-videos a {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    border: 1px solid var(--tw-border);
    background: var(--tw-base);
    padding: 12px;
    text-decoration: none;
    color: var(--tw-text);
  }
  .tw-videos a:hover {
    background: var(--tw-surface);
    border-color: var(--tw-primary);
  }
  .tw-videos img {
    width: 160px;
    height: 90px;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--tw-surface);
  }
  .tw-video-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }
  .tw-video-title {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--tw-primary);
  }
  .tw-video-note {
    font-size: 13px;
    color: var(--tw-text-sub);
    line-height: 1.8;
  }
  .tw-video-ext {
    font-size: 12px;
    color: var(--tw-text-sub);
  }
  .tw-channel {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--tw-border);
    font-size: 14px;
  }

  @media (max-width: 560px) {
    .tw-videos a {
      flex-direction: column;
    }
    .tw-videos img {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
