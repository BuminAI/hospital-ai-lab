---
// 醫院資安自我檢核 (2026-10-31 新設)
// ⚠️ 台灣沒有像日本厚勞省那樣專為醫院訂的單一資安檢核表。這裡的檢核項目，是本研究所依下列法規條文「自己整理」的，
//    每一項都標出依據的條文。條文都實際讀過原文：資通安全管理法（114-09-24 修正、114-12-01 施行）、
//    資通安全事件通報及應變辦法（115-01-05 修正）、資通安全責任等級分級辦法（115-01-07 修正）、
//    醫療機構電子病歷製作及管理辦法（111-07-18 修正）。
// ⚠️ 私立醫院是否屬於「特定非公務機關」（要看是否被指定），這裡沒有查到可確認的名單，所以不下定論，
//    只寫「若適用」。
import '../../styles/tw-guide.css';
import TwLayout from '../../layouts/TwLayout.astro';
import TwGuideFoot from '../../components/TwGuideFoot.astro';
import TwFaq from '../../components/TwFaq.astro';
import { guideSchema } from '../../utils/tw-guide';
import { SRC } from '../../data/tw/guides/milestones';
import { withBase } from '../../utils/site';

const CHECKED = '2026 年 10 月 31 日';
const title = '醫院資安自我檢核｜依資通安全管理法與電子病歷辦法整理';
const description =
  '依《資通安全管理法》、事件通報及應變辦法、責任等級分級辦法與電子病歷辦法，整理醫院行政與資訊單位可以自我檢核的 20 個重點，每一項都標出依據的條文。';

type Item = { no: string; text: string; basis: string };
type Group = { id: string; head: string; lead?: string; items: Item[] };

const groups: Group[] = [
  {
    id: 'g1',
    head: '一、組織與責任',
    items: [
      { no: '1', text: '已確認本院的資通安全責任等級（公立醫學中心為 A 級，公立區域醫院或地區醫院為 B 級）。', basis: '責任等級分級辦法第 4 條第 7 款、第 5 條第 7 款' },
      { no: '2', text: '若屬特定非公務機關：已設置資通安全長，由代表人、管理人、其他有代表權人，或其指派的適當人員擔任。', basis: '資通安全管理法第 23 條' },
      { no: '3', text: '若屬特定非公務機關：已依責任等級設置資通安全專職人員。', basis: '資通安全管理法第 20、21 條' },
    ],
  },
  {
    id: 'g2',
    head: '二、維護計畫與稽核',
    items: [
      { no: '4', text: '已訂定並實施資通安全維護計畫，並能向中央目的事業主管機關提出實施情形。', basis: '資通安全管理法第 20、21 條' },
      { no: '5', text: '接受稽核後發現的缺失，已提出改善報告。', basis: '資通安全管理法第 20、21 條' },
    ],
  },
  {
    id: 'g3',
    head: '三、委外與廠商管理',
    lead: '醫院把系統建置、維運或服務交給廠商時，常常是風險最大的地方。',
    items: [
      { no: '6', text: '委外時已選任適當的受託者，並監督其實施資通安全管理。', basis: '資通安全管理法第 10 條' },
      { no: '7', text: '受託者已具備有效的資通安全管理措施，或通過公正第三方的驗證。', basis: '資通安全管理法第 10 條' },
      { no: '8', text: '委外契約是書面的，並載明雙方的權利義務與違約責任。', basis: '資通安全管理法第 10 條' },
      { no: '9', text: '電子病歷系統委外時：書面契約已涵蓋委託範圍、病人隱私保護與安全維持措施、契約終止時的資料處理、發現資安異常或缺陷時即時通知、再委託的限制等事項。', basis: '電子病歷辦法第 6、7 條' },
      { no: '10', text: '電子病歷系統委外時：受託機構已通過中央主管機關認可的資訊安全標準驗證，並有證明文件。', basis: '電子病歷辦法第 6 條第 3 項' },
    ],
  },
  {
    id: 'g4',
    head: '四、雲端服務與資料位置',
    items: [
      { no: '11', text: '使用雲端服務時：已採取適當的風險管理措施與避免醫療業務中斷的措施，並監督雲端業者。', basis: '電子病歷辦法第 8 條第 1 項' },
      { no: '12', text: '雲端服務停止或終止時，資料可以移轉給受託機構或其他雲端業者。', basis: '電子病歷辦法第 8 條第 1 項' },
      { no: '13', text: '電子病歷的儲存位置在我國境內（有特殊情形需經中央主管機關許可）。', basis: '電子病歷辦法第 8 條第 2 項' },
      { no: '14', text: '開始委外或使用雲端的 15 日內，已向直轄市、縣（市）主管機關備查，並附上契約與驗證證明文件。', basis: '電子病歷辦法第 9 條' },
    ],
  },
  {
    id: 'g5',
    head: '五、事件通報與應變',
    items: [
      { no: '15', text: '已訂定資通安全事件的通報及應變機制。', basis: '資通安全管理法第 24 條' },
      { no: '16', text: '若屬特定非公務機關：知悉事件後 1 小時內，依中央目的事業主管機關指定的方式通報。', basis: '事件通報及應變辦法第 11 條第 1 項' },
      { no: '17', text: '知悉事件後 72 小時內完成損害控制或復原作業（重大事件為 36 小時內）。', basis: '事件通報及應變辦法第 13 條第 1 項' },
      { no: '18', text: '事件處理後 1 個月內送交調查、處理及改善報告。', basis: '事件通報及應變辦法第 13 條第 2 項' },
      { no: '19', text: '電子病歷發生安全事故，影響營運或病人權益時：知悉後 72 小時內向直轄市、縣（市）主管機關通報，並依規定通知當事人。', basis: '電子病歷辦法第 5 條' },
      { no: '20', text: '配合主管機關的資安演練（若可能侵害院方權利或正當利益，需先取得書面同意）。', basis: '事件通報及應變辦法第 16 條第 2 項' },
    ],
  },
];

const total = groups.reduce((n, g) => n + g.items.length, 0);

const faq = [
  {
    q: '醫院發生資安事件，通報時限是多久？',
    a: '特定非公務機關知悉資通安全事件後，要在 1 小時內依中央目的事業主管機關指定的方式通報（事件通報及應變辦法第 11 條第 1 項）。電子病歷發生安全事故、影響營運或病人權益時，另依電子病歷辦法第 5 條，在知悉後 72 小時內向直轄市、縣（市）主管機關通報。',
  },
  {
    q: '電子病歷放在雲端，一定要放在台灣嗎？',
    a: '電子病歷辦法第 8 條第 2 項規定，雲端服務的儲存位置原則上要設在我國境內；有特殊情形，經中央主管機關許可可以例外。',
  },
  {
    q: '醫院把系統維運交給廠商，法律上有什麼要求？',
    a: '《資通安全管理法》第 10 條要求委外時要選任適當的受託者，受託者要有有效的資通安全管理措施或通過公正第三方驗證，並以書面契約載明雙方權利義務與違約責任。電子病歷系統的委外，另有電子病歷辦法第 6、7 條的契約事項與驗證要求。',
  },
  {
    q: '沒有通報資安事件會有什麼後果？',
    a: '《資通安全管理法》第 29 條規定，特定非公務機關未依第 24 條第 2 項通報事件，由中央目的事業主管機關處新臺幣 30 萬元以上 1,000 萬元以下罰鍰，並令限期改正；屆期未改正者按次處罰。',
  },
];

const sources = [
  SRC.cyberAct,
  SRC.cyberReport,
  SRC.cyberLevel,
  { label: '全國法規資料庫《醫療機構電子病歷製作及管理辦法》', url: 'https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=L0020121' },
];

const siteRootG = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const guide = guideSchema({
  siteRoot: siteRootG,
  path: '/tw/cyber-checklist/',
  headline: title,
  description,
  sources,
  published: '2026-10-31',
  modified: '2026-10-31',
  audience: '醫院行政與資訊單位',
  faq,
});
---

<TwLayout
  title={title}
  description={description}
  crumb="醫院資安自我檢核"
  standalone
  updated={new Date('2026-10-31T00:00:00+08:00')}
  schema={guide}
>
  <h1>醫院資安自我檢核</h1>
  <p class="tg-lead">
    醫院的資安要求散在好幾部法規裡：資通安全管理法、通報及應變辦法、責任等級分級辦法，還有電子病歷辦法。這裡把和醫院最有關的規定，整理成一份可以逐項勾選的自我檢核表。
  </p>
  <p class="tg-meta">查證日：{CHECKED} ／ 共 {total} 項 ／ 適用對象：醫院行政與資訊單位</p>

  <p class="tg-answer">
    重點：特定非公務機關知悉資安事件後，要在 1 小時內通報；應變處置 72 小時內完成（重大事件 36 小時內），1 個月內送交調查與改善報告。電子病歷的資料儲存位置，原則上要在我國境內。
  </p>

  <div class="tg-box tg-warn">
    <strong>先說清楚</strong>
    <ul class="tg-list">
      <li>這份檢核表是本研究所依法規條文整理的，<strong>不是官方公布的檢核表</strong>。每一項都標了依據的條文，請回到條文確認。</li>
      <li>私立醫院是否屬於「特定非公務機關」（要看是否被指定），本研究所沒有查到可確認的指定名單，所以標示「若屬特定非公務機關」的項目，請向貴院的主管機關確認是否適用。</li>
      <li>責任等級分級辦法規定，公立醫學中心為 A 級、公立區域醫院或地區醫院為 B 級。各等級的「應辦事項」（資安長、專職人員、驗證、健診等的頻率）在辦法附表，本頁沒有逐項列出，請查閱附表。</li>
    </ul>
  </div>

  {
    groups.map((g) => (
      <section class="tg-sec" id={g.id} aria-labelledby={`${g.id}-h`}>
        <h2 id={`${g.id}-h`}>{g.head}</h2>
        {g.lead && <p>{g.lead}</p>}
        <table class="tg-table">
          <thead>
            <tr>
              <th>項次</th>
              <th>檢核內容</th>
              <th>依據</th>
            </tr>
          </thead>
          <tbody>
            {g.items.map((it) => (
              <tr>
                <th>{it.no}</th>
                <td>{it.text}</td>
                <td>{it.basis}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))
  }

  <section class="tg-sec" aria-labelledby="h-how">
    <h2 id="h-how">怎麼用這份檢核表（本研究所的建議）</h2>
    <p>以下是本研究所的建議，不是法規要求。</p>
    <ol class="tg-list">
      <li><strong>先分成「已做到、沒做到、不確定」三類。</strong>不確定的項目，請問資訊室或廠商。</li>
      <li><strong>先看委外與雲端（第三、四組）。</strong>這幾項需要廠商配合，通常最花時間。</li>
      <li><strong>把通報流程做成一張卡片。</strong>誰通報、通報給誰、1 小時與 72 小時的時間點，放在夜間與假日也找得到的地方。</li>
      <li><strong>導入 AI 服務時用同一套標準問廠商。</strong>廠商能不能碰院內資料、資料放在哪裡、有沒有第三方驗證，對應第 6 到 14 項。</li>
    </ol>
    <p>
      向廠商提問的題目，可以直接用本站<a href={withBase('/tw/templates/')}>範本集</a>的「向廠商提問的 20 題」；生成式 AI 的院內規範，可參考同一頁的範本。
    </p>
  </section>

  <TwFaq items={faq} />

  <TwGuideFoot sources={sources} checked={CHECKED} />
</TwLayout>
