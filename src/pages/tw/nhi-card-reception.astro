---
// 健保卡就醫 櫃檯應對指南 (2026-10-31 新設)
// 根據: 健保署「就醫程序」(112-11-29 更新)、健保署《健保卡資料上傳格式 2.0 就醫情境問答集》(2024/10,
//       PDF 本文直接讀過)、衛福部新聞稿「健保卡數位化 出示手機即可就醫」(111-01-07)。
// ⚠️ 健保署網站對自動連線有時回應 403；本頁只寫實際讀到的內容。虛擬健保卡的現況沒有查到最新資料，所以只寫
//    2022 年新聞稿當時的試辦內容並標明日期，並請讀者向健保署確認。
import '../../styles/tw-guide.css';
import TwLayout from '../../layouts/TwLayout.astro';
import TwGuideFoot from '../../components/TwGuideFoot.astro';
import TwFaq from '../../components/TwFaq.astro';
import { guideSchema } from '../../utils/tw-guide';
import { withBase } from '../../utils/site';

const CHECKED = '2026 年 10 月 31 日';
const title = '健保卡就醫櫃檯應對指南｜忘記帶卡、讀卡異常怎麼辦';
const description =
  '民眾忘記帶健保卡、遇到停電或讀卡機故障時，櫃檯該怎麼處理？依健保署的就醫程序與 2024 年就醫情境問答集，整理成醫院掛號櫃檯與醫事課看得懂的重點。';

const sources = [
  { label: '健保署「就醫程序」（112 年 11 月 29 日更新）', url: 'https://www.nhi.gov.tw/ch/cp-5136-dd11f-2947-1.html' },
  { label: '健保署《健保卡資料上傳格式 2.0 就醫情境問答集》（2024/10，PDF）', url: 'https://www.nhi.gov.tw/ch/dl-19639-3d58420f6c8743ffbe411145dc7c1bc6-1.pdf' },
  { label: '衛福部新聞稿「健保卡數位化 出示手機即可就醫」（111 年 1 月 7 日）', url: 'https://www.mohw.gov.tw/cp-16-65465-1.html' },
];

const abnormal = [
  ['停電', 'C000'],
  ['醫療資訊系統（HIS）當機、電腦死當（無法開機）', 'D000 / D001'],
  ['醫療院所電腦故障', 'D010 / D011'],
  ['讀卡機、網路、安全模組故障', 'A000 / A001、A010 / A011、A020 / A021、A030 / A031'],
  ['健保署 VPN 當機', 'E000'],
  ['例外就醫', 'C001'],
  ['卡片晶片異常', 'B000 / B001'],
  ['民眾不願意提供健保卡密碼', 'Z000'],
];

const faq = [
  {
    q: '民眾忘記帶健保卡，可以先看診嗎？',
    a: '可以。健保署的就醫程序規定，民眾提不出健保卡或身分證件時，保險醫事服務機構應先提供醫療服務、收取保險醫療費用，並開給保險醫療費用項目明細表及收據。',
  },
  {
    q: '民眾事後補送健保卡，期限是多久？',
    a: '民眾在就醫之日起 10 日內（不含例假日）或出院前，補送保險憑證或身分證明，院所要在保險憑證登錄就醫紀錄，並把所收的保險醫療費用扣除民眾應自行負擔的部分後退還。',
  },
  {
    q: '民眾因不可抗力沒辦法在 10 日內補送，怎麼辦？',
    a: '健保署的就醫程序寫明，若有不可抗力，或可歸因於健保署或投保單位的因素，民眾可檢附院所開給的保險醫療費用項目明細表及收據，向健保署轄區業務組申請核退保險醫療費用。',
  },
  {
    q: '沒帶健保卡可以開立慢性病連續處方箋嗎？',
    a: '不行。健保署 2024 年問答集在說明欠卡情境時註明，未攜帶健保卡不得開立慢性病連續處方箋（依全民健康保險醫療辦法第 14 條）。',
  },
  {
    q: '停電或讀卡機故障時，櫃檯要怎麼處理？',
    a: '這類情況要以「異常就醫序號」處理：停電是 C000，HIS 當機是 D000／D001，讀卡機、網路或安全模組故障是 A 開頭的代碼，健保署 VPN 當機是 E000。取得就醫識別碼與上傳的欄位細節屬系統端作業，請與資訊廠商確認，並以健保署最新的作業說明為準。',
  },
];

const siteRootG = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const guide = guideSchema({
  siteRoot: siteRootG,
  path: '/tw/nhi-card-reception/',
  headline: title,
  description,
  sources,
  published: '2026-10-31',
  modified: '2026-10-31',
  audience: '醫院掛號櫃檯與醫事課',
  faq,
});
---

<TwLayout
  title={title}
  description={description}
  crumb="健保卡就醫櫃檯應對"
  standalone
  updated={new Date('2026-10-31T00:00:00+08:00')}
  schema={guide}
>
  <h1>健保卡就醫櫃檯應對指南</h1>
  <p class="tg-lead">
    櫃檯最難處理的，往往是「平常的流程走不通」的時候：民眾沒帶卡、停電、讀卡機壞了。這裡依健保署公布的規定，把這些情況該怎麼處理整理出來。
  </p>
  <p class="tg-meta">查證日：{CHECKED} ／ 適用對象：醫院掛號櫃檯與醫事課</p>

  <p class="tg-answer">
    重點：民眾沒帶健保卡時，院所要先提供醫療服務、收取保險醫療費用並開收據；民眾在就醫之日起 10 日內（不含例假日）或出院前補送健保卡，院所要把扣除自行負擔後的費用退還。
  </p>

  <section class="tg-sec" aria-labelledby="h-scenes">
    <h2 id="h-scenes">情境一：民眾沒帶健保卡（欠卡）</h2>
    <p>以下整理自健保署「就醫程序」。</p>
    <table class="tg-table">
      <thead>
        <tr><th>項目</th><th>健保署的說明</th></tr>
      </thead>
      <tbody>
        <tr>
          <th>就醫時要繳驗什麼</th>
          <td>保險憑證（健保卡），以及國民身分證或其他足以證明身分的證件；但保險憑證已足以辨識身分時，可以免繳驗。未滿 14 歲的民眾，可以戶口名簿、戶籍謄本等影本或其他足以證明身分的文件代替。</td>
        </tr>
        <tr>
          <th>提不出健保卡時</th>
          <td>因為尚未領到卡、分娩或緊急傷病就醫等原因提不出時，院所應先提供醫療服務、收取保險醫療費用，並開給保險醫療費用項目明細表及收據。</td>
        </tr>
        <tr>
          <th>民眾補送時</th>
          <td>民眾在就醫之日起 10 日內（不含例假日）或出院前補送保險憑證或身分證明，院所應在保險憑證登錄就醫紀錄，並把所收的保險醫療費用扣除民眾應自行負擔的費用後退還。</td>
        </tr>
        <tr>
          <th>來不及補送時</th>
          <td>民眾有不可抗力或可歸因於健保署或投保單位的因素，無法在 10 日內補送時，可檢附院所開的明細表及收據，向健保署轄區業務組申請核退。</td>
        </tr>
        <tr>
          <th>慢性病連續處方箋</th>
          <td>2024 年問答集註明，未攜帶健保卡不得開立慢性病連續處方箋（依全民健康保險醫療辦法第 14 條）。</td>
        </tr>
        <tr>
          <th>無法確認身分的緊急就醫</th>
          <td>問答集提到，路倒或急診緊急就醫無法判斷身分，或因故沒有取得就醫識別碼時，院所要填寫「無實際就醫識別碼補卡上傳報備單」向健保署分區業務組報備，說明原因。</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="tg-sec" aria-labelledby="h-abn">
    <h2 id="h-abn">情境二：有帶卡，但系統出了狀況（異常就醫序號）</h2>
    <p>
      健保署 2024 年問答集區分了「欠卡」與「異常」：欠卡是民眾沒帶卡、以自費就醫後再補卡；異常則是民眾有出示健保卡，但院所因故沒辦法正常取得就醫序號。異常情境要用對應的「異常就醫序號」上傳。常見代碼如下。
    </p>
    <table class="tg-table">
      <thead>
        <tr><th>狀況</th><th>異常就醫序號</th></tr>
      </thead>
      <tbody>
        {abnormal.map(([a, b]) => <tr><th>{a}</th><td>{b}</td></tr>)}
      </tbody>
    </table>
    <p>
      以上代碼取自問答集，且該問答集註明「相關規定以作業說明為主」。如何取得就醫識別碼、上傳欄位怎麼填，屬系統端作業，請與資訊廠商及健保署分區業務組確認。
    </p>
  </section>

  <section class="tg-sec" aria-labelledby="h-other">
    <h2 id="h-other">情境三：其他常被問到的狀況</h2>
    <table class="tg-table">
      <tbody>
        <tr>
          <th>新生兒還沒有健保卡</th>
          <td>問答集分成兩種：出生日期在 60 日以內，依附母親就醫，用母親的健保卡與就醫識別碼，並依規定登錄新生兒依附註記；出生超過 60 日且在 92 日以內，以自費方式就醫，再補辦健保投保手續後回院所補卡，或向健保署申請核退。</td>
        </tr>
        <tr>
          <th>民眾拿手機出示虛擬健保卡</th>
          <td>衛福部 111 年 1 月 7 日的新聞稿說明，民眾可用「全民健保行動快易通│健康存摺」APP 申請虛擬健保卡，以 QR Code 就醫。當時是試辦，領域為遠距醫療、居家醫療與擴大視訊診療門診；只有參加試辦並完成線上受理的院所才能受理，民眾就醫前要先查名單並電話確認。這是 2022 年的資料，目前的適用範圍請向健保署確認。</td>
        </tr>
        <tr>
          <th>民眾要問健保相關事務</th>
          <td>健保署諮詢服務專線：市話 0800-030-598，手機請撥 02-4128-678（健保署網站頁尾）。</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="tg-sec" aria-labelledby="h-staff">
    <h2 id="h-staff">櫃檯可以先準備的事（本研究所的建議）</h2>
    <p>以下是本研究所的建議，不是健保署的規定。</p>
    <ul class="tg-list">
      <li><strong>做一張「沒帶卡」的流程圖：</strong>先看診 → 收費並開明細與收據 → 告知民眾 10 日內（不含例假日）或出院前補送 → 補送後退費，讓每位櫃檯人員都用同一套說法。</li>
      <li><strong>把「異常就醫序號」對照表放在櫃檯：</strong>停電、系統當機、讀卡機故障時，不用臨時翻文件。</li>
      <li><strong>慢性病連續處方箋要先問有沒有帶卡：</strong>避免開出後才發現不符規定。</li>
      <li><strong>和資訊廠商確認異常情境的系統操作：</strong>演練一次停電或讀卡機故障時的作業流程。</li>
      <li><strong>給民眾的一句話：</strong>「沒帶卡也可以先看診，請在 10 日內（不含例假日）帶健保卡回來補送，我們會退還健保給付的部分。」</li>
    </ul>
    <p>
      民眾端的說明，可以參考本站的<a href={withBase('/tw/patients/nhi-health-passbook/')}>患者專區：健保卡、健康存摺與找院所</a>。
    </p>
  </section>

  <TwFaq items={faq} />

  <TwGuideFoot sources={sources} checked={CHECKED} />
</TwLayout>
