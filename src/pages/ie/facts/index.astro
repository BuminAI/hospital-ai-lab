---
// Key facts for citation (2026-11-15) — a page for AEO/GEO.
// One item = question + short answer + section + primary source. Data: src/data/ie/guides/facts.ts.
// Each item has an anchor (#id) for direct linking.
import '../../../styles/ie-guide.css';
import IeLayout from '../../../layouts/IeLayout.astro';
import IeGuideFoot from '../../../components/IeGuideFoot.astro';
import { FACTS, FACT_TOPICS, FACTS_CHECKED } from '../../../data/ie/guides/facts';
import { SRC } from '../../../data/ie/guides/milestones';
import { withBase } from '../../../utils/site';

const title = 'Key facts: AI rules, patient data and device safety in Ireland';
const description = `${FACTS.length} short answers you can cite on HIQA’s AI guidance, the AI for Care strategy, the EU AI Act, device incident reporting, GDPR and the DPC’s AI guidance.`;

const siteRoot = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://hospital-ai-lab.com';
const pageUrl = `${siteRoot}${withBase('/ie/facts/')}`;

const faqLd = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  url: pageUrl,
  inLanguage: 'en-IE',
  isPartOf: { '@id': `${siteRoot}/#website-ie` },
  mainEntity: FACTS.map((f) => ({
    '@type': 'Question',
    '@id': `${pageUrl}#${f.id}`,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: `${f.a} (Basis: ${f.basis}.)`, citation: SRC[f.src].url },
  })),
};
const articleLd = {
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: title,
  description,
  inLanguage: 'en-IE',
  author: { '@id': `${siteRoot}/#person` },
  publisher: { '@id': `${siteRoot}/#organization` },
  isPartOf: { '@id': `${siteRoot}/#website-ie` },
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  datePublished: '2026-11-15T00:00:00+00:00',
  dateModified: '2026-11-15T00:00:00+00:00',
  isAccessibleForFree: true,
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.tg-answer', 'h1'] },
  citation: Object.values(SRC).map((s) => ({ '@type': 'CreativeWork', name: s.label, url: s.url })),
};

const sources = [SRC.hiqaRelease, SRC.hiqaDraft, SRC.aiForCare, SRC.aiAct, SRC.gdpr, SRC.mdr, SRC.dpcAi, SRC.hpraOverview, SRC.hpraReporting];
---

<IeLayout title={title} description={description} crumb="Key facts" standalone updated={new Date('2026-11-15T00:00:00+00:00')} schema={[articleLd, faqLd]}>
  <h1>Key facts: AI rules, patient data and device safety in Ireland</h1>
  <p class="tg-lead">
    Short answers to the questions that come up most in purchasing and compliance meetings. Each answer was written after the text of the document was opened, and gives the section and a link to the primary source.
  </p>
  <p class="tg-meta">Checked: {FACTS_CHECKED} · {FACTS.length} items · For: administrators, nurses and patients</p>

  <p class="tg-answer">
    In short: HIQA published Ireland’s first national AI guidance for health and social care on 29 July 2026; the EU AI Act makes a hospital that uses an AI system a deployer, with duties that apply in stages (most from 2 August 2026, as published); AI software can be a medical device under the MDR, which HPRA applies without approving products; and patient data is special category data under the GDPR, with a 72-hour breach clock.
  </p>

  <div class="tg-box">
    <strong>How to use this page</strong><br />
    Copy an answer together with its section, and check the text of the rule at the primary source. There are no deadlines or rules here whose text we did not read; this is not legal advice.
    <br />
    {
      FACT_TOPICS.map((t, i) => (
        <>
          <a href={`#t-${i}`}>{t}</a>
          {i < FACT_TOPICS.length - 1 ? ' · ' : ''}
        </>
      ))
    }
  </div>

  {
    FACT_TOPICS.map((topic, i) => (
      <section class="tg-sec" aria-labelledby={`t-${i}`}>
        <h2 id={`t-${i}`}>{topic}</h2>
        <dl class="tg-facts">
          {FACTS.filter((f) => f.topic === topic).map((f) => (
            <>
              <dt id={f.id}>
                <a href={`#${f.id}`}>{f.q}</a>
              </dt>
              <dd>
                <p>{f.a}</p>
                <p class="tg-basis">
                  Basis: {f.basis} ·{' '}
                  <a href={SRC[f.src].url} target="_blank" rel="noopener">
                    primary source<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </p>
              </dd>
            </>
          ))}
        </dl>
      </section>
    ))
  }

  <section class="tg-sec" aria-labelledby="h-next">
    <h2 id="h-next">Next</h2>
    <div class="tg-cards">
      <a class="tg-card" href={withBase('/ie/dx-roadmap/')}><b>Roadmap</b><span>Key rules on one timeline.</span></a>
      <a class="tg-card" href={withBase('/ie/data-checklist/')}><b>Patient data protection checklist</b><span>Items from the GDPR and the DPC’s AI guidance.</span></a>
      <a class="tg-card" href={withBase('/ie/glossary/')}><b>Glossary</b><span>Medical AI terms in plain language.</span></a>
    </div>
  </section>

  <IeGuideFoot sources={sources} checked={FACTS_CHECKED} />
</IeLayout>
