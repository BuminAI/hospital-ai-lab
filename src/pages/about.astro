---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchIcon from '../components/ResearchIcon.astro';
import { researchAreas } from '../data/research';
import { withBase } from '../utils/site';

// ProfilePage — AI 답변 엔진이 '누가 쓰는 사이트인가'를 판정하는 근거.
// 일본어판(ja/about)에는 있는데 원본인 한국어판에만 빠져 있었다(2026-08-30).
// Person 본체는 SchemaOrg가 전 페이지에 넣으므로 여기서는 @id로 참조만 한다.
// 화면에 보이는 사실만 마크업한다(구글은 비가시 콘텐츠 마크업을 금지) — 아래
// '연구소장 소개' 절이 그 근거 화면이다.
const siteUrl = Astro.site
  ? Astro.site.href.replace(/\/$/, '')
  : 'https://hospital-ai-lab.com';
const profilePage = {
  '@type': 'ProfilePage',
  '@id': `${siteUrl}${withBase('/about/')}#profile`,
  url: `${siteUrl}${withBase('/about/')}`,
  inLanguage: 'ko-KR',
  mainEntity: { '@id': `${siteUrl}/#person` },
};

const timeline = [
  {
    label: '종합병원 근무 시작',
    detail: '종합병원에서 근무를 시작해 현재 17년째입니다.',
  },
  {
    label: '병원 기획 업무 7년',
    detail: '그중 7년은 병원 기획 업무를 맡았습니다.',
  },
];
---

<BaseLayout
  title="소개"
  description="종합병원에서 17년(그중 병원 기획 7년) 일한 운영자가 병원 행정·간호의 언어로 의료 AI를 정리합니다. 연구소의 미션과 연구 방식, 다루는 분야, 운영자 약력을 소개합니다."
  alternates={{ ja: '/ja/about/', ru: '/ru/about/', id: '/id/about/' }}
  schema={[profilePage]}
>
  <div class="container">
    <header class="page-head">
      <h1>소개</h1>
      <p class="lead">
        종합병원 현장에서 쌓은 경험을 바탕으로 이 연구소는 시작되었습니다.
      </p>
    </header>

    <section class="section">
      <h2>연구 방식에 대하여</h2>
      <div class="honest-note">
        <p>
          저는 프로그램 개발자가 아닙니다. 종합병원에서 오래 근무한
          실무자입니다. 비개발자이며, 바이브코딩(AI와의 대화로 프로그램을
          만드는 방식)으로 연구합니다. 코딩 하나하나를 설명할 수는 없습니다.
          다만 왜 이러한 기획을 했고, 어떻게 연구하고 있는지를 보여드립니다.
        </p>
        <p>
          이곳은 의료진, 간호, 행정, 보건, 의료기사 등 병원에 종사하는 많은
          분들과 함께 성장하는 연구소입니다.
        </p>
      </div>
    </section>

    <section class="section">
      <h2>연구소장 소개</h2>
      {/*
        이름·직함·학력은 2026-07-27 오너 지시로 공개 전환했다(briefing.md에 근거 기록).
        ⚠️ 이 블록을 지우면 안 되는 이유: SchemaOrg의 Person JSON-LD가 같은 사실
        (이름·직함·석사·박사)을 선언하는데, 구글 구조화 데이터 정책은 **화면에 보이지
        않는 내용을 마크업하는 것을 금지**한다. 여기가 그 근거 화면이다.
        JSON-LD를 바꾸면 이 블록도 같이 맞춰야 한다.
      */}
      <p class="person-line">
        <strong>조영호</strong> · 병원 AI 연구소 소장
      </p>
      <ul class="person-facts">
        <li>종합병원 근무 17년 (그중 병원 기획 7년)</li>
        <li>통계학 석사 · 경제학 박사</li>
      </ul>
      <p>
        종합병원에서 17년간 근무하며, 현장에서 마주치는 크고 작은 문제를
        가까이서 지켜봐 왔습니다. 그중 7년은 병원 기획 업무를 맡아, 의사결정이
        어떤 근거 위에서 이뤄지는지, 또 어디서 정보가 부족한지를 직접
        경험했습니다. 오랜 병원 현장 경험을 바탕으로 인공지능이 실제로 어떤
        역할을 할 수 있을지 고민하다 이 연구소를 시작하게 되었습니다.
      </p>
    </section>

    <section class="section">
      <h2>미션</h2>
      <p>
        병원 AI 연구소는 병원 현장의 오랜 경험을 AI 활용과 연결하는 것을
        목표로 합니다. AI는 화려한 기술 소개로 그치기 쉽지만, 이 연구소는
        병원 기획·운영 현장에서 17년간 쌓은 경험을 바탕으로 "실제로 병원에서
        쓸 수 있는가"라는 질문을 가장 먼저 던집니다. 이 연구소가 지향하는 것은
        두 가지입니다. 첫째, 근거가 분명하고 현장에서 실행 가능한 AI 활용법을
        연구합니다. 둘째, 그 과정과 결과를 간호·행정을 비롯한 병원 종사자들이
        이해할 수 있는 언어로 기록하고 나눕니다.
      </p>
    </section>

    <section class="section" id="research">
      <h2>연구 분야</h2>
      <div class="areas">
        {
          researchAreas.map((area) => (
            <article class="area">
              <ResearchIcon icon={area.icon} />
              <div>
                <h3>{area.title}</h3>
                <p>{area.full}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <h2>약력</h2>
      <ol class="timeline">
        {
          timeline.map((item) => (
            <li>
              <h3>{item.label}</h3>
              <p>{item.detail}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section">
      <h2>문의</h2>
      <p>
        연구 주제에 대한 의견이나 협업 제안은
        <a href={withBase('/contact/')}>문의 페이지</a>에서 이메일 주소를
        확인해 보내주세요.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .section {
    padding-block: 2.25rem;
    max-width: var(--prose-width);
  }

  /* 연구소장 신원 — Person JSON-LD가 선언하는 사실의 화면 근거 */
  .person-line {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .person-facts {
    margin: 0 0 1rem;
    padding-left: 1.1rem;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .section h2 {
    font-size: 1.375rem;
    margin-bottom: 1rem;
  }

  .section p {
    color: var(--color-text);
  }

  .honest-note {
    background: var(--color-primary-soft);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.5rem 1.75rem;
  }

  .honest-note p + p {
    margin-top: 1em;
  }

  .areas {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .area {
    display: flex;
    gap: 1.1rem;
  }

  .area h3 {
    font-size: 1.1rem;
  }

  .area p {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  @media (max-width: 40rem) {
    .area {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--color-border);
  }

  .timeline li {
    position: relative;
    padding: 0 0 2rem 1.75rem;
  }

  .timeline li:last-child {
    padding-bottom: 0.25rem;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.5em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .timeline h3 {
    font-size: 1.05rem;
  }

  .timeline p {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    color: var(--color-muted);
  }
</style>
