{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(gh run *)",
      "Bash(gh workflow run *)",
      "Bash(./.claude/run-npm.cmd build*)",
      "Bash(./.claude/run-audit.cmd*)",
      "Bash(curl -s https://hospital-ai-lab.com*)",
      "Bash(ls *)",
      "Bash(date*)",
      "Write(src/content/blog/**)",
      "Edit(src/content/blog/**)",
      "Write(src/content/blog-ru/**)",
      "Edit(src/content/blog-ru/**)",
      "Write(src/content/blog-ja/**)",
      "Edit(src/content/blog-ja/**)",
      "Write(src/content/blog-id/**)",
      "Write(src/content/blog-tw/**)",
      "Edit(src/content/blog-id/**)",
      "Edit(src/content/blog-tw/**)",
      "Edit(src/layouts/**)",
      "Write(src/layouts/**)",
      "Edit(src/pages/**)",
      "Write(src/pages/**)",
      "Edit(src/components/**)",
      "Write(src/components/**)",
      "Edit(src/utils/**)",
      "Write(src/utils/**)",
      "Edit(src/i18n/**)",
      "Write(src/i18n/**)",
      "Edit(src/data/**)",
      "Write(src/data/**)",
      "Edit(src/styles/**)",
      "Write(src/styles/**)",
      "Edit(public/llms.txt)",
      "Write(public/llms.txt)",
      "Edit(public/*.txt)",
      "Write(public/*.txt)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\nodejs\\node.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/allow-webfetch.cjs"]
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\nodejs\\node.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/allow-content-write.cjs"]
          }
        ]
      }
    ]
  }
}
