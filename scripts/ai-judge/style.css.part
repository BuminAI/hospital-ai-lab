<style>
/* Layout: 파일 업로드 + 짧은 질문(왼쪽) ↔ 실시간 판정(오른쪽 고정), 아래에 자동 분석 리포트와 공개 채점 규칙 */
:root{
  --bg:#f3f5f8; --surface:#ffffff; --ink:#0e141d; --muted:#566173; --line:#d8dde6; --soft:#e9edf3;
  --accent:#0e141d; --accent-ink:#ffffff; --focus:#2f5fd0;
  --prog:#b9471f; --mid:#0f6e64; --cons:#2a4f9a;
  --gS:#9a6400; --gS-bg:#fbf0d6; --gA:#17694a; --gA-bg:#dff1e7; --gB:#2a4f9a; --gB-bg:#e2e9f7; --gC:#5f6673; --gC-bg:#e9ebef;
  --warn:#9a3a12; --warn-bg:#fbe8de; --ok:#17694a; --ok-bg:#dff1e7;
  --sans:"IBM Plex Sans KR","Pretendard","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0e141d; --surface:#151d29; --ink:#e6ebf2; --muted:#9aa6b8; --line:#2a3546; --soft:#1c2634;
  --accent:#e6ebf2; --accent-ink:#0e141d; --focus:#7fa2ff;
  --prog:#f0936c; --mid:#5cc7b8; --cons:#8fb0f2;
  --gS:#f1c35c; --gS-bg:#382d14; --gA:#74d2a4; --gA-bg:#163327; --gB:#9fbaf0; --gB-bg:#1b2944; --gC:#a9b0bc; --gC-bg:#242b36;
  --warn:#f3a27c; --warn-bg:#3a2219; --ok:#74d2a4; --ok-bg:#163327; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0e141d; --surface:#151d29; --ink:#e6ebf2; --muted:#9aa6b8; --line:#2a3546; --soft:#1c2634;
  --accent:#e6ebf2; --accent-ink:#0e141d; --focus:#7fa2ff;
  --prog:#f0936c; --mid:#5cc7b8; --cons:#8fb0f2;
  --gS:#f1c35c; --gS-bg:#382d14; --gA:#74d2a4; --gA-bg:#163327; --gB:#9fbaf0; --gB-bg:#1b2944; --gC:#a9b0bc; --gC-bg:#242b36;
  --warn:#f3a27c; --warn-bg:#3a2219; --ok:#74d2a4; --ok-bg:#163327; color-scheme:dark}

*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.6}
a{color:inherit}
code,.num{font-family:var(--mono);font-variant-numeric:tabular-nums}
code{font-size:.9em;background:var(--soft);border-radius:4px;padding:0 4px;word-break:break-all}
h1,h2,h3{margin:0;text-wrap:balance}
.topbar{border-bottom:1px solid var(--line);background:var(--surface)}
.topbar .in{max-width:1200px;margin:0 auto;padding-block:10px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:13.5px}
.topbar a{text-decoration:none;color:var(--muted)} .topbar a:hover{color:var(--ink)}
.wrap{max-width:1200px;margin:0 auto;padding-block:28px 64px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:grid;gap:28px}
header.hero{display:grid;gap:6px;border-bottom:2px solid var(--ink);padding-bottom:18px}
.eyebrow{font-size:12px;font-weight:600;letter-spacing:.08em;color:var(--muted)}
h1{font-size:clamp(24px,3.4vw,32px);font-weight:700;letter-spacing:-.015em}
.lede{color:var(--muted);max-width:72ch;margin:0}
.pill-row{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.pill{font-size:12.5px;background:var(--soft);border-radius:999px;padding:3px 10px;color:var(--muted)}

.grid{display:grid;grid-template-columns:minmax(0,1fr);gap:24px;align-items:start}
@media (max-width:920px){.grid{grid-template-columns:minmax(0,1fr)}}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:20px;display:grid;gap:16px;min-width:0}
.panel-head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
h2{font-size:18px;font-weight:700}
.btns{display:flex;gap:8px;flex-wrap:wrap}
button{font:inherit;font-size:13.5px;font-weight:600;border-radius:6px;padding:7px 14px;cursor:pointer;border:1px solid var(--line);background:var(--surface);color:var(--ink)}
button.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
button:disabled{opacity:.45;cursor:not-allowed}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
.example-note{font-size:13px;color:var(--warn);background:var(--warn-bg);border-radius:6px;padding:7px 10px;margin:0}

.field{display:grid;gap:5px;min-width:0}
.field>label,.q-title{font-size:14px;font-weight:600}
input[type=text],input[type=number]{width:100%;font:inherit;font-size:14px;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:8px 10px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.row3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
@media (max-width:520px){.row2,.row3{grid-template-columns:1fr}}
.hint{font-size:12.5px;color:var(--muted);font-weight:400}

.drop{border:2px dashed var(--line);border-radius:10px;padding:20px;display:grid;gap:8px;justify-items:center;text-align:center;background:var(--bg);transition:border-color .15s}
.drop.over{border-color:var(--focus)}
.drop b{font-size:15px}
.files{display:grid;gap:6px}
.file{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;align-items:center;border:1px solid var(--line);border-radius:7px;padding:7px 10px;font-size:13.5px}
.file .ty{font-family:var(--mono);font-size:11.5px;font-weight:600;border-radius:4px;padding:1px 6px;background:var(--soft);color:var(--muted);text-transform:uppercase}
.file .nm{overflow-wrap:anywhere}
.file button{padding:2px 8px;font-size:12px}

.area{border-top:1px solid var(--line);padding-top:16px;display:grid;gap:14px}
.area-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}
.area-head h3{font-size:15.5px}
.area-head .pts{font-family:var(--mono);font-size:12.5px;color:var(--muted)}
.q{display:grid;gap:6px;border:0;padding:0;margin:0;min-width:0}
.q legend{padding:0;margin-bottom:6px}
.opts{display:grid;gap:6px}
.opt{display:flex;gap:10px;align-items:flex-start;border:1px solid var(--line);border-radius:7px;padding:8px 10px;cursor:pointer;font-size:14px;background:var(--bg)}
.opt input{margin:3px 0 0;accent-color:var(--ink)}
.opt:has(input:checked){border-color:var(--ink);background:var(--soft)}
.opts.inline{grid-template-columns:repeat(auto-fit,minmax(130px,1fr))}
.calc{font-size:13px;color:var(--muted);background:var(--soft);border-radius:6px;padding:7px 10px}
.auto{font-size:13px;color:var(--muted);background:var(--soft);border-radius:6px;padding:8px 10px}

/* result */
dialog.resdlg{width:min(860px,calc(100vw - 24px));max-height:calc(100vh - 24px);padding:0;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:inherit;overflow:auto}
dialog.resdlg::backdrop{background:rgba(0,0,0,.5)}
dialog.resdlg .in{padding:18px 20px 22px}
.submitbar{margin-top:18px;padding-top:16px;border-top:1px solid var(--line);display:grid;gap:10px}
.submitbar .go{font-weight:700;font-size:15px;border-radius:8px;padding:11px 18px;cursor:pointer;background:var(--accent);color:var(--accent-ink);border:0}
.submitbar .go:disabled{opacity:.5;cursor:not-allowed}
@media (max-width:920px){.result{position:static}}
#result{display:grid;gap:12px}
.verdict{display:grid;grid-template-columns:auto minmax(0,1fr);gap:16px;align-items:center;border-radius:10px;padding:16px;background:var(--soft)}
.badge{width:76px;height:76px;border-radius:10px;display:grid;place-items:center;font-size:38px;font-weight:700;font-family:var(--mono);background:var(--g-bg);color:var(--g)}
.g-S{--g:var(--gS);--g-bg:var(--gS-bg)} .g-A{--g:var(--gA);--g-bg:var(--gA-bg)} .g-B{--g:var(--gB);--g-bg:var(--gB-bg)} .g-C{--g:var(--gC);--g-bg:var(--gC-bg)} .g-H{--g:var(--warn);--g-bg:var(--warn-bg)}
.verdict .big{font-size:22px;font-weight:700;line-height:1.3}
.verdict .sub{font-size:13px;color:var(--muted)}
.judges{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.judge{border:1px solid var(--line);border-top:4px solid var(--jc);border-radius:8px;padding:10px;display:grid;gap:2px;min-width:0}
.judge .n{font-size:13px;font-weight:700;color:var(--jc)}
.judge .s{font-size:26px;font-weight:600;line-height:1.15}
.judge .g{font-size:12.5px;color:var(--muted)}
.j-prog{--jc:var(--prog)} .j-mid{--jc:var(--mid)} .j-cons{--jc:var(--cons)}
.flags{display:grid;gap:6px}
.flag{font-size:13px;border-radius:6px;padding:7px 10px;background:var(--warn-bg);color:var(--warn)}
.flag.ok{background:var(--ok-bg);color:var(--ok)}
.flag.info{background:var(--soft);color:var(--muted)}
.tbl{overflow-x:auto;border:1px solid var(--line);border-radius:8px}
table{border-collapse:collapse;width:100%;font-size:13.5px}
th,td{padding:7px 9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
tr:last-child td{border-bottom:0}
thead th{background:var(--soft);font-size:12px;font-weight:600;color:var(--muted);white-space:nowrap}
.c{text-align:center}
.src{font-size:11px;font-weight:600;border-radius:3px;padding:0 5px;margin-left:4px;background:var(--soft);color:var(--muted);white-space:nowrap}
.lv{display:inline-block;min-width:40px;text-align:center;font-weight:600;border-radius:4px;padding:0 6px;font-size:12.5px}
.lv0{background:var(--ok-bg);color:var(--ok)} .lv1{background:var(--gB-bg);color:var(--gB)} .lv2{background:var(--gS-bg);color:var(--gS)} .lv3{background:var(--warn-bg);color:var(--warn)}
tr.gap td{background:color-mix(in srgb,var(--warn-bg) 60%,transparent)}
details{border:1px solid var(--line);border-radius:8px;padding:9px 12px}
details summary{cursor:pointer;font-weight:600;font-size:14px}
.why{display:grid;gap:8px;margin-top:10px;font-size:13.5px}
.why div{display:grid;gap:1px}
.why .adj{color:var(--jc)}
.status{font-size:12.5px;color:var(--muted);margin:0}

/* report */
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.metric{border:1px solid var(--line);border-radius:8px;padding:10px 12px;display:grid;gap:2px}
.metric .k{font-size:12.5px;color:var(--muted)}
.metric .v{font-size:20px;font-weight:600}
.find{display:grid;gap:8px}
.fgroup{border:1px solid var(--line);border-left:4px solid var(--fc);border-radius:8px;padding:10px 12px;display:grid;gap:4px;font-size:13.5px}
.fgroup h3{font-size:14px;color:var(--fc)}
.fgroup ul{margin:0;padding-left:18px;display:grid;gap:3px}
.f-bad{--fc:var(--warn)} .f-ok{--fc:var(--ok)} .f-info{--fc:var(--muted)}

/* rubric */
.pay{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
@media (max-width:640px){.pay{grid-template-columns:repeat(2,minmax(0,1fr))}}
.pay-card{border-radius:8px;padding:12px;background:var(--g-bg);color:var(--g);display:grid;gap:4px}
.pay-card .gg{font-family:var(--mono);font-size:24px;font-weight:700}
.pay-card .rng{font-size:12.5px}
.pay-card label{font-size:12px}
.pay-card input{padding:5px 8px;font-size:13.5px;background:var(--surface)}
.rubric td:first-child{white-space:nowrap;font-weight:600}
.rubric .pt{font-family:var(--mono);font-size:12px;color:var(--muted)}
.rules{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
@media (max-width:820px){.rules{grid-template-columns:minmax(0,1fr)}}
.rule{border:1px solid var(--line);border-top:4px solid var(--jc);border-radius:8px;padding:12px 14px;font-size:13.5px}
.rule h3{color:var(--jc);font-size:15px;margin-bottom:4px}
.rule ul{margin:6px 0 0;padding-left:18px;display:grid;gap:4px}
.steps{margin:0;padding-left:20px;display:grid;gap:4px;font-size:14px}
footer{font-size:12.5px;color:var(--muted);border-top:1px solid var(--line);padding-top:16px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
.sandbox{position:absolute;left:-9999px;top:0;width:800px;height:600px;border:0}

.mbar{display:none}
.mbar button{font:inherit;font-weight:600;border:0;background:none;color:var(--accent);cursor:pointer}
@media (max-width:920px){
  .mbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:20;gap:12px;align-items:center;justify-content:space-between;background:var(--surface);border-top:1px solid var(--line);padding-block:10px calc(10px + env(safe-area-inset-bottom,0px));padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));font-size:14px}
  .mbar b{font-family:var(--mono)}
  body{padding-bottom:64px}
}
@media print{body>*:not(dialog){display:none!important}dialog.resdlg{position:static;display:block;width:auto;max-height:none;border:0;overflow:visible}dialog.resdlg .btns{display:none}dialog.resdlg::backdrop{display:none}body{background:#fff}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>